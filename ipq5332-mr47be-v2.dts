// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
//
// Mercusys MR47BE V2 - IPQ5332 AP-MI01.6 based Wi-Fi 7 tri-band router
// Base: GL-BE6500 DTS (qualcommbe/ipq53xx) + MR47BE V2 GPL kernel DTS
// SoC: Qualcomm IPQ5322 (die: "IPQ5322 003 FK5134HJ"; software variant
//      string is IPQ5332LA), 4x Cortex-A53, 1 GiB DDR4 (SEC K4A8G165WC)
// WiFi: on-SoC 2.4GHz (wifi0, qcom,board-id = 18 = 0x12) + QCN6274 via
//      PCIe1 (5G+6G, 2 radios, pci17cb,1109, qcom,board-id = 0x1015)
// Switch: QCA8084 - INTEGRATED into the IPQ53xx SoC (NO separate chip; GPL U-Boot
//      ipq_qca8084.c "QCA8084-switch"), 4x 2.5G + SoC PPE
// Flash: SPI-NAND Winbond W25N01GW 128MiB (NO SPI-NOR - boot log: not found)
// UART: GPIO18/19 @ 115200
// v6: firmware-DTB fixes on top of v5 (reset button gpio29, bus reset 30/39/45, LED 24/39 removed).
// v3: on top of FINAL-DTS-6.18.54: mdio reset-gpios removed, nsscc reset delay, reset button gpio30,
//     NAND ECC 4-bit (stock), conduit label "cpu". Everything else identical.

/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>
#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
#include <dt-bindings/net/qcom,qca808x.h>
#include <dt-bindings/net/qcom,ipq9574-pcs.h>

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	model = "Mercusys MR47BE V2";
	compatible = "mercusys,mr47be-v2", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		/* Stock DTS semantic mapping: dp1/id=2 -> LAN switch CPU conduit,
		 * dp2/id=1 -> WAN MAC. These aliases are enumeration hints only;
		 * DSA still creates the actual lan1/lan2/lan3 ports below. */
		ethernet0 = &xgmac2;
		ethernet1 = &xgmac1;
		led-boot = &led_sys_green;
		led-failsafe = &led_sys_orange;
		led-running = &led_sys_green;
		led-upgrade = &led_sys_orange;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* test051: because the NSSCC provider (clock-controller@18) is okay, CCF
		 * disables, at late_initcall, every branch with enable_count==0 in hardware
		 * (mac0..mac4/gephy/srds) = WAN+LAN RX zero (test039-A, test050 measured).
		 * clk_ignore_unused turns this cleanup off; what U-Boot set up stays in place. */
		bootargs-append = " root=/dev/ubiblock0_1 cnss2.bdf_integrated=0x12 clk_ignore_unused";
	};

        /* CPU: 4x Cortex-A53 */
        cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		cpu@0 { reg = <0x00>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
		cpu@1 { reg = <0x01>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
		cpu@2 { reg = <0x02>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
		cpu@3 { reg = <0x03>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		tzapp: tzapp@49b00000 {
			reg = <0x0 0x49b00000 0x0 0x00600000>;
			no-map;
		};

		/*
		 * Q6 carveout 35 MB (0x2300000) = VENDOR GL-BE9300 stock DTB
		 * (vendor.dts wcnss@4a900000) + MR47BE GPL mi01.6 value.
		 * test50: with 43MB, TZ AUTH ret=-12 res0=0 (SMC layer worked,
		 * TZ did not write the payload) -> mismatch with TZ's own 35MB table.
		 * test51: vendor map (m3 0x4cc00000, caldb 0x4ce00000).
		 */
		q6_region: wcss@4a900000 {
			reg = <0x0 0x4a900000 0x0 0x02300000>;
			no-map;
		};

		/* BE9300/MR47BE vendor Q6 BDF host window: q6 base + 0x0c00000.
		 * It intentionally lies in the tail of q6_region, as in the working
		 * GL-BE9300 DTS; ath12k consumes it as an explicit host-ddr region. */
		q6_host_ddr: host-ddr@4b500000 {
			reg = <0x0 0x4b500000 0x0 0x01700000>;
			no-map;
		};

		m3_dump: m3-dump@4cc00000 {
			reg = <0x0 0x4cc00000 0x0 0x100000>;
			no-map;
		};

		q6_caldb: q6-caldb@4ce00000 {
			reg = <0x0 0x4ce00000 0x0 0x500000>;
			no-map;
		};

		q6_etr: q6-etr-dump@4cd00000 {
			reg = <0x0 0x4cd00000 0x0 0x100000>;
			no-map;
		};

		/* ramoops: flint3 on be9300 at 0x4da00000, 1MB (persistent dmesg) */
		ramoops@4da00000 {
			compatible = "ramoops";
			reg = <0x0 0x4da00000 0x0 0x100000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
			pmsg-size = <0x20000>;
		};

		mlo_mem: mlo-global-mem@4db00000 {
			reg = <0x0 0x4db00000 0x0 0x01100000>; /* TEST133: stock 17MB */
			no-map;
		};

		qcn9224_host_ddr: qcn9224-host-ddr@4ed00000 {
			reg = <0x0 0x4ed00000 0x0 0x03200000>;
			no-map;
		};
	};

	soc@0 {
		leds {
			compatible = "gpio-leds";
			pinctrl-0 = <&leds_pins>;
			pinctrl-names = "default";
			status = "okay";

			led@31 {
				label = "wan";
				gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};

			/* v6: led@24 (lan1) and led@39 (lan2) REMOVED. In the firmware DTB gpio24 =
			 * ledswitch BUTTON (input), gpio39 = PHY reset line. The LED mapping from the
			 * GPL mi01.6 reference board was not verified for this board. */

			led@32 {
				label = "lan3";
				gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};

			led_sys_green: led@33 {
				label = "sys_green";
				gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
				default-state = "on";
			};

			led_sys_orange: led@34 {
				label = "sys_orange";
				gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
				default-state = "on";
			};
		};

		gpio_keys {
			compatible = "gpio-keys";
			pinctrl-0 = <&button_pins>;
			pinctrl-names = "default";
			status = "okay";

			reset {
				label = "reset";
				linux,code = <KEY_RESTART>;
				gpios = <&tlmm 29 GPIO_ACTIVE_LOW>; /* v6: firmware DTB gpio-keys-polled reset = gpio29 (the 30 in v2-v5 was WRONG: 30 = PHY reset line) */
				linux,input-type = <1>;
			};
		};

		/* mdio@90000 is defined in the dtsi; compatible = "qcom,ipq4019-mdio".
		 * Redefining it here overrode the compatible and disabled the driver
		 * (no mdio probe -> no PHY/switch/WAN).
		 * The &mdio override is below: qca8k_nsscc, ethernet-phy-package@1,
		 * switch@10 (pseudo-PHY 0x10). */

        /* NSS & PPE */
	nss-ppe { qcom,ppeds-num = <0x02>; qcom,ppeds-map = <0x01 0x01 0x01 0x01 0x20 0x08 0x02 0x02 0x02 0x02 0x28 0x08>; };
	nsscc@39b00000 { compatible = "qcom,nsscc-ipq5332";
		clock-names = "xo", "cmn_pll_nss_clk_200m", "cmn_pll_nss_clk_300m", "gcc_gpll0_out_aux"; };
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&tlmm {
	qspi_nand_pins: qspi_nand_pins {
		qspi_clock {
			pins = "gpio13";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		qspi_cs {
			pins = "gpio12";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		qspi_data {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	leds_pins: leds_pinmux {
		led_wan {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_lan3 {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_green {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_orange {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	button_pins: button_pins {
		reset_button {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pcie1_default: pcie1-default-state {
		clkreq-n-pins {
			pins = "gpio46";
			function = "pcie1_clk";
			drive-strength = <8>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio47";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio48";
			function = "pcie1_wake";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio0_pins: mdio0-state {
		mux_0 {
			pins = "gpio25";
			function = "mdc0";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio26";
			function = "mdio0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio1_pins: mdio1-state {
		mux_0 {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio1_pins &mdio0_pins>;
	pinctrl-names = "default";
	mdio_clk_fixup;
	/* QCA8084 reset (vendor GPL: phy-reset-gpio tlmm 16).
	 * QCA8084 = 4x 2.5G switch-PHY: LAN PORT1..3 + WAN PHY1.
	 * NO SEPARATE CHIP: QCA8084 is integrated into the IPQ53xx SoC (GPL U-Boot
	 * ipq_qca8084.c:1472 "QCA8084-switch"; all register/clock access goes
	 * through the internal MDIO). CERTAIN: there is NO QCA8386 (photo + boot log).
	 */
	/* TEST8: real vendor GPL resets (ipq5332-BE9300_2_0_0.dts:
	 * phy-reset-gpio = <&tlmm 30 0 &tlmm 39 0 &tlmm 43 0>).
	 * The old gpio16 was a GUESS and WRONG. */
	/* test46 (6.18.39) real vendor 3-PHY reset line */
	/* v6: firmware DTB (mr47be_stock_dtb) mdio node: phy-reset-gpio = tlmm 30, 39, 45
	 * (0x1e, 0x27, 0x2d). 45, not 43. NOTE: the MDIO core uses only the FIRST
	 * entry (30) of the reset-gpios array; 39 and 45 are only documented here.
	 * The qca8k_nsscc gpio16 reset was left untouched (same as v2-v5). */
	/* test011 = ref50 live DTB: mdio@90000 reset-gpios <&tlmm 16 ACTIVE_LOW>,
	 * assert/deassert 100000 us. Since qca8k_nsscc is disabled, this is the one
	 * place that guarantees the QCA8084 chip reset (in ref50 WAN+lan 2.5G link up).
	 * The old 30/39/45 array was a reading of the stock vendor DTB; the core only
	 * used the first entry anyway. */
	reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
	reset-assert-us = <100000>;
	reset-deassert-us = <100000>;

	/* TEST9: U-Boot mii read EVIDENCE: at 004d.d180, addresses 1,2,3 respond (C22
	 * reg2/3), address 7 is EMPTY (FFFF). The 0x7/0x1d in the vendor DTS
	 * turned out to be port numbers, not MDIO addresses. Address 4 (WAN) is to be checked on the device. */
	/* B133: WAN PHY0 (MDIO addr 1) is now defined INSIDE the package as "ephy1"
	 * (below). The old standalone phy0 was DELETED: it collided with package@1 at
	 * the same MDIO address and did not get GEPHY0_SYS_CLK/RESET. */

	/* ===================================================================
	 /* B131: QCA8084 DSA switch - ONLY for LAN1/2/3.
	  * Taken from B127 (field-proven port mapping) + B130 clocks.
	  * WAN IS NOT HERE: xgmac1 -> phy0(addr1) works as in B130. */
	/* test011: exact shape of reference test50 - no DSA/switch driver.
	 * The mdio core recognizes these nodes by PHY ID (004d:d180); no clock/reset
	 * needed (U-Boot + mdio reset-gpios are enough). qca8084_probe supports the
	 * package-less path: devm_of_phy_package_join -EINVAL -> continue.
	 * GMAC1 <-> :01 (wan), GMAC2 <-> :04 (lan). :02/:03 are idle (test012). */
	/* test050: DSA users want these via phy-handle (the package node stays
	 * disabled, otherwise the child ephys do not probe and the DSA ports get
	 * stuck in -EPROBE_DEFER). die port N == EPHY MDIO address N:
	 *   :01 = WAN jack | :02 = LAN3 | :03 = LAN2 | :04 = LAN1 */
	phy_wan: ethernet-phy@1 {
		reg = <1>;
	};

	phy_l3: ethernet-phy@2 {
		reg = <2>;
	};

	phy_l2: ethernet-phy@3 {
		reg = <3>;
	};

	phy_lan: ethernet-phy@4 {
		reg = <4>;
	};

	qca8k_nsscc: clock-controller@18 {
		compatible = "qcom,qca8084-nsscc";
		reg = <0x18>;
		/* test050: provider ENABLED (the DSA driver wants 13 resets + 21 clocks).
		 * reset-gpios is NOT WRITTEN HERE: the &mdio node owns the die reset line; since
		 * the gpiod "reset" in probe is OPTIONAL, the line is never pulsed here. A double
		 * request = -EBUSY (test038) and a pulse = resets the die that U-Boot
		 * set up (test039-A: WAN+lan RX both zero). */
		status = "okay";
		reset-delay-us = <10000>;
		reset-post-delay-us = <50000>;
		/* v2: names read by the mdio_device core (the two above are legacy) */
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;

		clocks = <&qca8084_xo>,
			 <&qca8k_uniphy0_rx>,
			 <&qca8k_uniphy0_tx>,
			 <&qca8k_uniphy1_rx>,
			 <&qca8k_uniphy1_tx>,
			 <&qca8k_uniphy1_rx312p5m>,
			 <&qca8k_uniphy1_tx312p5m>;
	};

	/* 3 integrated QCA8084 GEPHYs: addr2/3/4 = LAN3/LAN2/LAN1.
	 * (addr1 = WAN, stayed as a plain phy0 on the xgmac1 side.) */
	ethernet-phy-package@1 {
		compatible = "qcom,qca8084-package";
		reg = <1>;
		/* test011: ref50 live DTB also has NO package node; U-Boot sets WORK_MODE. */
		status = "disabled";
		#address-cells = <1>;
		#size-cells = <0>;

		clocks = <&qca8k_nsscc NSS_CC_APB_BRIDGE_CLK>,
			 <&qca8k_nsscc NSS_CC_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_TLMM_CLK>,
			 <&qca8k_nsscc NSS_CC_TLMM_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_CNOC_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_MDIO_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_MDIO_MASTER_AHB_CLK>,
			 <&qca8k_nsscc NSS_CC_SWITCH_CORE_CLK>;
		clock-names = "apb_bridge", "ahb", "sec_ctrl_ahb",
			      "tlmm", "tlmm_ahb", "cnoc_ahb", "mdio_ahb",
			      "mdio_master_ahb", "switch_core";
		resets = <&qca8k_nsscc NSS_CC_GEPHY_FULL_ARES>;

		/* WORK_MODE 0x20 = PCS1_SGMII | MAC_PCS0_SGMII | PHY.
		 * test120 evidence: writing 0x10 KILLS the LAN1 uplink. */
		qcom,package-mode = <QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_PHY>;
		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;

		/* B133: PHY0 = WAN (GMAC1). The upstream binding (0301) requires the package's
		 * FIRST child to be ethernet-phy@1: reg=1 + GEPHY0_SYS_CLK/ARES.
		 * In B131/B132 this node was MISSING -> the WAN EPHY stayed outside the package and
		 * got neither clock nor reset (WAN link Up but no DHCP). */
		ephy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <1>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_ARES>;
		};

		ephy2: ethernet-phy@2 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <2>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_ARES>;
		};

		ephy3: ethernet-phy@3 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <3>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_ARES>;
		};

		ephy4: ethernet-phy@4 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <4>;
			clocks = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_CLK>;
			resets = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_ARES>;
		};

		/* PCS1 SGMII+ -> carrier of switch MAC0 (CPU uplink). */
		pcs-phy@6 {
			compatible = "qcom,qca8k-pcs-phy";
			reg = <6>;
			clocks = <&qca8k_nsscc NSS_CC_SRDS1_SYS_CLK>,
				 <&qca8k_uniphy1_tx312p5m>,
				 <&qca8k_uniphy1_rx312p5m>;
			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root";
			resets = <&qca8k_nsscc NSS_CC_SRDS1_SYS_ARES>;
		};
	};

	/* A QCA8386-compatible DSA driver manages the QCA8084 (there is NO QCA8386
	 * on the board; register window is pseudo-PHY 0x10). */
	switch@10 {
		compatible = "qca,qca8386";
		reg = <0x10>;
		/* test050: ENABLED. Driver = m (module); the dsa profile of mr47be-die-switch
		 * does the insmod, because the WORK_MODE 0x20 -> 0x10 flip and the
		 * SerDes/RCG/CBC bring-up must come first (proof: test047 apply order). */
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;

		resets = <&qca8k_nsscc NSS_CC_SWITCH_CORE_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC0_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC1_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC1_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC2_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC2_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC3_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC3_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC4_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC4_RX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC5_TX_ARES>,
			 <&qca8k_nsscc NSS_CC_MAC5_RX_ARES>;
		reset-names = "switch_core",
			      "mac0_tx", "mac0_rx",
			      "mac1_tx", "mac1_rx",
			      "mac2_tx", "mac2_rx",
			      "mac3_tx", "mac3_rx",
			      "mac4_tx", "mac4_rx",
			      "mac5_tx", "mac5_rx";

		clocks = <&qca8k_nsscc NSS_CC_MAC0_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_TX_SRDS1_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC0_RX_SRDS1_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>,
			 <&qca8k_nsscc NSS_CC_SRDS1_SYS_CLK>;
		clock-names = "mac0_tx", "mac0_rx", "mac0_tx_srds1", "mac0_rx_srds1",
			      "mac1_tx", "mac1_rx", "mac1_gephy_tx", "mac1_gephy_rx",
			      "mac2_tx", "mac2_rx", "mac2_gephy_tx", "mac2_gephy_rx",
			      "mac3_tx", "mac3_rx", "mac3_gephy_tx", "mac3_gephy_rx",
			      "mac4_tx", "mac4_rx", "mac4_gephy_tx", "mac4_gephy_rx",
				     "srds1_sys";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* test050 SINGLE CONDUIT = die port5 <-> &xgmac2 (pcs1/UNIPHY1).
			 * Evidence: vendor cpu_bmp=0x21 (port0 + port5) and the test047 flip
			 * carries LAN over port5 (measured with acl cpu_bmp 0x21:
			 * 0x20000000/0x14). 6.18 DSA (dsa.c:1120 + dsa_tree_setup)
			 * assigns the FIRST local CPU port to the user ports -> single conduit.
			 * B127 evidence: "sgmii" rejects 2500 -> 2500base-x +
			 * fixed-link; the fixed-link SUB-NODE must come last. */
			port@5 {
				reg = <5>;
				label = "cpu";
				ethernet = <&xgmac2>;
				phy-mode = "2500base-x";
				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};

			/* Users: the label is directly the netdev name
			 * (user.c:dsa_user_create, NET_NAME_PREDICTABLE).
			 * phy-handle = standalone qca808x PHYs (MDIO 1..4);
			 * since the package node stays disabled, the ephy1..4 labels
			 * CANNOT BE USED (they do not probe, DSA defers forever).
			 * WAN is also on the die now: WORK_MODE is global, bypass and
			 * switch cannot be active at the same time (test042/#82). */
			/* phylib SINGLE OWNER rule (drivers/net/phy/phy_device.c
			 * phy_attach_direct): if a PHY is already attached to a dev, a second
			 * attach gives -EBUSY "PHY already attached". &phy_wan must hold the
			 * PRE-flip WAN path (xgmac1) -> DSA port@1 becomes a
			 * fixed-link. The fabric does the carrying inside the die; link
			 * state is not the judge, the DSA-GUARD pinger gives the verdict.
			 * The fixed-link SUB-NODE must come last. */
			port@1 {
				reg = <1>;
				label = "wan";
				phy-mode = "internal";
				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};

			port@2 {
				reg = <2>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&phy_l3>;
			};

			port@3 {
				reg = <3>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&phy_l2>;
			};

			port@4 {
				reg = <4>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&phy_lan>;
			};
		};	/* ports */
	};	/* switch@10 */
	/* The closing of &mdio is appended below (via replace). */};

/* TEST22 (vendor truth: Iplatform/build/product_configs/MR47BEv2/
 * kernel-ipq5332-mi01.6.dts):
 *   dp1 = qcom,id=2, reg 0x3a504000, qcom,is_switch_connected=1 -> LAN (behind the switch)
 *   dp2 = qcom,id=1, reg 0x3a500000, no phy                     -> WAN
 * Evidence: ppe_regs.h:605 PPE_PORT_XGMAC_ADDR(x)=0x500000+(x-1)*0x4000
 *   port@1 = 0x3a500000 = MAC1 = WAN | port@2 = 0x3a504000 = MAC2 = LAN-switch
 * Field evidence (test20): cable in the LAN1 jack -> port@2 ("wan") netdev link came up.
 * I.e. before TEST22 the labels were the reverse of the vendor's.
 * The WAN jack PHY MDIO address is one of 1, 2 or 3 (U-Boot live PHY: 1,2,3;
 * addr4 = LAN1, proven in test20). First attempt: wan = phy@1
 * (vendor boot log "eth0 PHY1 = WAN"). port@2 is a fixed-link without phy-handle
 * (vendor dp1 has no phy-handle; LAN1..3 reach MAC2 via the QCA8084 switch).
 */
&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			/* test050: the "wan" netdev name moved to DSA port@1 (the WAN jack
			 * is now the die's switch port1). This MAC carries the pre-flip bypass
			 * path (WORK_MODE is global: bypass + fabric cannot be active at the same
			 * time, test042/#82); netdev name "gmac1". */
			label = "gmac1";
			pcs-handle = <&pcs0_ch0>;
			/* test011 = ref50 live DTB: GMAC1 over pcs0/uniphy0 with
			 * 2500base-x + in-band-status. Works without being attached to a PHY driver
			 * (ref50: wan rx 8906 packets, DHCP 192.168.1.110). */
			phy-mode = "2500base-x";
			/* test050 FIX: phy-handle RESTORED.
			 * Evidence: drivers/net/phy/phy_device.c phy_attach_direct()
			 * gives -EBUSY "PHY already attached" on a second attach,
			 * i.e. &phy_wan can only have a single owner. It must stay here
			 * because: (1) the pre-flip bypass path (test047 WAN 2.5G) works with this
			 * MAC+PHY, (2) the ready() gate in the service looks at the gmac1 link while
			 * DSA is marked, (3) since DSA port@1 is a fixed-link it does not
			 * claim the PHY -> no conflict. */
			phy-handle = <&phy_wan>;
			nvmem-cells = <&base_macaddr 0>;
			nvmem-cell-names = "mac-address"; /* TEST22: WAN jack = QCA8084 PHY, MDIO addr1 (candidate: 1/2/3) */

			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";

		};

		xgmac2: port@2 {
			reg = <2>;
			label = "lan";
			pcs-handle = <&pcs1_ch0>;
			/* test011 = ref50: GMAC2 directly to EPHY :04 (pcs1/uniphy1,
			 * phy/sgmii). No DSA conduit, no fixed-link. */
			/* TEST048 ROOT-CAUSE FIX:
			 * The old recipe (test011 ref50) tied GMAC2 to EPHY :04, i.e. the PHY of the LAN1
			 * JACK; since phylink takes the carrier from that PHY's MDI
			 * link, 'lan' dropped when no cable was in LAN1 and br-lan's only
			 * cabled member disappeared. That is why LAN2/LAN3 worked only
			 * while LAN1 was populated (t315/t317 live evidence).
			 * In switch mode the data path is die port5; jack links come from the die's own
			 * PS words. The vendor dp1 recipe also has port@2 without phy-handle.
			 * B127 evidence: "sgmii" rejects 2500 -> 2500base-x + fixed-link.
			 * dtc rule: the fixed-link SUB-NODE must come after all properties. */
			/* TEST049: test048 removed this phy-handle for the fixed-link and
			 * LAN1/2/3 died: the die mesh was carrying LAN2/3 frames over port4 (the LAN1 EPHY),
			 * which was the uplink itself. Reverted.
			 */
			phy-mode = "2500base-x";
			/* test050: phy-handle REMOVED. This MAC is now the DSA
			 * conduit (switch port@5 ethernet=<&xgmac2>): trunk,
			 * the SerDes line of die port5; jack links are read from the die's own PS
			 * words. &phy_lan is now the phy-handle of DSA port@4
			 * (double dependency is forbidden).
			 * The NEGATIVE result of TEST048 belonged to the bypass topology -
			 * in that mode the uplink itself was EPHY4; in switch mode the port5
			 * trunk is a fixed-link, so "lan" is always oper-up. */
			nvmem-cells = <&base_macaddr 1>;
			nvmem-cell-names = "mac-address"; /* TEST27: LAN1 jack = PHY addr4 (test20 evidence + MAC2<->addr4 link response in test11a) */


			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";

			fixed-link {
				speed = <2500>;
				full-duplex;
			};

		};
	};
};
&pcs0 {
	status = "okay";
};

&pcs1 {
	/* test011 = ref50 live DTB: keep only the XPCS reset from the dtsi.
	 * The old B119 override gave GCC_UNIPHY1_BCR under the name "sys";
	 * the pcs-qcom-ipq9574.c:418 (sys_rstc || soft_rstc) block fully reset the UNIPHY1
	 * SerDes with a 100ms assert/deassert -> U-Boot's SGMII setup
	 * was lost (test001-010 lan rx=0). In ref50 the name is absent -> the block does not run
	 * and the 2.5G link is up on the same line. dtsi resets = <&gcc GCC_UNIPHY1_XPCS_ARES>. */
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;
		/* v3: stock DTB nandcs@0 = nand-ecc-strength 4 / step 512 / bus-width 8.
		 * 8 (GL-BE6500 copy) did not let the stock-written partitions (0:art, ubi) be read:
		 * UART log: "I/O error, dev mtdblock10", "UBI error: unable to read
		 * from mtd12", WAN "Using random MAC address". */
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Real NAND layout (PRE_TEST_CHECK §4 = nand-partition.xml).
			 * The previous even 1MiB blocks were SHIFTED: 0:art pointed to the wrong place,
			 * ubi overlapped the physical rootfs + rootfs_1 (soft-brick risk).
			 * ART (0x900000..0xB00000) read-only; MAC nvmem is read from here. */
			partition@0 {
				label = "0:sbl1";
				reg = <0x0 0x180000>;
				read-only;
			};

			partition@180000 {
				label = "0:mibib";
				reg = <0x180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:bootconfig";
				reg = <0x280000 0x080000>;
				read-only;
			};

			partition@300000 {
				label = "0:bootconfig1";
				reg = <0x300000 0x080000>;
				read-only;
			};

			partition@380000 {
				label = "0:qsee";
				reg = <0x380000 0x240000>;
				read-only;
			};

			partition@5c0000 {
				label = "0:devcfg";
				reg = <0x5c0000 0x080000>;
				read-only;
			};

			partition@640000 {
				label = "0:tme";
				reg = <0x640000 0x080000>;
				read-only;
			};

			partition@6c0000 {
				label = "0:cdt";
				reg = <0x6c0000 0x080000>;
				read-only;
			};

			partition@740000 {
				label = "0:appsblenv";
				reg = <0x740000 0x080000>;
				read-only;
			};

			partition@7c0000 {
				label = "0:appsbl";
				reg = <0x7c0000 0x140000>;
				read-only;
			};

			partition@900000 {
				label = "0:art";
				reg = <0x900000 0x200000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/* test041: ART+0x0 is empty (ff:ff:ff:ff:ff:ff) -> of_get_mac_address
					 * rejects the invalid address and falls back to eth_hw_addr_random. The factory MAC
					 * is at ART+0x1008 (inside the cal-ahb header, 00:f8:b3:0d:a8:04 on this board).
					 * index0=WAN, index1=LAN; on LAN, U-Boot's local-mac-address takes
					 * precedence (of_net order: mac-address > local-mac-address > nvmem),
					 * so the only real change is the WAN jack. */
					base_macaddr: mac-address@1008 {
						compatible = "mac-base";
						reg = <0x1008 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@b00000 {
				label = "secure-binary";
				reg = <0xb00000 0x080000>;
				read-only;
			};

			partition@b80000 {
				label = "ubi";
				reg = <0xb80000 0x34c0000>;
			};

			partition@4040000 {
				label = "rootfs_1";
				reg = <0x4040000 0x34c0000>;
				read-only;
			};

			partition@7500000 {
				label = "tp_data";
				reg = <0x7500000 0x0a00000>;
			};

			partition@7f00000 {
				label = "data";
				reg = <0x7f00000 0x080000>;
			};

			partition@7f80000 {
				label = "reserverd_data";
				reg = <0x7f80000 0x080000>;
			};
		};
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pinctrl-0 = <&pcie1_default>;
	pinctrl-names = "default";

	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi1: pcie@0 {
			compatible = "pci17cb,1109";
			reg = <0x00010000  0 0 0 0>;
			/* QCN6274 dualmac: MAC0 = 5 GHz, MAC1 = 6 GHz.
			 * OTP board-id is 0xff on this board; the board-2.bin entry is
			 * "bus=pci,qmi-chip-id=0,qmi-board-id=4121" (0x1019).
			 * The mac80211 patch 701 reads the id from DT. */
			qcom,ath12k-board-id = <4121>;

			/* TEST144: WSI ports graph REMOVED -> test45/47 single-device mode.
			 * Evidence: the 103 log goes silent after "qcn9274 hw2.0 / MSI vectors: 16" (the wall in test41-44);
			 * test45-47 with the portless DTS brought up a 5G ch36/80 + 6G ch37/160 AP.
			 * REVERT: put back the blocks from the .bak_104_pre_ports_revert file. */

		};
	};
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};

&wifi0 {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
	/* ath12k AHB (mac80211 backports wifi7 driver) resolves these by INDEX, not
	 * by name: index0 = q6-region (UserPD load + BDF pool at +bdf_addr_offset
	 * = 0x4b500000), index1 = m3-dump.  With host-ddr at index1 the target is
	 * told its M3 dump buffer starts on top of the BDF/calibration data. */
	memory-region = <&q6_region>, <&m3_dump>, <&q6_caldb>, <&mlo_mem>,
			<&q6_etr>, <&q6_host_ddr>;
	memory-region-names = "q6-region", "m3-dump", "q6-caldb", "mlo-global-mem",
			      "q6-etr-dump", "host-ddr-mem";
	/* The board-2.bin entry is "bus=ahb,qmi-chip-id=0,qmi-board-id=18".
	 * QMI returns board_id 0xff on this device; patch 701 (mac80211)
	 * reads the id from DT. The qcom,board-id / bdf-type properties
	 * were not read by any driver in this tree, so they were removed. */
	qcom,ath12k-board-id = <18>;
	qcom,rproc = <&q6v5_wcss>;
	qcom,wsi-controller;

	status = "okay";

	/* TEST144: WSI ports graph REMOVED -> test45/47 single-device mode.
	 * Evidence: the 103 log goes silent after "qcn9274 hw2.0 / MSI vectors: 16" (the wall in test41-44);
	 * test45-47 with the portless DTS brought up a 5G ch36/80 + 6G ch37/160 AP.
	 * REVERT: put back the blocks from the .bak_104_pre_ports_revert file. */

};

&q6v5_wcss {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw0.mdt";
	/* TEST142: stock DTS (stock_mi01.dts 1540-1560) properties */
	qcom,bootargs_smem = <0x1fb>;
	qcom,bootargs_version = <0x02>;
	upd-firmware-names = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt";
	qcom,userpd-bootargs;
	qcom,heartbeat_smem = <0x1fc>;
	status = "okay";
};

/* TEST116: input clocks of the QCA8386 internal NSS clock controller (nsscc @ MDIO 0x18).
 * XO = real 50 MHz. The UNIPHY1 rate comes from the on-chip SerDes PLL; the fixed-clock
 * is only there to select the CCF parent. UNIPHY0 is not used in switch mode -> 0 Hz
 * stub (the RCG selector falls to UNIPHY1_TX312P5M/2.5 - proven on SPNMX57). */
/ {
	qca8084_xo: clock-qca8084-xo {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};

	qca8k_uniphy0_rx: clock-qca8k-uniphy0-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	qca8k_uniphy0_tx: clock-qca8k-uniphy0-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	qca8k_uniphy1_rx: clock-qca8k-uniphy1-rx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_tx: clock-qca8k-uniphy1-tx {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_rx312p5m: clock-qca8k-uniphy1-rx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};

	qca8k_uniphy1_tx312p5m: clock-qca8k-uniphy1-tx312p5m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <312500000>;
	};
};

/* B127: NSSCC's UNIPHY parent clocks (were left as <0> in ipq5332.dtsi!).
 * The order must match the DT_ enum in nsscc-ipq5332.c exactly:
 *   0=cmn_pll_nss_200m 1=cmn_pll_nss_300m 2=gpll0_aux
 *   3=uniphy0 TX 4=uniphy0 RX 5=uniphy1 TX 6=uniphy1 RX 7=xo_board
 * (PCS_TX_CLK=1 / PCS_RX_CLK=0 -> dt-bindings/net/qcom,ipq9574-pcs.h)
 * Without this link nss_cc_port2_rx/tx_clk_src cannot select 312.5 MHz and stays
 * on XO (24 MHz); the conduit MAC2 <-> switch CPU port carries no data.
 * Evidence: MR47BE_126 -> nss_cc_port2_rx_clk = 24000000
 *       (should be 312500000; the PCS side is already 312500000).
 */
&nsscc {
	/* B130: NSSCC probe REQUIRES the names "bus/nssnoc/nssnoc_snoc/nssnoc_snoc_1/
	 * snoc_nssnoc/snoc_nssnoc_1" via pm_clk_add(). Without clock-names,
	 * of_clk_get_by_name() falls to index 0 -> all 6 names get tied to the same PLL and
	 * the GCC NSS<->SNOC fabric clocks are NEVER enabled -> the LAN/PPE conduit
	 * data path stays dead (link is up, no traffic). Same as PR#23161 0375. */
	clocks = <&cmn_pll_nss_200m_clk>,
		 <&cmn_pll_nss_300m_clk>,
		 <&gcc GPLL0_OUT_AUX>,
		 <&pcs0 PCS_TX_CLK>,
		 <&pcs0 PCS_RX_CLK>,
		 <&pcs1 PCS_TX_CLK>,
		 <&pcs1 PCS_RX_CLK>,
		 <&xo_board>,
		 <&gcc GCC_NSSCC_CLK>,
		 <&gcc GCC_NSSNOC_NSSCC_CLK>,
		 <&gcc GCC_NSSNOC_SNOC_CLK>,
		 <&gcc GCC_NSSNOC_SNOC_1_CLK>,
		 <&gcc GCC_SNOC_NSSNOC_CLK>,
		 <&gcc GCC_SNOC_NSSNOC_1_CLK>;
	clock-names = "cmn_pll_nss_clk_200m",
		      "cmn_pll_nss_clk_300m",
		      "gcc_gpll0_out_aux",
		      "uniphy0_tx",
		      "uniphy0_rx",
		      "uniphy1_tx",
		      "uniphy1_rx",
		      "xo",
		      "bus",
		      "nssnoc",
		      "nssnoc_snoc",
		      "nssnoc_snoc_1",
		      "snoc_nssnoc",
		      "snoc_nssnoc_1";
};
