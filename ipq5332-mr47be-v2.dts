// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
//
// Mercusys MR47BE V2 - IPQ5332 AP-MI01.6 based Wi-Fi 7 tri-band router
// Base: GL-BE6500 DTS (qualcommbe/ipq53xx) + MR47BE V2 GPL kernel DTS
// SoC: Qualcomm IPQ5322 (die: "IPQ5322 003 FK5134HJ"; yazilim varyanti
//      string'i IPQ5332LA), 4x Cortex-A53, 1 GiB DDR4 (SEC K4A8G165WC)
// WiFi: on-SoC 2.4GHz (wifi0, qcom,board-id = 18 = 0x12) + QCN6274 via
//      PCIe1 (5G+6G, 2 radyo, pci17cb,1109, qcom,board-id = 0x1015)
// Switch: QCA8084 - IPQ53xx SoC'ya ENTEGRE (ayri cip YOK; GPL U-Boot
//      ipq_qca8084.c "QCA8084-switch"), 4x 2.5G + SoC PPE
// Flash: SPI-NAND Winbond W25N01GW 128MiB (SPI-NOR YOK - boot log: not found)
// UART: GPIO18/19 @ 115200

/dts-v1/;

#include <arm64/qcom/ipq5332.dtsi>

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>

/ {
	#address-cells = <0x2>;
	#size-cells = <0x2>;
	model = "Mercusys MR47BE V2";
	compatible = "mercusys,mr47be-v2", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* TZ apps region is SBL-configured per board; Flint 3 vendor
		 * DT places it at 0x49b00000 (BE6500 uses 0x49600000). */
		tzapp: tzapp@49600000 {
			reg = <0x0 0x49600000 0x0 0x00600000>;
			no-map;
		};

		/*
		 * Q6 carveout 35 MB (0x2300000) = VENDOR GL-BE9300 stok DTB
		 * (vendor.dts wcnss@4a900000) + MR47BE GPL mi01.6 degeri.
		 * test50: 43MB ile TZ AUTH ret=-12 res0=0 (SMC katmani oldu,
		 * TZ payload yazmadi) -> TZ kendi 35MB tablosuyla uyusmazlik.
		 * test51: vendor haritasi (m3 0x4cc00000, caldb 0x4ce00000).
		 */
		q6_region: wcss@4a900000 {
			reg = <0x0 0x4a900000 0x0 0x02300000>;
			no-map;
		};

		m3_dump: m3-dump@4cc00000 {
			reg = <0x0 0x4cc00000 0x0 0x100000>;
			no-map;
		};

		q6_caldb: q6-caldb@4ce00000 {
			reg = <0x0 0x4ce00000 0x0 0x500000>;
			no-map;
		};		

		/*
		 * Persist the kernel log across a reboot. This board has no
		 * usable serial console, so a boot loop is otherwise silent:
		 * ramoops keeps dmesg and the console in RAM through a warm
		 * reset and exposes them under /sys/fs/pstore on the next boot
		 * (including a TFTP initramfs rescue boot).
		 *
		 * q6-caldb now ends at 0x4d2fffff and mlo-global-mem starts at
		 * 0x4db00000, so 0x4d300000..0x4dafffff (8 MiB) is unreserved and
		 * ramoops sits at the top of it - verified against the live
		 * "OF: reserved mem" map, not just the DTS.
		 * Deliberately mapped (no "no-map"): ramoops must write here.
		/* ramoops: flint3 be9300'de 0x4da00000 1MB (persist dmesg)
		*/
		ramoops@4da00000 {
			compatible = "ramoops";
			reg = <0x0 0x4da00000 0x0 0x100000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
			pmsg-size = <0x20000>;
		};

		mlo_mem: mlo-global-mem@4db00000 {
			reg = <0x0 0x4db00000 0x0 0x01200000>;
			no-map;
		};

		qcn9274_host_ddr: qcn9274-host-ddr@4ed00000 {
			reg = <0x0 0x4ed00000 0x0 0x03200000>;
			no-map;
		};		
	};

	soc@0 {
		leds {
			compatible = "gpio-leds";
			pinctrl-0 = <&leds_pins>;
			pinctrl-names = "default";
			status = "okay";

			led@32 {
				label = "blue:run";
				gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};

			led@33 {
				label = "white:system";
				gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
				default-state = "off";
			};
		};

		gpio_keys {
			compatible = "gpio-keys";
			pinctrl-0 = <&button_pins>;
			pinctrl-names = "default";
			status = "okay";

			reset {
				label = "reset";
				linux,code = <KEY_RESTART>;
				gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
				linux,input-type = <1>;
			};
		};

		fan0: pwm-fan {
			compatible = "pwm-fan";
			pinctrl-0 = <&fan_pins>;
			pinctrl-names = "default";
			pwms = <&pwm 3 40000 0>;
			interrupt-parent = <&tlmm>;
			interrupts = <36 IRQ_TYPE_EDGE_RISING>;
			pulses-per-revolution = <2>;
			cooling-levels = <36 128 192 255>;
			#cooling-cells = <2>;
		};		

		mdio: mdio@90000 {
			compatible = "qcom,ipq4019-mdio";
			reg = <0x90000 0x64>;
			pinctrl-0 = <&mdio1_pins &mdio0_pins>;
			pinctrl-names = "default";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&gcc GCC_MDIO_AHB_CLK>;
			clock-names = "gcc_mdio_ahb_clk";
			mdio_clk_fixup;
			status = "disabled";
		};
	};

	thermal-zones {
		cpu-top-thermal {
			polling-delay = <1000>;

			trips {
				fan_trip_high: active-high {
					temperature = <100000>;
					hysteresis = <2000>;
					type = "active";
				};

				fan_trip_med: active-med {
					temperature = <75000>;
					hysteresis = <2000>;
					type = "active";
				};

				fan_trip_low: active-low {
					temperature = <50000>;
					hysteresis = <2000>;
					type = "active";
				};
			};

			cooling-maps {
				fan-active-high {
					cooling-device = <&fan0 3 3>;
					trip = <&fan_trip_high>;
				};

				fan-active-med {
					cooling-device = <&fan0 2 2>;
					trip = <&fan_trip_med>;
				};

				fan-active-low {
					cooling-device = <&fan0 1 1>;
					trip = <&fan_trip_low>;
				};
			};
		};
	};
};

/ {
	usb_vbus_5v: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};
};

&blsp1_uart0 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&pwm {
	#pwm-cells = <2>;
	pinctrl-0 = <&pwm_pins>;
	pinctrl-names = "default";
	used-pwm-indices = <0>, <0>, <0>, <1>;
	status = "okay";
};

&tlmm {
	leds_pins: leds_pinmux {
		led_wan {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};

		led_white {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	button_pins: button_pins {
		reset_button {
			pins = "gpio17";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	pwm_pins: pwm_pinmux {
		pwm1 {
			pins = "gpio29";
			function = "pwm1";
			drive-strength = <8>;
		};
	};	

	fan_pins: fan_pins {
		pwr {
			pins = "gpio34";
			function = "gpio";
			bias-pull-up;
			output-high;
		};
		speed {
			pins = "gpio36";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
	};	

	usb_pins: usb_pins {
		usb_pwr {
			pins = "gpio16";
			function = "gpio";
			bias-pull-up;
			output-high;
		};
	};    	    

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio13";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio12";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

    pcie1_default: pcie1-default-state {
		clkreq-n-pins {
			pins = "gpio46";
			function = "pcie1_clk";
			drive-strength = <8>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio47";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio48";
			function = "pcie1_wake";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio0_pins: mdio0-state {
		mux_0 {
			pins = "gpio25";
			function = "mdc0";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio26";
			function = "mdio0";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	mdio1_pins: mdio1-state {
		mux_0 {
			pins = "gpio27";
			function = "mdc1";
			drive-strength = <8>;
			bias-disable;
		};

		mux_1 {
			pins = "gpio28";
			function = "mdio1";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio1_pins &mdio0_pins>;
	pinctrl-names = "default";
	mdio_clk_fixup; /* MDIO clock sequence fix up flag */

	/*
	 * QCA8084- 2.5G WAN PHY. Vendor DT lists two MDIO reset
	 * GPIOs: 51 and 24. Per our May bring-up notes 51 is the QXA8084
	 * and 24 the QCA8084 switch (BE6500 uses 24 for its PHY — if the
	 * WAN PHY fails to probe, swap to 24 here).
	 */
	phy: ethernet-phy@1 {
		compatible = "ethernet-phy-id004d.d180";
		reg = <1>;
		reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <50000>;
	};

	clock-controller@18 {
    compatible = "qcom,qca8084-nsscc";
    reg = <0x18>;
    reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
    };

	/*
	 * QCA8084 switch (4x 2.5G LAN + 10G SerDes uplink to xgmac1).
	 * No reset-gpios: U-Boot leaves the switch initialized with SDS0
	 * in 10G mode and port 3 linked; the driver re-inits from there.
	 * The four sdsN-rx/tx-swap flags are required on this board, same as
	 * BE6500. Without them the 10G CPU link still reports up, but no
	 * traffic crosses it in either direction (bench-verified 2026-07-27:
	 * swap_cfg 0x0 = dead LAN path, swap_cfg 0xf = LAN path works).
	 */
    qca8084: qca8084-dsa@29 {
		compatible = "qualcomm,qca8084";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <29>;
		qca8084,sds0mode = "usxgmii";
		gpio-controller;
		#gpio-cells = <2>;

		sds0-rx-swap;
		sds0-tx-swap;
		sds1-rx-swap;
		sds1-tx-swap;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@3 {
				reg = <3>;
				label = "cpu";
				ethernet = <&xgmac1>;
				phy-mode = "10gbase-r";

				fixed-link {
					speed = <10000>;
					full-duplex;
				};
			};

			/*
			 * Front-panel jack mapping, verified 2026-07-27 by
			 * walking one cable through all four jacks and
			 * watching which netdev gained carrier:
			 * LAN1=port6, LAN2=port5, LAN4=port3.
			 * This matches the vendor device tree; the May-2026
			 * note that had lan2/lan3 the other way round was
			 * wrong.
			 */

			port@4 {
				reg = <4>;
				label = "lan3";
				phy-mode = "internal";
			};

			port@5 {
				reg = <5>;
				label = "lan2";
				phy-mode = "internal";
			};

			port@6 {
				reg = <6>;
				label = "lan1";
				phy-mode = "internal";
			};
		};
	};	
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			phy-mode = "10gbase-r";
			label = "lan";
			pcs-handle = <&pcs0_ch0>;
			phy-handle = <&rtl837x>;
			nvmem-cells = <&base_macaddr 2>;
			nvmem-cell-names = "mac-address";
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";

			fixed-link {
				speed = <10000>;
				full-duplex;
				pause;
			};
		};

		xgmac2: port@2 {
			reg = <2>;
			phy-mode = "usxgmii";
			managed = "in-band-status";
			label = "wan";
			pcs-handle = <&pcs1_ch0>;
			phy-handle = <&phy>;
			nvmem-cells = <&base_macaddr 0>;
			nvmem-cell-names = "mac-address";

			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&usb {
	pinctrl-0 = <&usb_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usbphy0 {
	status = "okay";
};

/*
 * phy@4b0000 is the shared PCIe0/USB3 combo uniphy. The BE9300 does not use
 * PCIe0, so retarget the existing node as the USB SuperSpeed PHY rather than
 * declaring a second node at the same address (which DTC rejects).
 */
&pcie0_phy {
	compatible = "qcom,ipq5332-uniphy-usb-ss-phy";
	clocks = <&gcc GCC_PCIE3X1_PHY_AHB_CLK>,
		 <&gcc GCC_USB0_PHY_CFG_AHB_CLK>,
		 <&gcc GCC_USB0_PIPE_CLK>;
	clock-names = "ahb", "cfg_ahb", "pipe";
	resets = <&gcc GCC_USB0_PHY_BCR>;
	vdd-supply = <&usb_vbus_5v>;
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Gercek NAND yerlesimi (PRE_TEST_CHECK §4 = nand-partition.xml).
			 * Onceki 1MiB duzgun bloklar KAYMISTI: 0:art yanlis yeri gosteriyor,
			 * ubi fiziksel rootfs + rootfs_1 uzerine biniyordu (soft-brick riski).
			 * ART (0x900000..0xB00000) read-only; MAC nvmem buradan okunur. */
			partition@0 {
				label = "0:sbl1";
				reg = <0x0 0x180000>;
				read-only;
			};

			partition@180000 {
				label = "0:mibib";
				reg = <0x180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:bootconfig";
				reg = <0x280000 0x080000>;
				read-only;
			};

			partition@300000 {
				label = "0:bootconfig1";
				reg = <0x300000 0x080000>;
				read-only;
			};

			partition@380000 {
				label = "0:qsee";
				reg = <0x380000 0x240000>;
				read-only;
			};

			partition@5c0000 {
				label = "0:devcfg";
				reg = <0x5c0000 0x080000>;
				read-only;
			};

			partition@640000 {
				label = "0:tme";
				reg = <0x640000 0x080000>;
				read-only;
			};

			partition@6c0000 {
				label = "0:cdt";
				reg = <0x6c0000 0x080000>;
				read-only;
			};

			partition@740000 {
				label = "0:appsblenv";
				reg = <0x740000 0x080000>;
				read-only;
			};

			partition@7c0000 {
				label = "0:appsbl";
				reg = <0x7c0000 0x140000>;
				read-only;
			};

			partition@900000 {
				label = "0:art";
				reg = <0x900000 0x200000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					base_macaddr: mac-address@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@b00000 {
				label = "secure-binary";
				reg = <0xb00000 0x080000>;
				read-only;
			};

			partition@b80000 {
				label = "ubi";
				reg = <0xb80000 0x34c0000>;
			};

			partition@4040000 {
				label = "rootfs_1";
				reg = <0x4040000 0x34c0000>;
				read-only;
			};

			partition@7500000 {
				label = "tp_data";
				reg = <0x7500000 0x0a00000>;
			};

			partition@7f00000 {
				label = "data";
				reg = <0x7f00000 0x080000>;
			};

			partition@7f80000 {
				label = "reserverd_data";
				reg = <0x7f80000 0x080000>;
			};
		};
	};
};

&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pinctrl-0 = <&pcie1_default>;
	pinctrl-names = "default";

	perst-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;

	pcie@0 {
		/*
		 * QCN9274/QCN6274 dualmac package: MAC0 = 5 GHz,
		 * MAC1 = 6 GHz. OTP board-id is unprovisioned (0xff), so
		 * both board-id and radio count come from DT. Vendor CNSS
		 * uses board_id 0x1019 for this radio.
		 */
		wifi1: pcie@0 {
			compatible = "pci17cb,1109";
			reg = <0x00010000  0 0 0 0>;
			memory-region = <&qcn9274_host_ddr>, <&mlo_mem>;
			memory-region-names = "host-ddr-mem", "mlo-global-mem";
			qcom,ath12k-fw-memory-mode = <1>;
			qcom,board-id = <0x1019>;
			qcom,num-radios = <2>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi0_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi0_wsi_tx>;
					};
				};
			};
		};
	};
};

/*
 * The bootstrap pins for the board select the XO clock frequency that
 * supports 48 MHZ or 96 MHZ. This setting automatically enables the
 * right dividers, to ensure the reference clock output from WiFi to
 * the CMN PLL is 48 MHZ.
 */
&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

/*
 * The frequency of xo_board is fixed to 24 MHZ, which is routed
 * from WiFi output clock 48 MHZ divided by 2.
 */
&xo_board {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};

/* IPQ5332 integrated 2.4 GHz radio (AHB). Vendor board_id 0x12 = 18,
 * same as GL-BE6500. */
&wifi0 {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
	/* Order matters: ath12k still resolves the UserPD image by INDEX 0
	 * (ahb.c), so "q6-region" must stay first. The rest are by name. */
	memory-region = <&q6_region>, <&q6_host_ddr>, <&m3_dump>, <&q6_caldb>,
			<&mlo_mem>, <&q6_etr>;
	memory-region-names = "q6-region", "host-ddr-mem", "m3-dump", "q6-caldb",
			      "mlo-global-mem", "q6-etr-dump";
	qcom,board-id = <18>;
	qcom,rproc = <&q6v5_wcss>;
	qcom,wsi-controller;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			wifi0_wsi_tx: endpoint {
				remote-endpoint = <&wifi1_wsi_rx>;
			};
		};

		port@1 {
			reg = <1>;

			wifi0_wsi_rx: endpoint {
				remote-endpoint = <&wifi1_wsi_tx>;
			};
		};
	};
};

&q6v5_wcss {
	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw0.mdt";
	qcom,bootargs_smem = <507>;
	qcom,bootargs_version = <2>;
	upd-firmware-names = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt";
	status = "okay";
};

/*
 * The target patch that adds q6_region sizes it at 0x2b00000 (43 MiB) for the
 * RDP reference board. The live vendor DT for this board says the Q6 span is
 * wcnss@4a900000 + 0x2300000 (35 MiB), ending at 0x4cc00000 where m3-dump
 * begins. Leaving it at 43 MiB would overlap m3-dump, q6-etr-dump and q6-caldb,
 * and of_reserved_mem only warns - firmware would then be free to write over
 * caldata. Our ath12k blobs reach 0x4b2cbff8, so 35 MiB leaves ~25 MiB spare.
 */
&q6_region {
	reg = <0x0 0x4a900000 0x0 0x02300000>;
};