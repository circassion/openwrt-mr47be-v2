+#content_syslog > div > :is(select, input:not([type="checkbox"])) + label { margin-left: var(--sp-3) !important; }
+#content_syslog > div > #logSeveritySelect + label { margin-left: 0 !important; }   /* "and above" ends its own group */
+
+/* Network -> Diagnostics: the three tools in equal columns, top aligned */
+.table:has(.diag-action) { table-layout: fixed; }
+/* LuCI measures the scroll parent before opening a diagnostic menu. */
+#view .cbi-map > .table:has(.diag-action .cbi-dropdown) { overflow: visible; }
