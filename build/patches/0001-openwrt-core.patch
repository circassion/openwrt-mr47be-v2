+.v-nft-note { max-width: 90ch; margin: 0; color: var(--text-2); font-size: var(--fs-sm); }
+.v-nft-endpoint {
+	flex: none;
+	padding: 4px 10px;
+	border-radius: 999px;
+	background: var(--s3); color: var(--text-2);
+	font-size: var(--fs-sm); font-weight: 600; white-space: nowrap;
