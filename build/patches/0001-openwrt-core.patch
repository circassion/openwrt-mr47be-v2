+/* Status -> System Log / Kernel Log: LuCI's filter rows (Not, box, label,
+   field) as wrapping rows; the gap replaces LuCI's inline margins */
+#content_syslog > div:has(> :is(input, select)) {
+	display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2);
+	margin-bottom: var(--sp-3) !important;
+}
+#content_syslog > div:has(> :is(input, select)) > * { margin: 0 !important; }
