diff --git a/package/kernel/qca-ssdk/Makefile b/package/kernel/qca-ssdk/Makefile
new file mode 100644
index 0000000..d905caf
--- /dev/null
+++ b/package/kernel/qca-ssdk/Makefile
@@ -0,0 +1,97 @@
+#
+# Qualcomm SSDK (Switch/Silicon SDK) -- provides the FAL (Forwarding Abstraction Layer)
+# that qca-nss-ppe needs for register-level PPE hardware access on IPQ53xx.
+#
+# Vendor source, permissively licensed (ISC-style), from Qualcomm's CodeLinaro OSS mirror.
+# Adapted from GL.iNet's own qca-ssdk.Makefile (upstream/refs/qsdk-feeds/qca-ssdk.Makefile),
+# stripped to just the ipq53xx path this port targets -- see
+# project_flint3_ppe_hw_offload_research.md for the full investigation this came out of.
+#
+
+include $(TOPDIR)/rules.mk
+include $(INCLUDE_DIR)/kernel.mk
+
+PKG_NAME:=qca-ssdk
+PKG_RELEASE:=1
+
+PKG_SOURCE_PROTO:=git
+PKG_SOURCE_URL:=https://git.codelinaro.org/clo/qsdk/oss/lklm/qca-ssdk.git
+PKG_SOURCE_VERSION:=199052ad04a8de97cff8fb4b91b9de86861da79b
+PKG_MIRROR_HASH:=skip
+PKG_LICENSE:=ISC
+
+hal_arch:=ipq53xx
+
+# This package's own build system (MODULE_TYPE=KSLIB) runs its real Kbuild
+# M=... invocation inside a nested temp/ subdirectory, not at PKG_BUILD_DIR
+# top level -- that's where the real modules.order and Module.symvers land.
+# OpenWrt's generic collect_module_symvers hook (include/kernel.mk) defaults
+# PKG_EXTMOD_SUBDIRS to "." and stitches together
+# $(PKG_BUILD_DIR)/$$subdir/Module.symvers; left at the default, it finds
+# nothing there, silently produces an EMPTY qca-ssdk.symvers (0 bytes) even
+# though qca-ssdk.ko itself exports 661 symbols correctly (confirmed via
+# nm) -- so any other kmod depending on kmod-qca-ssdk (qca-nss-ppe) fails
+# at modpost with "undefined!" for every FAL symbol it references, despite
+# them genuinely existing in the built .ko. Point this at temp/ instead.
+PKG_EXTMOD_SUBDIRS:=temp
+
+include $(INCLUDE_DIR)/package.mk
+
+define KernelPackage/qca-ssdk
+  SECTION:=kernel
+  CATEGORY:=Kernel modules
+  SUBMENU:=Network Devices
+  TITLE:=Kernel driver for QCA SSDK (FAL) -- ipq53xx
+  DEPENDS:=@TARGET_qualcommbe_ipq53xx
+  FILES:=$(PKG_BUILD_DIR)/build/bin/qca-ssdk.ko
+  AUTOLOAD:=$(call AutoLoad,30,qca-ssdk)
+endef
+
+define KernelPackage/qca-ssdk/description
+Kernel module providing Qualcomm's FAL (Forwarding Abstraction Layer) for
+register-level access to the IPQ53xx PPE hardware. Required by qca-nss-ppe.
+endef
+
+# SWCONFIG=FALSE excludes src/ref/{ref_uci,ref_misc,ref_athtag,ref_vport,
+# ref_mapt,ref_tunnel}.c -- an optional legacy interactive UCI-CLI shell for
+# reconfiguring AR8327-family switches at runtime. It depends on a
+# switch_ext/ext_val vendor extension to the swconfig subsystem's
+# struct switch_val that this open-source drop never defines anywhere
+# (only used, never declared) -- presumably carried in QCA's own
+# downstream kernel fork. We don't need an interactive CLI shell; our
+# actual dependency is the FAL/HSL/ADPT driver code in src/fal, src/hsl,
+# src/adpt (unaffected by SWCONFIG) that qca-nss-ppe calls directly.
+QCASSDK_CONFIG_OPTS:= \
+	TOOL_PATH=$(TOOLCHAIN_DIR)/bin \
+	SYS_PATH=$(LINUX_DIR) \
+	TOOLPREFIX=$(TARGET_CROSS) \
+	KVER=$(LINUX_VERSION) \
+	ARCH=$(LINUX_KARCH) \
+	SoC=$(hal_arch) \
+	CHIP_TYPE=MPPE \
+	SWCONFIG=FALSE \
+	CFLAGS=-I$(STAGING_DIR)/usr/include \
+	EXTRA_CFLAGS=-Wno-missing-prototypes
+
+define Build/InstallDev
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk/api
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk/ref
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk/fal
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk/sal
+	$(INSTALL_DIR) $(1)/usr/include/qca-ssdk/init
+	$(CP) -rf $(PKG_BUILD_DIR)/include/api/sw_ioctl.h $(1)/usr/include/qca-ssdk/api
+	$(CP) -rf $(PKG_BUILD_DIR)/include/init $(1)/usr/include/qca-ssdk
+	$(CP) -rf $(PKG_BUILD_DIR)/include/fal $(1)/usr/include/qca-ssdk
+	$(CP) -rf $(PKG_BUILD_DIR)/include/common/*.h $(1)/usr/include/qca-ssdk
+	$(CP) -rf $(PKG_BUILD_DIR)/include/sal/os/linux/*.h $(1)/usr/include/qca-ssdk
+	$(CP) -rf $(PKG_BUILD_DIR)/include/sal/os/*.h $(1)/usr/include/qca-ssdk
+endef
+
+define Build/Compile
+	$(MAKE) -C $(PKG_BUILD_DIR) $(strip $(QCASSDK_CONFIG_OPTS)) \
+		LNX_MAKEOPTS='$(KERNEL_MAKEOPTS) KCFLAGS="-Wno-error=missing-prototypes -Wno-error=missing-declarations"' \
+		MODULE_TYPE=KSLIB modules
+endef
+
+$(eval $(call KernelPackage,qca-ssdk))
diff --git a/package/kernel/qca-ssdk/patches/001-qca808x-kernel-6.18-phy-api.patch b/package/kernel/qca-ssdk/patches/001-qca808x-kernel-6.18-phy-api.patch
new file mode 100644
index 0000000..b43fc3d
--- /dev/null
+++ b/package/kernel/qca-ssdk/patches/001-qca808x-kernel-6.18-phy-api.patch
@@ -0,0 +1,51 @@
+From: village <village@flint3-port>
+Subject: hsl: qca808x: fix PHY driver registration API for kernel 6.18
+
+This vendor driver targets an older kernel where struct phy_driver's
+match_phy_device took a single struct phy_device * argument, and
+phy_driver_register()/phy_driver_unregister() existed as singular
+wrappers. Both changed upstream:
+- match_phy_device gained a second `const struct phy_driver *` argument
+  (see include/linux/phy.h)
+- phy_driver_register/phy_driver_unregister were replaced entirely by
+  the batch phy_drivers_register()/phy_drivers_unregister() API, which
+  takes an array + count.
+
+The QCA8084/QCA8081 PHYs this file matches are not present on the
+Flint 3 (BE9300) -- WAN is RTL8221B, LAN goes through the RTL8372N
+switch -- so this file is unconditionally compiled as part of the
+vendor SDK's PHY driver set but never actually probes anything on this
+board. Fixed for build correctness regardless.
+
+--- a/src/hsl/phy/qca808x.c
++++ b/src/hsl/phy/qca808x.c
+@@ -600,7 +600,8 @@
+ 	return err;
+ }
+
+-int qca808x_match_phy_device(struct phy_device *phydev)
++int qca808x_match_phy_device(struct phy_device *phydev,
++			      const struct phy_driver *drv)
+ {
+ 	a_uint32_t phy_id = 0;
+
+@@ -693,17 +694,13 @@
+ a_int32_t qca808x_phy_driver_register(void)
+ {
+ 	a_int32_t ret;
+-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4,9,0))
+-	ret = phy_driver_register(&qca808x_phy_driver, THIS_MODULE);
+-#else
+-	ret = phy_driver_register(&qca808x_phy_driver);
+-#endif
++	ret = phy_drivers_register(&qca808x_phy_driver, 1, THIS_MODULE);
+ 	return ret;
+ }
+
+ void qca808x_phy_driver_unregister(void)
+ {
+-	phy_driver_unregister(&qca808x_phy_driver);
++	phy_drivers_unregister(&qca808x_phy_driver, 1);
+ }
+
+ void qca808x_phydev_init(a_uint32_t dev_id, a_uint32_t port_id)
diff --git a/package/kernel/qca-ssdk/patches/002-sfp-phy-kernel-6.18-phy-api.patch b/package/kernel/qca-ssdk/patches/002-sfp-phy-kernel-6.18-phy-api.patch
new file mode 100644
index 0000000..175ade9
--- /dev/null
+++ b/package/kernel/qca-ssdk/patches/002-sfp-phy-kernel-6.18-phy-api.patch
@@ -0,0 +1,36 @@
+From: village <village@flint3-port>
+Subject: hsl: sfp_phy: fix PHY driver registration API for kernel 6.18
+
+Same issue as 001-qca808x-kernel-6.18-phy-api.patch: phy_driver_register()/
+phy_driver_unregister() were replaced upstream by the batch
+phy_drivers_register()/phy_drivers_unregister() API.
+
+The line 341 IN_PHY_I2C_MODE call site is left alone -- that config option
+is not enabled in our build, so it never actually compiles, and this SFP
+PHY driver as a whole is not relevant to the Flint 3 (BE9300, no SFP cage)
+-- fixed only for build correctness of the unconditionally-compiled vendor
+source tree.
+
+--- a/src/hsl/phy/sfp_phy.c
++++ b/src/hsl/phy/sfp_phy.c
+@@ -387,11 +387,7 @@
+ 	int ret = 0;
+ 	if(sfp_phy_drv_registered == A_FALSE)
+ 	{
+-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(4,9,0))
+-		ret = phy_driver_register(&sfp_phy_driver, THIS_MODULE);
+-#else
+-		ret = phy_driver_register(&sfp_phy_driver);
+-#endif
++		ret = phy_drivers_register(&sfp_phy_driver, 1, THIS_MODULE);
+ 		sfp_phy_drv_registered = A_TRUE;
+ 	}
+ 	return ret;
+@@ -401,7 +397,7 @@
+ {
+ 	if (sfp_phy_drv_registered == A_TRUE)
+ 	{
+-		phy_driver_unregister(&sfp_phy_driver);
++		phy_drivers_unregister(&sfp_phy_driver, 1);
+ 	}
+ }
diff --git a/package/kernel/qca-ssdk/patches/003-hsl-phy-eee-kernel-6.18-api.patch b/package/kernel/qca-ssdk/patches/003-hsl-phy-eee-kernel-6.18-api.patch
