+
+.v-nft-card > summary {
+	display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;
+	min-height: 44px; padding: 8px var(--card-px);
+	list-style: none; cursor: pointer;
+	border-radius: var(--r-lg);
