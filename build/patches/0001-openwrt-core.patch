+	@media (pointer: coarse) {
+		:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option { min-block-size: var(--ctl-h); }
+	}
+}
+
+/* password + reveal and other control groups */
+.control-group {
+	display: flex; align-items: stretch; flex-wrap: nowrap;
+	max-width: var(--field-max);
+}
+.control-group > * { margin: 0 !important; }
+.control-group > :not(:first-child) { margin-left: -1px !important; }
+.control-group > input, .control-group > .cbi-dropdown, .control-group > select { flex: 1 1 auto; min-width: 0; max-width: none; }
+.control-group > :not(:last-child) { border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important; }
+.control-group > :not(:first-child) { border-top-left-radius: 0 !important; border-bottom-left-radius: 0 !important; }
+.control-group > .btn, .control-group > .cbi-button { flex: none; }
+/* a group on the line under its field (System -> Local Time's Sync buttons) */
+.cbi-value-field > br + .control-group { margin-top: var(--sp-2); }
+/* in LuCI's unclassed field wrapper (a flex row) the group sized to its
+   content, 254px for a password with its reveal button: as wide as a field */
+.cbi-value-field > div:not([class]) > .control-group { flex: 1 1 auto; }
+
+/* checkbox */
+.cbi-checkbox { display: inline-flex; align-items: center; min-height: var(--ctl-h); gap: var(--sp-2); }
+input.cbi-checkbox { min-height: 0; }   /* banIP puts the class on the box itself */
+/* its help 8px under the box, as under a field: the box (16px) sits
+   centred in a control-high row */
+@media (width > 720px) {
+	.cbi-value-field > .cbi-checkbox + .cbi-value-description { margin-top: calc((16px - var(--ctl-h)) / 2 + 8px); }
+}
+@media (pointer: coarse) and (width > 720px) {
+	.cbi-value-field > .cbi-checkbox + .cbi-value-description { margin-top: calc((20px - var(--ctl-h)) / 2 + 8px); }   /* 20px touch box */
+}
+.cbi-checkbox > label:empty { display: none; }
+input[type="checkbox"], input[type="radio"] {
+	appearance: none; -webkit-appearance: none;
+	width: 16px; height: 16px; margin: 0;
+	flex: none;
+	display: inline-grid; place-content: center;
+	vertical-align: middle;
+	background: var(--s2);
+	border: 1px solid var(--line-2);
+	border-radius: var(--r-sm);
+	cursor: pointer;
+	transition: background-color .12s, border-color .12s;
+}
+input[type="radio"] { border-radius: 50%; }
+input[type="checkbox"]:hover, input[type="radio"]:hover { border-color: var(--text-3); }
+input[type="checkbox"]:checked, input[type="radio"]:checked { background: var(--accent); border-color: var(--accent-line); }
+input[type="checkbox"]:checked::before {
+	content: ""; width: 9px; height: 5px;
+	border: solid var(--accent-ink); border-width: 0 0 2px 2px;
+	transform: translateY(-1px) rotate(-45deg);
+}
+input[type="radio"]:checked::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-ink); }
+input[type="checkbox"]:focus-visible, input[type="radio"]:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+input[type="checkbox"][disabled]:checked { opacity: .5; }
+
+/* range slider */
+.cbi-range-slider { display: flex; align-items: center; gap: var(--sp-3); max-width: var(--field-max); min-height: var(--ctl-h); flex-wrap: wrap; }
+.cbi-range-slider input[type="range"] { flex: 1 1 160px; accent-color: var(--accent-text); }
+.cbi-range-slider-value, .cbi-range-slider-calc { font-family: var(--mono); color: var(--text-2); font-size: var(--fs-sm); }
+
+/* buttons */
+:where(.btn, .cbi-button, .vt-main button:not([class]), .modal button:not([class]),
+input[type="button"], input[type="reset"], input[type="submit"]) {
+	display: inline-flex; align-items: center; justify-content: center; gap: 6px;
+	min-height: var(--ctl-h);
+	padding: 0 var(--sp-3);
+	background: var(--s3);
+	color: var(--text);
+	border: 1px solid var(--line-2);
+	border-radius: var(--r);
+	font: 500 var(--fs-base)/1 var(--font);
+	white-space: nowrap;
+	cursor: pointer;
+	user-select: none;
+	text-decoration: none !important;
+	vertical-align: middle;
+	transition: background-color .12s, border-color .12s, color .12s;
+}
+:where(.btn, .cbi-button, input[type="button"], input[type="submit"]):hover { background: var(--s4); border-color: var(--text-3); }
+:where(.btn, .cbi-button):active { transform: translateY(.5px); }
+
+.btn[disabled], .cbi-button[disabled], button[disabled], .btn.disabled, .cbi-button.disabled {
+	opacity: .45; cursor: not-allowed; pointer-events: none;
+}
+
+.cbi-button-up, .cbi-button-down { min-width: var(--ctl-h); padding: 0 6px; }
+
+.button-row { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--sp-2); margin-top: var(--sp-4); }
+.right > .btn, .right > .cbi-button, .right > button { margin-left: var(--sp-2); }
+
+/* dropdown (ui.Dropdown / ui.ComboButton) */
+.cbi-dropdown {
+	position: relative;
+	display: inline-flex; align-items: stretch;
+	width: 100%; max-width: var(--field-max);
+	min-height: var(--ctl-h);
+	padding: 0;
+	background: var(--s2);
+	color: var(--text);
+	border: 1px solid var(--line-2);
+	border-radius: var(--r);
+	cursor: pointer;
+	outline: none;
+	vertical-align: middle;
+}
+.cbi-dropdown:hover { border-color: var(--text-3); }
+.cbi-dropdown:focus, .cbi-dropdown[open] { border-color: var(--focus); box-shadow: 0 0 0 1px var(--focus), 0 0 0 4px var(--accent-soft); }
+.cbi-dropdown:focus-visible { outline: none; }
+.cbi-dropdown[disabled] { opacity: .55; pointer-events: none; }
+
+.cbi-dropdown > ul {
+	display: flex; flex-wrap: wrap; align-items: center; gap: 4px;
+	flex: 1 1 auto; min-width: 0;
+	margin: 0; padding: 3px 4px 3px 10px;
+	list-style: none;
+	overflow: hidden;
+}
+.cbi-dropdown > ul > li {
+	display: none;
+	align-items: center; gap: 6px;
+	min-height: 24px;
+	overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.cbi-dropdown > ul > li[display] { display: flex; }
