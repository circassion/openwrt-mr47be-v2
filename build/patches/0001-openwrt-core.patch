+.cbi-section-table .td var { font-style: normal; }
+.cbi-section-table .td var:is([data-tooltip="ACCEPT"], [data-tooltip="REJECT"], [data-tooltip="DROP"],
+	[data-tooltip="DNAT"], [data-tooltip="SNAT"], [data-tooltip="MASQUERADE"], [data-tooltip="NOTRACK"], [data-tooltip="HELPER"]) {
+	display: inline-block; padding: 0 7px; margin-right: 2px;
