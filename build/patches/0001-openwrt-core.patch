+	max-height: 1lh;
+	overflow: hidden;
+	cursor: pointer;
+}
+:is(.cbi-map-descr, .cbi-section-descr) > .vt-help {
+	display: inline-grid; place-items: center;
+	width: 1.5em; height: 1.5em;
+	margin: 0 6px 0 -3px; padding: 0;
+	vertical-align: top;
+	background: none; border: 0; border-radius: var(--r-sm);
+	color: var(--text-3);
+	cursor: pointer;
+}
+/* both buttons, after their placement rules */
+.vt-help svg { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
+.vt-help:hover { color: var(--text); background: var(--s3); }
+.vt-help[aria-expanded="true"] { color: var(--accent-text); }
+
+/* the box (i) opens, over the page and any modal (menu-vantage.js) */
+.vt-help-pop {
+	position: fixed; z-index: 1100;
+	width: max-content; max-width: min(34em, calc(100vw - 16px));
+	padding: 10px 12px;
+	overflow-y: auto; overscroll-behavior: contain;
+	border: 1px solid var(--line-2); border-radius: var(--r);
+	background: var(--s2); box-shadow: var(--shadow-pop);
+	color: var(--text-2);
+	font-size: var(--fs-sm); line-height: 1.5;
+	overflow-wrap: anywhere;
