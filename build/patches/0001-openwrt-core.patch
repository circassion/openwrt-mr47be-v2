+
+/* File Manager (luci-app-filemanager) injects a light palette of its own: a
+   #f9f9f9 status bar, #f0f0f0 row hover and editor gutter, #ccc rules. On the
+   dark scheme that is a white band under the theme's light ink; repaint those
+   surfaces with the theme's, and let the table's own hover show through the
+   app's !important row fill. */
+body[data-page="admin-system-filemanager"] #status-bar { background: var(--s1); border-color: var(--line); }
+body[data-page="admin-system-filemanager"] #status-bar .cbi-progressbar { background: none; }
