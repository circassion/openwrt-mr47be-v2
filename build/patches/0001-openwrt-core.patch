+		margin: 4px 0;
+		padding: 4px;
+		min-inline-size: anchor-size(self-inline);
+		max-inline-size: calc(100% - var(--sp-2));
+		max-block-size: min(50vh, calc(100% - 8px));
+		background: var(--s2);
+		color: var(--text);
+		border: 1px solid var(--line-2);
+		border-radius: var(--r);
+		box-shadow: var(--shadow-pop);
+		overflow: hidden auto;
+		scrollbar-width: thin;
+	}
+	/* choices as .cbi-dropdown's: long ones wrap */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option {
+		min-block-size: calc(var(--ctl-h) - 4px);
+		padding: 4px 8px;
+		border-radius: var(--r-sm);
+		white-space: normal;
+		color: var(--text);
+		font-weight: 400;
+	}
+	/* the chosen one in the signal (fill and weight, no check mark); the
+	   one under the pointer or the keyboard on --s4, the keyboard's with
+	   the accent bar */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option::checkmark { display: none; }
+	/* the tint over an opaque fill: apps that copy a select's option colour
+	   onto their own list (PassWall's node picker) would get a see-through one */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option:checked { color: var(--accent-text); font-weight: 600; background: linear-gradient(var(--accent-soft) 0 0) var(--s2); }
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option:is(:hover, :focus-visible) { background: var(--s4); color: var(--text); outline: none; }
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option:focus-visible { box-shadow: inset 2px 0 0 var(--accent-text); }
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) option:disabled { color: var(--text-3); background: none; cursor: not-allowed; }
+	/* a group's label: quiet, its choices as any other */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) optgroup { color: var(--text-3); font-weight: 600; }
