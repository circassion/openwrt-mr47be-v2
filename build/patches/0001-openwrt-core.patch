diff --git a/package/network/mr47be-die-switch/files/mr47be-polish.init b/package/network/mr47be-die-switch/files/mr47be-polish.init
new file mode 100755
index 0000000..d8a9d78
--- /dev/null
+++ b/package/network/mr47be-die-switch/files/mr47be-polish.init
@@ -0,0 +1,48 @@
+#!/bin/sh /etc/rc.common
+# v27 system polish (runs on every boot, after /etc/init.d/wan-rename):
+#
+#  1) The WAN netdev is renamed gmac1 -> wan at boot (wan-rename, START=19).
+#     /etc/board.json still named the WAN device "gmac1", so LuCI drew a
+#     phantom "gmac1" port with 0 B and the WAN LED trigger pointed at a
+#     device that no longer exists.  Migrate every board JSON copy in place.
+#  2) upstream OpenWrt does not publish a target feed for qualcommbe/ipq53xx,
+#     so "apk update" always ended with a 404 (wget error 8).  Drop that line
+#     from the apk repository list; the arch feed stays.
+#
+# /etc/board.json is a symlink to /tmp/sysinfo/board.json (a copy of
+# /etc/board-base.json), so the runtime copy is the one LuCI/rpcd reads.
+
+START=25
+STOP=10
+
+_patch_board_json() {
+	_f="$1"
+	[ -f "$_f" ] || return 0
+	grep -q '"device": "gmac1"' "$_f" 2>/dev/null || return 0
+	sed -i 's/"device": "gmac1"/"device": "wan"/g' "$_f"
+	echo "mr47be-polish: board json gmac1 -> wan ($_f)" > /dev/kmsg 2>/dev/null
+}
+
+boot() {
+	# only touch the JSON when the renamed netdev really exists
+	if [ -e /sys/class/net/wan ]; then
+		_patch_board_json /etc/board-base.json
+		_patch_board_json /tmp/sysinfo/board.json
+		# /etc/board.json is normally a symlink - never sed -i over a symlink
+		if [ -f /etc/board.json ] && [ ! -L /etc/board.json ]; then
+			_patch_board_json /etc/board.json
+		fi
+	fi
+
+	# apk: drop the 404 target feed, keep the arch feed
+	for _f in /etc/apk/repositories.d/distfeeds.list /etc/apk/repositories; do
+		[ -f "$_f" ] || continue
+		grep -q 'targets/qualcommbe/ipq53xx' "$_f" 2>/dev/null || continue
+		sed -i '\#/targets/qualcommbe/ipq53xx/#d' "$_f"
+		echo "mr47be-polish: removed 404 target feed ($_f)" > /dev/kmsg 2>/dev/null
+	done
+
+	return 0
+}
+
+start() { boot; }
diff --git a/package/network/mr47be-die-switch/files/wan-rename.init b/package/network/mr47be-die-switch/files/wan-rename.init
new file mode 100755
index 0000000..6c280dd
--- /dev/null
+++ b/package/network/mr47be-die-switch/files/wan-rename.init
@@ -0,0 +1,34 @@
+#!/bin/sh /etc/rc.common
+# v25: the SoC WAN MAC is probed as "gmac1".  Rename it to "wan" before netifd
+# (START=20) so ifconfig/LuCI/forums show the expected name.  If the rename
+# cannot be done, network.wan.device is kept as gmac1 and the WAN still works.
+START=19
+STOP=10
+
+boot() {
+	[ -e /sys/class/net/gmac1 ] || return 0
+	if [ -e /sys/class/net/wan ]; then
+		echo "wan-rename: 'wan' already exists -> keeping gmac1" > /dev/kmsg 2>/dev/null
+		return 0
+	fi
+	ip link set dev gmac1 down 2>/dev/null
+	_dev=gmac1
+	if ip link set dev gmac1 name wan 2>/dev/null; then
+		_dev=wan
+		echo "wan-rename: gmac1 -> wan" > /dev/kmsg 2>/dev/null
+	else
+		echo "wan-rename: rename failed -> staying on gmac1" > /dev/kmsg 2>/dev/null
+	fi
+	if uci -q get network.wan >/dev/null 2>&1; then
+		case "$(uci -q get network.wan.device)" in
+			gmac1|wan|'')
+				uci set network.wan.device="$_dev" >/dev/null
+				uci -q set network.wan.ifname="$_dev" >/dev/null
+				uci commit network >/dev/null 2>&1
+				;;
+		esac
+	fi
+	return 0
+}
+
+start() { boot; }
