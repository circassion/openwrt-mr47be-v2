+			client: weak[0].mac, list: weak.length > 1 ? 'weak' : null });
+		/* all fine: the weakest, which is how close the network is to a problem */
+		else if (!counted.length) out.push({ id: 'signal', level: 'ok', title: _('Signal'), value: fmt.DASH,
