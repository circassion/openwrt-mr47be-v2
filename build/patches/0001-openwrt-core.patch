+/* Bare elements some themes style globally (bootstrap: header is a sticky
+   dark navbar with 40px paragraphs, footer a flex row with a top rule,
+   headings sit in 36px line boxes, labels get a fixed font). :where()
+   keeps these at class specificity, so every rule of the app below still
+   wins and only the theme's element selectors are overridden. */
+.vt-app :where(header, footer) {
+	position: static; z-index: auto; display: block; overflow: visible;
+	margin: 0; padding: 0; border: 0; border-radius: 0;
+	background: none; box-shadow: none; color: inherit; text-shadow: none;
+}
+.vt-app :where(header, footer) :where(p, a, span) { line-height: inherit; text-shadow: none; }
+.vt-app :where(header) :where(a) { color: inherit; }
+.vt-app :where(h2, h3, h4) { line-height: 1.25; font-family: inherit; }
+.vt-app :where(label) { font: inherit; line-height: inherit; }
+.vt-app button {
+	/* themes style bare buttons (centred, fixed height, shadows); the
+	   dashboard's buttons are layout elements with their own classes */
+	font: inherit; color: inherit; letter-spacing: normal; text-transform: none;
+	justify-content: flex-start; align-items: center; text-align: left;
+	height: auto; min-height: 0; white-space: normal; user-select: auto; vertical-align: baseline;
+}
+.vt-app .vt-mono { font-family: var(--vt-mono); font-size: .92em; letter-spacing: -.01em; }
+.vt-app .vt-tn { font-variant-numeric: tabular-nums; }
+.vt-app .vt-muted { color: var(--vt-text-3); }
+.vt-app .vt-hint { color: var(--vt-text-3); font-size: var(--vt-fs-sm); }
+.vt-app .vt-t-warn { color: var(--vt-warn); }
+.vt-app .vt-t-err { color: var(--vt-err); }
+.vt-app .vt-label { display: block; color: var(--vt-text-3); font-size: var(--vt-fs-micro); font-weight: var(--vt-fw-semibold); letter-spacing: .08em; text-transform: uppercase; }
+.vt-app .vt-big { font-size: var(--vt-fs-2xl); font-weight: var(--vt-fw-bold); letter-spacing: -.02em; line-height: 1.05; }
+
+.vt-app .vt-ico {
