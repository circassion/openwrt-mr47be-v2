+/* System -> Software: the control rows line up with the page (LuCI pads
+   each by .25em), and "Update lists…" is a plain button among plain ones */
+#view > .controls { column-gap: var(--sp-3); }
+#view > .controls > * { padding-left: 0; padding-right: 0; }
+#view > .controls :is(.btn, .cbi-button).cbi-button-positive:not(.important) { color: var(--text); }
