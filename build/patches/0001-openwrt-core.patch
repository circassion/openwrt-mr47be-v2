+					if (typeof b === 'string' && b) own.add(b.toUpperCase());
+				});
+		safeRun();
+	});
+	new MutationObserver(safeRun).observe(view, { childList: true, subtree: true, attributes: true, attributeFilter: [ 'points', 'data-tab-active' ] });
+	safeRun();
+}
