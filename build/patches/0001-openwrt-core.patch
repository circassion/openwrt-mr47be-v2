+input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }
+/* fields in pages, modals and the login: the rules above lose to the field
+   rules' (0,2,1), so hover and focus are restated at their weight. Focus:
+   a --focus border plus a 1px ring of it (>= 3:1 against the field and
+   the card in both modes) and the soft halo. The dashboard styles its own. */
+:is(input, select, textarea):not([type="checkbox"], [type="radio"], [type="range"], .vt-pal-input, .vt-app *):hover { border-color: var(--text-3); }
+:is(input, select, textarea):not([type="checkbox"], [type="radio"], [type="range"], .vt-pal-input, .vt-app *):focus {
+	border-color: var(--focus);
+	box-shadow: 0 0 0 1px var(--focus), 0 0 0 4px var(--accent-soft);
+}
+/* a disabled field does not answer the pointer */
+:is(input, select, textarea):not([type="checkbox"], [type="radio"], [type="range"], .vt-pal-input, .vt-app *):disabled:hover { border-color: var(--line-2); }
+input[disabled], select[disabled], textarea[disabled], input[readonly] { opacity: .6; cursor: not-allowed; }
+input[readonly] { cursor: default; }
+
+.cbi-input-invalid, input.cbi-input-invalid, .cbi-input-invalid > .cbi-dropdown, .cbi-dropdown.cbi-input-invalid,
+.cbi-input-invalid input, select.cbi-input-invalid {
+	border-color: var(--err) !important;
+	background-color: var(--err-soft) !important;
+	color: var(--text) !important;
+	box-shadow: 0 0 0 3px var(--err-soft) !important;
+}
+
+/* a select's list drawn by the browser (Firefox, Safari, Chromium before
+   135, and the selects below that keep it) takes little from the page
+   but the options' colours. It took the field's background: a tinted
+   field (invalid, a firewall warning) opened a cream list with light
+   text in dark mode. The options carry the surface and text instead. */
+:is(.vt-main, .modal) select:not([multiple], [size], .vt-app *) :is(option, optgroup) { background-color: var(--s2); color: var(--text); }
+:is(.vt-main, .modal) select:not([multiple], [size], .vt-app *) option:disabled { color: var(--text-3); }
+
+/* a select's list drawn in the page (customizable select, Chromium 135+)
+   gets the .cbi-dropdown list's look. Not listboxes, nor a select LuCI
+   sizes itself (width:auto, Wireless "Operating frequency"): base-select
+   sizes a field to its chosen label, not its longest. The dashboard
+   styles its own. */
+@supports (appearance: base-select) {
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *),
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *)::picker(select) { appearance: base-select; }
+	/* the field as before: base-select makes it a flex box with the value
+	   at the top (2px high, 6px on touch) and free to wrap; centre it on
+	   one line, cut at the content edge as the native field cuts it */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *) {
+		align-items: center;
+		white-space: nowrap;
+		overflow: clip; overflow-clip-margin: content-box;
+	}
+	/* the theme draws the arrow */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *)::picker-icon { display: none; }
+	/* focus moves to an option while the list is open: the field keeps its
+	   ring and its arrow turns to the signal, as on an open .cbi-dropdown */
+	:is(.vt-main, .modal) select:not([multiple], [size], [style*="width:auto"], .vt-app *):open {
+		border-color: var(--focus);
+		box-shadow: 0 0 0 1px var(--focus), 0 0 0 4px var(--accent-soft);
+		background-image: linear-gradient(45deg, transparent 50%, var(--accent-text) 50%), linear-gradient(135deg, var(--accent-text) 50%, transparent 50%);
+	}
+	/* the list: 4px off the field, at least as wide, above it when there
+	   is more room there; 50vh at most, as .cbi-dropdown, and never past
+	   the screen (100% is the room beside the field: less the 8px of
+	   margins below, an 8px gutter across) */
