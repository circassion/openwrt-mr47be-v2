+[id^="cbi-firewall-"] .cbi-section-table .td > small:has(> br) { display: block; font-size: var(--fs-base); line-height: 1.8; }
+[id^="cbi-firewall-"] .cbi-section-table .td > small:has(> br) > span:first-child { color: var(--text-3); font-size: var(--fs-sm); }
+[id^="cbi-firewall-"] .cbi-section-table .td > small:has(> br) > span:first-child var { color: inherit; }
+[id^="cbi-firewall-"] .cbi-section-table .td small var:not([data-tooltip]) { font-size: .92em; }
+/* names: tabular figures would widen their hyphens ("Allow - Ping") */
+.cbi-section-table .td.cbi-section-table-titles { font-variant-numeric: normal; }
+/* a zone badge coloured with a plain hex (Port Forwards' target zone)
+   gets the same tint and edge as the rgb ones above */
+.zonebadge[style*="background-color:#"] {
+	padding-left: 10px;
+	border-color: var(--line-2) !important; color: var(--text) !important;
+	background-image: linear-gradient(to right, transparent 3px, color-mix(in srgb, var(--s2) calc(100% - var(--zone-mix) * 100%), transparent) 3px);
