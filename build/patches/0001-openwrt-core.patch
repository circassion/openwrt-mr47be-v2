+.v-nft-card[open] > summary::before { transform: rotate(45deg); margin-bottom: 4px; }
+.v-nft-card[open] > summary { border-bottom: 1px solid var(--line); border-radius: var(--r-lg) var(--r-lg) 0 0; }
