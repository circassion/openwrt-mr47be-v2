diff --git a/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger b/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger
new file mode 100755
index 0000000..e739218
--- /dev/null
+++ b/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger
@@ -0,0 +1,121 @@
+#!/bin/sh
+# Read-only WAN RX timer.
+# NO WRITES: only reads ethtool MIB + /sys, writes to /dev/kmsg, and reads the
+# 0x3a000000 (PPE) block via mmap READ-ONLY. Nothing is written to MDIO/registers.
+# Goal: answer "when did unicast RX die" within a single boot.
+#   - t ~60 s: BASE full dump (register values while RX is LIVE = baseline)
+#   - every 300 s: REG line (GMAC1 + GMAC2 filter/ENABLE/SPEED blocks)
+#   - unicast freeze: 3 consecutive samples du==0 && dt>0 -> FREEZE full dump
+# Usage: mr47be-wan-logger [interface] [interval-seconds]
+
+IF=${1:-wan}
+INTERVAL=${2:-20}
+FREEZE_AFTER=${FREEZE_AFTER:-3}
+REG_EVERY=${REG_EVERY:-15}
+DUMP_EVERY=${DUMP_EVERY:-300}
+PEEREBIN=/usr/sbin/peeread
+
+# GMAC1(port1)=wan 0x3a001000, GMAC2(port2)=lan 0x3a001200
+# offsets: +00 ENABLE, +04 SPEED, +08 GOL_ADDR0(byte5:4), +0C GOL_ADDR1(byte0..3),
+#           +18 CTRL0, +1C CTRL1
+# XGMAC1(port1) 0x3a500000: +300 ADDR0_H (bit31=EN), +304 ADDR0_L
+# PPE mux: 0x3a000010 (bit8 = port1 XGMAC selected)
+# PPE drop tbl: 0x3a00b024 (8 entries)
+A_WAN=0x3a001000
+A_LAN=0x3a001200
+A_MUX=0x3a000010
+A_XGM=0x3a500300
+A_DROP=0x3a00b024
+
+up_i() { cut -d. -f1 /proc/uptime | cut -d' ' -f1; }
+
+mib() {
+	ethtool -S "$IF" 2>/dev/null | awk '
+		/^ *rx_frames:/      {r=$2}
+		/^ *rx_unicast_g:/   {u=$2}
+		/^ *rx_multicast_g:/ {m=$2}
+		/^ *rx_broadcast_g:/ {b=$2}
+		/^ *tx_frames_g:/    {t=$2}
+		END {printf "%d %d %d %d %d", r+0, u+0, m+0, b+0, t+0}'
+}
+
+k() { echo "$1" > /dev/kmsg 2>/dev/null; }
+
+blk() {
+	[ -x "$PEEREBIN" ] || { k "5|MR47BE-PROBE peeread MISSING"; return; }
+	"$PEEREBIN" "$1" "${2:-8}" 2>&1 | tr '\n' ' '
+}
+
+regs() {
+	k "6|MR47BE-REG$1 wanGMAC $(blk $A_WAN 8)"
+	k "6|MR47BE-REG$1 lanGMAC $(blk $A_LAN 8)"
+	k "6|MR47BE-REG$1 mux=$(blk $A_MUX 1) xgmac1=$(blk $A_XGM 2)"
+}
+
+fulldump() {
+	tag=$1
+	k "5|MR47BE-$tag t=$now silent=${silent}x${INTERVAL}s — full dump"
+	k "6|MR47BE-$tag-iplink $(ip -s link show $IF 2>/dev/null | tr '\n' '|')"
+	k "6|MR47BE-$tag-neigh $(ip neigh show dev $IF 2>/dev/null | tr '\n' '|')"
+	k "6|MR47BE-$tag-lanmib $(ethtool -S lan 2>/dev/null | awk '/rx_frames:|rx_unicast_g:|tx_frames_g:/{gsub(/^ +| /,"");printf "%s ", $1 $2}' | cut -c1-300)"
+	k "6|MR47BE-$tag-mib $(ethtool -S $IF 2>/dev/null | awk '/:/{gsub(/^ +/,"");printf "%s=%s ", $1, $2}' | cut -c1-850)"
+	regs "$tag"
+	k "6|MR47BE-$tag-droptbl $(blk $A_DROP 8)"
+	k "5|MR47BE-$tag done t=$now"
+}
+
+set -- $(mib)
+pr=$1; pu=$2; pm=$3; pb=$4; pt=$5
+k "5|MR47BE-WANRX started t=$(up_i) if=$IF interval=${INTERVAL}s freeze=${FREEZE_AFTER} reg=${REG_EVERY}x rxF=$pr rxU=$pu txF=$pt"
+
+silent=0
+lastdump=0
+n=0
+frozen=0
+
+while : ; do
+	sleep "$INTERVAL"
+	n=$((n+1))
+
+	cur=$(mib)
+	[ -n "$cur" ] || continue
+	set -- $cur
+	r=$1; u=$2; m=$3; b=$4; t=$5
+
+	dr=$((r-pr)); du=$((u-pu)); dm=$((m-pm)); db=$((b-pb)); dt=$((t-pt))
+	car=$(cat /sys/class/net/$IF/carrier 2>/dev/null)
+
+	k "6|MR47BE-WANRX t=$(up_i) rxF=$r(+$dr) rxU=$u(+$du) rxM=$m(+$dm) rxB=$b(+$db) txF=$t(+$dt) carrier=$car"
+
+	pr=$r; pu=$u; pm=$m; pb=$b; pt=$t
+	now=$(up_i)
+
+	# 1) live baseline: once at ~60 s
+	if [ "$n" -eq 3 ]; then
+		tag=BASE
+		fulldump BASE
+	fi
+
+	# 2) periodic register line: timestamp which one changes at the freeze moment
+	if [ $((n % REG_EVERY)) -eq 0 ]; then
+		regs ""
+	fi
+
+	# 3) unicast-specific freeze detection (du==0 but tx present)
+	if [ "$du" -eq 0 ] && [ "$dt" -gt 0 ]; then
+		silent=$((silent+1))
+	elif [ "$du" -ne 0 ]; then
+		if [ "$frozen" -eq 1 ]; then
+			k "5|MR47BE-WANRECOVER t=$now du=+$du (unicast RX recovered)"
+		fi
+		silent=0
+		frozen=0
+	fi
+
+	if [ "$silent" -ge "$FREEZE_AFTER" ] && [ $((now-lastdump)) -ge "$DUMP_EVERY" ]; then
+		lastdump=$now
+		frozen=1
+		FREEZE_AFTER_MARK=""
+		fulldump FREEZE
+	fi
+done
diff --git a/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger.init b/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger.init
new file mode 100755
index 0000000..e706db3
--- /dev/null
+++ b/package/firmware/mr47be-wan-probe/files/mr47be-wan-logger.init
@@ -0,0 +1,20 @@
+#!/bin/sh /etc/rc.common
+# Read-only WAN RX watchdog (starts automatically; easy to stop)
+START=98
+STOP=01
+USE_PROCD=1
+PROG=/usr/sbin/mr47be-wan-logger
+
+start_service() {
+	# rc.d links are generated automatically by 'rc.common enable'
+	# (include/rootfs.mk:107), so we keep the gate here. DEFAULT: DISABLED.
+	# To run manually: touch /tmp/mr47be_diag_on && /etc/init.d/mr47be-wan-logger start
+	# (or directly: /usr/sbin/mr47be-wan-logger wan 20 &)
+	[ -e /tmp/mr47be_diag_on ] || return 0
+	procd_open_instance wanlogger
+	procd_set_param command "$PROG" wan 20
+	procd_set_param respawn 3600 5 0
+	procd_set_param stdout 0
+	procd_set_param stderr 0
+	procd_close_instance
+}
diff --git a/package/firmware/mr47be-wan-probe/files/mr47be-wan-probe b/package/firmware/mr47be-wan-probe/files/mr47be-wan-probe
new file mode 100755
index 0000000..72f7ba1
--- /dev/null
+++ b/package/firmware/mr47be-wan-probe/files/mr47be-wan-probe
@@ -0,0 +1,36 @@
+#!/bin/sh
+# One-shot read-only WAN dump: run manually over SSH.
+# READS ONLY: ethtool / sysfs / debugfs cat + /dev/mem mmap (peeread).
+# No writes at all (the debugfs counter-clear store path is NOT used).
+IF=${1:-wan}
+PEER=/usr/sbin/peeread
+echo "===== mr47be-wan-probe t=$(cut -d' ' -f1 /proc/uptime) ====="
+echo "MAC=$(cat /sys/class/net/$IF/address 2>/dev/null) carrier=$(cat /sys/class/net/$IF/carrier 2>/dev/null) operstate=$(cat /sys/class/net/$IF/operstate 2>/dev/null)"
+echo "-- MIB --"
+ethtool -S $IF 2>/dev/null | grep -aE "rx_unicast_g|rx_frames:|rx_multicast_g|rx_broadcast_g|tx_frames_g|tx_unicast|rx_dropped|rx_drop_frames|rx_wdog_err|rx_fifo_overflow"
+echo "-- neighbours --"
+ip neigh show dev $IF 2>/dev/null
+echo "-- ip -s link --"
+ip -s link show $IF 2>/dev/null | tail -4
+echo "-- PPE debugfs (read-only cat) --"
+ls /sys/kernel/debug/ppe >/dev/null 2>&1 || mount -o ro -t debugfs nodev /sys/kernel/debug 2>/dev/null
+for f in port_rx port_tx l2_forward parse cpu_code qm; do
+	echo "  [$f]"
+	cat /sys/kernel/debug/ppe/$f 2>&1 | head -8 | sed 's/^/    /'
+done
+if [ -x "$PEER" ]; then
+	echo "-- GMAC1 (wan) 0x3a001000..0x1c: ENABLE/SPEED/ADDR0/ADDR1/CTRL0/CTRL1 --"
+	$PEER 0x3a001000 8
+	echo "-- GMAC2 (lan) 0x3a001200..0x1c (CONTROL, live port) --"
+	$PEER 0x3a001200 8
+	echo "-- PPE mux 0x3a000010 (bit8=port1 XGMAC secili) + PPE baz --"
+	$PEER 0x3a000000 8
+	echo "-- XGMAC1 port1 ADDR0_H/L 0x3a500300 (bit31=EN) --"
+	$PEER 0x3a500300 2
+	echo "-- PPE drop tbl 0x3a00b024 (8 girdi) --"
+	$PEER 0x3a00b024 8
+else
+	echo "peeread MISSING"
+fi
+echo "-- concurrent lan MIB (live reference) --"
+ethtool -S lan 2>/dev/null | grep -aE "rx_unicast_g|rx_frames:"
diff --git a/package/firmware/mr47be-wan-probe/files/peeread.c b/package/firmware/mr47be-wan-probe/files/peeread.c
new file mode 100755
index 0000000..c36afcc
--- /dev/null
+++ b/package/firmware/mr47be-wan-probe/files/peeread.c
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0
+// Read-only PPE/GMAC MMIO reader. /dev/mem read() returns EFAULT for MMIO on
+// this kernel; mmap() works. PROT_READ-only: a write attempt faults.
+#include <stdio.h>
+#include <stdlib.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/mman.h>
+
+#define MAP_LEN 8192UL
+
+int main(int argc, char **argv)
+{
+	unsigned long long base, page;
+	unsigned n = 1, i;
+	size_t off, maxn;
+	int fd;
+	volatile void *map;
+	volatile unsigned *p;
+
+	if (argc < 2) {
+		fprintf(stderr, "usage: %s <hex-phys-addr> [count]\n", argv[0]);
+		return 2;
+	}
+
+	base = strtoull(argv[1], NULL, 0);
+	if (argc > 2)
+		n = (unsigned)strtoul(argv[2], NULL, 0);
+	if (n == 0)
+		n = 1;
+
+	page = base & ~0xFFFULL;
+	off = (size_t)(base - page);
+
+	maxn = (MAP_LEN - off) / 4;
+	if (n > maxn)
+		n = maxn;
+
+	fd = open("/dev/mem", O_RDONLY | O_SYNC);
+	if (fd < 0) {
+		perror("open /dev/mem");
+		return 1;
+	}
+
+	map = mmap(NULL, MAP_LEN, PROT_READ, MAP_SHARED, fd, (off_t)page);
+	if (map == MAP_FAILED) {
+		perror("mmap /dev/mem");
+		close(fd);
+		return 1;
+	}
+
+	p = (volatile unsigned *)((volatile char *)map + off);
+	for (i = 0; i < n; i++)
+		printf("0x%08llx : 0x%08x\n",
+		       base + (unsigned long long)i * 4, (unsigned)p[i]);
+
+	munmap((void *)map, MAP_LEN);
+	close(fd);
+	return 0;
+}
