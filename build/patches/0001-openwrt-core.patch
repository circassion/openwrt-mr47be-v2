index 0000000..d7c705e
--- /dev/null
+++ b/package/luci/luci-app-mr47be-boot/Makefile
@@ -0,0 +1,29 @@
+#
+# MR47BE v2 boot selector: stock <-> OpenWrt
+#
+# This application does two things:
+#  1) Writes the tp_boot_idx variable in the U-Boot environment (mtd8) -> selects
+#     which firmware boots. 0 = stock, 1 = OpenWrt.
+#  2) If the stock partition (mtd12 "ubi") is damaged, writes a stock UBI image
+#     back to NAND (no UART needed).
+#
+# This is free software, licensed under the GNU General Public License,
+# version 2 or later.
+#
+
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=luci-app-mr47be-boot
+PKG_VERSION:=1.0.0
+PKG_RELEASE:=1
+PKG_LICENSE:=GPL-2.0-or-later
+
+LUCI_TITLE:=MR47BE v2 boot selector (stock / OpenWrt)
+LUCI_DESCRIPTION:=Switch the boot target between the stock firmware and OpenWrt \
+	on a Mercusys MR47BE v2, and restore a stock UBI image to NAND without UART.
+LUCI_DEPENDS:=+luci-base +uboot-envtools +nand-utils
+LUCI_PKGARCH:=all
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
+# call BuildPackage - OpenWrt buildroot signature
