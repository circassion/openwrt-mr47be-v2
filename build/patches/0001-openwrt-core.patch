+
+return baseclass.extend({
+	PAGES: PAGES,
+	WEAK_DBM: WEAK_DBM,
+
+	/* ------------------------------------------------------------ health */
+
+	/* model + { cpu: { pct, cores } | null, uplinkRate: { rx, tx } | null,
