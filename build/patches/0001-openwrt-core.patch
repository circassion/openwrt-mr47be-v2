+.v-nft-arrow { position: relative; flex: 0 0 18px; height: 2px; margin-right: 6px; background: var(--text-3); }
+.v-nft-arrow::after {
+	content: ""; position: absolute; right: -6px; top: -4px;
+	border: 5px solid transparent; border-left: 6px solid var(--text-3); border-right: 0;
