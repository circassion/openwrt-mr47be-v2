diff --git a/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler b/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler
new file mode 100755
index 0000000..135bb90
--- /dev/null
+++ b/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler
@@ -0,0 +1,159 @@
+#!/bin/sh
+# mr47be-fwram-sampler - READ-ONLY live sampler for the IPQ5332 WCSS firmware fatal.
+#
+# STATUS (v5): DISABLED BY DEFAULT. test033b proved that reading a WCSS-owned page
+# while the PD is coming up is fatal for the HOST, not for the firmware: at 13.42 s
+# the 4 KB read of PA 0x4b228000 produced "Internal error: synchronous external
+# abort", `Comm: dd`, `x5 = 0x4b228000`, `read_mem+0xe4` and then
+# "Kernel panic - not syncing ... SMP: stopping secondary CPUs" -> the board reset
+# into stock firmware. This live-read route is closed on this SoC; the sampler only
+# runs if /tmp/fwram_on exists (i.e. started by hand over ssh, after the WCSS is
+# already down, where such reads are known to work).
+#
+# Why it exists: the AHB MODE request goes out at ~14.37 s and the firmware dies at
+# ~14.56 s, while kmodloader is still running (it finishes ~14.49 s). Every rc.d S*
+# script starts after that, so test033 (rc.d-armed) only ever caught post-mortem RAM.
+# This is armed from /etc/hotplug.d/firmware, measured in test032 to run at 13.24 s.
+#
+# Target pages (PA = firmware VA - 0x651FC000), both confirmed readable and both
+# proven to still hold firmware content at uptime 950 s:
+#   P1 PA 0x4b2d4000 (VA 0xb04d0000) FW RW globals
+#   P2 PA 0x4b228000 (VA 0xb0428000) thread records + the crash record itself
+#
+# The crash record layout was measured over ssh on the running device (2026-11-04):
+#   P2 +0x8dc size/class?  +0x8e0 PC(=0xb02eb4ac)  +0x8e4 SP window
+#      +0x8e8 BADVA(=0xc)  +0x8ec 0x7003  +0x8f0 0x01b70170  +0x8f4 SP again
+#      +0x8f8 PC again (LR)  +0x8fc 2  +0x900 0x7ff7edbe
+#   P2 +0x75c thread name "err_ex_pd_2"
+# So watching P2 catches the exception frame at the moment the firmware writes it.
+#
+# Reads only. Never writes /dev/mem, never touches mtd/overlay, never unbinds a
+# driver, never reads an address we have not measured to be safe. Everything lands
+# in /tmp (tmpfs, gone at reboot) plus a few console lines.
+
+TAG=MR47BE-FWSAMP
+P1PA=0x4b2d4000
+P2PA=0x4b228000
+# byte offsets inside the page (dword-aligned), decimal for the awk selector
+P1COLS="1540,1576,1584,1964,2784,3040,20,128,144"
+P2COLS="2268,2272,2276,2280,2284,2288,2292,2296,2300,2304"
+BUFT=/tmp/fwram
+ARM=/tmp/fwram.arm
+DEADLINE=45
+MAXARCH=200
+
+log() { echo "$TAG: $*" > /dev/kmsg; }
+up() { read u _ < /proc/uptime; echo "$u"; }
+
+# One page -> "off=LE off=LE ..." on stdout, and appends the timestamped 1024-dword
+# image of the page to $4. Only hexdump -C fields $2..$17 are read: the ASCII column
+# can contain 2-hex-char tokens and silently shifts every later offset. Dwords are
+# printed most-significant-byte-last-as-value (little-endian integer), which was
+# cross-checked against python on real device output.
+sample() {
+	hexdump -C -v "$1" | awk -v cols="$2" -v t="$3" -v dump="$4" '
+	BEGIN { n = split(cols, c, ",") }
+	function le(off,   d) { d = int(off / 4) + 1
+		return b[4*d] b[4*d-1] b[4*d-2] b[4*d-3] }
+	{ for (i = 2; i <= 17; i++) b[++k] = $i }
+	END {
+		sel = ""
+		for (j = 1; j <= n; j++)
+			sel = sel sprintf("%03x=%s ", c[j], le(c[j]))
+		printf "%s", sel
+		full = ""
+		for (d = 1; d <= 1024; d++)
+			full = full b[4*d-3] b[4*d-2] b[4*d-1] b[4*d] " "
+		print t " " full >> dump
+	}'
+}
+
+[ -e /tmp/fwram_off ] && exit 0
+# v5 GATE: reading the WCSS window live panics the host (test033b) -> by default
+# NOTHING is read; it exits silently unless /tmp/fwram_on is created by hand.
+[ -e /tmp/fwram_on ] || exit 0
+mkdir "$BUFT" 2>/dev/null
+# atomic single-instance guard: the hotplug handler fires per firmware request
+if ! mkdir "$ARM" 2>/dev/null; then
+	exit 0
+fi
+
+# A blind read of the wrong WCSS page hangs the box (test030), so probe both pages
+# once under timeout and give up rather than burn the boot.
+if ! timeout 3 dd if=/dev/mem bs=512 count=1 skip=$(( P1PA / 512 )) of=/tmp/probe.bin 2>/dev/null; then
+	log "probe FAILED p1=$P1PA - sampler disabled"
+	rmdir "$ARM"
+	exit 0
+fi
+if ! timeout 3 dd if=/dev/mem bs=512 count=1 skip=$(( P2PA / 512 )) of=/tmp/probe2.bin 2>/dev/null; then
+	log "probe FAILED p2=$P2PA - P2 dropped"
+	P2PA=
+fi
+
+# busybox here has no usleep and no fractional sleep; test033 measured 1 Hz on the
+# rc.d path, so re-calibrate every boot instead of assuming.
+read a0 _ < /proc/uptime
+timeout 0.05 sleep 2 2>/dev/null
+read a1 _ < /proc/uptime
+fast=$(awk -v a="$a0" -v b="$a1" 'BEGIN { print (b - a < 0.2) ? 1 : 0 }')
+if [ "$fast" = 1 ]; then
+	DELAY="timeout 0.05 sleep 2"
+	RATE=20Hz
+else
+	DELAY="sleep 1"
+	RATE=1Hz
+fi
+
+log "start t=$(up) p1=$P1PA p2=${P2PA:-none} rate=$RATE"
+log "P1: 604=? 628=? 630=? 7ac=? ae0/be0=rings 014/080/090=ptrs"
+[ -n "$P2PA" ] && log "P2: 8dc..900=crash record (8e0=PC 8e8=BADVA 8f8=LR)"
+
+# page -> archive on change: dd + cmp each tick, hexdump+awk only when it changed
+n1=0
+n2=0
+arch1=0
+arch2=0
+i=0
+while :; do
+	read t _ < /proc/uptime
+	[ "${t%.*}" -lt "$DEADLINE" ] || break
+
+	dd if=/dev/mem bs=4096 count=1 skip=$(( P1PA / 4096 )) of=/tmp/p1.bin 2>/dev/null
+	if [ ! -f /tmp/prev1.bin ] || ! cmp -s /tmp/p1.bin /tmp/prev1.bin; then
+		n1=$(( n1 + 1 ))
+		mv /tmp/p1.bin /tmp/prev1.bin
+		sel=$(sample /tmp/prev1.bin "$P1COLS" "$t" "$BUFT/P1.full.log")
+		echo "$n1 $t $sel" >> "$BUFT/P1.log"
+		log "P1 n=$n1 t=$t $sel"
+		if [ $arch1 -lt $MAXARCH ]; then
+			arch1=$(( arch1 + 1 ))
+			cp /tmp/prev1.bin "$BUFT/1-$n1-$t.bin" 2>/dev/null
+		fi
+	fi
+
+	if [ -n "$P2PA" ]; then
+		dd if=/dev/mem bs=4096 count=1 skip=$(( P2PA / 4096 )) of=/tmp/p2.bin 2>/dev/null
+		if [ ! -f /tmp/prev2.bin ] || ! cmp -s /tmp/p2.bin /tmp/prev2.bin; then
+			n2=$(( n2 + 1 ))
+			mv /tmp/p2.bin /tmp/prev2.bin
+			sel=$(sample /tmp/prev2.bin "$P2COLS" "$t" "$BUFT/P2.full.log")
+			echo "$n2 $t $sel" >> "$BUFT/P2.log"
+			log "P2 n=$n2 t=$t $sel"
+			if [ $arch2 -lt $MAXARCH ]; then
+				arch2=$(( arch2 + 1 ))
+				cp /tmp/prev2.bin "$BUFT/2-$n2-$t.bin" 2>/dev/null
+			fi
+		fi
+	fi
+
+	i=$(( i + 1 ))
+	if [ $(( i % 20 )) -eq 0 ]; then
+		log "hb t=$t ticks=$i ch1=$n1 ch2=$n2"
+	fi
+	$DELAY
+done
+
+log "done t=$t ticks=$i ch1=$n1 ch2=$n2 arch1=$arch1 arch2=$arch2"
+log "last1='$(tail -1 "$BUFT/P1.log" 2>/dev/null)'"
+log "last2='$(tail -1 "$BUFT/P2.log" 2>/dev/null)'"
+log "files=$(ls "$BUFT" 2>/dev/null | wc -l) free=$(df -k /tmp 2>/dev/null | tail -1)"
diff --git a/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler.init b/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler.init
new file mode 100644
index 0000000..0235fa2
--- /dev/null
+++ b/package/firmware/mr47be-wifi-cal/files/mr47be-fwram-sampler.init
@@ -0,0 +1,18 @@
+#!/bin/sh /etc/rc.common
+# test033 fallback. The real arming happens in /etc/hotplug.d/firmware because rc.d
+# only runs after kmodloader, i.e. after the fatal. This copy exists to (a) report
+# whether the early hook fired and (b) still take a post-mortem page snapshot if it
+# did not.
+START=20
+STOP=90
+
+start() {
+	# Disabled by default; single switch /tmp/mr47be_diag_on
+	[ -e /tmp/mr47be_diag_on ] || return 0
+	if [ -d /tmp/fwram.arm ]; then
+		echo "MR47BE-FWSAMP: rc.d late, hotplug sampler already armed" > /dev/kmsg
+		return 0
+	fi
+	echo "MR47BE-FWSAMP: hotplug never fired, starting late sampler" > /dev/kmsg
+	/usr/sbin/mr47be-fwram-sampler &
+}
