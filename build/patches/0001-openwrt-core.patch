+	if (l4.length) {
+		var ports = item.portText ? ' ' + item.portText : '';
+		if (item.portsExcept) ports += ' ' + (item.portText ? _('except %s') : _('all ports except %s')).format(item.portsExcept);
+		parts.push(l4.map(function(p) { return p.toUpperCase(); }).join(', ') + ports);
