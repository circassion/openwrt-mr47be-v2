+.v-nft-panel > h3 { margin: var(--sp-5) 0 var(--sp-3); font-size: var(--fs-md); }
+.v-nft-panel > h3:first-child { margin-top: 0; }
+.v-nft-chains { display: grid; gap: var(--sp-2); }
+.v-nft-chart, .v-nft-card {
+	background: var(--s1);
+	border: 1px solid var(--line);
+	border-radius: var(--r-lg);
+	box-shadow: var(--v-shadow);
+}
+.v-nft-chart { display: grid; gap: var(--sp-3); padding: 14px var(--card-px); }
+.v-nft-chart-row { display: flex; align-items: center; min-width: 0; }
