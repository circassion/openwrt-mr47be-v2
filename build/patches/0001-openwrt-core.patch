+/* Status -> Firewall (nftables): each chain a card, its heading the header
+   row, hook and policy under it, the rules edge to edge. The view injects
+   ".nft-rules tr > td { padding: .25em !important }" and a margin on its
+   badges, hence #view and !important. A match (span.ifacebadge per
+   expression) is inline text, never flex columns: its words wrap. */
+.nft-table > h3 { margin: 0 0 var(--sp-3); font-size: var(--fs-md); }
+.nft-table + .nft-table { margin-top: var(--sp-6); }
+.nft-chain {
+	margin: 0 0 var(--sp-4);
