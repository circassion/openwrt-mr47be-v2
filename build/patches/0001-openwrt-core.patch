+				reason: _('%s of %s').format(fmt.bytes(mem.available), fmt.bytes(mem.total)),
+				detail: _('%s of %s available (%s in use)').format(fmt.bytes(mem.available), fmt.bytes(mem.total), fmt.pct(mem.usedPct)), page: PAGES.processes });
+		}
