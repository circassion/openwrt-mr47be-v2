+'require view';
+'require fs';
+'require ui';
+
+return view.extend({
+	load: function() {
+		return fs.exec('/usr/sbin/mr47be-boot', [ 'status' ])
+			.then(function(res) {
+				return (res.stdout || '').trim();
+			})
+			.catch(function() {
+				return '';
+			});
+	},
+
+	run: function(action, title, question) {
+		if (!confirm(question))
+			return Promise.resolve();
+
+		ui.showModal(title, [
+			E('p', { 'class': 'spinning' }, _('Please wait…'))
+		]);
+
+		return fs.exec('/usr/sbin/mr47be-boot', [ action ])
+			.then(function(res) {
+				ui.hideModal();
+				var ok = (res.code === 0);
+				var text = ((ok ? res.stdout : res.stderr) || '').trim() ||
+					(ok ? _('Done.') : _('Command failed.'));
+				ui.addNotification(null, E('p', {}, text), ok ? 'info' : 'danger');
+				if (ok && action === 'stock')
+					ui.addNotification(null, E('p', {},
+						_('The device is rebooting. The connection will drop.')), 'warning');
+			})
+			.catch(function(e) {
+				ui.hideModal();
+				ui.addNotification(null, E('p', {}, e.message || String(e)), 'danger');
+			});
+	},
+
+	render: function(status) {
+		var idx = (status.match(/tp_boot_idx=(\d+)/) || [])[1];
+		var current = idx === '0' ? _('Stock firmware (Mercusys)')
+			: idx === '1' ? _('OpenWrt')
+			: _('Unknown');
+
+		var table = E('table', { 'class': 'table' }, [
+			E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td', 'width': '33%' }, _('Current boot target')),
+				E('td', { 'class': 'td' }, E('strong', {}, current))
+			]),
+			E('tr', { 'class': 'tr' }, [
+				E('td', { 'class': 'td' }, _('Raw value')),
+				E('td', { 'class': 'td' }, E('code', {}, status || '—'))
+			])
+		]);
+
+		var buttons = E('div', { 'class': 'cbi-page-actions' }, [
+			E('button', {
+				'class': 'btn cbi-button cbi-button-negative',
+				'click': ui.createHandlerFn(this, function() {
+					return this.run('stock', _('Switch to stock'),
+						_('The device will boot the stock firmware and restart. Continue?'));
+				})
+			}, _('Switch to stock')),
+
+			' ',
+
+			E('button', {
+				'class': 'btn cbi-button cbi-button-positive',
+				'click': ui.createHandlerFn(this, function() {
+					return this.run('openwrt', _('Select OpenWrt'),
+						_('OpenWrt will be selected for the next boot. Continue?'));
+				})
+			}, _('Select OpenWrt'))
+		]);
+
+		return E([
+			E('h2', {}, _('Boot selector')),
+			E('div', { 'class': 'cbi-map-descr' }, [
+				E('p', {}, _('This device holds two firmwares: stock (mtd12) and OpenWrt (mtd13). ' +
+					'A U-Boot variable decides which one boots.')),
+				E('p', {}, _('Holding the reset button for 20 seconds also returns to stock. ' +
+					'This page is for when the button is broken or you have no UART access.'))
+			]),
+			table,
+			buttons,
+			E('h3', {}, _('Stock backup and restore (SSH)')),
+			E('div', { 'class': 'cbi-map-descr' }, [
+				E('p', {}, _('To back up the stock partition:')),
+				E('pre', {}, 'mr47be-backup /tmp/stock.ubi'),
+				E('p', {}, _('To write a backup back after the stock partition got damaged:')),
+				E('pre', {}, 'mr47be-restore /tmp/stock.ubi --yes')
+			])
+		]);
+	}
+});
diff --git a/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-backup b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-backup
new file mode 100755
index 0000000..f96eb6a
--- /dev/null
+++ b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-backup
@@ -0,0 +1,62 @@
+#!/bin/sh
+# mr47be-backup - take a full backup of the stock partition ("ubi")
+#
+# Usage:
+#   mr47be-backup                 create /tmp/stock-YYYYmmdd-HHMMSS.ubi
+#   mr47be-backup /tmp/stock.ubi  write to the given path
+#
+# The resulting file can be written back with mr47be-restore.
+# The backup reads the whole partition without OOB (data only); UBI images are
+# sequential from the start, so this file is valid.
+#
+# Important: copy the backup OFF the device (USB / scp / HTTP).
+# /tmp is RAM and is wiped on reboot.
+
+set -e
+
+OUT="$1"
+[ -n "$OUT" ] || OUT="/tmp/stock-$(date +%Y%m%d-%H%M%S).ubi"
+
+MTDNUM=$(awk '/"ubi"/ { sub(":.*", "", $1); sub("mtd", "", $1); print $1 }' /proc/mtd)
+[ -n "$MTDNUM" ] || { echo "ERROR: partition '\"ubi\"' not found" >&2; cat /proc/mtd >&2; exit 1; }
+DEV="/dev/mtd${MTDNUM}"
+
+PEB=131072
+PART_SIZE=$(cat "/sys/class/mtd/mtd${MTDNUM}/size" 2>/dev/null || echo 0)
+[ "$PART_SIZE" -gt 0 ] || { echo "ERROR: could not read partition size" >&2; exit 1; }
+PART_PEB=$((PART_SIZE / PEB))
+
+echo "Source : $DEV (stock partition, mtd${MTDNUM})"
+echo "Size   : $PART_SIZE bytes ($PART_PEB PEB)"
+echo "Target : $OUT"
+echo "Reading... (a few minutes)"
+
+nanddump --omitoob -f "$OUT" "$DEV"
+
+SIZE=$(wc -c < "$OUT")
+echo "Written: $SIZE bytes"
+if [ $((SIZE % PEB)) -eq 0 ]; then
+	echo "Align  : OK (multiple of $PEB)"
+else
+	echo "WARNING: size is not a multiple of $PEB" >&2
+fi
+
+HASH=$(sha256sum "$OUT" 2>/dev/null | awk '{print $1}')
+[ -n "$HASH" ] || HASH=$(md5sum "$OUT" | awk '{print $1}')
+
+# Short info file: for comparison when restoring
+{
+	echo "partition=mtd${MTDNUM}"
+	echo "size=$SIZE"
+	echo "peb=$PEB"
+	echo "sha256=$HASH"
+	echo "date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$OUT.info"
+
+echo
+echo "SHA256 : $HASH"
+echo "Info   : $OUT.info"
+echo
+echo "DONE. Keep this file in a safe place off the device."
+echo "To write it back:"
+echo "  mr47be-restore $OUT --yes"
diff --git a/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-boot b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-boot
new file mode 100755
index 0000000..117791d
--- /dev/null
+++ b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-boot
@@ -0,0 +1,94 @@
+#!/bin/sh
+# mr47be-boot - Mercusys MR47BE v2 boot selector
+#
+# Usage:
+#   mr47be-boot status            print the current target
+#   mr47be-boot stock             return to stock firmware (tp_boot_idx=0) + reboot
+#   mr47be-boot stock --no-reboot only mark, do not reboot
+#   mr47be-boot openwrt           mark OpenWrt (tp_boot_idx=1)
+#   mr47be-boot toggle            switch the target + reboot
+#
+# tp_boot_idx is kept in the U-Boot environment on mtd8 ("0:appsblenv").
+# Writing requires /etc/fw_env.config (present in the image).
+
+set -e
+
+CMD="$1"
+OPT="$2"
+
+usage() {
+	cat <<EOF
+Usage: mr47be-boot <command>
+
+  status              show the current boot target
+  stock [--no-reboot] return to stock firmware (tp_boot_idx=0)
+  openwrt             target OpenWrt (tp_boot_idx=1)
+  toggle              switch the target and reboot
+
+Example:
+  mr47be-boot stock
+EOF
+}
+
+need_env() {
+	[ -f /etc/fw_env.config ] || {
+		echo "ERROR: /etc/fw_env.config missing (cannot write without fw_env.config)" >&2
+		exit 1
+	}
+	command -v fw_setenv >/dev/null 2>&1 || {
+		echo "ERROR: fw_setenv not found (uboot-envtools not installed)" >&2
+		exit 1
+	}
+}
+
+cur_idx() {
+	fw_printenv -n tp_boot_idx 2>/dev/null || echo "?"
+}
+
+write_idx() {
+	need_env
+	if ! fw_setenv tp_boot_idx "$1"; then
+		echo "ERROR: could not write tp_boot_idx=$1" >&2
+		exit 1
+	fi
+	sync
+}
+
+case "$CMD" in
+status)
+	IDX="$(cur_idx)"
+	case "$IDX" in
+	0) NAME="stock firmware" ;;
+	1) NAME="OpenWrt" ;;
+	*) NAME="unknown" ;;
+	esac
+	echo "tp_boot_idx=$IDX ($NAME)"
+	;;
+
+stock)
+	write_idx 0
+	echo "OK: tp_boot_idx=0 (stock firmware). Rebooting..."
+	[ "$OPT" = "--no-reboot" ] && { echo "(reboot skipped)"; exit 0; }
+	sleep 1
+	reboot
+	;;
+
+openwrt)
+	write_idx 1
+	echo "OK: tp_boot_idx=1 (OpenWrt). OpenWrt will be selected on the next boot."
+	;;
+
+toggle)
+	IDX="$(cur_idx)"
+	if [ "$IDX" = "0" ]; then write_idx 1; echo "OK: OpenWrt selected.";
+	elif [ "$IDX" = "1" ]; then write_idx 0; echo "OK: stock selected.";
+	else echo "ERROR: could not read the current value" >&2; exit 1; fi
+	sleep 1
+	reboot
+	;;
+
+*)
+	usage
+	exit 1
+	;;
+esac
diff --git a/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-restore b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-restore
new file mode 100755
index 0000000..405371a
--- /dev/null
+++ b/package/luci/luci-app-mr47be-boot/root/usr/sbin/mr47be-restore
@@ -0,0 +1,146 @@
+#!/bin/sh
+# mr47be-restore - write a stock UBI image back to NAND (no UART needed)
+#
+# Usage:
+#   mr47be-restore /tmp/stock.ubi --yes
+#   mr47be-restore /tmp/stock.ubi --yes --no-reboot
+#
+# What it does:
+#   1) Find the target partition: the mtd labelled "ubi" (stock firmware, mtd12).
+#      The OpenWrt partition (rootfs_1 / mtd13) is NEVER written.
+#   2) Detach the partition from UBI if attached (ubidetach).
+#   3) Write the image with ubiformat (skips bad blocks correctly).
+#   4) Re-attach UBI and show the volume list.
+#   5) Set tp_boot_idx=0 (select stock) and reboot.
+#
+# WARNING: if power is lost during the write the STOCK firmware is corrupted.
+# OpenWrt (rootfs_1) lives on a separate partition, so the device still boots;
+# you can repair it by running this again.
+
+set -e
+
+FILE="$1"
+[ -n "$FILE" ] || {
+	echo "Usage: mr47be-restore <stock.ubi> --yes [--no-reboot]" >&2
+	exit 1
+}
+shift || true
+
+YES=0
+REBOOT=1
+for a in "$@"; do
+	case "$a" in
+	--yes|-y) YES=1 ;;
+	--no-reboot) REBOOT=0 ;;
+	*) echo "Unknown option: $a" >&2; exit 1 ;;
+	esac
+done
+
+[ -f "$FILE" ] || { echo "ERROR: file not found: $FILE" >&2; exit 1; }
+
+PEB=131072
+SIZE=$(wc -c < "$FILE")
+[ "$SIZE" -gt 0 ] || { echo "ERROR: file is empty" >&2; exit 1; }
+
+MAGIC=$(dd if="$FILE" bs=4 count=1 2>/dev/null || true)
+[ "$MAGIC" = "UBI#" ] || {
+	echo "ERROR: file is not a UBI image (first 4 bytes must be 'UBI#', found: '$MAGIC')" >&2
+	echo "       Use a backup taken with mr47be-backup." >&2
+	exit 1
+}
+
+if [ $((SIZE % PEB)) -ne 0 ]; then
+	echo "WARNING: size $SIZE is not a multiple of PEB ($PEB); the tail will be trimmed" >&2
+fi
+
+MTDNUM=$(awk '/"ubi"/ { sub(":.*", "", $1); sub("mtd", "", $1); print $1 }' /proc/mtd)
+[ -n "$MTDNUM" ] || {
+	echo "ERROR: no mtd partition labelled '\"ubi\"'. /proc/mtd:" >&2
+	cat /proc/mtd >&2
+	exit 1
+}
+
+PART_SIZE=$(cat "/sys/class/mtd/mtd${MTDNUM}/size" 2>/dev/null || echo 0)
+DEV="/dev/mtd${MTDNUM}"
+
+# Safety 1: the target must not be the UBI partition of the running system
+# (kernel cmdline: ubi.mtd=rootfs_1 -> the OpenWrt partition)
+BOOT_MTD=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^ubi\.mtd=//p' | head -1)
+if [ -n "$BOOT_MTD" ]; then
+	case "$BOOT_MTD" in
+	''|*[!0-9]*)
+		BOOT_NUM=$(awk -v n="$BOOT_MTD" '
+			{ name=$4; gsub(/"/, "", name);
+			  if (name == n) { x=$1; sub(":", "", x); sub("mtd", "", x); print x } }
+		' /proc/mtd | head -1)
+		;;
+	*)
+		BOOT_NUM="$BOOT_MTD"
+		;;
+	esac
+	if [ -n "$BOOT_NUM" ] && [ "$BOOT_NUM" = "$MTDNUM" ]; then
+		echo "ERROR: mtd${MTDNUM} is the running OpenWrt partition (ubi.mtd=$BOOT_MTD)." >&2
+		echo "       This script only writes the stock partition (\"ubi\")." >&2
+		exit 1
+	fi
+fi
+
+# Safety 2: warn if the image is larger than the partition (it will be trimmed)
+if [ -n "$PART_SIZE" ] && [ "$PART_SIZE" -gt 0 ] && [ "$SIZE" -gt "$PART_SIZE" ]; then
+	echo "WARNING: image ($SIZE B) is larger than the partition ($PART_SIZE B); it will be trimmed" >&2
+fi
+
+echo "Target : $DEV (stock partition, label \"ubi\")"
+if [ -n "$PART_SIZE" ] && [ "$PART_SIZE" -gt 0 ]; then
+	echo "Part   : $PART_SIZE bytes ($((PART_SIZE / PEB)) PEB)"
+fi
+echo "File   : $FILE ($SIZE bytes, $((SIZE / PEB)) PEB)"
+
+if [ "$YES" != "1" ]; then
+	echo
+	echo "This command will ERASE and rewrite the stock partition."
+	echo "To continue, append --yes:"
+	echo "  mr47be-restore $FILE --yes"
+	exit 1
+fi
+
+# 1) Detach if attached
+if ubidetach -m "$MTDNUM" 2>/dev/null; then
+	echo "1/4 UBI detached (mtd${MTDNUM})"
+else
+	echo "1/4 UBI was not attached"
+fi
+
+# 2) Write
+echo "2/4 writing... (a few minutes)"
+ubiformat "$DEV" -y -f "$FILE"
+
+# 3) Re-attach and show
+echo "3/4 checking..."
+if ubiattach -m "$MTDNUM" >/tmp/mr47be-attach.log 2>&1; then
+	UBINUM=$(awk '{print $NF}' /tmp/mr47be-attach.log | tail -1)
+	[ -n "$UBINUM" ] && ubinfo -d "$UBINUM" 2>/dev/null | sed -n '1,12p'
+	ubinfo -a 2>/dev/null | grep -E 'Name|Volume [0-9]|Size' | head -20
+else
+	echo "WARNING: UBI could not be re-attached; the stock may still have been written." >&2
+	cat /tmp/mr47be-attach.log >&2 || true
+fi
+rm -f /tmp/mr47be-attach.log
+
+# 4) Select stock
+if [ -f /etc/fw_env.config ] && command -v fw_setenv >/dev/null 2>&1; then
+	fw_setenv tp_boot_idx 0 && echo "4/4 tp_boot_idx=0 (stock selected)"
+else
+	echo "4/4 WARNING: fw_setenv missing; run 'setenv tp_boot_idx 0; saveenv' from U-Boot" >&2
+fi
+
+sync
+echo "DONE: stock partition written."
+
+if [ "$REBOOT" = "1" ]; then
+	echo "Rebooting..."
+	sleep 2
+	reboot
+else
+	echo "(reboot skipped)"
+fi
