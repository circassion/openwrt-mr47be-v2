+/* -------------------------------------------------------------- 2. base */
+
+.vt-app .vt-body { container: vt / inline-size; }
+.vt-app {
+	color: var(--vt-text);
+	font-family: var(--vt-font);
+	font-size: var(--vt-fs-base);
