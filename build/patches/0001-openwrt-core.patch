diff --git a/package/firmware/mr47be-wifi-cal/files/13-mr47be-fwram-sampler b/package/firmware/mr47be-wifi-cal/files/13-mr47be-fwram-sampler
new file mode 100644
index 0000000..35b6f00
--- /dev/null
+++ b/package/firmware/mr47be-wifi-cal/files/13-mr47be-fwram-sampler
@@ -0,0 +1,19 @@
+#!/bin/sh
+# test033: arm the read-only FW-RAM sampler on the first IPQ5332 firmware request.
+#
+# rc.d S* scripts run only after kmodloader finishes (~14.49 s measured), which is
+# AFTER the firmware fatal (~14.56 s). The firmware hotplug path is proven to run at
+# 13.24 s (that is where the caldata12: lines come from), so it is the earliest
+# userspace hook available. Backgrounded + guarded, so it never blocks a firmware
+# load and never starts a second sampler.
+
+# Disabled by default. Single switch:
+#   touch /tmp/mr47be_diag_on
+[ -e /tmp/mr47be_diag_on ] || exit 0
+
+case "$FIRMWARE" in
+ath12k/IPQ5332/*)
+	( /usr/sbin/mr47be-fwram-sampler ) &
+	;;
+esac
+exit 0
