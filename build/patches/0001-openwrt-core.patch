+	:is(.vt-main, .modal) .table .tr > .td[data-title]:empty { display: none; }
+	/* LuCI's wide columns (col-7 and up: a package's description, a
+	   connection's addresses) take the card's width */
+	:is(.vt-main, .modal) .table .tr > .td[data-title]:is(.col-7, .col-8, .col-9, .col-10) { flex-basis: 100%; }
+	#connections .tr:not(.table-titles) > .td:is(:nth-child(3), :nth-child(4)) { white-space: normal; overflow-wrap: anywhere; }
+	/* a zone and its forwards read across the card */
+	#cbi-firewall-zone .tr > .td:has(.zone-forwards) { flex-basis: 100%; }
+	/* LuCI 24.10: a named row's drawn name heads its card */
+	.table:has(.cbi-section-table-titles.named[data-title]) .cbi-section-table-row[data-title]:not(:has(> .cbi-section-table-titles))::before {
+		display: block; flex: 1 1 100%;
+		padding: 4px var(--card-px); border: 0;
+		font-weight: 600;
+	}
+	[id^="cbi-firewall-"] .table:has(.cbi-section-table-titles.named[data-title]) .cbi-section-table-row[data-title]:has(input[data-widget-id$=".enabled"])::before { padding-right: calc(var(--card-px) + 40px); }
+	.table:has(.cbi-section-table-titles.named[data-title]) .cbi-section-table-row[data-title]:hover::before { background: none; }
+	/* nftables rule cards: LuCI's !important cell padding, on the card's edge */
+	#view .nft-rules .tr > .td, #view .nft-rules .tr > .td:is(:first-child, :last-child) { padding: 3px var(--card-px) !important; }
+	/* firewall flow: a step's verdict goes under its text */
+	.v-nft-step { grid-template-columns: 20px minmax(0, 1fr); }
+	.v-nft-then { grid-column: 2; align-items: flex-start; }
+	.v-nft-sub { grid-column: 1 / -1; }
+	/* log filters: each field on its own line under its label */
+	#content_syslog > div > :is(select, input:not([type="checkbox"])) { flex: 1 1 100%; }
+	#content_syslog > div > :is(select, input:not([type="checkbox"])) + label { margin-left: 0 !important; }
+	/* read-only output (logs, Diagnostics) wraps instead of showing each
+	   line's first 40 characters (LuCI: wrap="off", inline white-space) */
+	.vt-main textarea[readonly] { white-space: pre-wrap !important; overflow-wrap: anywhere; }
+	.cbi-progressbar { max-width: none; }
+	.network-status-table > .ifacebox { max-width: none; }
+
+	#modal_overlay { padding: var(--sp-3); }
+	#modal_overlay > .modal { padding: var(--sp-4); }
+	#modal_overlay > .modal > h4:first-child { margin: calc(-1 * var(--sp-4)) calc(-1 * var(--sp-4)) var(--sp-3); padding: var(--sp-3) var(--sp-4); }
+	#modal_overlay > .modal .cbi-page-actions, #modal_overlay > .modal > .right, #modal_overlay > .modal > .button-row {
+		margin: var(--sp-4) calc(-1 * var(--sp-4)) calc(-1 * var(--sp-4)); padding: var(--sp-3) var(--sp-4);
+	}
+	.vt-pal-overlay { padding: var(--sp-3); align-items: flex-start; }
+	.vt-pal { max-height: 80vh; }
+	.vt-pal-foot > span:not(.vt-pal-count) { display: none; }
+}
+
+/* touch, at any width: 16px text in fields (iOS zooms below that),
+   bigger check marks, a little more air between rows */
+@media (pointer: coarse), (max-width: 720px) {
+	.vt-main input, .vt-main select, .vt-main textarea:not([readonly]), .cbi-dropdown:not(.btn, .cbi-button), .modal input, .modal select { font-size: 16px !important; }
+}
+@media (pointer: coarse) {
+	input[type="checkbox"], input[type="radio"] { width: 20px; height: 20px; }
+	/* top-bar buttons: a touch control high, at every width */
+	.vt-icon-btn, .vt-search { min-width: var(--ctl-h); height: var(--ctl-h); }
+	/* short row buttons (Processes' Kill) at least as wide as they are high */
+	.td.cbi-section-actions :is(.btn, .cbi-button):not(.drag-handle) { min-width: var(--ctl-h); }
+	/* dropdown choices (Save & Apply's too) are touch targets */
+	.cbi-dropdown[open] > ul.dropdown > li, .vt-actmenu-item { min-height: var(--ctl-h); }
+	.cbi-value { padding: 8px 0; }
+}
+
+/* ----------------------------------------------------------- motion */
+
+/* phones: content in cards wraps instead of pushing the card wider */
+@media (max-width: 720px) {
+	.td .ifacebadge:not(.cbi-tooltip), .td.nowrap, .td .nowrap,
+	.td > span:has(> span + br + span) > span { white-space: normal; }
+	.td.cbi-section-actions, .td.cbi-section-actions.nowrap { flex-basis: 100% !important; width: auto !important; min-width: 0 !important; white-space: normal; }
+	.td.cbi-section-actions > div:not(.btn, .cbi-button) { display: flex; flex-wrap: wrap; justify-content: flex-start; }
+	.cbi-value-field > div[id$="-ifc-description"] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
+	.v-meter-rows { grid-template-columns: minmax(0, 1fr); gap: 14px; }
+	.v-meter-row { grid-template-areas: "label" "bar" "val"; row-gap: 6px; }
+	.v-meter-row > .v-meter-val { text-align: left; white-space: normal; }
+	.v-meter-row > .v-meter-label small { display: inline; margin-left: 6px; }
+	/* Software: "Actions" is one group of three buttons; it ran past the
+	   card and widened the page. Groups of buttons only wrap here. */
+	:is(#view > .controls, #view > .cbi-section > .controls) > div > .control-group:not(:has(> input, > select, > .cbi-dropdown)) { flex-wrap: wrap; gap: var(--sp-2); }
+	:is(#view > .controls, #view > .cbi-section > .controls) > div > .control-group:not(:has(> input, > select, > .cbi-dropdown)) > * { flex: 1 1 auto; margin-left: 0 !important; border-radius: var(--r-sm) !important; }
+	/* a package's dependency tree: less indent per level */
+	#modal_overlay ul.deps { padding-left: var(--sp-2); }
+}
+/* Software, a package's details: a dependency line (name, size, status)
+   doesn't wrap in LuCI's own stylesheet; a few levels deep it ran past the
+   dialog and left the ↳ alone on its line */
+#modal_overlay ul.deps li > span { white-space: normal; overflow-wrap: anywhere; }
+#modal_overlay ul.deps li > span > .label { white-space: nowrap; }
+
+@media (prefers-reduced-motion: reduce) {
+	*, *::before, *::after {
+		animation-duration: .001ms !important;
+		animation-iteration-count: 1 !important;
+		scroll-behavior: auto !important;
+	}
+	.spinning::before, #modal_overlay > .modal::before { animation-duration: 1.6s !important; animation-iteration-count: infinite !important; }
+	.alert-message { transition-duration: .01s; }
+	/* ui.Dropdown moves focus on transitionend: keep a (near-instant) transition */
+	.cbi-dropdown[open] > ul.dropdown { transition-duration: .001s; }
+	.cbi-progressbar > div { transition: none; }
+	.vt-crumb-switch > svg, .vt-rail-caret, .vt-rail-pin svg { transition: none; }
+	.v-nft-card > summary::before, .v-nft-jump::after { transition: none; }
+}
+
+@media print {
+	.vt-rail, .vt-flyout, .vt-topbar, .vt-tabs, .cbi-page-actions, .vt-foot, body.vt-auth .vt-shell::before { display: none !important; }
+	.vt-frame { margin: 0 !important; }
+}
