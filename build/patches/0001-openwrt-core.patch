diff --git a/package/luci/luci-theme-vantage/htdocs/luci-static/vantage/vantage.css b/package/luci/luci-theme-vantage/htdocs/luci-static/vantage/vantage.css
new file mode 100644
index 0000000..1bab76e
--- /dev/null
+++ b/package/luci/luci-theme-vantage/htdocs/luci-static/vantage/vantage.css
@@ -0,0 +1,3606 @@
+/*
+ * Vantage - a LuCI theme
+ * A precise, dark-first technical console for LuCI 25.12.
+ *
+ *  1. Tokens            5. Content: map, section, option rows
+ *  2. Base              6. Widgets: inputs, buttons, dropdown, dynlist
+ *  3. Shell             7. Tables, tabs, badges, feedback, modal
+ *  4. Palette           8. Login, responsive, motion
+ */
+
+/* ------------------------------------------------------------ 1. tokens */
+
+:root {
+	color-scheme: light;
+
+	--font: system-ui, -apple-system, "Segoe UI", Roboto, Inter, "Helvetica Neue", Arial, sans-serif;
+	--mono: ui-monospace, "JetBrains Mono", "SFMono-Regular", "Cascadia Mono", Menlo, Consolas, monospace;
+
+	--fs-micro: 10.5px;
+	--fs-sm: 12px;
+	--fs-base: 13px;
+	--fs-md: 14px;
+	--fs-lg: 16px;
+	--fs-xl: 20px;
+	--fs-2xl: 24px;
+
+	/* spacing: steps of 4px, with 2px and 6px for tight insides */
+	--sp-0-5: 2px;
+	--sp-1: 4px;
+	--sp-1-5: 6px;
+	--sp-2: 8px;
+	--sp-3: 12px;
+	--sp-4: 16px;
+	--sp-5: 20px;
+	--sp-6: 24px;
+	--sp-8: 32px;
+
+	/* font weights: four steps only (static fonts draw 620-680 as bold) */
+	--fw-regular: 400;
+	--fw-medium: 500;
+	--fw-semibold: 600;
+	--fw-bold: 700;
+
+	/* radii: bars, small controls, controls, cards, large icon tiles
+	   (pills are 999px, dots 50%) */
+	--r-xs: 2px;
+	--r-sm: 4px;
+	--r: 6px;
+	--r-lg: 8px;
+	--r-xl: 12px;
+
+	--rail-w: 56px;
+	--rail-w-pinned: 224px;
+	--top-h: 52px;
+	--ctl-h: 36px;              /* every control: inputs, selects, buttons, tabs, chips */
+	--label-w: 180px;           /* form label column */
+	--field-max: 360px;         /* widest single-line field */
+	--content-max: 1320px;      /* content column, on windows up to ~1920px */
+	--content-wide: 2400px;     /* wider windows: the column grows to this */
+	/* the column's width with its padding: grows with the window past
+	   1920px, ~200px clear each side, so 2K and 4K screens at 100% fill */
+	--main-max: clamp(calc(var(--content-max) + 2 * var(--sp-6)), 100% - 400px, calc(var(--content-wide) + 2 * var(--sp-6)));
+
+	/* light: cool paper grey, olive accent text */
+	--bg: #e9ecef;
+	--bg-rail: #f4f5f7;
+	--s1: #f8f9fa;
+	--s2: #ffffff;
+	--s3: #eef0f3;
+	--s4: #e1e4e8;
+	--line: #d6dade;
+	--line-2: #c1c7ce;
+	--text: #14171a;
+	--text-2: #4a515a;
+	--text-3: #5f666f;
+	--accent: #c8f031;
+	--accent-hover: #b9e421;
+	--accent-ink: #151b00;
+	--accent-text: #4b6600;
+	--accent-soft: rgba(122, 163, 0, .13);
+	--accent-line: #8db20f;
+	--focus: #4b6600;
+	--ok: #0b7f6c;
+	--ok-soft: rgba(11, 127, 108, .11);
+	--warn: #9a5b00;
+	--warn-soft: rgba(214, 138, 0, .15);
+	--err: #c42b2b;
+	--err-soft: rgba(196, 43, 43, .1);
+	--err-ink: #ffffff;         /* text on an --err / --info fill, >= 4.5:1 */
+	--warn-ink: #ffffff;        /* text on a --warn fill (counts, warning tooltips); #1a1200 was 3.4:1 */
+	--info: #1c64c4;
+	--info-ink: #ffffff;
+	--ok-text: #0a7262;         /* --ok as text on control fills (s3, s4) */
+	/* red, blue and amber as text on their own soft fill, which a hovered
+	   row darkens: >= 4.5:1 there too (--err itself was 4.4:1) */
+	--err-text: #b02525;
+	--info-text: #1a5cb5;
+	--warn-text: #875000;
+	--info-soft: rgba(28, 100, 196, .1);
+	--scrim: rgba(20, 23, 26, .38);
+	--shadow-pop: 0 12px 32px rgba(20, 23, 26, .16), 0 2px 6px rgba(20, 23, 26, .08);
+	--zone-mix: .22;
+	--seg-bg: var(--s3);        /* segmented control: track, selected segment and its ring */
+	--seg-on: var(--s2);
+	--seg-on-ring: inset 0 0 0 1px var(--accent-line);   /* inset: drawn at the segment's padding edge */
+}
+
+html[data-darkmode="true"] {
+	color-scheme: dark;
+
+	/* dark: charcoal neutrals, cool grey steps, lime signal */
+	--bg: #0d0e10;
+	--bg-rail: #111214;
+	--s1: #15171a;
+	--s2: #1b1d21;
+	--s3: #22252a;
+	--s4: #2b2f35;
+	--line: #262a2f;
+	--line-2: #353a41;
+	--text: #e8eaed;
+	--text-2: #a9afb7;
+	--text-3: #8a9099;
+	--accent: #c8f031;
+	--accent-hover: #d6fb4c;
+	--accent-ink: #141a00;
+	--accent-text: #c8f031;
+	--accent-soft: rgba(200, 240, 49, .1);
+	--accent-line: rgba(200, 240, 49, .5);
+	--focus: #c8f031;
+	--ok: #2dd4bf;
+	--ok-soft: rgba(45, 212, 191, .12);
+	--warn: #f5b84a;
+	--warn-soft: rgba(245, 184, 74, .13);
+	--err: #ff6b6b;
+	--err-soft: rgba(255, 107, 107, .12);
+	--err-ink: #1a0505;         /* white on the light dark-mode red was 2.8:1 */
+	--warn-ink: #1a1200;
+	--info: #6cb4ff;
+	--info-ink: #0d0e10;
+	--ok-text: var(--ok);
+	--err-text: var(--err);
+	--info-text: var(--info);
+	--warn-text: var(--warn);
+	--info-soft: rgba(108, 180, 255, .12);
+	--scrim: rgba(0, 0, 0, .58);
+	--shadow-pop: 0 16px 40px rgba(0, 0, 0, .55), 0 0 0 1px rgba(255, 255, 255, .02);
+	--zone-mix: .2;
+	--seg-bg: var(--bg);
+	--seg-on: var(--s3);
+}
+
+/* touch: controls are sized by the pointer, not the screen width */
+@media (pointer: coarse) {
+	:root { --ctl-h: 44px; }
+}
+
+/* Shared Vantage tokens (--v-*): the stable contract other Vantage views
+   (the dashboard app) style against, mapped onto this theme's palette.
+   --v-accent is always legible as text/strokes on --v-surface*; it is a
+   fill only together with --v-accent-ink. */
+:root {
+	--v-bg: var(--bg);
+	--v-surface: var(--s1);
+	--v-surface-2: var(--s2);
+	--v-surface-3: var(--s3);
+	--v-line: var(--line);
+	--v-line-2: var(--line-2);
+	--v-text: var(--text);
+	--v-text-2: var(--text-2);
+	--v-text-3: var(--text-3);
+	--v-accent: var(--accent-text);      /* olive: lime is unreadable on light */
+	--v-accent-ink: #ffffff;
+	--v-accent-soft: var(--accent-soft);
+	/* the accent by role, as the theme's own controls use it: text and
+	   icons; borders, rings and selection bars; the lime fill of primary
+	   buttons and pressed picks with its ink */
+	--v-accent-text: var(--accent-text);
+	--v-accent-line: var(--accent-line);
+	--v-accent-fill: var(--accent);
+	--v-accent-fill-hover: var(--accent-hover);
+	--v-accent-fill-ink: var(--accent-ink);
+	--v-ok: var(--ok);
+	--v-ok-soft: var(--ok-soft);
+	--v-warn: var(--warn);
+	--v-warn-soft: var(--warn-soft);
+	--v-err: var(--err);
+	--v-err-soft: var(--err-soft);
+	--v-info: var(--info);
+	--v-info-soft: var(--info-soft);
+	/* status colours as text on their soft fill, >= 4.5:1 on a hovered row too */
+	--v-ok-text: var(--ok-text);
+	--v-warn-text: var(--warn-text);
+	--v-err-text: var(--err-text);
+	--v-info-text: var(--info-text);
+	--v-focus: var(--focus);             /* a focused field: border plus a 1px ring of it */
+	--v-scrim: var(--scrim);             /* under dialogs, drawers and sheets */
+	--v-seg-bg: var(--seg-bg);           /* segmented control: track, selected segment, its ring */
+	--v-seg-on: var(--seg-on);
+	--v-seg-on-ring: var(--seg-on-ring);
+	--v-hover: color-mix(in srgb, var(--s3) 55%, transparent);   /* a hovered row on a card */
+	--v-surface-4: var(--s4);            /* a hovered item in a menu (menus are --v-surface-2) */
+	--v-meter: var(--info);              /* memory and storage bars: blue (lime is download) */
+	--v-card-px: var(--card-px);         /* card insides: 20 / 16px, 14px on phones */
+	--v-card-py: var(--card-py);
+	--v-sp-0-5: var(--sp-0-5);           /* spacing: 2 4 6 8 12 16 20 24 32 px */
+	--v-sp-1: var(--sp-1);
+	--v-sp-1-5: var(--sp-1-5);
+	--v-sp-2: var(--sp-2);
+	--v-sp-3: var(--sp-3);
+	--v-sp-4: var(--sp-4);
+	--v-sp-5: var(--sp-5);
+	--v-sp-6: var(--sp-6);
+	--v-sp-8: var(--sp-8);
+	--v-fw-regular: var(--fw-regular);   /* weights: 400 500 600 700 */
+	--v-fw-medium: var(--fw-medium);
+	--v-fw-semibold: var(--fw-semibold);
+	--v-fw-bold: var(--fw-bold);
+	--v-font: var(--font);
+	--v-mono: var(--mono);
+	--v-fs-micro: var(--fs-micro);       /* the type scale: 10.5 12 13 14 16 20 24 px */
+	--v-fs-sm: var(--fs-sm);
+	--v-fs-base: var(--fs-base);
+	--v-fs-md: var(--fs-md);
+	--v-fs-lg: var(--fs-lg);
+	--v-fs-xl: var(--fs-xl);
+	--v-fs-2xl: var(--fs-2xl);
+	--v-r-xs: var(--r-xs);               /* radii: 2 4 6 8 12 px */
+	--v-r-sm: var(--r-sm);
+	--v-r: var(--r);
+	--v-r-lg: var(--r-lg);
+	--v-r-xl: var(--r-xl);
+	--v-ctl-h: var(--ctl-h);             /* every control: 36px, 44px on touch */
+	--v-shadow: 0 1px 2px rgba(20, 23, 26, .06), 0 1px 0 rgba(20, 23, 26, .03);
+	--v-shadow-raise: 0 6px 16px rgba(20, 23, 26, .08);   /* a card lifted under the pointer */
+	--v-shadow-pop: var(--shadow-pop);   /* lists and menus that open over the page */
+	/* the dashboard's drawer and its scrim: over the rail and the top bar
+	   (300), under modals (1000) and menus (1100) */
+	--v-z-drawer: 890;
+	/* where sticky content may start: below the top bar (page tabs scroll) */
+	--v-stick-top: var(--stick-top);
+
+	/* charts (stock realtime graphs, channel analysis, the dashboard app).
+	   Categorical, fixed order, never cycled by rank: lime (the accent, series 1
+	   only), blue, orange, cyan, violet, magenta. Validated as a set against the
+	   card surface in both modes (adjacent-pair CVD dE >= 9.8, normal-vision
+	   dE >= 18, >= 3:1 contrast); only the dark lime sits above the lightness
+	   band, on purpose, as the brand signal. */
+	--v-chart-1: #6f9c00;
+	--v-chart-2: #2a78d6;
+	--v-chart-3: #e0632f;
+	--v-chart-4: #0f9fb0;
+	--v-chart-5: #8b5cf6;
+	--v-chart-6: #d55181;
+	--v-chart-grid: color-mix(in srgb, var(--text) 8%, transparent);
+	--v-chart-axis: var(--text-3);
+	--v-chart-fill-opacity: .22;
+}
+html[data-darkmode="true"] {
+	--v-accent: var(--accent);           /* lime signal */
+	--v-accent-ink: var(--accent-ink);
+	--v-shadow: 0 1px 0 rgba(0, 0, 0, .35);
+	--v-shadow-raise: 0 6px 16px rgba(0, 0, 0, .4);
+
+	--v-chart-1: #c8f031;
+	--v-chart-2: #3f8fe8;
+	--v-chart-3: #de6d33;
+	--v-chart-4: #1aa6b8;
+	--v-chart-5: #9a7cf2;
+	--v-chart-6: #d9588c;
+	--v-chart-grid: color-mix(in srgb, var(--text) 7%, transparent);
+	--v-chart-axis: var(--text-3);
+	--v-chart-fill-opacity: .2;
+}
+
+/* -------------------------------------------------------------- 2. base */
+
+*, *::before, *::after { box-sizing: border-box; }
+
+html {
+	-webkit-text-size-adjust: 100%;
+	text-size-adjust: 100%;
+	background: var(--bg);
+}
+
+body {
+	margin: 0;
+	min-height: 100vh;
+	background: var(--bg);
+	color: var(--text);
+	font: 400 var(--fs-base)/1.5 var(--font);
+	font-feature-settings: "cv11", "ss01";
+	-webkit-font-smoothing: antialiased;
+}
+
+[hidden], .hidden { display: none !important; }
+
+a { color: var(--accent-text); text-decoration: none; }
+a:hover { text-decoration: underline; text-underline-offset: 2px; }
+
+:focus { outline: none; }
+:focus-visible {
+	outline: 2px solid var(--focus);
+	outline-offset: 2px;
+	border-radius: var(--r-sm);
+}
+
+h1, h2, h3, h4, h5 { margin: 0 0 var(--sp-3); line-height: 1.25; font-weight: 600; color: var(--text); letter-spacing: -.005em; }
+h2 { font-size: var(--fs-xl); }
+h3 { font-size: var(--fs-md); }
+h4 { font-size: var(--fs-md); }
+h5 { font-size: var(--fs-base); }
+p { margin: 0 0 var(--sp-3); }
+small { font-size: var(--fs-sm); }
+strong, b { font-weight: 600; }
+hr { border: 0; border-top: 1px solid var(--line); margin: var(--sp-4) 0; }
+img { max-width: 100%; vertical-align: middle; }
+
+code, kbd, pre, samp, tt, var, .vt-num {
+	font-family: var(--mono);
+	font-variant-numeric: tabular-nums slashed-zero;
+}
+code { font-size: .92em; padding: 1px 5px; border-radius: var(--r-sm); background: var(--s3); border: 1px solid var(--line); }
+pre {
+	margin: 0 0 var(--sp-3);
+	padding: var(--sp-3);
+	font-size: var(--fs-sm);
+	line-height: 1.55;
+	background: var(--s2);
+	border: 1px solid var(--line);
+	border-radius: var(--r);
+	overflow: auto;
+	white-space: pre-wrap;
+	word-break: break-word;
+}
+pre code { border: 0; padding: 0; background: none; }
+.vt-num { font-size: .96em; letter-spacing: -.01em; }
+
+ul, ol { padding-left: var(--sp-5); }
+
+::selection { background: var(--accent); color: var(--accent-ink); }
+
+.vt-skip {
+	position: absolute; left: var(--sp-2); top: -40px; z-index: 2000;
+	padding: var(--sp-2) var(--sp-3);
+	background: var(--accent); color: var(--accent-ink);
+	border-radius: var(--r); font-weight: 600;
+}
+.vt-skip:focus { top: var(--sp-2); }
+
+/* scrollbars: thin hairline style */
+* { scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
+
+/* ------------------------------------------------------------- 3. shell */
+
+.vt-shell { position: relative; min-height: 100vh; }
+
+/* the rail's column, painted for the full document height: the fixed rail
+   covers the viewport (and scrolls its own list), this keeps the column
+   continuous wherever the page is taller than the viewport - full-page
+   captures, overscroll, print preview */
+body.vt-auth .vt-shell::before {
+	content: "";
+	position: absolute; z-index: 0;
+	top: 0; bottom: 0; left: 0;
+	width: var(--rail-w);
+	background: var(--bg-rail);
+	border-right: 1px solid var(--line);
+	pointer-events: none;
+}
+html[data-rail="pinned"] body.vt-auth .vt-shell::before { width: var(--rail-w-pinned); }
+
+/* brand mark */
+.vt-brand-tile { fill: var(--s2); stroke: var(--line-2); stroke-width: 1; }
+.vt-brand-l, .vt-brand-r { fill: none; stroke-width: 2.6; stroke-linecap: round; }
+.vt-brand-l { stroke: var(--text); }
+.vt-brand-r { stroke: var(--accent-text); }
+.vt-brand-dot { fill: var(--accent-text); }
+html[data-darkmode="true"] .vt-brand-tile { fill: #16181b; }
+
+/* rail */
+.vt-rail {
+	position: fixed; z-index: 300;
+	top: 0; bottom: 0; left: 0;
+	width: var(--rail-w);
+	display: flex; flex-direction: column; align-items: stretch;
+	background: var(--bg-rail);
+	border-right: 1px solid var(--line);
+}
+
+.vt-brand {
+	display: flex; align-items: center; gap: var(--sp-3);
+	height: var(--top-h);
+	padding: 0 12px;
+	color: var(--text);
+	border-bottom: 1px solid var(--line);
+	flex: none;
+	text-decoration: none !important;
+}
+.vt-brand svg { flex: none; }
+/* Appearance "Next to the logo" (menu-vantage.js applyBrand): beside the
+   logo while the rail is pinned open, else first in the top bar, as
+   "name / page"; not on phones, where the logo isn't shown either */
+.vt-brand-name { display: none; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
+html[data-rail="pinned"] .vt-brand-name:not([hidden]) { display: block; }
+.vt-top-name { flex: none; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-2); font-weight: 600; }
+.vt-top-name[hidden], html[data-rail="pinned"] .vt-top-name { display: none; }
+.vt-top-name + .vt-crumbs::before { content: "/"; flex: none; margin-inline-end: 4px; color: var(--text-3); font-family: var(--mono); font-size: var(--fs-sm); }
+.vt-top-name[hidden] + .vt-crumbs::before, html[data-rail="pinned"] .vt-top-name + .vt-crumbs::before { content: none; }
+
+.vt-rail-list {
+	list-style: none; margin: 0; padding: var(--sp-2) 0;
+	flex: 1 1 auto;
+	display: flex; flex-direction: column; gap: 2px;
+	overflow-y: auto; overflow-x: hidden;
+}
+
+.vt-rail-item { position: relative; padding: 0 8px; }
+
+.vt-rail-link {
+	position: relative;
+	display: flex; align-items: center; gap: var(--sp-3);
+	width: 100%; height: 40px;
+	padding: 0 10px;
+	border: 0; border-radius: var(--r-lg);
+	background: none;
+	color: var(--text-2);
+	font: inherit; font-weight: 500;
+	text-align: left;
+	cursor: pointer;
+	text-decoration: none !important;
+	white-space: nowrap;
+}
+.vt-rail-link svg { flex: none; width: 20px; height: 20px; }
+.vt-rail-label { overflow: hidden; text-overflow: ellipsis; display: none; flex: 1 1 auto; }
+.vt-rail-caret { display: none; width: 14px; height: 14px; color: var(--text-3); transition: transform .15s; }
+
+.vt-rail-link:hover, .vt-rail-item.is-open > .vt-rail-link { background: var(--s3); color: var(--text); }
+.vt-rail-item.is-active > .vt-rail-link { color: var(--accent-text); background: var(--accent-soft); }
+.vt-rail-item.is-active > .vt-rail-link::before {
+	content: ""; position: absolute; left: -8px; top: 9px; bottom: 9px;
+	width: 3px; border-radius: 0 3px 3px 0;
+	background: var(--accent-text);
+}
+
+.vt-rail-sub { display: none; list-style: none; margin: 2px 0 6px; padding: 0 0 0 20px; }
+
+.vt-rail-foot { flex: none; padding: var(--sp-2); border-top: 1px solid var(--line); }
+.vt-rail-pin {
+	display: flex; align-items: center; justify-content: center;
+	width: 40px; height: 36px;
+	border: 0; border-radius: var(--r-lg);
+	background: none; color: var(--text-3);
+	cursor: pointer;
+}
+.vt-rail-pin:hover { background: var(--s3); color: var(--text); }
+.vt-rail-pin svg, .vt-icon-btn svg, .vt-search svg, .vt-rail-link svg, .vt-flyout svg, .vt-pal svg, .vt-crumb-switch svg {
+	fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round;
+}
+.vt-rail-pin svg { transition: transform .15s; }
+
+/* pinned rail: labels + inline accordion instead of flyouts */
+html[data-rail="pinned"] .vt-rail { width: var(--rail-w-pinned); }
+html[data-rail="pinned"] .vt-rail-label { display: block; }
+html[data-rail="pinned"] .vt-rail-caret { display: block; }
+html[data-rail="pinned"] .vt-rail-item.is-expanded > .vt-rail-link .vt-rail-caret { transform: rotate(90deg); }
+html[data-rail="pinned"] .vt-rail-item.is-expanded > .vt-rail-sub { display: block; }
+html[data-rail="pinned"] .vt-rail-pin { width: 100%; justify-content: flex-end; padding-right: 12px; }
+html[data-rail="pinned"] .vt-rail-pin svg { transform: scaleX(-1); }
+html[data-rail="pinned"] .vt-frame { margin-left: var(--rail-w-pinned); }
+
+.vt-rail-sub a {
+	display: block;
+	padding: 5px 10px;
+	border-left: 1px solid var(--line-2);
+	color: var(--text-2);
+	font-size: var(--fs-sm);
+	white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+	text-decoration: none !important;
+}
+.vt-rail-sub a:hover { color: var(--text); border-left-color: var(--text-3); }
+.vt-rail-sub a[aria-current] { color: var(--accent-text); border-left: 2px solid var(--accent-text); padding-left: 9px; font-weight: 600; }
+
+/* flyout */
+.vt-flyout {
+	position: fixed; z-index: 290;
+	top: 0; bottom: 0; left: var(--rail-w);
+	width: 272px;
+	display: flex; flex-direction: column;
+	background: var(--s1);
+	border-right: 1px solid var(--line-2);
+	box-shadow: var(--shadow-pop);
+	animation: vt-fly-in .14s ease-out;
+}
+@keyframes vt-fly-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
+
+.vt-fly-head {
+	display: flex; align-items: center; gap: var(--sp-3);
+	height: var(--top-h);
+	padding: 0 var(--sp-4);
+	border-bottom: 1px solid var(--line);
+	flex: none;
+}
+.vt-fly-title { font-size: var(--fs-md); font-weight: 600; }
+
+.vt-fly-list { list-style: none; margin: 0; padding: var(--sp-2); overflow-y: auto; flex: 1 1 auto; }
+.vt-fly-list > li + li { margin-top: 1px; }
+.vt-fly-link {
+	display: flex; align-items: center; gap: var(--sp-2);
+	min-height: var(--ctl-h); padding: 6px 10px;
+	border-radius: var(--r);
+	color: var(--text);
+	text-decoration: none !important;
+}
+.vt-fly-link:hover { background: var(--s3); }
+.vt-fly-link[aria-current] { background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
+.vt-fly-sub { list-style: none; margin: 0 0 var(--sp-1) 18px; padding: 0; border-left: 1px solid var(--line-2); }
+.vt-fly-sub a {
+	display: block; padding: 4px 10px;
+	color: var(--text-2); font-size: var(--fs-sm);
+	border-radius: 0 var(--r-sm) var(--r-sm) 0;
+	text-decoration: none !important;
+}
+.vt-fly-sub a:hover { color: var(--text); background: var(--s3); }
+.vt-fly-sub a[aria-current] { color: var(--accent-text); font-weight: 600; box-shadow: inset 2px 0 0 var(--accent-text); }
+
+.vt-scrim { position: fixed; inset: 0; z-index: 280; background: var(--scrim); }
+
+/* frame + top bar */
+.vt-frame {
+	margin-left: var(--rail-w);
+	min-height: 100vh;
+	display: flex; flex-direction: column;
+}
+.vt-anon .vt-frame { margin-left: 0; }
+
+.vt-topbar {
+	position: sticky; top: 0; z-index: 200;
+	display: flex; align-items: center; gap: var(--sp-4);
+	height: var(--top-h);
+	padding: 0 var(--sp-5);
+	background: color-mix(in srgb, var(--bg) 88%, transparent);
+	backdrop-filter: saturate(1.2) blur(10px);
+	-webkit-backdrop-filter: saturate(1.2) blur(10px);
+	border-bottom: 1px solid var(--line);
+}
+
+.vt-crumbs {
+	display: flex; align-items: center; gap: 6px;
+	min-width: 0; flex: 1 .001 auto;     /* gives way last: see .vt-top-actions */
+	align-self: stretch;                 /* the bar's height: room for focus rings */
+	margin-inline: -8px; padding-inline: 8px;   /* room for the switch's ring (it sits 6px out) */
+	font-size: var(--fs-base);
+	white-space: nowrap; overflow: hidden;
+}
+.vt-crumb { color: var(--text-2); overflow: hidden; text-overflow: ellipsis; text-decoration: none !important; }
+/* a link crumb is a control high to click; the padding adds no height to the bar */
+a.vt-crumb { padding-block: calc((var(--ctl-h) - 1.5em) / 2); }
+a.vt-crumb:hover { color: var(--text); }
+.vt-crumb-current { color: var(--text); font-weight: 600; }
+.vt-crumb-sep { color: var(--text-3); flex: none; font-family: var(--mono); font-size: var(--fs-sm); }
+/* the current crumb of a page with page tabs: opens its sibling pages.
+   A control high; the ring sits on its edge, inside the crumbs' clip. */
+.vt-crumb-switch {
+	display: inline-flex; align-items: center; gap: 4px;
