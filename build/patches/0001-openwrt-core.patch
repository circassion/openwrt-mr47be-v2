+.v-nft-jump[aria-expanded="true"]::after { transform: rotate(-135deg); margin-bottom: -2px; }
+.v-nft-jump:hover { border-color: var(--text-3); }
+/* the chain a rule jumps to, beneath the rule */
+.v-nft-sub {
