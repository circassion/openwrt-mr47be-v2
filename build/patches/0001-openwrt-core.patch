@@ -0,0 +1,12 @@
+#!/bin/sh
+# Earliest userspace hook: start the die flip as soon as the 'lan' conduit appears.
+# This can run before rc.d S21; apply is protected by its own single-shot gate
+# ($DONE), so it never programs twice together with rc.d.
+[ "$ACTION" = add ] || exit 0
+case "$INTERFACE" in
+	lan)
+		( /usr/sbin/mr47be-die-switch apply >/dev/null 2>&1 ) &
+		;;
+esac
+
+exit 0
diff --git a/package/network/mr47be-die-switch/files/40-mr47be-die-watch b/package/network/mr47be-die-switch/files/40-mr47be-die-watch
new file mode 100755
index 0000000..e7b94a4
--- /dev/null
+++ b/package/network/mr47be-die-switch/files/40-mr47be-die-watch
@@ -0,0 +1,15 @@
+#!/bin/sh
+# WAN event-driven watchdog hook.
+# After a PHY flap the WAN die port1 face loses sync: link UP, carrier=1, but
+# die port1 tx=0/rx=0 -> DHCP never completes, no route/IPv4.
+# netifd emits a hotplug event for wan on this flap; arm the watchdog here.
+# `arm` starts a detached (setsid) watch process and returns immediately, so
+# netifd is not blocked. The watchdog is guarded by a single-instance gate
+# ($WATCHF + /proc/PID).
+[ "$INTERFACE" = wan ] || exit 0
+case "$ACTION" in
+	ifup|ifdown|up|down) ;;
+	*) exit 0 ;;
+esac
+/usr/sbin/mr47be-die-switch arm >/dev/null 2>&1
+exit 0
\ No newline at end of file
diff --git a/package/network/mr47be-die-switch/files/mr47be-die-switch b/package/network/mr47be-die-switch/files/mr47be-die-switch
new file mode 100755
index 0000000..f25e163
--- /dev/null
+++ b/package/network/mr47be-die-switch/files/mr47be-die-switch
@@ -0,0 +1,935 @@
+#!/bin/sh
+# mr47be-die-switch - QCA8084 die switch-mode uplink for Mercusys MR47BE V2.
+#
+# The vendor U-Boot leaves the integrated QCA8084 die in PORT5-bypass mode
+# (WORK_MODE 0x20): the SerDes is wired straight to EPHY3 (LAN1) and the
+# factory MAC face (PORT5) is clock-gated, so only LAN1 works.
+#
+# This service flips the die to factory switch mode (WORK_MODE 0x10) and
+# brings up the PORT5 CPU uplink so LAN2/LAN3 reach br-lan:
+#   1) WORK_MODE 0x20 -> 0x10
+#   2) UNIPHY0 MMD1 0x11b binding bit 0x10 (PHY side) -> 0x20 (MAC side)
+#   3) mux 0xc800300 -> UNIPHY0_SEL_MAC5
+#   4) MAC5/MAC4 tx/rx RCG parent/select + CBCR enable
+#   5) GLOBAL_FW_CTRL0 CPU_PORT_EN + GLOBAL_FW_CTRL1 flood masks
+#   6) PORT_LOOKUP_CTRL VLAN membership: wan {p0,p1}, lan {p2,p3,p4,p5}
+#   7) PORT_STATUS / speed class for the PHY-less CPU faces
+#   8) ACL ACTION+8 cpu_bmp: add port5 (SoC 'lan')
+#
+# A watchdog keeps the flip alive, repairs dead LAN jacks (LK FORWARD+LEARN)
+# and recovers a dead WAN PHY without touching the LAN fabric.
+# Runtime flags: /etc/mr47be-die.flip-enabled, /etc/mr47be-die.dsa
+#
+# Sources: GPL uboot-qca8084 +
+#          target/linux/qualcommbe/files/drivers/net/dsa/qca/qca8386.c
+
+LOG=/tmp/mr47be-die.log
+SAV=/tmp/mr47be-die.save
+DONE=/tmp/mr47be-die.done
+FAIL=/tmp/mr47be-die.fail
+GATE=/etc/mr47be-die.flip-enabled
+LOCK=/tmp/mr47be-die.lock
+TRY=/tmp/mr47be-die.try
+STARTF=/tmp/mr47be-die.start
+SRC=/usr/sbin/mr47be-die-switch
+WAN_WAIT=${WAN_WAIT:-180}
+ATTEMPTS=${ATTEMPTS:-2}
+WAN_SETTLE=${WAN_SETTLE:-30}
+MIN_UPTIME=${MIN_UPTIME:-45}
+STABF=/tmp/mr47be-die.wanlink
+WANPRE=/tmp/mr47be-die.wanpre
+REPAIR=/tmp/mr47be-die.repair
+REPAIRL=/tmp/mr47be-die.repairlock
+REPAIR_MAX=${REPAIR_MAX:-2}
+WATCHF=/tmp/mr47be-die.watch
+WATCH_ROUNDS=${WATCH_ROUNDS:-0}
+WATCH_GAP=${WATCH_GAP:-30}
+RATE_GAP=${RATE_GAP:-2}
+RATE_STATE=""
+DEAD_GRACE=${DEAD_GRACE:-120}
+PPP_DEAD_GRACE=${PPP_DEAD_GRACE:-300}
+BUS=${BUS:-90000.mdio-1}
+ACTION=${1:-apply}
+
+DSA_MARK=/etc/mr47be-die.dsa
+KMODIR=/lib/modules/$(uname -r)
+WANDEV=${WANDEV:-wan}
+
+log(){ echo "DIE-SW $(cut -d. -f1 /proc/uptime) $1" >> "$LOG"; }
+
+w16(){ mdio "$BUS" phy "$1" raw "$2" "$(printf '0x%04x' $(( $3 & 0xffff )))" >/dev/null 2>&1; }
+r16(){ _o=$(mdio "$BUS" phy "$1" raw "$2" 2>/dev/null) || return 1
+  _t=$(printf '%s' "$_o" | awk '{x=$NF} END{print x}'); _t=${_t#0x}; _t=${_t#0X}
+  case "$_t" in ''|*[!0-9a-fA-F]*) return 1;; esac; echo $(( 0x$_t )); }
+swrd(){ _sr=$(mdio "$BUS" qca "$1" 2>/dev/null) || return 1; RD_VAL=$(( _sr )); }
+rd(){ swrd "$1" >/dev/null 2>&1 || { echo ""; return 1; }; echo "$RD_VAL"; }
+swwr(){ mdio "$BUS" qca "$1" "$(printf '0x%08x' "$2")" >/dev/null 2>&1; }
+sw_rmw(){ mdio "$BUS" qca "$1" "$(printf '0x%08x' $(( $3 & $2 )))" "$(printf '0x%08x' "$2")" >/dev/null 2>&1; }
+
+mmdr(){ mdio "$BUS" mmd "$1" raw "$2" 2>/dev/null; }
+mmdw(){ mdio "$BUS" mmd "$1" raw "$2" "$3" >/dev/null 2>&1; }
+todec(){ _v=$1; case "$_v" in 0x*|0X*) echo $(( $_v ));; [0-9a-fA-F]*) echo $(( 0x$_v ));; *) echo ""; return 1;; esac; }
+
+WORK_MODE=0xc90f030; MUX=0xc800300
+P5_TXRCG=0xc800144; P5_TXCMD=0xc800140; P5_TXCBCR=0xc80014c
+P5_RXRCG=0xc800158; P5_RXCMD=0xc800154; P5_RXCBCR=0xc800160
+P4_TXRCG=0xc800104; P4_TXCMD=0xc800100; P4_TXCBCR=0xc800114
+P4_RXRCG=0xc800124; P4_RXCMD=0xc800120; P4_RXCBCR=0xc800134
+P4_TXCDIV=0xc800108; P4_RXCDIV=0xc800128
+P4_XGRXCDIV=0xc80010c; P4_XGTXCDIV=0xc80012c
+P4_XGRXCBCR=0xc80011c; P4_XGTXCBCR=0xc80013c
+PS0=0x7c; PS2=0x84; PS3=0x88; PS4=0x8c; PS5=0x90; HDR0=0x9c; HDR4=0xac; HDR5=0xb0
+LK0=0x660; LK1=0x66c; LK2=0x678; LK3=0x684; LK4=0x690; LK5=0x69c
+LK_FWD=$(( 0x00140000 ))
+FW0=0x620; FW_CPU_EN=0x400
+FW1=0x624; FW_DP_MASK=0x7f7f7f7f; FW_DP_VAL=0x3d3f3d3d
+ACLR16=0x58010; ACLM16=0x59010; ACLA4=0x5a004; ACLA8=0x5a008; APPLY=0x30
+ACL_ACT0=0x5a000; ACL_R0=0x58000; ACL_M0=0x59000
+ACL_A4_WANT=$(( 0x20000000 )); ACL_R16_WANT=$(( 0x1e )); ACL_M16_WANT=$(( 0xc9 ))
+ACL_A8_LAN=$(( 0x14 )); ACL_A8_TABAN=$(( 0x10 ))
+UPHY="5:1"; UMODE=0x11b; UCH0=0x120; UFUNC=0x18c
+MEMC=0xc90f044; MEMACC=0xc90f048; MEMACC_SWITCH=0x000c0c0c
+DVS_MASK=0x30; DVS_RAWA=0x20
+UDATA=0x180; UCAL=0x78; UCAL_DONE=0x80
+UANA=0x40; UPLL_IBSEL=0x30; UADPT=0x800; UFUNC_RST=0x10
+UDEVD=${UPHY%%:*}
+MB_GCC=0xc800000
+MB_EVERY=${MB_EVERY:-15}
+MB_TICK=0
+MB_TOUCH=""
+for _mbp in 2 3; do
+  _mbb=$(( MB_GCC + 0x80 + (_mbp - 2) * 0x40 ))
+  for _mbo in 0 4 8 12 20 24 32 36 40 44 52 56; do
+    MB_TOUCH="$MB_TOUCH $(printf 0x%x $(( _mbb + _mbo )))"
+  done
+  MB_TOUCH="$MB_TOUCH $(printf 0x%x $(( 0x84 + (_mbp - 2) * 4 )))"
+done
+TOUCH="$WORK_MODE $MUX $FW0 $FW1 $P5_TXRCG $P5_TXCMD $P5_TXCBCR $P5_RXRCG $P5_RXCMD $P5_RXCBCR $P4_TXRCG $P4_TXCMD $P4_TXCBCR $P4_RXRCG $P4_RXCMD $P4_RXCBCR $P4_TXCDIV $P4_RXCDIV $P4_XGRXCDIV $P4_XGTXCDIV $P4_XGRXCBCR $P4_XGTXCBCR $PS4 $PS5 $HDR4 $HDR5 $LK0 $LK1 $LK2 $LK3 $LK4 $LK5 $ACLR16 $ACLM16 $ACLA4 $ACLA8 $APPLY $MEMACC $MEMC $MB_TOUCH"
+PS_SET=0x4f
+RCG_P5TX=$(( (2 << 8) | 1 )); RCG_P5RX=$(( (1 << 8) | 1 )); RCG_P4TX=$(( (6 << 8) | 1 ))  # v24: source 6, like ports 1-3
+
+setrcg(){ swwr "$2" "$3"; c=$(rd "$1"); [ -n "$c" ] || return 1; swwr "$1" $(( c | 1 ))
+  i=0; while [ $i -lt 4 ]; do w=$(rd "$1"); [ $(( w & 1 )) -eq 0 ] && break; i=$(( i + 1 )); sleep 1; done; }
+cbc_en(){ cur=$(rd "$1"); swwr "$1" $(( cur | 1 )); off=$(rd "$1"); root=$(rd "$2")
+  if [ $(( off & 0x80000000 )) -ne 0 ] || [ $(( root & 0x80000000 )) -ne 0 ]; then
+    swwr "$2" $(( root & ~0x80000000 )); swwr "$1" $(( (off & ~0x80000000) | 1 ))
+    swwr "$2" $(( $(rd $2) | 1 )); sleep 1; fi; }
+
+p4_div_fix(){ # v26: LAN1 (die port4) datapath clocks, vendor qca8084_port_speed_clock_set()
+  # + qca8084_port_clk_en_set() values.  The port4 CDIV was left at 9 (=/10) by
+  # the boot firmware, so the 2.5G MAC ran at ~31 MHz and the link flapped
+  # 100M/1G/2.5G.  CDIV 0 is right for 100M/1G/2.5G; only 10M needs 9.
+  # XGMII CDIV = 312.5/78.125-1 = 3 and both XGMII clocks must leave CLK_OFF.
+  local _p4a _p4v _p4hit
+  _p4hit=0
+  for _p4a in $P4_TXCDIV $P4_RXCDIV; do
+    _p4v=$(rd "$_p4a") || continue
+    [ "$_p4v" -eq 0 ] || { swwr "$_p4a" 0; _p4hit=1; }
+  done
+  for _p4a in $P4_XGRXCDIV $P4_XGTXCDIV; do
+    _p4v=$(rd "$_p4a") || continue
+    [ "$_p4v" -eq 3 ] || { swwr "$_p4a" 3; _p4hit=1; }
+  done
+  for _p4a in $P4_XGRXCBCR $P4_XGTXCBCR; do
+    _p4v=$(rd "$_p4a") || continue
+    [ $(( _p4v & 0x80000001 )) -eq 1 ] || { swwr "$_p4a" $(( (_p4v & 0x7fffffff) | 1 )); _p4hit=1; }
+  done
+  [ "$_p4hit" -eq 1 ] && { log "LAN1-CLK port4 CDIV/XGMII onarildi (v26)"; return 0; }
+  return 1; }
+
+save(){ : > "$SAV"; for a in $TOUCH; do v=$(rd $a); [ -n "$v" ] && echo "REG $a $v" >> "$SAV"; done
+  for r in $UMODE $UCH0 $UFUNC $UDATA; do v=$(todec "$(mmdr $UPHY $r)"); [ -n "$v" ] && echo "MMD $r $v" >> "$SAV"; done
+  for m in 0 6; do v=$(r16 $UDEVD $m); [ -n "$v" ] && echo "MII $m $v" >> "$SAV"; done; }
+
+acl_replay(){ # $1 = ACTION+4, $2 = ACTION+8 (both decimal). Never write a single word.
+  swwr $ACL_ACT0 0;  swwr $ACLA4 "$1"; swwr $ACLA8 "$2"
+  swwr $ACL_R0 0;    swwr 0x58004 0;  swwr 0x58008 0;  swwr 0x5800c 0; swwr $ACLR16 $ACL_R16_WANT
+  swwr $ACL_M0 0;    swwr 0x59004 0;  swwr 0x59008 0;  swwr 0x5900c 0; swwr $ACLM16 $ACL_M16_WANT
+  swwr $APPLY 3; }
+
+acl_set(){ # writes the requested ACTION+8, reads back, retries up to 3 times (no false-positive revert)
+  _w8=${1:-$ACL_A8_LAN}; _w4=${2:-$ACL_A4_WANT}; _k=0
+  while [ $_k -lt 3 ]; do
+    acl_replay "$_w4" "$_w8"; sleep 1
+    _g4=$(rd $ACLA4); _g8=$(rd $ACLA8); _gr=$(rd $ACLR16); _gm=$(rd $ACLM16)
+    if [ "$_g4" = "$_w4" ] && [ "$_g8" = "$_w8" ] && [ "$_gr" = "$ACL_R16_WANT" ] && [ "$_gm" = "$ACL_M16_WANT" ]; then
+      log "ACL-REPLAY OK A4=$_g4 A8=$_g8 R16=$_gr M16=$_gm (attempt $(( _k + 1 )))"; return 0; fi
+    log "ACL-REPLAY attempt $(( _k + 1 )): wanted A4=$_w4 A8=$_w8 / read A4=$_g4 A8=$_g8 R16=$_gr M16=$_gm"
+    _k=$(( _k + 1 ))
+  done
+  log "ACL-REPLAY FAILED (3 attempts)"; return 1; }
+
+restore(){ [ -s "$SAV" ] || return 1
+  _a8s=""; _a4s=""
+  while read k a b; do case "$k" in
+    MMD) mmdw $UPHY "$a" "$(printf 0x%04x "$b")";;
+    MII) w16 $UDEVD "$a" "$b";;
+    REG) if   [ "$a" = "$ACLA8" ];   then _a8s="$b"
+         elif [ "$a" = "$ACLA4" ];   then _a4s="$b"
+         elif [ "$a" = "$ACLR16" ] || [ "$a" = "$ACLM16" ]; then :
+         else swwr "$a" "$b"; fi;;
+  esac; done < "$SAV"
+  acl_replay "${_a4s:-$ACL_A4_WANT}" "${_a8s:-$ACL_A8_TABAN}"; }
+
+lan_clients(){ ip -4 neigh 2>/dev/null | awk '/dev br-lan/ && /lladdr/ {print $1}' | head -3; }
+
+bcast(){ ip -4 -br addr show dev br-lan 2>/dev/null | awk '{print $3}' | cut -d/ -f1 \
+  | awk -F. 'NF==4{print $1"."$2"."$3".255"}'; }
+
+_wdev(){ # v25: physical WAN netdev.  wan-rename turns gmac1 into wan at boot.
+  for _d in wan gmac1; do [ -e /sys/class/net/$_d ] && { echo $_d; return; }; done
+  echo gmac1; }
+
+_wface(){ # v13: PPP tunnels first (PPPoE/L2TP/PPTP put the IP on ppp*, not on the MAC)
+  for _d in pppoe-wan ppp0 ppp1 wan gmac1; do
+    [ -e /sys/class/net/$_d ] && { echo $_d; return; }
+  done
+  echo gmac1; }
+
+wanrx(){ cat /sys/class/net/$(_wface)/statistics/rx_packets 2>/dev/null; }
+
+phytx(){ mdio "$BUS" mmd "$1:7" raw 0x8029 1 >/dev/null 2>&1
+  _o=$(mdio "$BUS" mmd "$1:7" raw 0x802e 2>/dev/null) || return 1
+  _t=$(printf '%s' "$_o" | awk '{x=$NF} END{print x}'); _t=${_t#0x}; _t=${_t#0X}
+  case "$_t" in ''|*[!0-9a-fA-F]*) return 1;; esac; echo $(( 0x$_t )); }
+
+phyclink(){ _o=$(mdio "$BUS" phy "$1" raw 1 2>/dev/null) || return 1
+  _t=$(printf '%s' "$_o" | awk '{x=$NF} END{print x}'); _t=${_t#0x}; _t=${_t#0X}
+  case "$_t" in ''|*[!0-9a-fA-F]*) return 1;; esac; echo $(( (0x$_t >> 2) & 1 )); }
+
+ephytx(){ phytx 1; }
+
+is_switch(){ _swm=$(rd $WORK_MODE); [ -n "$_swm" ] || return 1; [ $(( _swm & 0x3f )) -eq 16 ]; }
+
+wan_addr(){ ip -4 -br addr show dev "$(_wface)" 2>/dev/null | awk '{print $3}'; }
+
+sav_11b(){ awk '$1=="MMD" && $2=="0x11b" {print $3; exit}' "$SAV" 2>/dev/null; }
+
+sav_live(){ case "$(sav_11b)" in 2064|2080) return 0;; *) return 1;; esac; }
+
+lk_mem(){ case $1 in 0) echo 2;; 1) echo 1;; 2) echo 56;; 3) echo 52;; 4) echo 44;; 5) echo 28;; *) echo 0;; esac; }
+
+lk_fix(){
+  _fx=""
+  for _p in 0 1 2 3 4 5; do
+    _a=$(( 0x660 + _p * 12 ))
+    _m=$(lk_mem $_p)
+    _try=0; _ok=0
+    while [ $_try -lt 3 ]; do
+      _try=$(( _try + 1 ))
+      _cur=$(rd $_a) || { sleep 1; continue; }
+      _want=$(( (_cur & ~0x0017007f) | LK_FWD | _m ))
+      [ "$_want" = "$_cur" ] && { _ok=1; break; }
+      sw_rmw $_a 0x0017007f $(( LK_FWD | _m )) || { sleep 1; continue; }
+      _rb=$(rd $_a)
+      if [ -n "$_rb" ] && [ $(( _rb & 0x0017007f )) = $(( LK_FWD | _m )) ]; then
+        log "LK-FIX port$_p: $(printf '0x%08x' $_cur) -> $(printf '0x%08x' $_rb) (attempt $_try)"
+        _fx="$_fx p$_p"; _ok=1; break
+      fi
+      log "LK-FIX port$_p: readback mismatch wanted=$(printf '0x%08x' $_want) read=$(printf '0x%08x' ${_rb:-0}) -> retry"
+      sleep 1
+    done
+    [ "$_ok" = 1 ] || log "LK-FIX port$_p: FAILED (3 attempts) -> abandoned"
+  done
+  [ -n "$_fx" ] && log "LK-FIX uygulandi:$_fx"
+  return 0; }
+
+wan_reset(){
+  log "WAN-RESET BASLADI: BMCR=$(mdio "$BUS" phy 1 raw 0 2>/dev/null) BMSR=$(mdio "$BUS" phy 1 raw 1 2>/dev/null) p1_tx=$(ephytx)"
+  mdio "$BUS" phy 1 raw 0 0x8000 >/dev/null 2>&1
+  sleep 2
+  mdio "$BUS" phy 1 raw 0 0x1200 >/dev/null 2>&1
+  _i=0
+  while [ "$_i" -lt 12 ]; do
+    [ "$(phyclink 1)" = 1 ] && break
+    _i=$(( _i + 1 )); sleep 2
+  done
+  sleep 4
+  log "WAN-RESET SONU: link=$(phyclink 1) BMCR=$(mdio "$BUS" phy 1 raw 0 2>/dev/null) BMSR=$(mdio "$BUS" phy 1 raw 1 2>/dev/null) p1_tx=$(ephytx) bekleme=$(( _i * 2 ))sn"
+}
+
+lan_dead(){
+  _n=0
+  for c in $(lan_clients); do _n=$(( _n + 1 )); done
+  [ "$_n" -ge 1 ] || return 1
+  _r0=$(cat /sys/class/net/br-lan/statistics/rx_packets 2>/dev/null); _r0=${_r0:-0}
+  _bc=$(bcast); [ -n "$_bc" ] && ping -c 3 -b -i 1 "$_bc" >/dev/null 2>&1
+  sleep 5
+  _r1=$(cat /sys/class/net/br-lan/statistics/rx_packets 2>/dev/null); _r1=${_r1:-0}
+  [ $(( _r1 - _r0 )) -gt 0 ] && return 1
+  for c in $(lan_clients); do ping -c 2 -W 1 "$c" >/dev/null 2>&1 && return 1; done
+  return 0; }
+
+_dead_sample(){
+  is_switch || return 1
+  _su=$(cut -d. -f1 /proc/uptime); [ -n "$_su" ] || return 1
+  # v14: PPP-family WAN (PPPoE/L2TP/PPTP) puts the IP on ppp*, so there is no
+  # address/route on the MAC device. v13 skipped these protocols completely,
+  # which meant a PPPoE session that never came up was never repaired.
+  # Judge the tunnel instead:
+  #   tunnel with an address    -> healthy
+  #   tunnel without an address -> dead, but only after a long grace
+  #   no tunnel at all           -> dead after the normal grace
+  case "$(uci -q get network.wan.proto)" in
+    ppp|pppoe|pppoa|pptp|l2tp)
+      _ppp=
+      for _d in pppoe-wan ppp0 ppp1; do [ -e /sys/class/net/$_d ] && { _ppp=$_d; break; }; done
+      if [ -n "$_ppp" ]; then
+        [ -n "$(ip -4 -br addr show dev "$_ppp" 2>/dev/null | awk '{print $3}')" ] && return 1
+        [ "$_su" -ge "$PPP_DEAD_GRACE" ] || return 1
+      else
+        [ "$_su" -ge "$DEAD_GRACE" ] || return 1
+      fi
+      [ "$(phyclink 1)" = 1 ] || return 1
+      return 0 ;;
+  esac
+  if [ -e /sys/class/net/pppoe-wan ] || [ -e /sys/class/net/ppp0 ]; then return 1; fi
+  [ "$(phyclink 1)" = 1 ] || return 1
+  ip route 2>/dev/null | grep -q '^default' && return 1
+  [ -z "$(wan_addr)" ] || return 1
+  [ "$_su" -ge "$DEAD_GRACE" ] || return 1
+  return 0; }
+
+wan_phantom_fix(){ # v15: the DSA 'wan' port has no PHY behind it on this board
+  # (package-mode=2 -> the WAN PHY hangs on the SoC MAC1 via PCS0).  If the WAN
+  # interface is bound to that port it can never get a carrier, so DHCP/PPPoE
+  # die while the real path 'gmac1' is alive.  Rebind and reload.
+  _wd=$(uci -q get network.wan.device)
+  [ "$_wd" = "wan" ] || return 1
+  [ -e /sys/class/net/wan ] || return 1
+  [ "$(cat /sys/class/net/wan/carrier 2>/dev/null)" = 1 ] && return 1
+  [ "$(cat /sys/class/net/$(_wdev)/carrier 2>/dev/null)" = 1 ] || return 1
+  uci set network.wan.device="$(_wdev)" >/dev/null
+  uci -q set network.wan.ifname="$(_wdev)"
+  uci -q get network.wan6 >/dev/null 2>&1 && uci set network.wan6.device='@wan'
+  uci commit network
+  log "WAN-PHANTOM: DSA 'wan' link yok + gmac1 link var -> WAN gmac1'e alindi"
+  /etc/init.d/network reload >/dev/null 2>&1
+  return 0; }
+
+wan_dead(){
+  _dead_sample || return 1
+  _a=$(ephytx)
+  sleep 10
+  _dead_sample || return 1
+  _b=$(ephytx)
+  _mod=B; [ -n "$_a" ] && [ "$_a" = "$_b" ] && _mod=A
+  _dw=$(rd $WORK_MODE); _dm=$(mmdr $UPHY $UMODE)
+  log "WAN-DEAD MOD-$_mod detected: phy1_link=1 route=0 addr=0 p1_tx=$_a->${_b:-?} (2 samples/10 s) WORK_MODE=${_dw:+0x$(printf %08x $_dw)} 11b=${_dm:-?}"
+  return 0; }
+
+wan_inet_ok(){
+  ip route 2>/dev/null | grep -q '^default' || return 1
+  [ -n "$(wan_addr)" ] || return 1
+  ping -c 3 -W 3 8.8.8.8 >/dev/null 2>&1 || return 1
+  ping -c 3 -W 3 8.8.8.8 >/dev/null 2>&1; }
+
+_full_repair_wan(){
+  log "WAN-FULL-REPAIR (flag present): revert -> WORK_MODE 0x20 -> ifup -> flip; LAN2/3 at risk"
+  restore || { log "WAN-FULL-REPAIR restore FAILED"; return 1; }
+  _wm=$(rd $WORK_MODE); [ -n "$_wm" ] && swwr $WORK_MODE $(( (_wm & ~0x3f) | 0x20 ))
+  rm -f "$DONE"; rmdir "$LOCK" 2>/dev/null; echo 0 > "$TRY"
+  log "WAN-FULL-REPAIR bypass: WORK_MODE=$(rd $WORK_MODE) 11b=$(mmdr $UPHY $UMODE) lan_carrier=$(cat /sys/class/net/lan/carrier 2>/dev/null)"
+  ifup wan 2>/dev/null
+  _i=0
+  while [ "$_i" -lt 12 ]; do
+    ip route 2>/dev/null | grep -q '^default' && break
+    _i=$(( _i + 1 )); sleep 5
+  done
+  setsid sh -c "$SRC apply" </dev/null >/tmp/mr47be-die.repair.log 2>&1 &
+  _i=0; _s=0
+  while [ "$_i" -lt 48 ]; do
+    is_switch && { _s=1; break; }
+    _i=$(( _i + 1 )); sleep 5
+  done
+  sleep 25
+  _wm=$(rd $WORK_MODE); _mx=$(rd $MUX); _a8=$(rd $ACLA8); _b11=$(todec "$(mmdr $UPHY $UMODE)")
+  _sig=0
+  [ "$_wm" = "16" ] && [ "$_mx" = "3" ] && [ "$_a8" = "20" ] && [ "$_b11" = "2080" ] && _sig=1
+  _i=0; _ok=0
+  while [ "$_i" -lt 6 ]; do
+    if [ "$_sig" = 1 ] && wan_inet_ok; then _ok=1; break; fi
+    _i=$(( _i + 1 )); sleep 10
+  done
+  log "WAN-FULL-REPAIR RESULT switch=$_s sig=$_sig inet=$_ok WM=$(rd $WORK_MODE) MUX=$(rd $MUX) A8=$(rd $ACLA8) 11b=$(mmdr $UPHY $UMODE) p1_tx=$(ephytx) p2=$(phytx 2) p3=$(phytx 3) p4=$(phytx 4)"
+  [ "$_ok" = 1 ]; }
+
+_repair_wan(){
+  _n=$(cat "$REPAIR" 2>/dev/null); _n=${_n:-0}
+  if [ "$_n" -ge "$REPAIR_MAX" ]; then
+    log "WAN-REPAIR attempts exhausted ($_n/$REPAIR_MAX) -> untouched"; return 1
+  fi
+  _n=$(( _n + 1 )); echo "$_n" > "$REPAIR"
+  log "WAN-REPAIR $_n/$REPAIR_MAX: PHY1 full reset (switch NOT touched)"
+  wan_reset
+  # v14: a PPP-family WAN needs its session restarted after the PHY reset,
+  # otherwise the tunnel never comes back on its own.
+  case "$(uci -q get network.wan.proto)" in ppp|pppoe|pppoa|pptp|l2tp) ifup wan >/dev/null 2>&1;; esac
+  _i=0; _ok=0
+  while [ "$_i" -lt 6 ]; do
+    if wan_inet_ok; then _ok=1; break; fi
+    _i=$(( _i + 1 )); sleep 10
+  done
+  log "WAN-REPAIR(RESET) RESULT inet=$_ok route=$(ip route 2>/dev/null | grep -c '^default') addr=$(wan_addr) p1_tx=$(ephytx) WORK_MODE=$(rd $WORK_MODE) 11b=$(mmdr $UPHY $UMODE) lan_carrier=$(cat /sys/class/net/lan/carrier 2>/dev/null) p2=$(phytx 2) p3=$(phytx 3) p4=$(phytx 4) waited=$(( _i * 10 ))s"
+  [ "$_ok" = 1 ] && return 0
+  if [ -e /etc/mr47be-die.fullrepair-ok ] && sav_live; then
+    _full_repair_wan && return 0
+  else
+    log "WAN-REPAIR(RESET) FAILED -> full repair DISABLED (no flag / K3); switch and LAN preserved"
+  fi
+  return 1; }
+
+repair_wan(){
+  mkdir "$REPAIRL" 2>/dev/null || { log "WAN-REPAIR already running, skipped"; return 0; }
+  _repair_wan; _rrc=$?
+  rmdir "$REPAIRL" 2>/dev/null
+  return $_rrc; }
+
+# v24: port4 (LAN1) used source 3 = the bypass/trunk clock.  At 1G the
+# div=4 still landed on a usable rate, but at 2.5G (div=1) the MAC got no
+# clock: PHY reg17 reported 2500 while the PHY tx counter stayed 0x0000
+# (LAN2/LAN3 use source 6 and work).  Make LAN1 identical to them.
+rt_src(){ case $1 in 1|2|3|4) echo 6;; *) echo -1;; esac; }
+rt_txcmd(){ echo $(( 0xc800040 + ($1 - 1) * 0x40 )); }
+rt_rxcmd(){ echo $(( 0xc800060 + ($1 - 1) * 0x40 )); }
+
+rt_spd(){ local _rt_s _rt_c
+  _rt_s=$(r16 "$1" 17) || return 1
+  [ -n "$_rt_s" ] || return 1
+  [ $(( _rt_s & 0x800 )) -eq 0 ] && return 1
+  _rt_c=$(( (_rt_s >> 7) & 7 ))
+  case $_rt_c in 4) echo 2500;; 2) echo 1000;; 1) echo 100;; *) return 1;; esac; }
+
+rt_want(){ local _rt_sc _rt_d
+  _rt_sc=$(rt_src "$1")
+  [ "$_rt_sc" -lt 0 ] && return 1
+  case $2 in 2500) _rt_d=1;; 1000) _rt_d=4;; 100) _rt_d=24;; *) return 1;; esac
+  echo $(( (_rt_sc << 8) | _rt_d )); }
+
+rt_ok(){ local _rt_d _rt_sc
+  [ -n "$1" ] || return 1
+  _rt_d=$(( $1 & 0x1f )); _rt_sc=$(( ($1 >> 8) & 7 ))
+  [ "$_rt_sc" -ne "$3" ] && return 1
+  case $2 in
+    2500) [ "$_rt_d" -le 1 ] && return 0;;
+    1000) [ "$_rt_d" -eq 4 ] && return 0;;
+    100)  [ "$_rt_d" -eq 24 ] && return 0;;
+  esac
+  return 1; }
+
+rt_set(){ # cmd cfg want -> write + READBACK verify, <=3 attempts.
+  local _rt_cm _rt_cf _rt_w _rt_rb _rt_k
+  _rt_cm=$1; _rt_cf=$2; _rt_w=$3; _rt_k=0; _rt_rb=""
+  while [ "$_rt_k" -lt 3 ]; do
+    _rt_k=$(( _rt_k + 1 ))
+    setrcg "$_rt_cm" "$_rt_cf" "$_rt_w"
+    _rt_rb=$(rd "$_rt_cf")
+    if [ -n "$_rt_rb" ] && [ "$_rt_rb" -eq "$_rt_w" ]; then
+      printf '0x%03x' "$_rt_rb"; return 0
+    fi
+    sleep 1
+  done
+  printf 'FAILED(read=%s)' "${_rt_rb:-?}"; return 1; }
+
+mb_base(){ echo $(( MB_GCC + 0x80 + ($1 - 2) * 0x40 )); }
+mb_psaddr(){ case $1 in 2) echo $PS2;; 3) echo $PS3;; *) echo "";; esac; }
+mb_sc(){ case $1 in 100) echo 1;; *) echo 2;; esac; }
+
+mb_div0(){ local _mb_v
+  _mb_v=$(rd "$1"); [ -n "$_mb_v" ] || return 1
+  [ "$_mb_v" -eq 0 ] && return 0
+  swwr "$1" 0; }
+
+mb_cbc(){ local _mb_v
+  _mb_v=$(rd "$1"); [ -n "$_mb_v" ] || return 1
+  swwr "$1" $(( (_mb_v & 0x7fffffff) | 1 )); }
+
+mb_rst(){ local _mb_v
+  _mb_v=$(rd "$1"); [ -n "$_mb_v" ] || return 1
+  swwr "$1" $(( _mb_v | 4 )); sleep 1
+  swwr "$1" $(( (_mb_v & 0x7ffffffb) | 1 )); }
+
+mb_psfix(){ local _mb_a _mb_v _mb_sc
+  _mb_a=$(mb_psaddr "$1"); [ -n "$_mb_a" ] || return 1
+  _mb_v=$(rd "$_mb_a"); [ -n "$_mb_v" ] || return 1
+  [ $(( _mb_v & 0x200 )) -ne 0 ] && return 0
+  _mb_sc=$(mb_sc "$2")
+  swwr "$_mb_a" $(( (_mb_v & ~0x4f) | 0x7c | _mb_sc )); }
+
+mac_bringup(){ # $1 = port (2|3). INITIAL SETUP: 6 steps. The reset pulse is ONLY here.
+  local _mb_p _mb_b _mb_s _mb_w _mb_o _mb_ok
+  _mb_p=$1
+  case $_mb_p in 2|3) ;; *) return 0;; esac
+  _mb_b=$(mb_base "$_mb_p")
+  _mb_s=$(rt_spd "$_mb_p")
+  [ -n "$_mb_s" ] || _mb_s=1000
+  _mb_w=$(rt_want "$_mb_p" "$_mb_s")
+  if [ -z "$_mb_w" ]; then
+    log "MAC-BRINGUP port$_mb_p SKIPPED (rate=${_mb_s}M unsupported)"; return 0
+  fi
+  _mb_ok=1
+  for _mb_o in 8 40 12 44; do mb_div0 $(( _mb_b + _mb_o )) || _mb_ok=0; done
+  for _mb_o in 0 32; do
+    rt_set "$(printf 0x%x $(( _mb_b + _mb_o )))" "$(printf 0x%x $(( _mb_b + _mb_o + 4 )))" "$_mb_w" >/dev/null || _mb_ok=0
+  done
+  for _mb_o in 20 52 24 56; do mb_cbc $(( _mb_b + _mb_o )) || _mb_ok=0; done
+  for _mb_o in 20 52; do mb_rst $(( _mb_b + _mb_o )) || _mb_ok=0; done
+  for _mb_o in 24 56; do mb_rst $(( _mb_b + _mb_o )) || _mb_ok=0; done
+  mb_psfix "$_mb_p" "$_mb_s" || _mb_ok=0
+  log "MAC-BRINGUP port$_mb_p speed=${_mb_s}M want=$(printf 0x%03x "$_mb_w") base=$(printf 0x%x "$_mb_b") ps=$(mb_psaddr "$_mb_p") ok=$_mb_ok"
+  return 0; }
+
+mb_guard(){ # $1=port(2|3) $2=rate. Idempotently repairs DIV/gephy CBCR/PS mismatch. NO RESET.
+  local _mg_b _mg_o _mg_v _mg_a _mg_sc _mg_hit
+  _mg_b=$(mb_base "$1"); _mg_hit=0
+  for _mg_o in 8 40 12 44; do
+    _mg_v=$(rd $(( _mg_b + _mg_o )))
+    if [ -n "$_mg_v" ] && [ "$_mg_v" -ne 0 ]; then swwr $(( _mg_b + _mg_o )) 0; _mg_hit=1; fi
+  done
+  for _mg_o in 24 56; do
+    _mg_v=$(rd $(( _mg_b + _mg_o )))
+    if [ -n "$_mg_v" ] && [ $(( _mg_v & 0x80000001 )) -ne 1 ]; then
+      swwr $(( _mg_b + _mg_o )) $(( (_mg_v & 0x7fffffff) | 1 )); _mg_hit=1
+    fi
+  done
+  _mg_a=$(mb_psaddr "$1")
+  if [ -n "$_mg_a" ]; then
+    _mg_v=$(rd "$_mg_a")
+    if [ -n "$_mg_v" ] && [ $(( _mg_v & 0x200 )) -eq 0 ]; then
+      _mg_sc=$(mb_sc "$2")
+      if [ $(( _mg_v & 0x0c )) -ne 12 ] || [ $(( _mg_v & 0x03 )) -ne "$_mg_sc" ]; then
+        swwr "$_mg_a" $(( (_mg_v & ~0x4f) | 0x7c | _mg_sc )); _mg_hit=1
+      fi
+    fi
+  fi
+  if [ "$_mg_hit" -eq 1 ]; then
+    log "MAC-GUARD port$1 speed=${2}M DIV/gephy/PS onarildi (reset YOK)"; return 0
+  fi
+  return 1; }
+
+rate_pass(){ # ONE pass: scan 4 ports, write only the direction whose RATE mismatches. Idempotent.
+  local _rt_p _rt_s _rt_sc _rt_w _rt_tc _rt_rc _rt_t _rt_r _rt_ot _rt_or _rt_a _rt_b _rt_msg _rt_g _rt_domb
+  MB_TICK=$(( MB_TICK + 1 ))
+  _rt_domb=0
+  [ $(( MB_TICK % MB_EVERY )) -eq 1 ] && _rt_domb=1
+  _rt_msg=""
+  for _rt_p in 1 2 3 4; do
+    _rt_sc=$(rt_src "$_rt_p"); _rt_tc=$(rt_txcmd "$_rt_p"); _rt_rc=$(rt_rxcmd "$_rt_p")
+    _rt_t=$(rd $(( _rt_tc + 4 ))); _rt_r=$(rd $(( _rt_rc + 4 )))
+    if [ -z "$_rt_t" ] || [ -z "$_rt_r" ]; then
+      _rt_msg="$_rt_msg p${_rt_p}=unreadable"; continue
+    fi
+    _rt_s=$(rt_spd "$_rt_p")
+    if [ -z "$_rt_s" ]; then
+      _rt_msg="$_rt_msg p${_rt_p}=no-link/10M"; continue
+    fi
+    _rt_w=$(rt_want "$_rt_p" "$_rt_s")
+    if [ -z "$_rt_w" ]; then
+      _rt_msg="$_rt_msg p${_rt_p}=${_rt_s}M-unsupported"; continue
+    fi
+    _rt_ot=1; _rt_or=1
+    rt_ok "$_rt_t" "$_rt_s" "$_rt_sc" && _rt_ot=0
+    rt_ok "$_rt_r" "$_rt_s" "$_rt_sc" && _rt_or=0
+    _rt_g=0
+    if [ "$_rt_domb" -eq 1 ]; then
+      case $_rt_p in
+        2|3) mb_guard "$_rt_p" "$_rt_s" && _rt_g=1;;
+        4)   p4_div_fix && _rt_g=1;;
+      esac
+    fi
+    if [ "$_rt_ot" -eq 0 ] && [ "$_rt_or" -eq 0 ]; then
+      if [ "$_rt_g" -eq 1 ]; then
+        _rt_msg="$_rt_msg p${_rt_p}=${_rt_s}M-GUARD"
+      else
+        _rt_msg="$_rt_msg p${_rt_p}=${_rt_s}M-OK"
+      fi
+      continue
+    fi
+    _rt_a="-"; _rt_b="-"
+    if [ "$_rt_ot" -eq 1 ]; then
+      _rt_a=$(rt_set "$(printf 0x%x "$_rt_tc")" "$(printf 0x%x $(( _rt_tc + 4 )))" "$_rt_w")
+    fi
+    if [ "$_rt_or" -eq 1 ]; then
+      _rt_b=$(rt_set "$(printf 0x%x "$_rt_rc")" "$(printf 0x%x $(( _rt_rc + 4 )))" "$_rt_w")
+    fi
+    log "RATE-FIX port$_rt_p speed=${_rt_s}M want=$(printf 0x%03x "$_rt_w") tx=$(printf 0x%03x "$_rt_t")->$_rt_a rx=$(printf 0x%03x "$_rt_r")->$_rt_b"
+    _rt_msg="$_rt_msg p${_rt_p}=${_rt_s}M-RETIME"
+  done
+  RATE_STATE="$_rt_msg"; }
+
+serdes_fix(){ # v20: QCA8084 SerDes 0x05 can latch 0x0180 after a
+  # 2500base-x <-> sgmii renegotiation (cable replug / speed change). The MAC
+  # then reports link up but passes no frames, so PPPoE/DHCP stall forever.
+  # Only touch it at 1G and only for the known stuck value.
+  [ "$(cat /sys/class/net/$(_wdev)/speed 2>/dev/null)" = "1000" ] || return 1
+  _sv=$(mdio "$BUS" phy 0x05 0x18 2>/dev/null) || return 1
+  _sv=$(printf '%s' "$_sv" | awk '{print $NF}')
+  case "$_sv" in 0x0180|0x180) ;; *) return 1;; esac
+  mdio "$BUS" phy 0x05 0x18 0x0080 >/dev/null 2>&1
+  mdio "$BUS" phy 0x05 0x00 0x1340 >/dev/null 2>&1
+  log "SERDES-FIX: 0x05 reg0x18 0x0180 -> 0x0080 (reg0x00=0x1340)"
+  return 0; }
+
+watch_wan(){
+  _p=$(cat "$WATCHF" 2>/dev/null)
+  [ -n "$_p" ] && [ -d "/proc/$_p" ] && exit 0
+  echo $$ > "$WATCHF"
+  log "WAN-BEKCI silahlandi (pid=$$, tur=${WATCH_ROUNDS:-0}=0 ise SURESIZ, aralik=${WATCH_GAP}sn)"
+  _i=0; _lanwas=0; _rt_tick=0
+  _rt_div=$(( WATCH_GAP / RATE_GAP )); [ "$_rt_div" -lt 1 ] && _rt_div=1
+  log "RATE-WATCHDOG active (rate interval=${RATE_GAP}s, WAN/LK pass every ${_rt_div} ticks ~= ${WATCH_GAP}s)"
+  while :; do
+    sleep "$RATE_GAP"
+    _rt_tick=$(( _rt_tick + 1 ))
+    if [ -e "$DONE" ] && is_switch; then rate_pass; fi
+    [ $(( _rt_tick % _rt_div )) -ne 0 ] && continue
+    _i=$(( _i + 1 ))
+    wan_phantom_fix && { _i=0; continue; }
+    serdes_fix
+    if wan_dead; then
+      if repair_wan; then _i=0; continue; fi
+      log "WATCHDOG: repair failed; monitoring CONTINUES (WAN may stay dead this boot, LAN preserved)"
+    fi
+    is_switch && lk_fix
+    if is_switch && [ "$(cat /sys/class/net/lan/carrier 2>/dev/null)" = 1 ] && lan_dead; then
+      if [ "$_lanwas" = 0 ]; then
+        log "LAN-DEAD: br-lan rx not advancing and known neighbour not responding (p2=$(phytx 2) p3=$(phytx 3) p4=$(phytx 4)); NO intervention, reload the device"
+        _lanwas=1
+      fi
+    else
+      _lanwas=0
+    fi
+    [ $(( _i % 20 )) -eq 0 ] && log "BEKCI-NABIZ tur=$_i wm=$(rd $WORK_MODE) route=$(ip route 2>/dev/null | grep -c '^default') lan_carrier=$(cat /sys/class/net/lan/carrier 2>/dev/null) p1=$(phytx 1) p2=$(phytx 2) p3=$(phytx 3) p4=$(phytx 4) termik=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)mC rate=$RATE_STATE"
+    [ "${WATCH_ROUNDS:-0}" -gt 0 ] && [ "$_i" -ge "${WATCH_ROUNDS}" ] && break
+  done
+  rm -f "$WATCHF"
+  exit 0; }
+
+arm_watch(){ setsid sh -c "$SRC watch" </dev/null >>/tmp/mr47be-die.watch.log 2>&1 & }
+
+ready(){ # FLIP READINESS GATE (WAN-independent evidence).
+  [ "$(cat /sys/class/net/lan/carrier 2>/dev/null)" = 1 ] || return 1
+  _u=$(cut -d. -f1 /proc/uptime); [ -n "$_u" ] || return 1
+  [ "$_u" -ge "$MIN_UPTIME" ] || return 1
+  if [ "$(cat /sys/class/net/$(_wface)/carrier 2>/dev/null)" = 1 ]; then
+    _w=$(cat "$STABF" 2>/dev/null)
+    if [ -z "$_w" ]; then echo "$_u" > "$STABF"; return 1; fi
+    [ $(( _u - _w )) -ge "$WAN_SETTLE" ] || return 1
+  else
+    rm -f "$STABF" 2>/dev/null
+  fi
+  return 0; }
+
+dsa_kmod(){ _k=$(ls "$KMODIR"/qca8386.ko* 2>/dev/null | head -1)
+  [ -n "$_k" ] || { log "DSA: qca8386.ko YOK ($KMODIR) - mod =m paketlenmemis?"; return 1; }
+  _o=$(insmod "$_k" 2>&1); _rc=$?
+  log "DSA-INSMOD $_k rc=$_rc ${_o:-temiz}"
+  return $_rc; }
+
+dsa_ports(){ for p in wan lan1 lan2 lan3; do [ -e "/sys/class/net/$p" ] || return 1; done; return 0; }
+
+dsa_wait(){ i=0; while [ $i -lt 25 ]; do dsa_ports && break; i=$(( i + 1 )); sleep 1; done
+  _p=""
+  for p in wan lan1 lan2 lan3; do [ -e "/sys/class/net/$p" ] && _p="$_p $p=VAR"; done
+  log "DSA-BEKLE i=${i}s${_p}"
+  dmesg | grep -iE 'qca8386|DSA' | tail -8 | while read -r l; do log "DMESG: $l"; done
+  dsa_ports; }
+
+dsa_net(){ # add lan1/2/3 to br-lan; move the 'wan' interface from gmac1 to the DSA port.
+  _didx=; _idx=0
+  while uci -q get "network.@device[$_idx]" >/dev/null 2>&1; do
+    [ "$(uci -q get "network.@device[$_idx].name")" = "br-lan" ] && { _didx=$_idx; break; }
+    _idx=$(( _idx + 1 ))
+  done
+  [ -n "$_didx" ] || { log "DSA-NET: br-lan device bolumu BULUNAMADI (uci degistirilmedi)"; return 1; }
+  _cur=$(uci -q get "network.@device[$_didx].ports"); _add=""
+  for p in lan1 lan2 lan3; do
+    case " $_cur " in *" $p "*) ;; *) uci add_list "network.@device[$_didx].ports=$p" >/dev/null; _add="$_add $p";; esac
+  done
+  uci -q del_list "network.@device[$_didx].ports=lan"
+  # v14: the WAN PHY is NOT owned by the switch fabric on this board.
+  # The package runs in qcom,package-mode=2 (PCS0 in SGMII-PHY mode), so
+  # PHY1 (WAN jack) is presented to the SoC MAC1 through PCS0 -> the real
+  # WAN device is 'gmac1'.  The DSA port 'wan' (switch port@1) therefore has
+  # no PHY behind it: it never gets a carrier and never carries a frame
+  # (LuCI showed it as "no link / 0 B", the ghost WAN).  Binding the WAN
+  # interface to that phantom port is what broke PPPoE.
+  # So: keep WAN on gmac1 and only add the real LAN ports to br-lan.
+  if uci -q get network.wan >/dev/null 2>&1; then
+    _wd=$(uci -q get network.wan.device)
+    case "$_wd" in
+      gmac1|wan|'') uci set network.wan.device='gmac1' >/dev/null; uci -q set network.wan.ifname='gmac1' >/dev/null;;
+      *) log "DSA-NET: wan.device='$_wd' user-defined -> left untouched";;
+    esac
+    uci -q get network.wan6 >/dev/null 2>&1 && uci set network.wan6.device='@wan' >/dev/null
+  else
+    log "DSA-NET: network.wan absent (user removed it) -> not recreated"
+  fi
+  uci commit network
+  log "DSA-NET added to br-lan:$_add | 'lan' removed | wan->DSA 'wan' | netifd reload (Wi-Fi SSH may drop briefly)"
+  /etc/init.d/network reload 2>&1 | while read -r l; do log "NETIFD: $l"; done; }
+
+dsa_undo_net(){ # revert: detach DSA ports, move wan back to gmac1
+  _didx=; _idx=0
+  while uci -q get "network.@device[$_idx]" >/dev/null 2>&1; do
+    [ "$(uci -q get "network.@device[$_idx].name")" = "br-lan" ] && { _didx=$_idx; break; }
+    _idx=$(( _idx + 1 ))
+  done
+  if [ -n "$_didx" ]; then
+    for p in lan1 lan2 lan3; do
+      _cur=$(uci -q get "network.@device[$_didx].ports")
+      case " $_cur " in *" $p "*) uci -q del_list "network.@device[$_didx].ports=$p";; esac
+    done
+    _cur=$(uci -q get "network.@device[$_didx].ports")
+    case " $_cur " in *" lan "*) ;; *) uci add_list "network.@device[$_didx].ports=lan" >/dev/null;; esac
+  else
+    log "DSA-UNDO: br-lan device bolumu BULUNAMADI (uci degistirilmedi!)"
+  fi
+  # v13: only undo what we own; a deleted or user-customised wan stays as-is.
+  if uci -q get network.wan >/dev/null 2>&1; then
+    _wd=$(uci -q get network.wan.device)
+    case "$_wd" in
+      wan|gmac1|'') uci set network.wan.device='gmac1' >/dev/null; uci -q set network.wan.ifname='gmac1' >/dev/null;;
+      *) log "DSA-UNDO: wan.device='$_wd' user-defined -> left untouched";;
+    esac
+    uci -q get network.wan6 >/dev/null 2>&1 && uci set network.wan6.device='@wan' >/dev/null
+  else
+    log "DSA-UNDO: network.wan absent (user removed it) -> not recreated"
+  fi
+  uci commit network; /etc/init.d/network reload >/dev/null 2>&1
+  log "DSA-UNDO: br-lan eskisine (lan) dondu, wan->gmac1"; }
+
+dsa_guard(){ # DSA verdict: ports exist + WAN internet + live data on at least one LAN jack.
+  _ok=1
+  dsa_ports || { log "DSA-GUARD FAIL: port eksik"; return 1; }
+  ping -c 3 -W 3 8.8.8.8 >/dev/null 2>&1 || { _ok=0; log "DSA-GUARD: inet YOK"; }
+  _l1=$(cat /sys/class/net/lan1/carrier 2>/dev/null)
+  _l2=$(cat /sys/class/net/lan2/carrier 2>/dev/null)
+  _l3=$(cat /sys/class/net/lan3/carrier 2>/dev/null)
+  _r1=$(cat /sys/class/net/lan1/statistics/rx_packets 2>/dev/null)
+  _r2=$(cat /sys/class/net/lan2/statistics/rx_packets 2>/dev/null)
+  _r3=$(cat /sys/class/net/lan3/statistics/rx_packets 2>/dev/null)
+  sleep 6
+  _R1=$(cat /sys/class/net/lan1/statistics/rx_packets 2>/dev/null)
+  _R2=$(cat /sys/class/net/lan2/statistics/rx_packets 2>/dev/null)
+  _R3=$(cat /sys/class/net/lan3/statistics/rx_packets 2>/dev/null)
+  _x1=$(( ${_R1:-0} - ${_r1:-0} )); _x2=$(( ${_R2:-0} - ${_r2:-0} )); _x3=$(( ${_R3:-0} - ${_r3:-0} ))
+  bc=$(bcast); [ -n "$bc" ] && ping -c 6 -b -i 1 "$bc" >/dev/null 2>&1
+  sleep 2
+  _y1=$(cat /sys/class/net/lan1/statistics/rx_packets 2>/dev/null)
+  _y2=$(cat /sys/class/net/lan2/statistics/rx_packets 2>/dev/null)
+  _y3=$(cat /sys/class/net/lan3/statistics/rx_packets 2>/dev/null)
+  _z1=$(( ${_y1:-0} - ${_R1:-0} )); _z2=$(( ${_y2:-0} - ${_R2:-0} )); _z3=$(( ${_y3:-0} - ${_R3:-0} ))
+  _wm=$(rd $WORK_MODE); _lk5=$(rd $LK5); _fw0=$(rd $FW0); _a8=$(rd $ACLA8)
+  log "DSA-GUARD wm=${_wm:+0x$(printf %08x $_wm)} FW0=${_fw0:+0x$(printf %08x $_fw0)} LK5=${_lk5:+0x$(printf %08x $_lk5)} ACLA8=${_a8:+0x$(printf %08x $_a8)} inet_sw=$_ok lan1=${_l1}/rx6sn=$_x1/bc=$_z1 lan2=${_l2}/rx6sn=$_x2/bc=$_z2 lan3=${_l3}/rx6sn=$_x3/bc=$_z3"
+  [ "$_ok" = 1 ]; }
+
+dsa_repair(){ # AFTER the driver pulses core/MAC reset, bring up the SerDes-port5 interface
+  m0=$(todec "$(mmdr $UPHY $UMODE)"); [ -n "$m0" ] && mmdw $UPHY $UMODE "$(printf 0x%04x $(( (m0 & ~0x30) | 0x20 )))"
+  sw_rmw $MUX 0x3 0x3
+  g_r0=$(r16 $UDEVD 0); g_r6=$(r16 $UDEVD 6)
+  [ -n "$g_r6" ] && w16 $UDEVD 6 $(( g_r6 | UPLL_IBSEL ))
+  if [ -n "$g_r0" ]; then w16 $UDEVD 0 $(( g_r0 & ~UANA )); sleep 0.05 2>/dev/null; w16 $UDEVD 0 $(( g_r0 | UANA )); fi
+  i=0; while [ $i -lt 60 ]; do c=$(todec "$(mmdr $UPHY $UCAL)"); [ -n "$c" ] && [ $(( c & UCAL_DONE )) -ne 0 ] && break; i=$(( i + 1 )); sleep 0.02 2>/dev/null; done
+  g_c0=$(todec "$(mmdr $UPHY $UCH0)"); g_f0=$(todec "$(mmdr $UPHY $UFUNC)")
+  [ -n "$g_c0" ] && { mmdw $UPHY $UCH0 "$(printf 0x%04x $(( g_c0 & ~UADPT )))"; sleep 0.05 2>/dev/null; mmdw $UPHY $UCH0 "$(printf 0x%04x $(( g_c0 | UADPT )))"; }
+  [ -n "$g_f0" ] && { mmdw $UPHY $UFUNC "$(printf 0x%04x $(( g_f0 & ~UFUNC_RST )))"; sleep 0.05 2>/dev/null; mmdw $UPHY $UFUNC "$(printf 0x%04x $(( g_f0 | UFUNC_RST )))"; }
+  log "DSA-REPAIR run attempt=$i 11b=$(mmdr $UPHY $UMODE) DP=$(mmdr $UPHY $UDATA) MUX=$(rd $MUX)"; }
+
+dsa_apply_tail(){ # called AFTER the flip bring-up (steps 1..4b) is done.
+  log "DSA-TAIL: FW/LK/PS left to driver, ACL replay + insmod"
+  acl_set $ACL_A8_LAN $ACL_A4_WANT || log "DSA-TAIL: ACL replay FAILED (continuing)"
+  dsa_kmod || { log "DSA-TAIL: insmod duser -> REVERT"; restore; exit 1; }
+  if ! dsa_wait; then
+    log "DSA-TAIL: DSA portlari OLUSMADI -> rmmod + REVERT"
+    rmmod qca8386 2>/dev/null; restore; exit 1
+  fi
+  dsa_net
+  sleep 30
+  if dsa_guard; then log "DSA-1 OK (portlar + inet)"; exit 0; fi
+  log "DSA-1 DOWN -> SerDes-port5 interface re-established after core reset"
+  dsa_repair; sleep 20
+  if dsa_guard; then log "DSA-2 OK (repair sonrasi)"; exit 0; fi
+  log "DSA FAIL -> rmmod + revert + wan gmac1'e aliniyor"
+  : > "$FAIL"; rmmod qca8386 2>/dev/null; dsa_undo_net; restore; sleep 3
+  log "DSA-REVERT KANITI WORK_MODE=$(rd $WORK_MODE) MUX=$(rd $MUX) ACLA8=$(rd $ACLA8) lan_carrier=$(cat /sys/class/net/lan/carrier 2>/dev/null)"
+  exit 1; }
+
+guard(){ # Three measurements, none of them can be confused with client state:
+  inet=0; ping -c 3 -W 3 8.8.8.8 >/dev/null 2>&1 && inet=1
+  wanpre=$(cat "$WANPRE" 2>/dev/null); case "$wanpre" in 1) wanpre=1;; *) wanpre=0;; esac
+  carr=$(cat /sys/class/net/lan/carrier 2>/dev/null)
+  a0=$(wanrx); [ -n "$a0" ] || a0=0; sleep 2; a1=$(wanrx); [ -n "$a1" ] || a1=$a0
+  amb=$(( a1 - a0 )); [ $amb -lt 0 ] && amb=0
+  bc=$(bcast)
+  l0=$(phytx 4); q20=$(phytx 2); q30=$(phytx 3); l1=""
+  ping6 -c 6 -i 1 ff02::1%br-lan >/dev/null 2>&1
+  [ -n "$bc" ] && ping -c 6 -b -i 1 "$bc" >/dev/null 2>&1
+  sleep 2; l1=$(phytx 4); q21=$(phytx 2); q31=$(phytx 3)
+  f0=$(wanrx); [ -n "$f0" ] || f0=0; sleep 6; f1=$(wanrx); [ -n "$f1" ] || f1=$f0
+  leak=$(( f1 - f0 )); [ $leak -lt 0 ] && leak=0
+  limit=$(( amb * 10 + 1200 ))
+  lan1=-1; [ -n "$l0" ] && [ -n "$l1" ] && lan1=$(( (l1 - l0) & 0xffff ))
+  lan1lk=$(phyclink 4); [ -n "$lan1lk" ] || lan1lk=-1
+  lan2=-1; [ -n "$q20" ] && [ -n "$q21" ] && lan2=$(( (q21 - q20) & 0xffff ))
+  lan3=-1; [ -n "$q30" ] && [ -n "$q31" ] && lan3=$(( (q31 - q30) & 0xffff ))
+  lan2lk=$(phyclink 2); [ -n "$lan2lk" ] || lan2lk=-1
+  lan3lk=$(phyclink 3); [ -n "$lan3lk" ] || lan3lk=-1
+  best=0; n=0
+  for c in $(lan_clients); do
+    n=$(( n + 1 ))
+    r=$(ping -c 4 -i 1 -W 1 $c 2>/dev/null | sed -n 's/.*, \([0-9]*\) packets received.*/\1/p')
+    [ -z "$r" ] && r=0
+    [ $r -gt $best ] && best=$r
+  done
+  log "GUARD inet=$inet wanpre=$wanpre lan_carrier=$carr wan_amb2sn=$amb wan leak6sn=$leak/limit=$limit neigh=$n best_rx=$best/4 lan1_tx=$lan1 lan1_link=$lan1lk phy2_tx=$lan2 phy2_link=$lan2lk phy3_tx=$lan3 phy3_link=$lan3lk"
+  _ik=""
+  [ "$lan1lk" = 1 ] && [ "$lan1" = 0 ] && _ik="$_ik lan1"
+  [ "$lan2lk" = 1 ] && [ "$lan2" = 0 ] && _ik="$_ik lan2"
+  [ "$lan3lk" = 1 ] && [ "$lan3" = 0 ] && _ik="$_ik lan3"
+  [ -n "$_ik" ] && log "GUARD INFO: link=1 tx=0 jack(s):$_ik -> NOT counted as FAIL (empty jack / no client)"
+  [ "$carr" = 1 ] && [ $leak -le $limit ] \
+    && ! { [ "$wanpre" = 1 ] && [ $inet -eq 0 ]; }; }
+
+do_status(){ wm=$(rd $WORK_MODE); mx=$(rd $MUX); p5=$(rd $P5_TXCBCR); l5=$(rd $LK5); a8=$(rd $ACLA8)
+  f0=$(rd $FW0); f1=$(rd $FW1); p4=$(rd $PS4)
+  printf 'WORK_MODE=%s MUX=%s MAC5_TX_CBCR=%s FW0=%s FW1=%s LK5=%s PS4=%s ACLA8=%s UNIPHY0_11b=%s done=%s\n' \
+    "${wm:+0x$(printf %08x $wm)}" "${mx:+0x$(printf %08x $mx)}" "${p5:+0x$(printf %08x $p5)}" \
+    "${f0:+0x$(printf %08x $f0)}" "${f1:+0x$(printf %08x $f1)}" \
+    "${l5:+0x$(printf %08x $l5)}" "${p4:+0x$(printf %08x $p4)}" "${a8:+0x$(printf %08x $a8)}" \
+    "$(mmdr $UPHY $UMODE)" \
+    "$([ -e "$DONE" ] && echo EVET || echo HAYIR)"; \
+  if [ -e "$DSA_MARK" ]; then
+    printf 'DSA=VAR mod=%s ports:' "$(ls "$KMODIR"/qca8386.ko* 2>/dev/null | head -1)"
+    for p in wan lan1 lan2 lan3; do printf ' %s=%s' "$p" "$([ -e /sys/class/net/$p ] && echo VAR || echo YOK)"; done
+    printf ' lan_brlan=%s wan_dev=%s\n' \
+      "$(uci -q get network.@device[0].ports 2>/dev/null)" \
+      "$(uci -q get network.wan.ifname 2>/dev/null || uci -q get network.wan.device 2>/dev/null)"
+  fi; }
+
+do_apply(){ # hotplug + init.d may run concurrently: if the second `save` catches converted values
+  mkdir "$LOCK" 2>/dev/null || { log "apply already running, skipped"; exit 0; }
+  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
+  [ -e "$DONE" ] && { log "apply skipped again"; exit 0; }
+  _try=$(cat "$TRY" 2>/dev/null); _try=${_try:-0}
+  [ "$_try" -ge "$ATTEMPTS" ] && { log "attempt limit ($_try/$ATTEMPTS) reached, flip not attempted"; exit 0; }
+  [ -e "$GATE" ] || { log "flip DISABLED ($GATE missing) - no register touched"; exit 0; }
+  wm=$(rd $WORK_MODE)
+  [ -n "$wm" ] || { log "could not read (no MDIO window?), untouched"; exit 1; }
+  if [ $(( wm & 0x3f )) -ne 32 ]; then log "WORK_MODE=0x$(printf %08x $wm) not bypass, untouched"; : > "$DONE"; exit 0; fi
+  _now=$(cut -d. -f1 /proc/uptime)
+  _t0=$(cat "$STARTF" 2>/dev/null); [ -n "$_t0" ] || { _t0=$_now; echo "$_now" > "$STARTF"; }
+  _el=$(( _now - _t0 )); [ $_el -lt 0 ] && _el=0
+  if ! ready; then
+    if [ $_el -lt $WAN_WAIT ]; then
+      log "NOT READY (el=${_el}s, attempt $_try/$ATTEMPTS) -> re-check in 10 s"
+      rmdir "$LOCK" 2>/dev/null
+      setsid sh -c "sleep 10; $SRC apply" </dev/null >/dev/null 2>&1 &
+      exit 0
+    fi
+    log "READINESS TIMED OUT (${_el}s > ${WAN_WAIT}s) -> flip not attempted this boot"; : > "$DONE"; exit 0
+  fi
+  log "READY (el=${_el}s) -> flip attempt $(( _try + 1 ))/$ATTEMPTS"
+  _try=$(( _try + 1 )); echo "$_try" > "$TRY"
+  _wi=0; ping -c 3 -W 3 8.8.8.8 >/dev/null 2>&1 && _wi=1
+  echo "$_wi" > "$WANPRE"; log "WANPRE=$_wi (flip oncesi 8.8.8.8)"
+  save
+  log "ONCE WORK_MODE=0x$(printf %08x $wm)"
+  swwr $WORK_MODE $(( (wm & ~0x3f) | 0x10 ))
+  m0=$(todec "$(mmdr $UPHY $UMODE)"); _b11b=$(mmdr $UPHY $UMODE)
+  if [ -n "$m0" ]; then
+    mmdw $UPHY $UMODE "$(printf 0x%04x $(( (m0 & ~0xc30) | 0x0820 )))"
+    log "SGMIIFORCE-11b: before=${_b11b:-?} now=$(mmdr $UPHY $UMODE) (wanted 0x0820)"
+  fi
+  sw_rmw $MUX 0x3 0x3
+  setrcg $P5_TXCMD $P5_TXRCG $RCG_P5TX; cbc_en $P5_TXCBCR $P5_TXCMD
+  setrcg $P5_RXCMD $P5_RXRCG $RCG_P5RX; cbc_en $P5_RXCBCR $P5_RXCMD
+  setrcg $P4_TXCMD $P4_TXRCG $RCG_P4TX; cbc_en $P4_TXCBCR $P4_TXCMD
+  setrcg $P4_RXCMD $P4_RXRCG $RCG_P4TX; cbc_en $P4_RXCBCR $P4_RXCMD
+  p4_div_fix
+  g_acc=$(rd $MEMACC); g_ctrl=$(rd $MEMC); g_r0=$(r16 $UDEVD 0); g_r6=$(r16 $UDEVD 6)
+  log "KOLG-ONCE ACC=${g_acc:+0x$(printf %08x $g_acc)} CTRL=${g_ctrl:+0x$(printf %08x $g_ctrl)} MII0=${g_r0:+0x$(printf %04x $g_r0)} MII6=${g_r6:+0x$(printf %04x $g_r6)}"
+  if [ -n "$g_acc" ]; then
+    sw_rmw $MEMC $DVS_MASK $DVS_RAWA
+    swwr $MEMACC $MEMACC_SWITCH
+    g_new=$(rd $MEMACC); g_ctrl1=$(rd $MEMC)
+    log "KOLG-ACC: before=0x$(printf %08x $g_acc) now=${g_new:+0x$(printf %08x $g_new)} CTRL=${g_ctrl1:+0x$(printf %08x $g_ctrl1)}"
+  else
+    log "KOLG-ACC: MEM_ACC_0 unreadable -> not written"
+  fi
+  [ -n "$g_r6" ] && w16 $UDEVD 6 $(( g_r6 | UPLL_IBSEL ))
+  if [ -n "$g_r0" ]; then
+    w16 $UDEVD 0 $(( g_r0 & ~UANA )); _t0=$(cut -d. -f1 /proc/uptime); sleep 1; w16 $UDEVD 0 $(( g_r0 | UANA ))
+    log "KOLG-MAIN: MII0=0x$(printf %04x $g_r0) hold=1 s (before=${_t0} s, after=$(cut -d. -f1 /proc/uptime) s, now=0x$(printf %04x $(r16 $UDEVD 0)))"
+  else
+    log "KOLG-MAIN: MII0 unreadable -> pulse SKIPPED"
+  fi
+  i=0; g_cal=""
+  while [ $i -lt 5 ]; do
+    g_cal=$(todec "$(mmdr $UPHY $UCAL)")
+    [ -n "$g_cal" ] && [ $(( g_cal & UCAL_DONE )) -ne 0 ] && break
+    i=$(( i + 1 )); sleep 1
+  done
+  g_c0=$(todec "$(mmdr $UPHY $UCH0)"); g_f0=$(todec "$(mmdr $UPHY $UFUNC)")
+  if [ -n "$g_c0" ]; then
+    mmdw $UPHY $UCH0 "$(printf 0x%04x $(( g_c0 & ~UADPT )))"; sleep 1
+    mmdw $UPHY $UCH0 "$(printf 0x%04x $(( g_c0 | UADPT )))"
+  fi
+  if [ -n "$g_f0" ]; then
+    mmdw $UPHY $UFUNC "$(printf 0x%04x $(( g_f0 & ~UFUNC_RST )))"; sleep 1
+    mmdw $UPHY $UFUNC "$(printf 0x%04x $(( g_f0 | UFUNC_RST )))"
+  fi
+  g_11b=$(todec "$(mmdr $UPHY $UMODE)"); g_dp=$(todec "$(mmdr $UPHY $UDATA)")
+  log "KOLG-LAST CAL=${g_cal:+0x$(printf %04x $g_cal)} attempt=$i DP=${g_dp:+0x$(printf %04x $g_dp)} 11b=${g_11b:+0x$(printf %04x $g_11b)} CH0=${g_c0:+0x$(printf %04x $g_c0)} FNC=${g_f0:+0x$(printf %04x $g_f0)} ACC=${g_new:+0x$(printf %08x $g_new)}"
+  [ -e "$DSA_MARK" ] && dsa_apply_tail
+  sw_rmw $FW0 $FW_CPU_EN $FW_CPU_EN
+  sw_rmw $FW1 $FW_DP_MASK $FW_DP_VAL
+  sw_rmw $LK0 0x7f 0x02; sw_rmw $LK1 0x7f 0x01; sw_rmw $LK2 0x7f 0x38
+  sw_rmw $LK3 0x7f 0x34; sw_rmw $LK4 0x7f 0x2c; sw_rmw $LK5 0x7f 0x1c
+  p0=$(rd $PS0); c5=$(rd $PS5); c4=$(rd $PS4)
+  [ -n "$p0$c5" ] && swwr $PS5 $(( (c5 & ~(PS_SET | 0x200)) | (p0 & PS_SET) ))
+  if [ -n "$c4" ] && [ $(( c4 & 0x200 )) -eq 0 ]; then
+    if [ $(( c4 & 0x03 )) -eq 0 ]; then
+      sw_rmw $PS4 $(( 0x0c | (p0 & 0x43) )) $(( 0x0c | (p0 & 0x43) ))
+      log "PS4 speed code empty -> CPU face class overflow (p0 speed/duplex=0x$(printf %02x $(( p0 & 0x43 ))))"
+    else
+      sw_rmw $PS4 0x0c 0x0c
+    fi
+  else
+    log "PS4 LINK_EN=1 or unreadable -> left to hardware, untouched"
+  fi
+  h0=$(rd $HDR0); [ -n "$h0" ] && swwr $HDR5 "$h0"
+  mac_bringup 2
+  mac_bringup 3
+  acl_set $ACL_A8_LAN $ACL_A4_WANT
+  lk_fix
+  : > "$DONE"
+  sleep 2; log "APPLIED WORK_MODE=$(rd $WORK_MODE) MUX=$(rd $MUX) FW0=$(rd $FW0) FW1=$(rd $FW1) LK5=$(rd $LK5) PS4=$(rd $PS4) PS5=$(rd $PS5) ACLA4=$(rd $ACLA4) ACLA8=$(rd $ACLA8) ACLR16=$(rd $ACLR16)"
+  sleep 30
+  lk_fix
+  if guard; then log "BEKCI-1 OK (flip+VID+ACL)"; arm_watch; exit 0; fi
+  log "WATCHDOG-1 DOWN -> ACL entry replayed"
+  acl_set $ACL_A8_LAN $ACL_A4_WANT; sleep 30
+  if guard; then log "WATCHDOG-2 OK (ACL replayed)"; arm_watch; exit 0; fi
+  sleep 40
+  if guard; then log "BEKCI-3 OK (ACL halen gerekiyor)"; arm_watch; exit 0; fi
+  log "BEKCI DUS TU -> REVERT"; : > "$FAIL"; restore; sleep 3
+  echo "MR47BE-DIE: switch-mode revert (watchdog failed)" > /dev/kmsg
+  log "REVERT KANITI WORK_MODE=$(rd $WORK_MODE) MUX=$(rd $MUX) FW1=$(rd $FW1) PS4=$(rd $PS4) PS5=$(rd $PS5) ACLA8=$(rd $ACLA8)"
+  rm -f "$DONE"; rmdir "$LOCK" 2>/dev/null
+  _n=$(cat "$TRY" 2>/dev/null); _n=${_n:-0}
+  log "flip failed ($_n/$ATTEMPTS) -> stayed in bypass, will not retry"; exit 0; }
+
+case "$ACTION" in
+  apply) do_apply;;
+  revert) restore && log "manuel revert"; rm -f "$DONE"; rmdir "$LOCK" 2>/dev/null; echo 0 > "$TRY";;
+  wanreset) wan_reset;;
+  lanfix) lk_fix;;
+  rate) rate_pass; echo "RATE=$RATE_STATE";;
+  status) do_status;;
+  guard) guard;;
+  watch) watch_wan;;
+  repair) repair_wan;;
+  arm) arm_watch;;
+  *) exit 2;;
+esac
diff --git a/package/network/mr47be-die-switch/files/mr47be-die-switch.init b/package/network/mr47be-die-switch/files/mr47be-die-switch.init
new file mode 100644
index 0000000..ec15006
--- /dev/null
+++ b/package/network/mr47be-die-switch/files/mr47be-die-switch.init
@@ -0,0 +1,20 @@
+#!/bin/sh /etc/rc.common
+# Fallback path: if the 'lan' hotplug hook never runs (e.g. netifd is late), apply
+# here. apply protects itself with a single-shot gate ($DONE) and a WORK_MODE check;
+# the primary channel is /etc/hotplug.d/net because rc.d runs after kmodloader.
+START=21
+STOP=90
+
+boot() {
+	start
+}
+
+start() {
+	i=0
+	while [ ! -e /sys/class/net/lan ] && [ $i -lt 30 ]; do i=$(( i + 1 )); sleep 1; done
+	/usr/sbin/mr47be-die-switch apply >/dev/null 2>&1 &
+}
+
+stop() {
+	/usr/sbin/mr47be-die-switch revert >/dev/null 2>&1
+}
