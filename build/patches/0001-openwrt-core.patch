+.vt-help-pop[hidden] { display: none; }
+
+/* a heading that repeats the breadcrumb or its tab (menu-vantage.js):
+   gone from view, still a heading for screen readers */
+.vt-repeat {
+	position: absolute !important;
+	width: 1px; height: 1px; min-height: 0 !important;
+	margin: -1px !important; padding: 0 !important; border: 0 !important;
+	overflow: hidden; clip-path: inset(50%); white-space: nowrap;
+}
+.cbi-value.cbi-value-error .cbi-value-title,
+.cbi-value-field .cbi-input-invalid + .cbi-value-description { color: var(--err); }
+
+.cbi-section-create {
+	display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-2);
+	margin-top: var(--sp-3);
+}
+.cbi-section-create > * { margin: 0; }
+.cbi-section-create > .cbi-section-create-name { max-width: 240px; }
+.cbi-section-remove { text-align: right; padding: var(--sp-2) 0; }
+/* several nodes of one typed section in a card: a rule between them */
+.cbi-section-node + :is(.cbi-section-node, .cbi-section-remove) { margin-top: var(--sp-5); padding-top: var(--sp-5); border-top: 1px solid var(--line); }
+
+/* page actions: a floating command bar docked to the bottom right */
+.cbi-page-actions {
+	position: sticky; bottom: var(--sp-4); z-index: 150;
+	display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--sp-2);
+	width: fit-content; max-width: 100%;
+	margin: var(--sp-6) 0 0 auto;
+	padding: 6px;
+	background: color-mix(in srgb, var(--s1) 86%, transparent);
+	backdrop-filter: saturate(1.3) blur(14px);
+	-webkit-backdrop-filter: saturate(1.3) blur(14px);
+	border: 1px solid var(--line-2);
+	border-radius: var(--r-lg);
+	box-shadow: var(--shadow-pop);
+}
+.cbi-page-actions > * { margin: 0 !important; }
+.cbi-page-actions > form { display: contents; }
+.cbi-page-actions .cbi-button-reset { order: 1; }
+.cbi-page-actions .cbi-button-save { order: 2; }
+.cbi-page-actions .cbi-button-apply, .cbi-page-actions .cbi-dropdown { order: 3; }
+.cbi-page-actions:empty { display: none; }
+/* the bar sits at the bottom of the view (docked, or the page's end), so
+   its Save & Apply menu opens upwards; LuCI's touch branch would open it
+   down, under the phone's bottom bar and past the screen */
+.cbi-page-actions .cbi-dropdown[open] > ul.dropdown {
+	top: auto !important; bottom: 100% !important;
+	max-height: 50vh !important;
+}
+/* LuCI moves focus into the list when its max-height transition ends, and
+   the 50vh !important above left nothing to transition, so arrow keys never
+   reached "Apply unchecked". A length (not none) on the closed list gives
+   the open one a change to run */
+.cbi-page-actions .cbi-dropdown > ul:not(.dropdown) { max-height: 100vh; }
+
+/* ------------------------------------------------------------ 6. widgets */
+
+/* zero specificity, like the button rule below, which must win over it */
+:where(input, select, textarea, button) { font: inherit; color: inherit; }
+
+.cbi-input-text, .cbi-input-password, .cbi-input-select, .cbi-input-textarea,
+.cbi-section-create-name, .vt-main select, .vt-main textarea,
+.vt-main input[type="text"], .vt-main input[type="password"], .vt-main input[type="number"],
+.vt-main input[type="email"], .vt-main input[type="url"], .vt-main input[type="search"],
+.vt-main input[type="date"], .vt-main input[type="time"], .vt-main input[type="datetime-local"],
+.vt-main input:not([type]), .modal input[type="text"], .modal input[type="password"], .modal input:not([type]), .modal select, .modal textarea {
+	width: 100%;
+	max-width: var(--field-max);
+	min-height: var(--ctl-h);
+	padding: 5px 10px;
+	background: var(--s2);
+	color: var(--text);
+	border: 1px solid var(--line-2);
+	border-radius: var(--r);
+	font-size: var(--fs-base);
+	line-height: 20px;
+	transition: border-color .12s, box-shadow .12s;
+}
+.vt-main textarea, .cbi-input-textarea, .modal textarea { max-width: 100%; min-height: 88px; font-family: var(--mono); font-size: var(--fs-sm); resize: vertical; }
+/* read-only text (System and Kernel log) is a viewer, not a field: full width */
+.vt-main textarea[readonly] { max-width: none; }
+/* System notes follow the neighbouring single-line fields. */
+body[data-page="admin-system-system"] .cbi-value[data-name="notes"] textarea { max-width: var(--field-max); }
+.vt-main select, .cbi-input-select, .modal select {
+	appearance: none; -webkit-appearance: none;
+	padding-right: 30px;
+	background-image: linear-gradient(45deg, transparent 50%, var(--text-3) 50%), linear-gradient(135deg, var(--text-3) 50%, transparent 50%);
+	background-position: calc(100% - 15px) 50%, calc(100% - 10px) 50%;
+	background-size: 5px 5px, 5px 5px;
+	background-repeat: no-repeat;
+}
+/* a native select in a form row cuts a long choice off without an
+   ellipsis: let it grow past --field-max to fit (field-sizing: the chosen
+   value; elsewhere the widest option), never past its column */
+.cbi-value > .cbi-value-field > select:not([multiple]), .cbi-value > .cbi-value-field > div > select:not([multiple]) {
+	field-sizing: content;
+	width: auto; min-width: min(100%, var(--field-max)); max-width: 100%;
+}
+/* a listbox (multiple, or size above 1) has no arrow, in a page or a
+   modal (replaces `.vt-main select[multiple]`) */
+:is(.vt-main, .modal) select:is([multiple], [size]:not([size="1"])):not(.vt-app *) { background-image: none; padding-right: 10px; }
+/* adblock (DNS Report -> Refresh...) and banIP (Set Reporting -> Set
+   Content...) give the <label> around their select the select's class:
+   the label stays a label, not a second field with its own arrow */
+label.cbi-input-select {
+	display: block;
+	width: auto; max-width: none; min-height: 0;
+	padding: 0;
+	background: none;
+	border: 0; border-radius: 0;
+	transition: none;
+}
+input::placeholder, textarea::placeholder { color: var(--text-3); opacity: 1; }
+input:hover, select:hover, textarea:hover { border-color: var(--text-3); }
+input:focus, select:focus, textarea:focus {
+	outline: none;
+	border-color: var(--accent-line);
+	box-shadow: 0 0 0 3px var(--accent-soft);
