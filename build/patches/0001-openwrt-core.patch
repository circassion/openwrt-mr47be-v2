diff --git a/package/luci/luci-theme-vantage/root/etc/config/vantage_theme b/package/luci/luci-theme-vantage/root/etc/config/vantage_theme
new file mode 100644
index 0000000..0d4e591
--- /dev/null
+++ b/package/luci/luci-theme-vantage/root/etc/config/vantage_theme
@@ -0,0 +1,15 @@
+# Vantage theme settings (luci-theme-vantage).
+#
+# Appearance for every browser on this router, as picked under the theme's
+# Appearance button; an option left out keeps each browser's own pick:
+#
+#   option theme 'auto'       auto, light or dark
+#   option login 'grid'       the login page's background: grid, stars or none
+#   option backdrop 'grid'    the dashboard's network path background, likewise
+#   option brand 'none'       next to the logo: none, hostname or model
+#
+# The dashboard's Customize saves here too: its chart style (option chart) and
+# one layout per screen size (option layout_wide, layout_mid, layout_narrow and
+# the same with _wired), which are best changed there.
+
+config appearance 'appearance'
diff --git a/package/luci/luci-theme-vantage/root/etc/uci-defaults/30_luci-theme-vantage b/package/luci/luci-theme-vantage/root/etc/uci-defaults/30_luci-theme-vantage
new file mode 100755
index 0000000..1a6ce0d
--- /dev/null
+++ b/package/luci/luci-theme-vantage/root/etc/uci-defaults/30_luci-theme-vantage
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Register the Vantage theme with LuCI (System -> Language and Style).
+# Select it only on a fresh install and only when the entry is new, so an
+# upgrade or a reinstall never overrides the theme the administrator chose.
+
+new=0
+if [ -z "$(uci -q get luci.themes.Vantage)" ]; then
+	new=1
+fi
+uci -q set luci.themes.Vantage=/luci-static/vantage || exit 1
+
+if [ "$PKG_UPGRADE" != 1 ] && [ "$new" = 1 ]; then
+	uci -q set luci.main.mediaurlbase=/luci-static/vantage
+fi
+
+uci -q commit luci
+exit 0
