+.v-nft-stage[data-drops="open"] .v-nft-stage-name small { color: var(--text-2); }
+.v-nft-stage-chains { display: flex; flex-wrap: wrap; gap: 4px; min-width: 0; }
+.v-nft-none { color: var(--text-3); font-size: var(--fs-micro); }
+.v-nft-link {
+	display: inline-flex; align-items: center; flex-wrap: wrap; gap: 0 4px;
+	min-height: 22px; max-width: 100%; margin: 0; padding: 1px 7px;
+	background: var(--s1); color: var(--text);
