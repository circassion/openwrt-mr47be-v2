--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/702-ath12k-fw-req-logging.patch
@@ -0,0 +1,45 @@
+From: auto <openwrt@local>
+Date: Sun, 02 Nov 2026 22:30:00 +0300
+Subject: [PATCH] ath12k: log every firmware request path and CAL download result
+
+Diagnostic only (test018). ath12k uses firmware_request_nowarn(), so a missing
+firmware file is silent and the CAL branch only reports the error code of the
+fallback request. Print the full request path with hit/miss and error code, and
+report which CAL file was chosen plus the QMI download result code.
+
+No behavior change.
+diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
+--- a/drivers/net/wireless/ath/ath12k/core.c
++++ b/drivers/net/wireless/ath/ath12k/core.c
+@@ -290,8 +290,11 @@
+ 	ath12k_core_create_firmware_path(ab, file, path, sizeof(path));
+ 
+ 	ret = firmware_request_nowarn(&fw, path, ab->dev);
+-	if (ret)
++	if (ret) {
++		ath12k_warn(ab, "fwreq: MISS %s ret=%d\n", path, ret);
+ 		return ERR_PTR(ret);
++	}
++	ath12k_warn(ab, "fwreq: HIT %s size=%zu\n", path, fw->size);
+ 
+ 	ath12k_dbg(ab, ATH12K_DBG_BOOT, "boot firmware request %s size %zu\n",
+ 		   path, fw->size);
+diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
+--- a/drivers/net/wireless/ath/ath12k/qmi.c
++++ b/drivers/net/wireless/ath/ath12k/qmi.c
+@@ -3119,10 +3119,14 @@
+ 			fw_size = min_t(u32, ab->hw_params->fw.board_size,
+ 					fw_entry->size);
+ 			tmp = fw_entry->data;
++			ath12k_warn(ab, "fwreq: CAL use %s fw_size=%u board_size=%zu eeprom_caldata=%u\n",
++				    filename, fw_size,
++				    ab->hw_params->fw.board_size,
++				    ab->qmi.target.eeprom_caldata);
+ 		}
+ 		ret = ath12k_qmi_load_file_target_mem(ab, tmp, fw_size, file_type);
+ 		if (ret < 0) {
+-			ath12k_warn(ab, "qmi failed to load caldata\n");
++			ath12k_warn(ab, "qmi failed to load caldata: %d\n", ret);
+ 			goto out_qmi_cal;
+ 		}
+ 
diff --git a/package/kernel/mac80211/patches/ath12k/703-ath12k-caldb-reserved-mem.patch b/package/kernel/mac80211/patches/ath12k/703-ath12k-caldb-reserved-mem.patch
new file mode 100644
index 0000000..1790fa2
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/703-ath12k-caldb-reserved-mem.patch
@@ -0,0 +1,50 @@
+From: auto <openwrt@local>
+Date: Mon, 03 Nov 2026 10:00:00 +0300
+Subject: [PATCH] ath12k: assign the reserved q6-caldb region to the firmware CALDB mem seg
+
+Diagnostic only (test022). On IPQ5332 the AHB firmware asks for a 4 MiB
+type-4 (CALDB) memory segment and the fixed-memory path answers with
+paddr = 0. The firmware then faults 189 ms after "qmi firmware ready"
+with PC/LR 0xb02eb65c and BADVA 0x0000000c, i.e. a base-plus-12 read of a
+null region base, and remoteproc reports a q6wcss crash.
+
+The vendor 5.4 DT (GPL QCA SDK) sets qcom,caldb-addr = <0x4CE00000> and
+qcom,caldb-size = <0x500000>, and our ipq5332-mr47be-v2.dts already wires
+that reservation as memory-region index 2 ("q6-caldb"). Pass its base to
+the firmware instead of zero; fall back to the current paddr = 0 when the
+region is absent or too small, so other AHB platforms are unchanged.
+The host does not ioremap or touch this region (coredump.c dumps nothing
+for CALDB), so only the address value changes.
+diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
+--- a/drivers/net/wireless/ath/ath12k/qmi.c
++++ b/drivers/net/wireless/ath/ath12k/qmi.c
+@@ -2794,12 +2794,24 @@
+ 			idx++;
+ 			break;
+ 		case CALDB_MEM_REGION_TYPE:
+-			/* Cold boot calibration is not enabled in Ath12k. Hence,
+-			 * assign paddr = 0.
+-			 * Once cold boot calibration is enabled add support to
+-			 * assign reserved memory from DT.
++			/* Vendor ipq5332 DT hands the firmware a real CALDB base
++			 * (qcom,caldb-addr = <0x4CE00000>); paddr = 0 lets the
++			 * firmware dereference a null region base at boot.
++			 * memory-region index 2 is the q6-caldb reservation.
++			 * The host never maps or writes this region.
+ 			 */
+-			ab->qmi.target_mem[idx].paddr = 0;
++			rmem = ath12k_core_get_reserved_mem(ab, 2);
++			if (rmem && rmem->size >= ab->qmi.target_mem[i].size)
++				ab->qmi.target_mem[idx].paddr = rmem->base;
++			else
++				ab->qmi.target_mem[idx].paddr = 0;
++			ath12k_warn(ab,
++				    "qmi caldb: rmem %s base 0x%llx size 0x%llx req %u -> paddr 0x%llx\n",
++				    rmem ? "found" : "missing",
++				    rmem ? (unsigned long long)rmem->base : 0ULL,
++				    rmem ? (unsigned long long)rmem->size : 0ULL,
++				    ab->qmi.target_mem[i].size,
++				    (unsigned long long)ab->qmi.target_mem[idx].paddr);
+ 			ab->qmi.target_mem[idx].v.ioaddr = NULL;
+ 			ab->qmi.target_mem[idx].size = ab->qmi.target_mem[i].size;
+ 			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
diff --git a/package/kernel/mac80211/patches/ath12k/704-ath12k-skip-qmi-ini-req-ipq5332.patch b/package/kernel/mac80211/patches/ath12k/704-ath12k-skip-qmi-ini-req-ipq5332.patch
new file mode 100644
index 0000000..f320b32
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath12k/704-ath12k-skip-qmi-ini-req-ipq5332.patch
@@ -0,0 +1,46 @@
+From: auto <openwrt@local>
+Date: Tue, 03 Nov 2026 19:40:00 +0300
+Subject: [PATCH] ath12k: do not send WLAN INI to the IPQ5332 AHB firmware
+
+test028. This reverts the test027 BDF address offset experiment: on device, moving
+.bdf_addr_offset to 0x1A00000 made the WCSS firmware fault immediately after the
+board-2.bin fetch with BADVA 0x4b500000 (= rmem 0x4a900000 + the original 0xC00000),
+so WLAN.WBE.1.1-03321 expects the BDF pool exactly where we had it. Upstream
+408ec3ffcc76 belongs to the 1.6 firmware generation, not to our factory blob.
+
+The one change here closes the last empty cell of the message truth table measured on
+this board:
+  INI+CFG+MODE -> fatal error +190 ms after "qmi firmware ready" (test015..024)
+  nothing sent -> clean (test025); INI+CFG, no MODE -> clean (test026)
+So MODE is not fatal by itself; something INI leaves behind is a live suspect. And
+upstream ath11k never sends WLAN_INI_REQ to an AHB/SoC target - ath11k/qmi.c gates it
+on hw_params.fw_wmi_diag_event, false for ipq8074/ipq6018/ipq5018 - while ath12k wifi7
+sends it unconditionally with enable_fwlog = 1. BADVA 0x0000000c in thread
+wlan_platform is a null + 0xc read, consistent with a diag/fwlog context the WCSS
+firmware never allocated.
+
+Skip only WLAN INI for ATH12K_HW_IPQ5332_HW10. CFG and MODE are still sent untouched,
+and the PCIe (QCN9274) path keeps all three, so 5/6 GHz is unaffected. Unlike test025
+and test026 this build can actually bring up 2.4 GHz: if INI was the poison, the radio
+comes up; if MODE alone is the poison, we get HTC -110 with no exception.
+--- a/drivers/net/wireless/ath/ath12k/qmi.c
++++ b/drivers/net/wireless/ath/ath12k/qmi.c
+@@ -3631,10 +3631,14 @@
+ {
+ 	int ret;
+ 
+-	ret = ath12k_qmi_wlanfw_wlan_ini_send(ab);
+-	if (ret < 0) {
+-		ath12k_warn(ab, "qmi failed to send wlan fw ini: %d\n", ret);
+-		return ret;
++	if (ab->hw_rev == ATH12K_HW_IPQ5332_HW10) {
++		ath12k_warn(ab, "qmi start: INI skipped, CFG+MODE sent\n");
++	} else {
++		ret = ath12k_qmi_wlanfw_wlan_ini_send(ab);
++		if (ret < 0) {
++			ath12k_warn(ab, "qmi failed to send wlan fw ini: %d\n", ret);
++			return ret;
++		}
+ 	}
+ 
+ 	ret = ath12k_qmi_wlanfw_wlan_cfg_send(ab);
