+   minimum font size (Firefox) raises the line height but not the em;
+   browsers without lh (Safari before 16.4, Firefox before 120) take the
+   height the script measured (--vt-line). It ends after the first
+   sentence (cut, at --vt-cut), else it fades out where its first line
+   ends (--vt-cut again).
+   The button shares the label cell, so both are placed explicitly. */
+.cbi-value[data-v-help="fold"] > .cbi-value-field > .vt-help-text {
+	max-height: var(--vt-line, 1.5em);
+	max-height: 1lh;
+	overflow: hidden;
+}
+.vt-help-text[data-v-end="cut"] { clip-path: inset(0 calc(100% - var(--vt-cut, 100%)) 0 -2px); }
+.vt-help-text[data-v-end="fade"] {
+	-webkit-mask-image: linear-gradient(to right, #000 calc(var(--vt-cut, 100%) - 4em), transparent var(--vt-cut, 100%));
+	mask-image: linear-gradient(to right, #000 calc(var(--vt-cut, 100%) - 4em), transparent var(--vt-cut, 100%));
+}
+.cbi-value[data-v-help] > .cbi-value-title { grid-row: 1; grid-column: 1; }
+.cbi-value[data-v-help] > .cbi-value-field { grid-row: 1; }
+.cbi-value:has(> .vt-help:not([hidden])) > .cbi-value-title { padding-right: 32px; }
+.cbi-value > .vt-help {
+	grid-row: 1; grid-column: 1;
+	justify-self: end;
+	display: grid; place-items: center;
+	width: 28px; height: var(--ctl-h);
+	padding: 0;
+	background: none; border: 0; border-radius: var(--r);
+	color: var(--text-3);
+	cursor: pointer;
+}
+/* a title that opens with <br> (Wireless "Operating frequency", lined up
+   with captioned selects) has its text on the second line: so has (i) */
+.cbi-value:has(> .cbi-value-title > br:first-child) > .vt-help { margin-top: 1.5em; }
+
+/* page and section intros fold the same way, (i) leading the line */
+:is(.cbi-map-descr, .cbi-section-descr)[data-v-help="fold"] {
