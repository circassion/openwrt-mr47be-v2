+		bootloader@4a100000 {
+			reg = <0x00000000 0x4a100000 0x00000000 0x00400000>;
+			no-map;
+		};
+
+		sbl@4a500000 {
+			reg = <0x00000000 0x4a500000 0x00000000 0x00100000>;
+			no-map;
+		};
+
+                tz@4A600000 {
+                        no-map;
+                        reg = <0x00000000 0x4a600000 0x00000000 0x00200000>;
