+ /*
++ * Firmware crash areas (WCSS regions declared "no-map" in DT) stay known to
++ * memblock but have no linear mapping, so valid_phys_addr_range() rejects them
++ * and the generic xlate_dev_mem_ptr() returns a __va() with no PTE behind it.
++ * That makes read() on /dev/mem fail with EFAULT for exactly the ranges a
++ * post-mortem dump needs. Accept those ranges for reads only and map one page
++ * on demand; the write path keeps the strict check.
++ */
++static int readable_phys_addr(phys_addr_t addr, size_t count)
++{
++	return valid_phys_addr_range(addr, count) ||
++	       memblock_is_region_memory(addr, count);
++}
++
++static bool phys_needs_map(phys_addr_t addr)
++{
++	return !memblock_is_map_memory(addr);
++}
