diff --git a/target/linux/qualcommbe/patches-6.18/0427-net-ethernet-qualcomm-ppe-use-IPQ5332-buffer-budgets.patch b/target/linux/qualcommbe/patches-6.18/0427-net-ethernet-qualcomm-ppe-use-IPQ5332-buffer-budgets.patch
