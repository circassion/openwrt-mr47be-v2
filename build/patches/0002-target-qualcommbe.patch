diff --git a/target/linux/qualcommbe/patches-6.18/0312a-net-phy-qca808x-allow-QCA8084-without-phy-package-node.patch b/target/linux/qualcommbe/patches-6.18/0312a-net-phy-qca808x-allow-QCA8084-without-phy-package-node.patch
new file mode 100644
index 0000000..652fafc
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0312a-net-phy-qca808x-allow-QCA8084-without-phy-package-node.patch
@@ -0,0 +1,53 @@
+From: MR47BE project <mr47be@local>
+Subject: [PATCH] net: phy: qca808x: allow QCA8084 without phy-package node
+
+--- a/drivers/net/phy/qcom/qca808x.c
++++ b/drivers/net/phy/qcom/qca808x.c
+@@ -1173,7 +1173,14 @@
+ 	int ret;
+ 
+ 	ret = devm_of_phy_package_join(dev, phydev, sizeof(*shared_priv));
+-	if (ret)
++	if (ret && ret != -EINVAL)
++		/*
++		 * -EINVAL: there is no ethernet-phy-package parent node.
++		 * This is the case for SoC-integrated QCA8084 (e.g. IPQ5332)
++		 * where each PHY is described as an individual MDIO device
++		 * and the package setup (clocks, resets, work mode) is done
++		 * by the bootloader. Continue without package support.
++		 */
+ 		return ret;
+ 
+ 	if (phy_package_probe_once(phydev)) {
+@@ -1187,19 +1194,27 @@
+ 		return ret;
+ 
+ 	/* Enable clock of PHY device, so that the PHY register
+-	 * can be accessed to get PHY features.
++	 * can be accessed to get PHY features.  Optional: on SoC-integrated
++	 * QCA8084 the clocks are already set up by the bootloader and are
++	 * not described in the per-PHY node.
+ 	 */
+ 	clk = devm_clk_get_enabled(dev, NULL);
+-	if (IS_ERR(clk))
++	if (IS_ERR(clk) && PTR_ERR(clk) != -ENOENT && PTR_ERR(clk) != -EINVAL)
+ 		return dev_err_probe(dev, PTR_ERR(clk),
+ 				     "Enable PHY clock failed\n");
+ 
+-	/* De-assert PHY reset after the clock of PHY enabled. */
++	/* De-assert PHY reset after the clock of PHY enabled.  Optional:
++	 * on SoC-integrated QCA8084 the reset is handled by the MDIO bus
++	 * reset-gpios and the bootloader.
++	 */
+ 	rstc = devm_reset_control_get_exclusive(dev, NULL);
+-	if (IS_ERR(rstc))
++	if (IS_ERR(rstc) && PTR_ERR(rstc) != -ENOENT && PTR_ERR(rstc) != -EINVAL)
+ 		return dev_err_probe(dev, PTR_ERR(rstc),
+ 				     "Get PHY reset failed\n");
+ 
++	if (IS_ERR(rstc))
++		return 0;
++
+ 	return reset_control_deassert(rstc);
+ }
+ 
