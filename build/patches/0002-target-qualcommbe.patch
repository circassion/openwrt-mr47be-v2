+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/50-mr47be-wifi-defaults
@@ -0,0 +1,19 @@
+#!/bin/sh
+# After 10-wifi-detect generates the wifi-device sections for a new phy
+# (same add event, in name order), apply the MR47BE defaults.
+# Works for every phy, including the late-probing AHB 2.4 GHz.
+[ "$ACTION" = "add" ] || exit 0
+
+. /lib/mr47be-wifi-defaults.sh
+
+mr47be_apply_wifi_defaults || exit 0
+uci -q commit wireless
+logger -t mr47be-wifi "default wireless settings applied"
+
+(
+	sleep 2
+	ubus call network reload >/dev/null 2>&1
+	[ -n "$DEVICENAME" ] && ubus call network.wireless up "{\"device\":\"$DEVICENAME\"}" >/dev/null 2>&1
+) &
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/99-retry-setup-failed b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/99-retry-setup-failed
new file mode 100644
index 0000000..ddbfbdb
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/99-retry-setup-failed
@@ -0,0 +1,13 @@
+#!/bin/sh
+# The AHB (2.4 GHz) component of the IPQ53xx multi-radio wiphy can finish
+# probing after netifd's first wireless setup pass, which leaves its radio
+# in retry_setup_failed ("wifi-scripts: Bug: PHY is undefined for device").
+# When a phy appears, re-kick wireless setup if any radio is stuck.
+[ "$ACTION" = "add" ] || exit 0
+(
+	sleep 10
+	ubus call network.wireless status 2>/dev/null | \
+		grep -q '"retry_setup_failed": true' || exit 0
+	logger -t wifi-retry "phy added late; retrying failed radio setup"
+	wifi up
+) &
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/bootcount b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/bootcount
new file mode 100755
index 0000000..4bc002c
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/bootcount
@@ -0,0 +1,37 @@
+#!/bin/sh /etc/rc.common
+# SPDX-License-Identifier: GPL-2.0-only
+
+START=99
+
+ln6001_reset_bootcount() {
+	local device="$1" record count checksum
+
+	record="$(hexdump -v -n 12 -e '12/1 "%02x"' "$device")" || return 1
+	[ "${#record}" -eq 24 ] || return 1
+	case "$record" in
+		*[!0-9a-f]*) return 1 ;;
+	esac
+	case "$record" in
+		110811200000000011081120) return 0 ;;
+		11081120*) ;;
+		*) return 1 ;;
+	esac
+	count="$(hexdump -v -s 4 -n 4 -e '1/4 "%u"' "$device")" || return 1
+	checksum="$(hexdump -v -s 8 -n 4 -e '1/4 "%u"' "$device")" || return 1
+	# Also repair a zero count left with a stale checksum.
+	[ "$count" -eq 0 ] ||
+		[ "$checksum" -eq $(((0x20110811 + count) & 0xffffffff)) ] || return 1
+
+	printf '\000\000\000\000\021\010\021\040' |
+		dd of="$device" bs=1 seek=4 count=8 \
+		conv=notrunc 2>/dev/null || return 1
+	sync
+	[ "$(hexdump -v -n 12 -e '12/1 "%02x"' "$device")" = 110811200000000011081120 ]
+}
+
+boot() {
+	[ "$(board_name)" = 'linksys,ln6001' ] || return 0
+	. /lib/upgrade/ln6001.sh
+	ln6001_active_slot >/dev/null || return 1
+	ln6001_reset_bootcount /dev/mmcblk0p22
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/zrxdiag b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/zrxdiag
new file mode 100644
index 0000000..04a0295
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/zrxdiag
@@ -0,0 +1,68 @@
+#!/bin/sh /etc/rc.common
+# Automatic RX diagnosis - does not wait for a user command.
+# 45s after boot, prints the EDMA/PPE RX state to UART (dev/console + kmsg).
+# Goal: distinguish the root cause of RX=0 in a SINGLE log:
+#   rxfill EN=0          -> ring not set up
+#   rxdesc PROD>CONS     -> packets arrive but the CPU does not process them (IRQ/NAPI issue)
+#   rxdesc PROD=CONS=0   -> no desc ever lands in the ring (PPE->EDMA data path)
+#   /proc/interrupts rxdesc counter 0 -> no interrupt ever arrives
+START=99
+
+rxdiag_dump() {
+	tag="$1"
+	{
+	echo "===================== RXDIAG $tag ====================="
+	grep -E "rxdesc|txcmpl|misc" /proc/interrupts
+	for i in 12 13 14 15; do
+		off=$((0x1000*i))
+		prod=$(devmem $((0x3ab39004+off)) 2>/dev/null)
+		cons=$(devmem $((0x3ab39008+off)) 2>/dev/null)
+		istat=$(devmem $((0x3ab59000+off)) 2>/dev/null)
+		echo "RXDIAG rxdesc$i prod=$prod cons=$cons istat=$istat"
+	done
+	for i in 0 1 2 3 12 13 14 15; do
+		off=$((0x1000*i))
+		fen=$(devmem $((0x3ab2901c+off)) 2>/dev/null)
+		fprod=$(devmem $((0x3ab29004+off)) 2>/dev/null)
+		fcons=$(devmem $((0x3ab29008+off)) 2>/dev/null)
+		echo "RXDIAG rxfill$i en=$fen prod=$fprod cons=$fcons"
+	done
+	echo "RXDIAG --- ethtool lan/wan rx ---"
+	ethtool -S lan 2>/dev/null | grep -iE "rx_|desc|fill|drop" | head -12
+	ethtool -S wan 2>/dev/null | grep -iE "rx_|desc|fill|drop" | head -12
+	echo "RXDIAG --- ip -s link ---"
+	ip -s link show lan 2>/dev/null
+	ip -s link show br-lan 2>/dev/null
+	ip -s link show wan 2>/dev/null
+	echo "RXDIAG --- dmesg edma/ppe ---"
+	dmesg | grep -iE "edma|ppe:" | tail -10
+	echo "===================== RXDIAG $tag END ====================="
+	} | tee /dev/kmsg > /dev/console 2>&1
+}
+
+boot() {
+	# RXDIAG dump is DISABLED by default. To enable: touch /tmp/mr47be_diag_on
+	[ -e /tmp/mr47be_diag_on ] || exit 0
+	(
+		sleep 45
+		rxdiag_dump T45
+		ping -c 3 -W 1 192.168.1.100 >/dev/null 2>&1
+		sleep 5
+		rxdiag_dump T50_after_ping
+		{
+		echo "===== RXDIAG network-config ====="
+		uci show network 2>/dev/null | head -40
+		echo "===== RXDIAG wan-status ====="
+		ubus call network.interface.wan status 2>/dev/null
+		logread -e netifd 2>/dev/null | tail -12
+		echo "===== RXDIAG lan1-switch-mib ====="
+		ethtool -S lan1 2>/dev/null | grep -iE "rx|tx" | head -20
+		echo "===== RXDIAG netifd ====="
+		logread 2>/dev/null | grep -iE "netifd|udhcpc|dhcp" | tail -15
+		echo "===== RXDIAG wifi ====="
+		ps 2>/dev/null | grep -E "hostapd|wpad" | grep -v grep
+		wifi status 2>/dev/null | head -40
+		echo "===== RXDIAG END-ALL ====="
+		} | tee /dev/kmsg > /dev/console 2>&1
+	) &
+}
