diff --git a/target/linux/qualcommbe/patches-6.18/0365-net-pcs-qcom-ipq9574-set-IPQ5332-MII-clocks-on-link-up.patch b/target/linux/qualcommbe/patches-6.18/0365-net-pcs-qcom-ipq9574-set-IPQ5332-MII-clocks-on-link-up.patch
new file mode 100644
index 0000000..898ea26
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0365-net-pcs-qcom-ipq9574-set-IPQ5332-MII-clocks-on-link-up.patch
@@ -0,0 +1,96 @@
+From: Til Kaiser <mail@tk154.de>
+Date: Thu, 23 Apr 2026 00:00:00 +0200
+Subject: [PATCH] net: pcs: qcom-ipq9574: set IPQ5332 MII clocks on link up
+
+Reuse the qcom-ipq9574 PCS driver for IPQ5332 with an explicit MII clock
+rate request during link-up.
+
+The PCS configures the exported USXGMII RX/TX clocks correctly, but the
+derived NSSCC MII and PPE port clocks may otherwise remain on the 24 MHz
+XO path until a consumer requests the negotiated link rate. When that
+happens, link comes up but traffic does not pass.
+
+Program the IPQ5332 MII clocks on link-up so the shared NSSCC divider
+path switches to the correct derived rate. Use the same speed-to-clock
+mapping as downstream QSDK for the IPQ5332 USXGMII clock path.
+
+Signed-off-by: Til Kaiser <mail@tk154.de>
+---
+ drivers/net/pcs/pcs-qcom-ipq9574.c | 43 +++++++++++++++++++++++++++++++++++++
+ 1 file changed, 43 insertions(+)
+
+--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
++++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
+@@ -740,6 +740,43 @@ static void ipq_pcs_an_restart(struct ph
+ 	/* Currently not used */
+ }
+ 
++static unsigned long ipq_pcs_mii_clk_rate_get(phy_interface_t interface,
++					       int speed)
++{
++	if (interface != PHY_INTERFACE_MODE_USXGMII &&
++	    interface != PHY_INTERFACE_MODE_10G_QXGMII)
++		return 0;
++
++	switch (speed) {
++	case SPEED_10:
++		return 1250000;
++	case SPEED_100:
++		return 12500000;
++	case SPEED_1000:
++		return 125000000;
++	case SPEED_2500:
++		return 78125000;
++	case SPEED_5000:
++		return 156250000;
++	case SPEED_10000:
++		return 312500000;
++	default:
++		return 0;
++	}
++}
++
++static int ipq_pcs_mii_clk_set_rate(struct ipq_pcs_mii *qpcs_mii,
++				    phy_interface_t interface, int speed)
++{
++	unsigned long rate = ipq_pcs_mii_clk_rate_get(interface, speed);
++
++	if (!rate)
++		return 0;
++
++	return clk_set_rate(qpcs_mii->rx_clk, rate) ?:
++	       clk_set_rate(qpcs_mii->tx_clk, rate);
++}
++
+ static void ipq_pcs_link_up(struct phylink_pcs *pcs,
+ 			    unsigned int neg_mode,
+ 			    phy_interface_t interface,
+@@ -750,6 +787,12 @@ static void ipq_pcs_link_up(struct phyli
+ 	int index = qpcs_mii->index;
+ 	int ret;
+ 
++	if (of_device_is_compatible(qpcs->dev->of_node, "qcom,ipq5332-pcs")) {
++		ret = ipq_pcs_mii_clk_set_rate(qpcs_mii, interface, speed);
++		if (ret)
++			goto err;
++	}
++
+ 	switch (interface) {
+ 	case PHY_INTERFACE_MODE_SGMII:
+ 	case PHY_INTERFACE_MODE_QSGMII:
+@@ -772,6 +815,7 @@ static void ipq_pcs_link_up(struct phyli
+ 		return;
+ 	}
+ 
++err:
+ 	if (ret)
+ 		dev_err(qpcs->dev, "PCS link up fail for interface %s\n",
+ 			phy_modes(interface));
+@@ -1048,6 +1092,7 @@ static int ipq9574_pcs_probe(struct plat
+ }
+ 
+ static const struct of_device_id ipq9574_pcs_of_mtable[] = {
++	{ .compatible = "qcom,ipq5332-pcs" },
+ 	{ .compatible = "qcom,ipq9574-pcs" },
+ 	{ /* sentinel */ },
+ };
diff --git a/target/linux/qualcommbe/patches-6.18/0366-net-ethernet-qualcomm-ppe-Add-initial-IPQ5332-supp.patch b/target/linux/qualcommbe/patches-6.18/0366-net-ethernet-qualcomm-ppe-Add-initial-IPQ5332-supp.patch
new file mode 100644
index 0000000..2aa2a7b
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0366-net-ethernet-qualcomm-ppe-Add-initial-IPQ5332-supp.patch
@@ -0,0 +1,177 @@
+From: Til Kaiser <mail@tk154.de>
+Date: Sun, 19 Apr 2026 00:00:00 +0200
+Subject: [PATCH] net: ethernet: qualcomm: ppe: add initial IPQ5332 support
+
+Add the minimum PPE driver differences needed for IPQ5332.
+
+IPQ5332 uses a smaller EDMA topology than IPQ9574 and only needs the
+reduced PPE interconnect set. Teach qcom_ppe to select IPQ5332-specific
+ICC data, use three PPE-visible ports (CPU port 0 plus external ports
+1 and 2), and size EDMA with the reduced ring layout.
+
+This allows IPQ5332 boards to use the qcom_ppe/phylink path.
+
+Signed-off-by: Til Kaiser <mail@tk154.de>
+---
+ drivers/net/ethernet/qualcomm/ppe/edma.c | 44 ++++++++++++++++++--
+ drivers/net/ethernet/qualcomm/ppe/ppe.c  | 59 +++++++++++++++++++++-----
+ 2 files changed, 86 insertions(+), 17 deletions(-)
+
+--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
+@@ -86,6 +86,34 @@ static const char * const clock_name[EDM
+ 	[EDMA_APB_CLK] = "apb",
+ };
+ 
++/* Rx Fill ring info for IPQ5332. */
++static struct edma_ring_info ipq5332_rxfill_ring_info = {
++	.max_rings = 8,
++	.ring_start = 4,
++	.num_rings = 4,
++};
++
++/* Rx ring info for IPQ5332. */
++static struct edma_ring_info ipq5332_rx_ring_info = {
++	.max_rings = 16,
++	.ring_start = 12,
++	.num_rings = 4,
++};
++
++/* Tx ring info for IPQ5332. */
++static struct edma_ring_info ipq5332_tx_ring_info = {
++	.max_rings = 16,
++	.ring_start = 4,
++	.num_rings = 12,
++};
++
++/* Tx complete ring info for IPQ5332. */
++static struct edma_ring_info ipq5332_txcmpl_ring_info = {
++	.max_rings = 16,
++	.ring_start = 4,
++	.num_rings = 12,
++};
++
+ /* Rx Fill ring info for IPQ9574. */
+ static struct edma_ring_info ipq9574_rxfill_ring_info = {
+ 	.max_rings = 8,
+@@ -114,6 +142,17 @@ static struct edma_ring_info ipq9574_txc
+ 	.num_rings = 24,
+ };
+ 
++/* HW info for IPQ5332. */
++static struct edma_hw_info ipq5332_hw_info = {
++	.rxfill = &ipq5332_rxfill_ring_info,
++	.rx = &ipq5332_rx_ring_info,
++	.tx = &ipq5332_tx_ring_info,
++	.txcmpl = &ipq5332_txcmpl_ring_info,
++	.max_ports = 2,
++	.napi_budget_rx = 128,
++	.napi_budget_tx = 512,
++};
++
+ /* HW info for IPQ9574. */
+ static struct edma_hw_info ipq9574_hw_info = {
+ 	.rxfill = &ipq9574_rxfill_ring_info,
+@@ -850,7 +889,11 @@ int edma_setup(struct ppe_device *ppe_de
+ 	if (!edma_ctx)
+ 		return -ENOMEM;
+ 
+-	edma_ctx->hw_info = &ipq9574_hw_info;
++	if (of_device_is_compatible(dev->of_node, "qcom,ipq5332-ppe"))
++		edma_ctx->hw_info = &ipq5332_hw_info;
++	else
++		edma_ctx->hw_info = &ipq9574_hw_info;
++
+ 	edma_ctx->ppe_dev = ppe_dev;
+ 	edma_ctx->rx_buf_size = rx_buff_size;
+ 
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
+@@ -26,7 +26,30 @@
+ /* ICC clocks for enabling PPE device. The avg_bw and peak_bw with value 0
+  * will be updated by the clock rate of PPE.
+  */
+-static const struct icc_bulk_data ppe_icc_data[] = {
++static const struct icc_bulk_data ipq5332_icc_data[] = {
++	{
++		.name = "ppe",
++		.avg_bw = 0,
++		.peak_bw = 0,
++	},
++	{
++		.name = "ppe_cfg",
++		.avg_bw = 0,
++		.peak_bw = 0,
++	},
++	{
++		.name = "qos_gen",
++		.avg_bw = 6000,
++		.peak_bw = 6000,
++	},
++	{
++		.name = "timeout_ref",
++		.avg_bw = 6000,
++		.peak_bw = 6000,
++	},
++};
++
++static const struct icc_bulk_data ipq9574_icc_data[] = {
+ 	{
+ 		.name = "ppe",
+ 		.avg_bw = 0,
+@@ -111,7 +134,7 @@ static const struct regmap_config regmap
+ 	.fast_io = true,
+ };
+ 
+-static int ppe_clock_init_and_reset(struct ppe_device *ppe_dev)
++static int ppe_clock_init_and_reset(struct ppe_device *ppe_dev, const struct icc_bulk_data *ppe_icc_data)
+ {
+ 	unsigned long ppe_rate = ppe_dev->clk_rate;
+ 	struct device *dev = ppe_dev->dev;
+@@ -175,12 +198,23 @@ static int ppe_clock_init_and_reset(stru
+ 
+ static int qcom_ppe_probe(struct platform_device *pdev)
+ {
++	const struct icc_bulk_data *ppe_icc_data;
+ 	struct device *dev = &pdev->dev;
++	int ret, num_icc, num_ports;
+ 	struct ppe_device *ppe_dev;
+ 	void __iomem *base;
+-	int ret, num_icc;
+ 
+-	num_icc = ARRAY_SIZE(ppe_icc_data);
++	if (of_device_is_compatible(dev->of_node, "qcom,ipq5332-ppe")) {
++		ppe_icc_data = ipq5332_icc_data;
++		num_icc = ARRAY_SIZE(ipq5332_icc_data);
++		num_ports = 3;
++	}
++	else {
++		ppe_icc_data = ipq9574_icc_data;
++		num_icc = ARRAY_SIZE(ipq9574_icc_data);
++		num_ports = PPE_PORT_MAX;
++	}
++
+ 	ppe_dev = devm_kzalloc(dev, struct_size(ppe_dev, icc_paths, num_icc),
+ 			       GFP_KERNEL);
+ 	if (!ppe_dev)
+@@ -196,10 +230,10 @@ static int qcom_ppe_probe(struct platfor
+ 				     "PPE initialize regmap failed\n");
+ 	ppe_dev->dev = dev;
+ 	ppe_dev->clk_rate = PPE_CLK_RATE;
+-	ppe_dev->num_ports = PPE_PORT_MAX;
++	ppe_dev->num_ports = num_ports;
+ 	ppe_dev->num_icc_paths = num_icc;
+ 
+-	ret = ppe_clock_init_and_reset(ppe_dev);
++	ret = ppe_clock_init_and_reset(ppe_dev, ppe_icc_data);
+ 	if (ret)
+ 		return dev_err_probe(dev, ret, "PPE clock config failed\n");
+ 
+@@ -235,6 +269,7 @@ static void qcom_ppe_remove(struct platf
+ }
+ 
+ static const struct of_device_id qcom_ppe_of_match[] = {
++	{ .compatible = "qcom,ipq5332-ppe" },
+ 	{ .compatible = "qcom,ipq9574-ppe" },
+ 	{}
+ };
