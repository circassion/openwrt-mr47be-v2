++/*
++ * The firmware crash-reason SMEM item carries more than one C string: the
++ * exception register file and the stack dump trail behind NUL separators,
++ * which a plain "%s" print loses. Emit every segment plus a hex tail.
++ */
++static void q6v5_dump_crash_reason(struct qcom_q6v5 *q6v5, const char *what,
++				   char *msg, size_t len)
++{
++	size_t done = 0;
++	int seg = 0;
++
++	dev_err(q6v5->dev, "%s: smem item size %zu\n", what, len);
++
++	while (done < len && seg < 64) {
++		size_t n = strnlen(msg + done, len - done);
++
++		if (n)
++			dev_err(q6v5->dev, "%s[%d]: %.*s\n", what, seg,
++				(int)n, msg + done);
++		done += n + 1;
++		seg++;
++	}
++
++	print_hex_dump(KERN_ERR, "crash-smem: ", DUMP_PREFIX_OFFSET, 16, 1,
++		       msg, min_t(size_t, len, 1024), false);
++}
++
+ static irqreturn_t q6v5_wdog_interrupt(int irq, void *data)
+ {
