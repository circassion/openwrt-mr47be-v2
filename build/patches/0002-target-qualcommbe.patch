+/* TEST22 (vendor gercegi: Iplatform/build/product_configs/MR47BEv2/
+ * kernel-ipq5332-mi01.6.dts):
+ *   dp1 = qcom,id=2, reg 0x3a504000, qcom,is_switch_connected=1 -> LAN (switch arkasi)
+ *   dp2 = qcom,id=1, reg 0x3a500000, phy'siz                    -> WAN
+ * Kanit: ppe_regs.h:605 PPE_PORT_XGMAC_ADDR(x)=0x500000+(x-1)*0x4000
+ *   port@1 = 0x3a500000 = MAC1 = WAN | port@2 = 0x3a504000 = MAC2 = LAN-switch
+ * Saha kaniti (test20): LAN1 jakina kablo -> port@2 ("wan") netdev link geldi.
+ * Yani TEST22 oncesi etiketler vendor'in tersiydi.
+ * WAN jak PHY MDIO adresi 1,2 veya 3 arasinda (U-Boot canli PHY: 1,2,3;
+ * addr4 = LAN1, test20'de kanitlandi). Ilk deneme: wan = phy@1
+ * (vendor boot log "eth0 PHY1 = WAN"). port@2 phy-handle'siz fixed-link
+ * (vendor dp1'de phy-handle yok; LAN1..3 QCA8084 switch ile MAC2'ye gelir).
+ */
+&qcom_ppe {
+	status = "okay";
+
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		xgmac1: port@1 {
+			reg = <1>;
+			label = "wan"; /* TEST22: vendor dp2 qcom,id=1 MAC1@0x3a500000; WAN jak PHY ilk deneme addr1 */
+			pcs-handle = <&pcs0_ch0>;
+			/* test011 = ref50 canli DTB: GMAC1 pcs0/uniphy0 uzerinden
+			 * 2500base-x + in-band-status. PHY surucusune baglanmadan
+			 * calisir (ref50: wan rx 8906 paket, DHCP 192.168.1.110). */
+			phy-mode = "2500base-x";
+			managed = "in-band-status";
+			phy-handle = <&phy_wan>;
+			nvmem-cells = <&base_macaddr 0>;
+			nvmem-cell-names = "mac-address"; /* TEST22: WAN jak = QCA8084 PHY, MDIO addr1 (aday: 1/2/3) */
+
+			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT1_RX_CLK>,
+				 <&nsscc NSS_CC_PORT1_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+
+		};
+
+		xgmac2: port@2 {
+			reg = <2>;
+			label = "lan";
+			pcs-handle = <&pcs1_ch0>;
+			/* test011 = ref50: GMAC2 dogrudan EPHY :04 (pcs1/uniphy1,
+			 * phy/sgmii). DSA conduit yok, fixed-link yok. */
+			phy-mode = "sgmii";
+			phy-handle = <&phy_lan>;
+			nvmem-cells = <&base_macaddr 1>;
+			nvmem-cell-names = "mac-address"; /* TEST27: LAN1 jak = PHY addr4 (test20 kaniti + test11a'da MAC2<->addr4 link tepkisi) */
+
+
+			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT2_RX_CLK>,
+				 <&nsscc NSS_CC_PORT2_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+
+		};
+	};
+};
