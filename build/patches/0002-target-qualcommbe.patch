diff --git a/target/linux/qualcommbe/patches-6.18/2009-soc-qcom-mdt_loader-keep-hash-segment-at-declared-offset.patch b/target/linux/qualcommbe/patches-6.18/2009-soc-qcom-mdt_loader-keep-hash-segment-at-declared-offset.patch
new file mode 100644
index 0000000..da92ade
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2009-soc-qcom-mdt_loader-keep-hash-segment-at-declared-offset.patch
@@ -0,0 +1,49 @@
+From: Qoder <qoder@local>
+Subject: [PATCH] soc: qcom: mdt_loader: keep hash segment at declared offset
+
+IPQ5332 WCSS firmware (ath12k/IPQ5332/hw1.0/q6_fw0.mdt) stores its hash
+segment at p_offset 0x1000, flush with the end of the file, instead of
+packing it directly behind the 0x1b4-byte ELF header. qcom_mdt_read_metadata()
+repacks it, so the metadata handed to TrustZone no longer matches the program
+headers it carries: qcom_mdt_pas_init()/qcom_scm_pas_init_image() still succeed
+but qcom_scm_pas_auth_and_reset() returns -EINVAL, remoteproc reports
+"wcss_reset failed" and the on-SoC 2.4GHz radio never boots.
+
+Hand the image over unmodified when the hash already sits at its declared
+offset and ends exactly at EOF, matching the vendor (QSDK 5.4) behaviour of
+allocating fw->size and returning data_len = fw->size.
+
+---
+ drivers/soc/qcom/mdt_loader.c | 18 ++++++++++++++++++
+ 1 file changed, 18 insertions(+)
+
+--- a/drivers/soc/qcom/mdt_loader.c
++++ b/drivers/soc/qcom/mdt_loader.c
+@@ -197,6 +197,27 @@
+ 	ehdr_size = phdrs[0].p_filesz;
+ 	hash_size = phdrs[hash_segment].p_filesz;
+ 
++	/*
++	 * Some images keep the hash segment at its declared p_offset, ending
++	 * flush with the file, with padding between the ELF header and the
++	 * hash (e.g. ath12k/IPQ5332/hw1.0/q6_fw0.mdt: p_offset 0x1000,
++	 * p_filesz 0x2c70, file size 0x3c70). TrustZone parses the embedded
++	 * program headers, so such an image must be handed over unmodified;
++	 * repacking the hash directly behind the header makes
++	 * qcom_scm_pas_auth_and_reset() fail with -EINVAL. This mirrors the
++	 * vendor loader, which allocates fw->size and copies the hash to
++	 * phdrs[1].p_offset.
++	 */
++	if (phdrs[hash_segment].p_offset != ehdr_size &&
++	    phdrs[hash_segment].p_offset + hash_size == fw->size) {
++		data = kmemdup(fw->data, fw->size, GFP_KERNEL);
++		if (!data)
++			return ERR_PTR(-ENOMEM);
++
++		*data_len = fw->size;
++		return data;
++	}
++
+ 	data = kmalloc(ehdr_size + hash_size, GFP_KERNEL);
+ 	if (!data)
+ 		return ERR_PTR(-ENOMEM);
diff --git a/target/linux/qualcommbe/patches-6.18/2010-remoteproc-ipq5332-wcss-userpd-bootargs.patch b/target/linux/qualcommbe/patches-6.18/2010-remoteproc-ipq5332-wcss-userpd-bootargs.patch
new file mode 100644
index 0000000..daf0661
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2010-remoteproc-ipq5332-wcss-userpd-bootargs.patch
@@ -0,0 +1,518 @@
+From: JiaY-shi <shi05275@163.com>
+Subject: [PATCH] remoteproc: qcom: wcss: publish IPQ5332 UserPD bootargs
+
+MR47BE v2 adaptation: a controlled port of the 2010a + 2010b + 2010c series
+from perceival/openwrt-flint3 (flint3-be9300) onto our mainline 6.18.55
+wcss_sec driver.
+
+1) 2010b: IPQ5332 WLAN.WBE.1.6 reads the RootPD/UserPD entry point and the
+   file-based view from SMEM item 507. No driver writes it, so ath12k used to
+   get "UserPD spawn wait timed out" (-110). The bootargs table is set up in
+   the rproc .load callback, BEFORE auth_and_reset; it stays fresh on RootPD
+   recovery too.
+2) 2010a: the WCSS crash reason is not in global SMEM but in remote host 1.
+   Without this the log always says "fatal error without message".
+3) 2010c: crash wakes start/stop waiters with complete_all(); otherwise we
+   experience an empty 300 s timeout during recovery.
+
+The wcss_sec_stop() hunks of 2010c were dropped because our driver has no
+qcom_q6v5_request_stop() call (mainline 6.18.55 differs).
+
+Upstream-Status: Pending [Qualcomm downstream / flint3-be9300]
+
+diff -ruN a/drivers/remoteproc/qcom_q6v5.c b/drivers/remoteproc/qcom_q6v5.c
+--- a/drivers/remoteproc/qcom_q6v5.c	2026-11-01 03:12:15.651959513 +0300
++++ b/drivers/remoteproc/qcom_q6v5.c	2026-11-01 03:12:15.669112613 +0300
+@@ -61,6 +61,9 @@
+ 	reinit_completion(&q6v5->start_done);
+ 	reinit_completion(&q6v5->stop_done);
+ 
++	WRITE_ONCE(q6v5->start_ack, false);
++	WRITE_ONCE(q6v5->stop_ack, false);
++
+ 	q6v5->running = true;
+ 	q6v5->handover_issued = false;
+ 
+@@ -96,17 +99,24 @@
