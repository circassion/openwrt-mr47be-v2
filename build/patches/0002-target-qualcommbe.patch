diff --git a/target/linux/qualcommbe/patches-6.18/0371-net-ethernet-qualcomm-ppe-force-XGMAC-TX-queue-0-store-and-forward.patch b/target/linux/qualcommbe/patches-6.18/0371-net-ethernet-qualcomm-ppe-force-XGMAC-TX-queue-0-store-and-forward.patch
new file mode 100644
index 0000000..d107b41
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0371-net-ethernet-qualcomm-ppe-force-XGMAC-TX-queue-0-store-and-forward.patch
@@ -0,0 +1,46 @@
+From: Til Kaiser <mail@tk154.de>
+Date: Mon, 18 May 2026 00:00:00 +0200
+Subject: [PATCH] net: ethernet: qualcomm: ppe: force XGMAC TX queue 0 store-and-forward
+
+Observed on IPQ5332 XGMAC ports, small outbound packets increment
+tx_underflow_err unless MTL queue 0 is forced into store-and-forward
+mode. Program the TSF bit before enabling transmission so the queue
+is drained only after the frame has been buffered.
+
+Signed-off-by: Til Kaiser <mail@tk154.de>
+---
+ drivers/net/ethernet/qualcomm/ppe/ppe_port.c | 8 ++++++++
+ drivers/net/ethernet/qualcomm/ppe/ppe_regs.h | 3 +++
+ 2 files changed, 11 insertions(+)
+
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
+@@ -902,6 +902,15 @@ static int ppe_port_xgmac_link_up(struct
+ 	}
+ 
+ 	reg = PPE_PORT_XGMAC_ADDR(port);
++	/*
++	 * Use store-and-forward for XGMAC MTL queue 0 so transmission
++	 * starts only after the frame has been buffered.
++	 */
++	ret = regmap_update_bits(ppe_dev->regmap, reg + XGMAC_MTL_TXQ_OPMODE(0),
++				 XGMAC_MTL_TXQ_TSF, XGMAC_MTL_TXQ_TSF);
++	if (ret)
++		return ret;
++
+ 	val |= XGMAC_TXEN;
+ 	ret = regmap_update_bits(ppe_dev->regmap, reg + XGMAC_TX_CONFIG_ADDR,
+ 				 XGMAC_SPEED_M | XGMAC_TXEN, val);
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+@@ -717,6 +717,10 @@
+ #define XGMAC_JD				BIT(16)
+ #define XGMAC_TXEN				BIT(0)
+ 
++/* XGMAC MTL Tx queue operating mode register */
++#define XGMAC_MTL_TXQ_OPMODE(_q)		(0x00001100 + (0x80 * (_q)))
++#define XGMAC_MTL_TXQ_TSF			BIT(1)
++
+ /* XGMAC RX configuration register */
+ #define XGMAC_RX_CONFIG_ADDR			0x4
+ #define XGMAC_GPSL_M				GENMASK(29, 16)
diff --git a/target/linux/qualcommbe/patches-6.18/0372-net-ethernet-qualcomm-ppe-wake-the-Tx-queue-paired-w.patch b/target/linux/qualcommbe/patches-6.18/0372-net-ethernet-qualcomm-ppe-wake-the-Tx-queue-paired-w.patch
new file mode 100644
index 0000000..78663f6
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0372-net-ethernet-qualcomm-ppe-wake-the-Tx-queue-paired-w.patch
@@ -0,0 +1,64 @@
+From: Akshay Kakatkar <claude@akshaykakatkar.tech>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: wake the Tx queue paired with
+ the Tx cmpl ring
+
+edma_tx_complete() wakes the Tx queue indexed by smp_processor_id(),
+but completions are reaped on whichever CPU the Tx cmpl IRQ is affine
+to (CPU0 by default for every ring). A Tx queue stopped by
+edma_port_xmit() on any other CPU is therefore never woken again:
+packets for that queue accumulate in the qdisc, their skbs are never
+freed, and TCP suppresses every retransmission of the affected flows
+(skb_still_in_host_queue()), permanently wedging them while all other
+queues keep flowing. Observed in production as BGP sessions on an
+IPsec-over-PPPoE WAN hanging with stuck Send-Q and
+TCPSpuriousRtxHostQueues climbing, after a traffic burst filled one
+CPU's Tx ring; reproducible with taskset-pinned pings (100% loss from
+the CPU whose queue was stopped, 0% from the rest).
+
+Tx desc and Tx cmpl rings are paired 1:1 per (port, queue), so derive
+the queue index from the ring id instead of the executing CPU.
+
+Signed-off-by: Akshay Kakatkar <claude@akshaykakatkar.tech>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
+@@ -125,7 +125,7 @@
+ 	struct edma_txcmpl_stats *txcmpl_stats = &txcmpl_ring->txcmpl_stats;
+ 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
+ 	struct regmap *regmap = ppe_dev->regmap;
+-	u32 cons_idx, end_idx, data, cpu_id;
++	u32 cons_idx, end_idx, data, queue_id;
+ 	struct device *dev = ppe_dev->dev;
+ 	u32 avail, count, txcmpl_errors;
+ 	struct edma_txcmpl_desc *txcmpl;
+@@ -235,17 +235,24 @@
+ 	regmap_write(regmap, reg, cons_idx);
+ 
+ 	/* If tx_requeue_stop disabled (tx_requeue_stop = 0)
+-	 * Fetch the tx queue of interface and check if it is stopped.
+-	 * if queue is stopped and interface is up, wake up this queue.
++	 * Fetch the tx queue paired with this Tx cmpl ring and check if it
++	 * is stopped. if queue is stopped and interface is up, wake it up.
++	 *
++	 * The queue must be derived from the ring, not from the CPU running
++	 * this completion handler: Tx desc and Tx cmpl rings are paired
++	 * per (port, queue), but completions are reaped on whichever CPU
++	 * the IRQ is affine to. Waking the current CPU's queue leaves any
++	 * other stopped queue stopped forever once its ring fills.
+ 	 */
+ 	if (unlikely(!edma_ctx->tx_requeue_stop)) {
+-		cpu_id = smp_processor_id();
+-		nq = netdev_get_tx_queue(txcmpl_ring->napi.dev, cpu_id);
++		queue_id = (txcmpl_ring->id - edma_ctx->hw_info->txcmpl->ring_start) %
++			   num_possible_cpus();
++		nq = netdev_get_tx_queue(txcmpl_ring->napi.dev, queue_id);
+ 		if (unlikely(netif_tx_queue_stopped(nq)) &&
+ 		    netif_carrier_ok(txcmpl_ring->napi.dev)) {
+ 			dev_dbg(dev, "Waking queue number %d, for interface %s\n",
+-				cpu_id, txcmpl_ring->napi.dev->name);
+-			__netif_tx_lock(nq, cpu_id);
++				queue_id, txcmpl_ring->napi.dev->name);
++			__netif_tx_lock(nq, smp_processor_id());
+ 			netif_tx_wake_queue(nq);
+ 			__netif_tx_unlock(nq);
+ 		}
diff --git a/target/linux/qualcommbe/patches-6.18/0372-phy-qcom-uniphy-pcie-28lp-add-shared-reset-and-mux-mode-support-for-pcie2.patch b/target/linux/qualcommbe/patches-6.18/0372-phy-qcom-uniphy-pcie-28lp-add-shared-reset-and-mux-mode-support-for-pcie2.patch
new file mode 100644
index 0000000..727bede
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0372-phy-qcom-uniphy-pcie-28lp-add-shared-reset-and-mux-mode-support-for-pcie2.patch
@@ -0,0 +1,191 @@
+From: Til Kaiser <mail@tk154.de>
+Date: Sat, 19 Apr 2026 12:00:00 +0200
+Subject: [PATCH] phy: qcom: uniphy-pcie-28lp: add shared reset and mux mode
+ support for PCIe2
+
+IPQ5332 can run the UNIPHY block either as a 2-lane PCIe PHY or as two
+independent 1-lane PHYs. Enabling PCIe2 requires programming the mux into
+2-port mode and handling the shared AHB reset line correctly between PCIe1
+and PCIe2.
+
+Update the driver to:
+- request resets by name instead of a single reset array
+- support optional shared handling for the phy_ahb reset
+- prime/deassert the shared reset before the assert/deassert sequence
+- program the TCSR mux register via qti,phy-mux-regs
+- select 2-port or 2-lane mode based on qti,multiplexed-phy
+
+The reset sequencing and mux handling added here are adapted from the
+downstream Qualcomm/QSDK UNIPHY PCIe driver behavior.
+
+Signed-off-by: Til Kaiser <mail@tk154.de>
+---
+
+--- a/drivers/phy/qualcomm/phy-qcom-uniphy-pcie-28lp.c
++++ b/drivers/phy/qualcomm/phy-qcom-uniphy-pcie-28lp.c
+@@ -38,6 +38,8 @@
+ #define SSCG_CTRL_REG_5		0xac
+ #define SSCG_CTRL_REG_6		0xb0
+ #define PCS_INTERNAL_CONTROL_2	0x2d8
++#define TCSR_2LANE_MODE			0x0
++#define TCSR_2PORT_MODE			0x1
+ 
+ #define PHY_CFG_PLLCFG				0x220
+ #define PHY_CFG_EIOS_DTCT_REG			0x3e4
+@@ -68,8 +70,11 @@ struct qcom_uniphy_pcie {
+ 	const struct qcom_uniphy_pcie_data *data;
+ 	struct clk_bulk_data *clks;
+ 	int num_clks;
+-	struct reset_control *resets;
++	struct reset_control *res_phy;
++	struct reset_control *res_phy_ahb;
++	struct reset_control *res_phy_phy;
+ 	void __iomem *base;
++	bool shared_reset;
+ 	int lanes;
+ };
+ 
+@@ -158,10 +163,19 @@ static void qcom_uniphy_pcie_init(struct
+ static int qcom_uniphy_pcie_power_off(struct phy *x)
+ {
+ 	struct qcom_uniphy_pcie *phy = phy_get_drvdata(x);
++	int ret;
+ 
+ 	clk_bulk_disable_unprepare(phy->num_clks, phy->clks);
+ 
+-	return reset_control_assert(phy->resets);
++	ret = reset_control_assert(phy->res_phy);
++	if (ret)
++		return ret;
++
++	ret = reset_control_assert(phy->res_phy_phy);
++	if (ret)
++		return ret;
++
++	return reset_control_assert(phy->res_phy_ahb);
+ }
+ 
+ static int qcom_uniphy_pcie_power_on(struct phy *x)
+@@ -169,17 +183,50 @@ static int qcom_uniphy_pcie_power_on(str
+ 	struct qcom_uniphy_pcie *phy = phy_get_drvdata(x);
+ 	int ret;
+ 
+-	ret = reset_control_assert(phy->resets);
++	/* phy_ahb reset is shared between pcie1 and pcie2. */
++	if (phy->shared_reset) {
++		ret = reset_control_deassert(phy->res_phy_ahb);
++		if (ret) {
++			dev_err(phy->dev, "shared reset prime deassert failed (%d)\n", ret);
++			return ret;
++		}
++	}
++
++	ret = reset_control_assert(phy->res_phy);
+ 	if (ret) {
+-		dev_err(phy->dev, "reset assert failed (%d)\n", ret);
++		dev_err(phy->dev, "phy reset assert failed (%d)\n", ret);
++		return ret;
++	}
++
++	ret = reset_control_assert(phy->res_phy_phy);
++	if (ret) {
++		dev_err(phy->dev, "phy_phy reset assert failed (%d)\n", ret);
++		return ret;
++	}
++
++	ret = reset_control_assert(phy->res_phy_ahb);
++	if (ret) {
++		dev_err(phy->dev, "phy_ahb reset assert failed (%d)\n", ret);
+ 		return ret;
+ 	}
+ 
+ 	usleep_range(RST_ASSERT_DELAY_MIN_US, RST_ASSERT_DELAY_MAX_US);
+ 
+-	ret = reset_control_deassert(phy->resets);
++	ret = reset_control_deassert(phy->res_phy);
++	if (ret) {
++		dev_err(phy->dev, "phy reset deassert failed (%d)\n", ret);
++		return ret;
++	}
++
++	ret = reset_control_deassert(phy->res_phy_phy);
+ 	if (ret) {
+-		dev_err(phy->dev, "reset deassert failed (%d)\n", ret);
++		dev_err(phy->dev, "phy_phy reset deassert failed (%d)\n", ret);
++		return ret;
++	}
++
++	ret = reset_control_deassert(phy->res_phy_ahb);
++	if (ret) {
++		dev_err(phy->dev, "phy_ahb reset deassert failed (%d)\n", ret);
+ 		return ret;
+ 	}
+ 
+@@ -198,8 +245,33 @@ static int qcom_uniphy_pcie_power_on(str
+ 	return 0;
+ }
+ 
++static int qcom_uniphy_pcie_set_mux_mode(struct qcom_uniphy_pcie *phy, u32 mode)
++{
++	struct of_phandle_args args;
++	struct regmap *mux_map;
++	int ret;
++
++	ret = of_parse_phandle_with_fixed_args(dev_of_node(phy->dev),
++					       "qti,phy-mux-regs", 1, 0, &args);
++	if (ret)
++		return ret;
++
++	mux_map = syscon_node_to_regmap(args.np);
++	of_node_put(args.np);
++	if (IS_ERR(mux_map))
++		return dev_err_probe(phy->dev, PTR_ERR(mux_map),
++				     "failed to map phy mux register\n");
++
++	ret = regmap_write(mux_map, args.args[0], mode);
++	if (ret)
++		return dev_err_probe(phy->dev, ret,
++				     "failed to configure phy mux mode\n");
++
++	return 0;
++}
++
+ static inline int qcom_uniphy_pcie_get_resources(struct platform_device *pdev,
+-						 struct qcom_uniphy_pcie *phy)
++					 struct qcom_uniphy_pcie *phy)
+ {
+ 	struct resource *res;
+ 
+@@ -211,9 +283,29 @@ static inline int qcom_uniphy_pcie_get_r
+ 	if (phy->num_clks < 0)
+ 		return phy->num_clks;
+ 
+-	phy->resets = devm_reset_control_array_get_exclusive(phy->dev);
+-	if (IS_ERR(phy->resets))
+-		return PTR_ERR(phy->resets);
++	phy->shared_reset = device_property_read_bool(phy->dev,
++				 "phy-ahb-shared-reset");
++
++	phy->res_phy = devm_reset_control_get_exclusive(phy->dev, "phy");
++	if (IS_ERR(phy->res_phy))
++		return PTR_ERR(phy->res_phy);
++
++	phy->res_phy_phy = devm_reset_control_get_optional_exclusive(phy->dev, "phy_phy");
++	if (IS_ERR(phy->res_phy_phy))
++		return PTR_ERR(phy->res_phy_phy);
++
++	if (phy->shared_reset)
++		phy->res_phy_ahb = devm_reset_control_get_optional_shared(phy->dev, "phy_ahb");
++	else
++		phy->res_phy_ahb = devm_reset_control_get_optional_exclusive(phy->dev, "phy_ahb");
++	if (IS_ERR(phy->res_phy_ahb))
++		return PTR_ERR(phy->res_phy_ahb);
++
++	if (of_find_property(dev_of_node(phy->dev), "qti,phy-mux-regs", NULL)) {
++		return qcom_uniphy_pcie_set_mux_mode(phy,
++			device_property_read_bool(phy->dev, "qti,multiplexed-phy") ?
++			TCSR_2PORT_MODE : TCSR_2LANE_MODE);
++	}
+ 
+ 	return 0;
+ }
