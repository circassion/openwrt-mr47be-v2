+&qpic_nand {
+	pinctrl-0 = <&qspi_nand_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		nand-ecc-engine = <&qpic_nand>;
+		/* v3: stok DTB nandcs@0 = nand-ecc-strength 4 / step 512 / bus-width 8.
+		 * 8 (GL-BE6500 kopyasi) stok yazimli bolumleri (0:art, ubi) okutmuyordu:
+		 * UART logu: "I/O error, dev mtdblock10", "UBI error: unable to read
+		 * from mtd12", WAN "Using random MAC address". */
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+		nand-bus-width = <8>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			/* Gercek NAND yerlesimi (PRE_TEST_CHECK §4 = nand-partition.xml).
+			 * Onceki 1MiB duzgun bloklar KAYMISTI: 0:art yanlis yeri gosteriyor,
+			 * ubi fiziksel rootfs + rootfs_1 uzerine biniyordu (soft-brick riski).
+			 * ART (0x900000..0xB00000) read-only; MAC nvmem buradan okunur. */
+			partition@0 {
+				label = "0:sbl1";
+				reg = <0x0 0x180000>;
+				read-only;
+			};
+
+			partition@180000 {
+				label = "0:mibib";
+				reg = <0x180000 0x100000>;
+				read-only;
+			};
+
+			partition@280000 {
+				label = "0:bootconfig";
+				reg = <0x280000 0x080000>;
+				read-only;
+			};
+
+			partition@300000 {
+				label = "0:bootconfig1";
+				reg = <0x300000 0x080000>;
+				read-only;
+			};
+
+			partition@380000 {
+				label = "0:qsee";
+				reg = <0x380000 0x240000>;
+				read-only;
+			};
+
+			partition@5c0000 {
+				label = "0:devcfg";
+				reg = <0x5c0000 0x080000>;
+				read-only;
+			};
+
+			partition@640000 {
+				label = "0:tme";
+				reg = <0x640000 0x080000>;
+				read-only;
+			};
+
+			partition@6c0000 {
+				label = "0:cdt";
+				reg = <0x6c0000 0x080000>;
+				read-only;
+			};
+
+			partition@740000 {
+				label = "0:appsblenv";
+				reg = <0x740000 0x080000>;
+			};
+
+			partition@7c0000 {
+				label = "0:appsbl";
+				reg = <0x7c0000 0x140000>;
+				read-only;
+			};
+
+			partition@900000 {
+				label = "0:art";
+				reg = <0x900000 0x200000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					/* test041: ART+0x0 bos (ff:ff:ff:ff:ff:ff) -> of_get_mac_address
+					 * gecersiz adresi reddedip eth_hw_addr_random'a dusuyor. Fabrika MAC
+					 * izi ART+0x1008 (cal-ahb basligi ici, bu boardda <board MAC>).
+					 * index0=WAN, index1=LAN; LAN'da U-Boot'un local-mac-address'i one
+					 * gecer (of_net sirasi: mac-address > local-mac-address > nvmem),
+					 * yani tek gercek degisiklik WAN jakidir. */
+					base_macaddr: mac-address@1008 {
+						compatible = "mac-base";
+						reg = <0x1008 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			partition@b00000 {
+				label = "secure-binary";
+				reg = <0xb00000 0x080000>;
+				read-only;
+			};
+
+			partition@b80000 {
+				label = "ubi";
+				reg = <0xb80000 0x34c0000>;
+			};
+
+			partition@4040000 {
+				label = "rootfs_1";
+				reg = <0x4040000 0x34c0000>;
+			};
+
+			partition@7500000 {
+				label = "tp_data";
+				reg = <0x7500000 0x0a00000>;
+			};
+
+			partition@7f00000 {
+				label = "data";
+				reg = <0x7f00000 0x080000>;
+			};
+
+			partition@7f80000 {
+				label = "reserverd_data";
+				reg = <0x7f80000 0x080000>;
+			};
+		};
+	};
+};
