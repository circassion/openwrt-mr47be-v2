+#!/bin/sh
+
+[ -e /lib/firmware/$FIRMWARE ] && exit 0
+
+. /lib/functions/caldata.sh
+
+board=$(board_name)
+
+case "$FIRMWARE" in
+"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
+	case "$board" in
+	askey,sbe1v1k)
+		caldata_extract_mmc "0:ART" 0x58800 0x2d000
+		;;
+	esac
+	;;
+"ath12k/QCN9274/hw2.0/cal-pci-0002:01:00.0.bin")
+	case "$board" in
+	askey,sbe1v1k)
+		caldata_extract_mmc "0:ART" 0x8a800 0x2d000
+		;;
+	esac
+	;;
+"ath12k/QCN9274/hw2.0/cal-pci-0003:01:00.0.bin")
+	case "$board" in
+	askey,sbe1v1k)
+		caldata_extract_mmc "0:ART" 0xbc800 0x2d000
+		;;
+	esac
+	;;
+*)
+	exit 1
+	;;
+esac
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata
new file mode 100644
index 0000000..3c8098d
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/firmware/12-ath12k-caldata
@@ -0,0 +1,64 @@
+#!/bin/sh
+# Extract the correct calibration block from ART even if the firmware request
+# name does not match the expected pattern.
+
+. /lib/functions/caldata.sh
+
+fwlog() { echo "caldata12: $*" > /dev/kmsg; }
+
+if [ -e "/lib/firmware/$FIRMWARE" ]; then
+	fwlog "already-present '$FIRMWARE'"
+	exit 0
+fi
+
+board=$(board_name)
+fwlog "request '$FIRMWARE' board='$board'"
+
+case "$FIRMWARE" in
+"ath12k/IPQ5332/hw1.0/cal-ahb-c000000.wifi.bin")
+	case "$board" in
+	gl.inet,gl-be6500)
+		caldata_extract "0:art" 0x1000 0x20000
+		;;
+	gl.inet,gl-be9300)
+		caldata_extract_mmc "0:ART" 0x1000 0x20000
+		;;
+	mercusys,mr47be-v2)
+		fwlog "extract ahb 0:art 0x1000 0xf800"
+		caldata_extract "0:art" 0x1000 0xf800
+		;;
+	esac
+	;;
+"ath12k/QCN9274/hw2.0/cal-pci-0001:01:00.0.bin")
+	case "$board" in
+	gl.inet,gl-be6500)
+		caldata_extract "0:art" 0x58800 0x18800
+		;;
+	gl.inet,gl-be9300)
+		caldata_extract_mmc "0:ART" 0x58800 0x27800
+		;;
+	mercusys,mr47be-v2)
+		fwlog "extract pci 0:art 0x58800 0x27800"
+		caldata_extract "0:art" 0x58800 0x27800
+		;;
+	esac
+	;;
+*)
+	case "$FIRMWARE" in
+	*cal-ahb-*c000000.wifi.bin)
+		fwlog "FALLBACK-ahb for '$FIRMWARE'"
+		mkdir -p "/lib/firmware/$(dirname "$FIRMWARE")"
+		caldata_extract "0:art" 0x1000 0xf800
+		;;
+	*cal-pci-*0001:01:00.0.bin)
+		fwlog "FALLBACK-pci for '$FIRMWARE'"
+		mkdir -p "/lib/firmware/$(dirname "$FIRMWARE")"
+		caldata_extract "0:art" 0x58800 0x27800
+		;;
+	*)
+		fwlog "UNMATCHED '$FIRMWARE'"
+		exit 1
+		;;
+	esac
+	;;
+esac
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/40-gl-wireless-country b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/40-gl-wireless-country
new file mode 100644
index 0000000..c193670
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/40-gl-wireless-country
@@ -0,0 +1,89 @@
+#!/bin/sh
+#
+# Keep the regulatory country populated as PHYs appear.
+#
+# 95-gl-wireless-country runs once from uci-defaults and sets the country from
+# the ART partition. That is too early on this board: the AHB radio can finish
+# probing after netifd's first wireless pass ("PHY is undefined for device"),
+# so a wifi-device section created later ends up with no country. Without one
+# hostapd refuses to start on 6 GHz ("Invalid country_code '00'") and the radio
+# stays down, which presents to the user as "Wi-Fi is broken".
+#
+# This runs on every ieee80211 add event and fills in any radio that is still
+# missing a valid country. It is idempotent and silent when there is nothing to
+# do, so it costs nothing on a normally-booting device.
+
+[ "$ACTION" = add ] || exit 0
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+
+LOG_TAG=gl-wireless-country
+
+case "$(board_name)" in
+gl.inet,gl-be9300|gl.inet,gl-be6500) ;;
+*) exit 0 ;;
+esac
+
+# A country is valid only if it is two letters and not the "unset" 00 value,
+# which hostapd rejects outright on 6 GHz.
+valid_country() {
+	[ "${#1}" = 2 ] || return 1
+	case "$1" in
+		*[!A-Z]*) return 1 ;;
+	esac
+	return 0
+}
+
+# Nothing to do unless some radio is missing one - check before touching ART.
+needs_country=0
+for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
+	cur=$(uci -q get "wireless.$dev.country" | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
+	valid_country "$cur" || needs_country=1
+done
+[ "$needs_country" = 1 ] || exit 0
+
+art=$(find_mmc_part "0:ART")
+[ -n "$art" ] || {
+	logger -t "$LOG_TAG" -p daemon.warn "ART partition (0:ART) not found; cannot set country automatically"
+	exit 0
+}
+
+# Offset 0x88, 2 bytes.
+country=$(dd if="$art" bs=1 skip=136 count=2 2>/dev/null |
+	tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
+
+if ! valid_country "$country"; then
+	# An unprogrammed fuse will still be unprogrammed next boot, so do not
+	# keep retrying - say what the user has to do instead.
+	logger -t "$LOG_TAG" -p daemon.warn \
+		"ART regulatory field at 0x88 is unprogrammed; set one manually:" \
+		"for r in radio0 radio1 radio2; do uci set wireless.\$r.country=XX; done;" \
+		"uci commit wireless; wifi"
+	exit 0
+fi
+
+changed=0
+for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
+	cur=$(uci -q get "wireless.$dev.country" | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
+	valid_country "$cur" && continue
+	uci set "wireless.$dev.country=$country"
+	changed=1
+done
+
+[ "$changed" = 1 ] || exit 0
+
+uci commit wireless
+logger -t "$LOG_TAG" "set regulatory country '$country' from ART on late-registered radio(s)"
+
+# Reload once the event storm settles, and only if nobody else already did.
+# Backgrounded so the hotplug handler returns immediately.
+(
+	sleep 5
+	[ -f /var/run/gl-wireless-country.reload ] && exit 0
+	: > /var/run/gl-wireless-country.reload
+	/sbin/wifi reload
+	rm -f /var/run/gl-wireless-country.reload
+) &
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/50-mr47be-wifi-defaults b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/50-mr47be-wifi-defaults
new file mode 100644
index 0000000..47a366b
