@@ -0,0 +1,93 @@
+--- a/drivers/net/phy/qcom/qca808x.c
++++ b/drivers/net/phy/qcom/qca808x.c
+@@ -1355,6 +1355,71 @@
+ 	return qca8084_package_clock_init(shared_priv);
+ }
+ 
++/* phylib only runs ->config_init for the PHY addresses a netdev attaches to,
++ * but every EPHY of a QCA8084 is a front-panel port that has to forward
++ * frames. On a board whose LAN jacks are not each backed by a netdev, the
++ * unattached receivers keep the reset-time ADC edge and MSE threshold: they
++ * complete autonegotiation and then never decode a single symbol. Apply the
++ * same two per-PHY knobs (plus the aneg restart phylib would have issued)
++ * to the sibling EPHYs. Runs once, from the first attached PHY.
++ */
++static void qca8084_config_init_siblings(struct phy_device *phydev)
++{
++	static bool done;
++	struct mii_bus *bus = phydev->mdio.bus;
++	int ret = 0, i, addr, bmcr;
++	u16 reg_val;
++	u32 ephy_cfg;
++
++	if (done)
++		return;
++
++	if (qca8084_mii_read(phydev, QCA8084_EPHY_CFG, &ephy_cfg))
++		return;
++
++	for (i = 0; i < QCA8084_EPHY_NUM; i++) {
++		addr = qca8084_ephy_mdio_addr(ephy_cfg, i);
++		if (!addr || addr == phydev->mdio.addr)
++			continue;
++
++		ret = qca8084_phy_debug_read(bus, addr, QCA8084_ADC_CLK_SEL,
++					     &reg_val);
++		if (ret)
++			break;
++
++		ret = qca8084_phy_debug_write(bus, addr, QCA8084_ADC_CLK_SEL,
++					      (reg_val & ~QCA8084_ADC_CLK_SEL_ACLK) |
++					      FIELD_PREP(QCA8084_ADC_CLK_SEL_ACLK,
++							 QCA8084_ADC_CLK_SEL_ACLK_FALL));
++		if (ret)
++			break;
++
++		mutex_lock(&bus->mdio_lock);
++		ret = __mdiobus_c45_write(bus, addr, MDIO_MMD_PMAPMD,
++					  QCA8084_MSE_THRESHOLD,
++					  QCA8084_MSE_THRESHOLD_2P5G_VAL);
++		if (!ret) {
++			bmcr = __mdiobus_read(bus, addr, MII_BMCR);
++			if (bmcr < 0)
++				ret = bmcr;
++			else
++				ret = __mdiobus_write(bus, addr, MII_BMCR,
++						      bmcr | BMCR_ANENABLE |
++								   BMCR_ANRESTART);
++		}
++		mutex_unlock(&bus->mdio_lock);
++		if (ret)
++			break;
++
++		phydev_info(phydev, "EPHY%d mdio %d brought up: ADC falling edge, MSE 0x%x\n",
++			    i, addr, QCA8084_MSE_THRESHOLD_2P5G_VAL);
++	}
++
++	done = true;
++	if (ret)
++		phydev_warn(phydev, "EPHY sibling bring-up failed: %d\n", ret);
++}
++
+ static int qca8084_config_init(struct phy_device *phydev)
+ {
+ 	int ret;
+@@ -1384,9 +1449,15 @@
+ 	/* Adjust MSE threshold value to avoid link issue with
+ 	 * some link partner.
+ 	 */
+-	return phy_write_mmd(phydev, MDIO_MMD_PMAPMD,
+-			     QCA8084_MSE_THRESHOLD,
+-			     QCA8084_MSE_THRESHOLD_2P5G_VAL);
++	ret = phy_write_mmd(phydev, MDIO_MMD_PMAPMD,
++			    QCA8084_MSE_THRESHOLD,
++			    QCA8084_MSE_THRESHOLD_2P5G_VAL);
++	if (ret < 0)
++		return ret;
++
++	qca8084_config_init_siblings(phydev);
++
++	return 0;
+ }
+ 
+ static void qca8084_link_change_notify(struct phy_device *phydev)
