@@ -0,0 +1,9 @@
+#!/bin/sh
+# On first boot apply defaults to the present radios (OpenWRT_2G/_5G/_6G,
+# WPA3, channels 5/48/49, 40/80/160 MHz, country BR). For phys that probe late,
+# /etc/hotplug.d/ieee80211/50-mr47be-wifi-defaults takes over.
+. /lib/mr47be-wifi-defaults.sh
+
+mr47be_apply_wifi_defaults || exit 0
+uci -q commit wireless
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/98-mr47be-mac b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/98-mr47be-mac
new file mode 100755
index 0000000..c49fcfb
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/98-mr47be-mac
@@ -0,0 +1,90 @@
+#!/bin/sh
+# MR47BE V2: in the stock firmware the MAC is kept only in the 'default-mac'
+# file (6 raw bytes) inside the tp_data UBIFS. ART 0x0 is empty (FF).
+# This script reads it once and writes it to UCI; if it cannot read, it exits 1
+# and stays in uci-defaults, retrying on the next boot.
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+[ "$(board_name)" = "mercusys,mr47be-v2" ] || exit 0
+
+
+valid_mac() {
+	case "$1" in
+	""|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff) return 1 ;;
+	[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
+		return 0 ;;
+	esac
+	return 1
+}
+
+mac=$(uci -q get network.wan.macaddr)
+valid_mac "$mac" && exit 0
+
+mtdnum=
+while read -r dev size erase name; do
+	case "$name" in
+	*tp_data*) mtdnum=${dev#mtd}; mtdnum=${mtdnum%:}; break ;;
+	esac
+done < /proc/mtd
+[ -n "$mtdnum" ] || exit 1
+
+attached=0
+if [ ! -e /dev/ubi1 ]; then
+	ubiattach -m "$mtdnum" -d 1 >/dev/null 2>&1 && attached=1
+fi
+
+mnt=/tmp/.tp_data
+mkdir -p "$mnt"
+if ! mount -t ubifs -o ro ubi1:tp_data "$mnt" >/dev/null 2>&1; then
+	mount -t ubifs ubi1:tp_data "$mnt" >/dev/null 2>&1 || {
+		umount "$mnt" 2>/dev/null
+		[ "$attached" = 1 ] && ubidetach -d 1 >/dev/null 2>&1
+		rmdir "$mnt" 2>/dev/null
+		exit 1
+	}
+fi
+
+if [ -s "$mnt/default-mac" ]; then
+	# v16: busybox 'od' is NOT built into this image -> use hexdump (present),
+	# keep 'od' as a fallback for other builds.
+	mac=$(hexdump -v -e "1/1 \"%02x\" " -n 6 "$mnt/default-mac" 2>/dev/null | tr -d ' \n' | sed 's/../&:/g; s/:$//')
+	[ -z "$mac" ] && mac=$(od -An -tx1 -N6 "$mnt/default-mac" 2>/dev/null | tr -d ' \n' | sed 's/../&:/g; s/:$//')
+fi
+
+umount "$mnt" 2>/dev/null
+[ "$attached" = 1 ] && ubidetach -d 1 >/dev/null 2>&1
+rmdir "$mnt" 2>/dev/null
+
+valid_mac "$mac" || exit 1
+
+lan_mac=$(macaddr_add "$mac" 1)
+
+[ -n "$(uci -q get network.wan)" ] && uci set network.wan.macaddr="$mac"
+[ -n "$(uci -q get network.lan)" ] && uci set network.lan.macaddr="$lan_mac"
+
+# v16: also push the MAC onto the device itself (gmac1 for the WAN path), so
+# the PPPoE client uses the stock MAC even before netifd applies the option.
+_wd=$(uci -q get network.wan.device)
+case "$_wd" in
+gmac1|wan|eth1|eth2|'') ;;
+*) _wd="" ;;
+esac
+if [ -n "$_wd" ] && [ -e "/sys/class/net/$_wd" ]; then
+	ip link set dev "$_wd" down 2>/dev/null
+	ip link set dev "$_wd" address "$mac" 2>/dev/null
+	ip link set dev "$_wd" up 2>/dev/null
+fi
+
+idx=0
+while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
+	case "$(uci -q get "network.@device[$idx].name")" in
+	wan) uci set "network.@device[$idx].macaddr=$mac" ;;
+	lan|br-lan) uci set "network.@device[$idx].macaddr=$lan_mac" ;;
+	esac
+	idx=$((idx + 1))
+done
+
+uci commit network
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-gl-be9300-wifi-macs b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-gl-be9300-wifi-macs
new file mode 100644
index 0000000..fd9cf80
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-gl-be9300-wifi-macs
@@ -0,0 +1,36 @@
+#!/bin/sh
+# ath12k takes its MAC from firmware board data and has no DT/nvmem support,
+# so without this every boot invents a new base address and all BSSIDs move.
+# Pin each BSS to an address derived from the factory ART value (offset 0x04,
+# what stock uses for wlan0). Sections that already set macaddr are left alone.
+. /lib/functions.sh
+. /lib/functions/system.sh
+
+[ "$(board_name)" = "gl.inet,gl-be9300" ] || exit 0
+
+base=$(mmc_get_mac_binary 0:ART 0x4)
+[ -n "$base" ] || exit 0
+
+n=0
+set_wifi_mac() {
+	local section="$1"
+	config_get mac "$section" macaddr
+	[ -n "$mac" ] && return 0		# explicitly pinned already
+	config_get mode "$section" mode
+	[ "$mode" = "ap" ] || return 0		# leave sta/mesh alone
+
+	local addr
+	if [ "$n" = 0 ]; then
+		addr="$base"
+	else
+		addr=$(macaddr_setbit_la "$(macaddr_add "$base" $n)")
+	fi
+	uci set "wireless.$section.macaddr=$addr"
+	n=$((n + 1))
+}
+
+config_load wireless
+config_foreach set_wifi_mac wifi-iface
+uci commit wireless
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-mr47be-dsa-network b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-mr47be-dsa-network
new file mode 100644
index 0000000..ceab8a0
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/99-mr47be-dsa-network
@@ -0,0 +1,72 @@
+#!/bin/sh
+# MR47BE V2 - DSA network defaults.
+#
+# Real netdev map in this image (at boot, BEFORE flip/insmod):
+#   gmac1 -> PPE port@1 (xgmac1) -> UNIPHY0/PCS0 -> 2500base-x -> die port0
+#             WAN face of the factory bypass path: EPHY1 (WAN jack) -> uniphy0 -> xgmac1.
+#   lan   -> PPE port@2 (xgmac2) -> UNIPHY1/PCS1 -> 2500base-x fixed-link
+#             DSA conduit. It is no longer attached to the jack PHY, so it is ALWAYS
+#             carrier=1 (the "lan goes down when LAN1 has no cable" defect is gone).
+#
+# If flip + insmod SUCCEEDS, the service additionally creates these netdevs:
+#   wan lan1 lan2 lan3  (qca8386 DSA user ports = die port1/4/3/2)
+# and dsa_net() moves the 'wan' interface from gmac1 to the DSA port, adds lan1/2/3 to br-lan.
+#
+# The one thing this script must KEEP SMALL: Wi-Fi, SSH and LAN1 must keep working
+# under all conditions. So the only SAFE member of br-lan is 'lan' (conduit);
+# DSA ports are added by the service, but only after they are proven to exist.
+# If DSA never works, the device stays on the bypass-guard behaviour.
+#
+# Old note (test012/038) is obsolete: back then the 'lan' conduit was attached to a
+# PHY (ephy4) and a dead member (lan1/2/3) could lock up netifd.
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+[ -f /lib/functions/system.sh ] && [ "$(board_name)" = "mercusys,mr47be-v2" ] || exit 0
+[ -f /etc/config/network ] || exit 0
+[ -e /sys/class/net/lan ] || exit 0
+
+didx=
+idx=0
+while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
+	if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
+		didx="$idx"
+		break
+	fi
+	idx=$((idx + 1))
+done
+
+if [ -z "$didx" ]; then
+	uci add network device >/dev/null
+	didx=-1
+	uci set network.@device[-1].name='br-lan'
+	uci set network.@device[-1].type='bridge'
+fi
+
+# Replace ports only with a real netdev: the ONLY member here is 'lan'.
+uci -q delete "network.@device[$didx].ports"
+uci -q add_list "network.@device[$didx].ports=lan"
+uci set network.lan.device='br-lan'
+
+# WAN: the pre-flip path is SoC xgmac1 ('gmac1'). 02_network wrote "wan"; that
+# netdev DOES NOT EXIST until the DSA module is loaded, so the readiness gate
+# collects its internet evidence over gmac1 here. dsa_net() switches to 'wan' on
+# success; on failure this value is restored (bypass WAN behaviour preserved).
+uci -q set network.wan.device='gmac1'
+uci -q set network.wan.ifname='gmac1'
+
+# v13: wan6 must follow the wan interface ('@wan'), never the phantom DSA name
+# 'wan' (that netdev does not exist in bypass mode -> LuCI draws a dead 0 B tile).
+if uci -q get network.wan6 >/dev/null 2>&1; then
+	_d6=$(uci -q get network.wan6.device)
+	case "$_d6" in wan|gmac1|'') uci set network.wan6.device='@wan';; esac
+fi
+
+uci commit network
+
+/etc/init.d/dnsmasq  enable 2>/dev/null || true
+/etc/init.d/uhttpd   enable 2>/dev/null || true
+/etc/init.d/dropbear enable 2>/dev/null || true
+/etc/init.d/firewall enable 2>/dev/null || true
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/mr47be-wifi-defaults.sh b/target/linux/qualcommbe/ipq53xx/base-files/lib/mr47be-wifi-defaults.sh
new file mode 100644
index 0000000..1b96d68
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/mr47be-wifi-defaults.sh
@@ -0,0 +1,87 @@
+#!/bin/sh
+# MR47BE V2 default wireless settings.
+#
+# Works per band (2g/5g/6g); the phy path/number is not fixed. So even if the
+# AHB 2.4 GHz probes late, or the PCI 5/6 GHz radios are numbered in a different
+# order, the correct wifi-device section is found.
+#
+# If the user added their own wifi-iface, that device is left untouched.
+
+MR47BE_WIFI_CHANGED=0
+
+mr47be_wifi_set() {
+	[ "$(uci -q get "wireless.$1.$2")" = "$3" ] || {
+		uci -q set "wireless.$1.$2=$3"
+		MR47BE_WIFI_CHANGED=1
+	}
+}
+
+mr47be_apply_wifi_defaults() {
+	grep -qs "mercusys,mr47be-v2" /proc/device-tree/compatible || return 1
+	[ -f /etc/config/wireless ] || return 1
+
+	local devs ifaces s dev band ssid ch ht iface user_iface
+
+	MR47BE_WIFI_CHANGED=0
+	devs="$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')"
+	ifaces="$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p')"
+
+	for dev in $devs; do
+		# Defaults are applied only once per radio. This flag persists in UCI
+		# across reboots, so user changes (SSID/channel/htmode/key) are never
+		# overwritten again by the boot/hotplug default hook.
+		[ "$(uci -q get "wireless.$dev.mr47be_defaults")" = "1" ] && continue
+		band="$(uci -q get "wireless.$dev.band")"
+		case "$band" in
+		2g) ssid='OpenWRT_2G'; ch='5';  ht='EHT40'  ;;
+		5g) ssid='OpenWRT_5G'; ch='48'; ht='EHT80'  ;;
+		6g) ssid='OpenWRT_6G'; ch='49'; ht='EHT160' ;;
+		*) continue ;;
+		esac
+
+		iface=
+		user_iface=
+		for s in $ifaces; do
+			[ "$(uci -q get "wireless.$s.device")" = "$dev" ] || continue
+			case "$s" in
+			default_radio*|openwrt_2g|openwrt_5g|openwrt_6g)
+				[ -n "$iface" ] || iface="$s"
+				;;
+			*)
+				user_iface=1
+				;;
+			esac
+		done
+		# If the user has their own SSID, do not change this radio.
+		[ -n "$user_iface" ] && continue
+
+		mr47be_wifi_set "$dev" channel "$ch"
+		mr47be_wifi_set "$dev" htmode "$ht"
+		mr47be_wifi_set "$dev" country 'BR'
+
+		[ -n "$iface" ] || iface="openwrt_$band"
+		uci -q get "wireless.$iface" >/dev/null 2>&1 || {
+			uci -q set "wireless.$iface=wifi-iface"
+			MR47BE_WIFI_CHANGED=1
+		}
+
+		mr47be_wifi_set "$iface" device "$dev"
+		mr47be_wifi_set "$iface" network 'lan'
+		mr47be_wifi_set "$iface" mode 'ap'
+		mr47be_wifi_set "$iface" ssid "$ssid"
+		mr47be_wifi_set "$iface" encryption 'sae'
+		mr47be_wifi_set "$iface" key '12345678'
+		mr47be_wifi_set "$iface" ieee80211w '2'
+		mr47be_wifi_set "$iface" disabled '0'
+
+		# Mark this radio as configured; do not re-apply defaults on later boots.
+		uci -q set "wireless.$dev.mr47be_defaults=1"
+		MR47BE_WIFI_CHANGED=1
+	done
+
+	[ "$MR47BE_WIFI_CHANGED" = 1 ]
+}
+
+mr47be_wifi_has_radios() {
+	uci -q show wireless 2>/dev/null | grep -q '=wifi-device$'
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/glinet-upgrade.sh b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/glinet-upgrade.sh
new file mode 100644
index 0000000..8495cb9
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/glinet-upgrade.sh
@@ -0,0 +1,75 @@
+. /lib/upgrade/common.sh
+
+glinet_get_fit_part() {
+	local image="$1"
+	local name="$2"
+
+	dumpimage -l "$image" 2>/dev/null | \
+		sed -n "s/^[[:space:]]*Image \([0-9][0-9]*\) ($name)$/\1/p"
+}
+
+glinet_emmc_check_image() {
+	[ "$(identify_magic_long "$(get_magic_long "$1")")" != "fit" ] && return 0
+
+	local hlos=$(glinet_get_fit_part "$1" hlos)
+	local rootfs=$(glinet_get_fit_part "$1" rootfs)
+	[ -n "$hlos" ] && [ -n "$rootfs" ] && return 0
+
+	v "The factory image must contain hlos and rootfs sections."
+	return 1
+}
+
+glinet_emmc_flash_fit_part() {
+	local image="$1"
+	local part="$2"
+	local device="$3"
+	local name="$4"
+	local output="/tmp/glinet-emmc-$name.bin"
+	local ret
+
+	v "Extracting and flashing $name to $device"
+	rm -f "$output"
+	dumpimage -T flat_dt -p "$part" -o "$output" "$image" &&
+		[ -s "$output" ] && dd if="$output" of="$device" bs=1M conv=fsync
+	ret=$?
+	rm -f "$output"
+	return "$ret"
+}
+
+glinet_emmc_do_fit_upgrade() {
+	local image="$1"
+	local hlos=$(glinet_get_fit_part "$image" hlos)
+	local rootfs=$(glinet_get_fit_part "$image" rootfs)
+	local wifi_fw=$(glinet_get_fit_part "$image" wifi_fw)
+	local hlos_dev=$(find_mmc_part "$CI_KERNPART" "$CI_ROOTDEV")
+	local rootfs_dev=$(find_mmc_part "$CI_ROOTPART" "$CI_ROOTDEV")
+	local wifi_fw_dev
+
+	[ -n "$wifi_fw" ] && wifi_fw_dev=$(find_mmc_part "0:WIFIFW" "$CI_ROOTDEV")
+	[ -n "$hlos" ] && [ -n "$rootfs" ] && \
+		[ -n "$hlos_dev" ] && [ -n "$rootfs_dev" ] || {
+		v "Unable to find the required GL.iNet image sections or eMMC partitions."
+		return 1
+	}
+	[ -z "$wifi_fw" ] || [ -n "$wifi_fw_dev" ] || {
+		v "Unable to find the GL.iNet Wi-Fi firmware partition."
+		return 1
+	}
+
+	dd if=/dev/zero of="$hlos_dev" bs=512 count=8 conv=fsync || return 1
+	glinet_emmc_flash_fit_part "$image" "$rootfs" "$rootfs_dev" rootfs || return 1
+	[ -z "$wifi_fw" ] || \
+		glinet_emmc_flash_fit_part "$image" "$wifi_fw" "$wifi_fw_dev" wifi_fw || return 1
+	glinet_emmc_flash_fit_part "$image" "$hlos" "$hlos_dev" hlos
+}
+
+glinet_emmc_do_upgrade() {
+	case "$(identify_magic_long "$(get_magic_long "$1")")" in
+	fit)
+		glinet_emmc_do_fit_upgrade "$1"
+		;;
+	*)
+		emmc_do_upgrade "$1"
+		;;
+	esac
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/ln6001.sh b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/ln6001.sh
new file mode 100644
index 0000000..41eb234
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/ln6001.sh
@@ -0,0 +1,430 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+
+# Read the primaryboot flag for one named Qualcomm bootconfig entry.
+ln6001_bootconfig_primaryboot() {
+	local file="$1" wanted="$2" count i name value found=0
+
+	[ -r "$file" ] || return 1
+	[ "$(hexdump -v -n 4 -e '4/1 "%02x"' "$file")" = a0a1a2a3 ] || return 1
+	[ "$(hexdump -v -s 332 -n 4 -e '4/1 "%02x"' "$file")" = b0b1b2b3 ] || return 1
+
+	count="$(hexdump -v -s 8 -n 4 -e '1/4 "%u"' "$file")" || return 1
+	case "$count" in
+		''|*[!0-9]*) return 1 ;;
+	esac
+	[ "$count" -ge 1 ] && [ "$count" -le 16 ] || return 1
+
+	i=0
+	while [ "$i" -lt "$count" ]; do
+		name="$(dd if="$file" bs=1 skip=$((12 + i * 20)) count=16 2>/dev/null |
+			tr -d '\000')" || return 1
+		if [ "$name" = "$wanted" ]; then
+			[ "$found" -eq 0 ] || return 1
+			value="$(hexdump -v -s $((28 + i * 20)) -n 4 \
+				-e '1/4 "%u"' "$file")" || return 1
+			case "$value" in
+				0|1) ;;
+				*) return 1 ;;
+			esac
+			found=1
+		fi
+		i=$((i + 1))
+	done
+
+	[ "$found" -eq 1 ] || return 1
+	printf '%s\n' "$value"
+}
+
+ln6001_bootconfig_slot() {
+	local hlos rootfs wififw
+
+	hlos="$(ln6001_bootconfig_primaryboot "$1" '0:HLOS')" || return 1
+	rootfs="$(ln6001_bootconfig_primaryboot "$1" rootfs)" || return 1
+	wififw="$(ln6001_bootconfig_primaryboot "$1" '0:WIFIFW')" || return 1
+	[ "$hlos" = "$rootfs" ] && [ "$hlos" = "$wififw" ] || return 1
+	printf '%s\n' "$hlos"
+}
+
+ln6001_bootconfig_pair_slot() {
+	local first second
+
+	first="$(ln6001_bootconfig_slot "$1")" || return 1
+	second="$(ln6001_bootconfig_slot "$2")" || return 1
+	[ "$first" = "$second" ] || return 1
+	printf '%s\n' "$first"
+}
+
+ln6001_check_partition() {
+	local number="$1" label="$2" start="$3" size="$4"
+	local sysfs="${5:-/sys/class/block}"
+	local path="$sysfs/mmcblk0p$number"
+
+	[ "$(sed -n 's/^DEVNAME=//p' "$path/uevent")" = "mmcblk0p$number" ] || return 1
+	[ "$(sed -n 's/^PARTNAME=//p' "$path/uevent")" = "$label" ] || return 1
+	[ "$(cat "$path/start")" = "$start" ] || return 1
+	[ "$(cat "$path/size")" = "$size" ] || return 1
+	[ "$(cat "$path/ro")" = 0 ] || return 1
+}
+
+# These are GPT sectors observed on the retail 8 GiB eMMC. Refuse other layouts.
+ln6001_check_layout() {
+	local sysfs="${1:-/sys/class/block}"
+
+	ln6001_check_partition 3 '0:BOOTCONFIG' 4130 512 "$sysfs" &&
+	ln6001_check_partition 4 '0:BOOTCONFIG1' 4642 512 "$sysfs" &&
+	ln6001_check_partition 21 u_env 24098 512 "$sysfs" &&
+	ln6001_check_partition 22 s_env 24610 512 "$sysfs" &&
+	ln6001_check_partition 26 '0:WIFIFW' 27170 20480 "$sysfs" &&
+	ln6001_check_partition 27 '0:WIFIFW_1' 47650 20480 "$sysfs" &&
+	ln6001_check_partition 28 '0:HLOS' 68130 16384 "$sysfs" &&
+	ln6001_check_partition 29 rootfs 84514 1024000 "$sysfs" &&
+	ln6001_check_partition 30 '0:HLOS_1' 1108514 16384 "$sysfs" &&
+	ln6001_check_partition 31 rootfs_1 1124898 1024000 "$sysfs"
+}
+
+ln6001_cmdline_slot() {
+	local cmdline="${1:-/proc/cmdline}" sysfs="${2:-/sys/class/block}"
+	local args arg root count=0 uuid a b
+
+	[ -r "$cmdline" ] || return 1
+	read -r args < "$cmdline"
+	for arg in $args; do
+		case "$arg" in
+			root=*) root="${arg#root=}"; count=$((count + 1)) ;;
+		esac
+	done
+	[ "$count" -eq 1 ] || return 1
+
+	case "$root" in
+		/dev/mmcblk0p29) printf '0\n'; return 0 ;;
+		/dev/mmcblk0p31) printf '1\n'; return 0 ;;
+		PARTUUID=*) uuid="${root#PARTUUID=}" ;;
+		*) return 1 ;;
+	esac
+
+	printf '%s\n' "$uuid" | grep -Eqi \
+		'^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$' || return 1
+	uuid="$(printf '%s' "$uuid" | tr 'A-F' 'a-f')"
+	[ "$uuid" != 00000000-0000-0000-0000-000000000000 ] || return 1
+	a="$(sed -n 's/^PARTUUID=//p' "$sysfs/mmcblk0p29/uevent" | tr 'A-F' 'a-f')"
+	b="$(sed -n 's/^PARTUUID=//p' "$sysfs/mmcblk0p31/uevent" | tr 'A-F' 'a-f')"
+	[ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ] || return 1
+	if [ "$uuid" = "$a" ]; then
+		printf '0\n'
+	elif [ "$uuid" = "$b" ]; then
+		printf '1\n'
+	else
+		return 1
+	fi
+}
+
+ln6001_bootenv_slot() {
+	local boot_part ready recovery
+
+	boot_part="$(fw_printenv -n boot_part 2>/dev/null)" || return 1
+	ready="$(fw_printenv -n boot_part_ready 2>/dev/null)" || return 1
+	recovery="$(fw_printenv -n auto_recovery 2>/dev/null)" || return 1
+	[ "$ready" = 3 ] && [ "$recovery" = yes ] || return 1
+	case "$boot_part" in
+		1) printf '0\n' ;;
+		2) printf '1\n' ;;
+		*) return 1 ;;
+	esac
+}
+
+ln6001_selected_slot() {
+	local bootconfig bootenv
+
+	ln6001_check_layout || return 1
+	bootconfig="$(ln6001_bootconfig_pair_slot \
+		/dev/mmcblk0p3 /dev/mmcblk0p4)" || return 1
+	bootenv="$(ln6001_bootenv_slot)" || return 1
+	[ "$bootconfig" = "$bootenv" ] || return 1
+	printf '%s\n' "$bootconfig"
+}
+
+ln6001_active_slot() {
+	local selected cmdline
+
+	selected="$(ln6001_selected_slot)" || return 1
+	cmdline="$(ln6001_cmdline_slot)" || return 1
+	[ "$selected" = "$cmdline" ] || return 1
+	printf '%s\n' "$selected"
+}
+
+ln6001_rambooted() {
+	local args arg
+
+	[ "$(cat /tmp/sysinfo/board_name)" = 'linksys,ln6001' ] || return 1
+	[ "$(awk '$2 == "/" { print $1 " " $3 }' /proc/mounts)" = 'tmpfs tmpfs' ] || return 1
+	read -r args < /proc/cmdline
+	for arg in $args; do
+		case "$arg" in
+			root=*) return 1 ;;
+		esac
+	done
+}
+
+ln6001_upgrade_slot() {
+	local selected cmdline
+
+	selected="$(ln6001_selected_slot)" || return 1
+	if cmdline="$(ln6001_cmdline_slot)"; then
+		[ "$selected" = "$cmdline" ] || return 1
+	else
+		ln6001_rambooted || return 1
+	fi
+	printf '%s\n' "$selected"
+}
+
+ln6001_check_image_contents() {
+	local image="$1" dir="$2" members expected control kernel_size root_size
+
+	members="$(tar -tf "$image" 2>/dev/null)" || return 1
+	expected="$(printf '%s\n' \
+		'sysupgrade-linksys_ln6001/' \
+		'sysupgrade-linksys_ln6001/CONTROL' \
+		'sysupgrade-linksys_ln6001/kernel' \
+		'sysupgrade-linksys_ln6001/root')"
+	[ "$members" = "$expected" ] || return 1
+	control="$(tar -xOf "$image" sysupgrade-linksys_ln6001/CONTROL)" || return 1
+	[ "$control" = BOARD=linksys_ln6001 ] || return 1
+
+	tar -xOf "$image" sysupgrade-linksys_ln6001/kernel > "$dir/kernel" || return 1
+	tar -xOf "$image" sysupgrade-linksys_ln6001/root > "$dir/root" || return 1
+	kernel_size="$(wc -c < "$dir/kernel")"
+	root_size="$(wc -c < "$dir/root")"
+	[ "$kernel_size" -gt 0 ] && [ "$kernel_size" -le 8388608 ] || return 1
+	# The archive and extracted root both occupy tmpfs during sysupgrade.
+	[ "$root_size" -gt 0 ] && [ "$root_size" -le 134217728 ] || return 1
+	[ "$(hexdump -v -n 4 -e '4/1 "%02x"' "$dir/kernel")" = d00dfeed ] || return 1
+	[ "$(hexdump -v -n 4 -e '4/1 "%02x"' "$dir/root")" = 68737173 ] || return 1
+}
+
+ln6001_check_image() {
+	local dir rc
+
+	dir="$(mktemp -d /tmp/ln6001-image.XXXXXX)" || return 1
+	ln6001_check_image_contents "$1" "$dir"
+	rc=$?
+	rm -f "$dir/kernel" "$dir/root"
+	rmdir "$dir"
+	return "$rc"
+}
+
+ln6001_bootconfig_age() {
+	local age
+
+	ln6001_bootconfig_slot "$1" >/dev/null || return 1
+	age="$(hexdump -v -s 4 -n 4 -e '1/4 "%u"' "$1")" || return 1
+	case "$age" in
+		''|*[!0-9]*) return 1 ;;
+	esac
+	printf '%s\n' "$age"
+}
+
+ln6001_bootconfig_offset() {
+	local file="$1" wanted="$2" count i name offset found=
+
+	count="$(hexdump -v -s 8 -n 4 -e '1/4 "%u"' "$file")" || return 1
+	[ "$count" -ge 1 ] && [ "$count" -le 16 ] || return 1
+	i=0
+	while [ "$i" -lt "$count" ]; do
+		name="$(dd if="$file" bs=1 skip=$((12 + i * 20)) count=16 2>/dev/null |
+			tr -d '\000')" || return 1
+		if [ "$name" = "$wanted" ]; then
+			[ -z "$found" ] || return 1
+			offset=$((28 + i * 20))
+			found=1
+		fi
+		i=$((i + 1))
+	done
+	[ "$found" = 1 ] || return 1
+	printf '%s\n' "$offset"
+}
+
+ln6001_write_le32() {
+	local file="$1" offset="$2" value="$3" bytes
+
+	[ -f "$file" ] && [ "$value" -ge 0 ] &&
+		[ "$value" -le 4294967295 ] || return 1
+	bytes="$(printf '\\%03o\\%03o\\%03o\\%03o' \
+		$((value & 255)) $(((value >> 8) & 255)) \
+		$(((value >> 16) & 255)) $(((value >> 24) & 255)))"
+	printf '%b' "$bytes" | dd of="$file" bs=1 seek="$offset" count=4 \
+		conv=notrunc 2>/dev/null
+}
+
+# Change only a regular-file snapshot; callers must validate before any device I/O.
+ln6001_prepare_bootconfig() {
+	local file="$1" slot="$2" age="$3" name offset
+
+	[ -f "$file" ] || return 1
+	case "$slot" in
+		0|1) ;;
+		*) return 1 ;;
+	esac
+	[ "$age" -ge 1 ] && [ "$age" -le 4294967294 ] || return 1
+	ln6001_bootconfig_slot "$file" >/dev/null || return 1
+	for name in '0:HLOS' rootfs '0:WIFIFW'; do
+		offset="$(ln6001_bootconfig_offset "$file" "$name")" || return 1
+		ln6001_write_le32 "$file" "$offset" "$slot" || return 1
+	done
+	ln6001_write_le32 "$file" 4 "$age" || return 1
+	[ "$(ln6001_bootconfig_slot "$file")" = "$slot" ] || return 1
+	[ "$(ln6001_bootconfig_age "$file")" = "$age" ]
+}
+
+ln6001_check_bootconfig_pair() {
+	local dir rc=1 a b age_a age_b count_a count_b
+
+	[ "$(ln6001_bootconfig_pair_slot "$1" "$2")" = "$3" ] || return 1
+	count_a="$(hexdump -v -s 8 -n 4 -e '1/4 "%u"' "$1")" || return 1
+	count_b="$(hexdump -v -s 8 -n 4 -e '1/4 "%u"' "$2")" || return 1
+	[ "$count_a" = 8 ] && [ "$count_b" = 8 ] || return 1
+	age_a="$(ln6001_bootconfig_age "$1")" || return 1
+	age_b="$(ln6001_bootconfig_age "$2")" || return 1
+	[ "$age_a" -lt 4294967294 ] && [ "$age_b" -lt 4294967294 ] || return 1
+
+	dir="$(mktemp -d /tmp/ln6001-bootconfig.XXXXXX)" || return 1
+	a="$dir/a"
+	b="$dir/b"
+	if dd if="$1" of="$a" bs=336 count=1 2>/dev/null &&
+		dd if="$2" of="$b" bs=336 count=1 2>/dev/null &&
+		[ "$(wc -c < "$a")" -eq 336 ] &&
+		[ "$(wc -c < "$b")" -eq 336 ] &&
+		ln6001_write_le32 "$a" 4 0 &&
+		ln6001_write_le32 "$b" 4 0 &&
+		cmp -s "$a" "$b"; then
+		rc=0
+	fi
+	rm -f "$a" "$b"
+	rmdir "$dir"
+	return "$rc"
+}
+
+ln6001_preflight() {
+	local slot
+
+	slot="$(ln6001_upgrade_slot)" || return 1
+	ln6001_check_bootconfig_pair /dev/mmcblk0p3 /dev/mmcblk0p4 "$slot" || return 1
+	cmp -s /dev/mmcblk0p26 /dev/mmcblk0p27 || return 1
+	ln6001_check_image "$1"
+}
+
+ln6001_write_verified() {
+	local source="$1" device="$2" size expected actual
+
+	size="$(wc -c < "$source")" || return 1
+	expected="$(sha256sum "$source" | cut -d ' ' -f 1)" || return 1
+	dd if="$source" of="$device" bs=65536 conv=notrunc 2>/dev/null || return 1
+	sync
+	actual="$(head -c "$size" "$device" | sha256sum | cut -d ' ' -f 1)" || return 1
+	[ "$actual" = "$expected" ]
+}
+
+ln6001_write_overlay() {
+	local root="$1" root_size="$2" backup="$3" blocks size expected actual
+
+	[ $((root_size % 65536)) -eq 0 ] || return 1
+	blocks=$((root_size / 512))
+	dd if=/dev/zero of="$root" bs=512 seek="$blocks" count=8 \
+		conv=notrunc 2>/dev/null || return 1
+	sync
+	[ -n "$backup" ] || return 0
+	[ -f "$backup" ] || return 1
+	size="$(wc -c < "$backup")" || return 1
+	[ $((root_size + size)) -le 134217728 ] || return 1
+	expected="$(sha256sum "$backup" | cut -d ' ' -f 1)" || return 1
+	dd if="$backup" of="$root" bs=512 seek="$blocks" \
+		conv=notrunc 2>/dev/null || return 1
+	sync
+	actual="$(dd if="$root" bs=512 skip="$blocks" 2>/dev/null |
+		head -c "$size" | sha256sum | cut -d ' ' -f 1)" || return 1
+	[ "$actual" = "$expected" ]
+}
+
+ln6001_write_sector_verified() {
+	local source="$1" device="$2" readback="$3"
+
+	[ "$(wc -c < "$source")" -eq 512 ] || return 1
+	dd if="$source" of="$device" bs=512 count=1 \
+		conv=notrunc 2>/dev/null || return 1
+	sync
+	dd if="$device" of="$readback" bs=512 count=1 2>/dev/null || return 1
+	[ "$(wc -c < "$readback")" -eq 512 ] || return 1
+	cmp -s "$source" "$readback"
+}
+
+ln6001_cleanup_upgrade() {
+	local dir="$1" file
+
+	for file in kernel root old0 old1 new0 new1 check0 check1 readback; do
+		rm -f "$dir/$file"
+	done
+	rmdir "$dir"
+}
+
+ln6001_stage_inactive_slot() {
+	local image="$1" dir="$2" kernel_dev="$3" root_dev="$4"
+	local slot="$5" backup="$6" age0 age1 age root_size
+
+	ln6001_check_image_contents "$image" "$dir" || return 1
+	dd if=/dev/mmcblk0p3 of="$dir/old0" bs=512 count=1 2>/dev/null || return 1
+	dd if=/dev/mmcblk0p4 of="$dir/old1" bs=512 count=1 2>/dev/null || return 1
+	[ "$(wc -c < "$dir/old0")" -eq 512 ] || return 1
+	[ "$(wc -c < "$dir/old1")" -eq 512 ] || return 1
+	age0="$(ln6001_bootconfig_age "$dir/old0")" || return 1
+	age1="$(ln6001_bootconfig_age "$dir/old1")" || return 1
+	age="$age0"
+	[ "$age1" -le "$age" ] || age="$age1"
+	age=$((age + 1))
+	cp "$dir/old0" "$dir/new0" || return 1
+	cp "$dir/old1" "$dir/new1" || return 1
+	ln6001_prepare_bootconfig "$dir/new0" "$slot" "$age" || return 1
+	ln6001_prepare_bootconfig "$dir/new1" "$slot" "$age" || return 1
+
+	root_size="$(wc -c < "$dir/root")" || return 1
+	ln6001_write_verified "$dir/root" "$root_dev" || return 1
+	ln6001_write_overlay "$root_dev" "$root_size" "$backup" || return 1
+	ln6001_write_verified "$dir/kernel" "$kernel_dev" || return 1
+
+	dd if=/dev/mmcblk0p3 of="$dir/check0" bs=512 count=1 2>/dev/null || ln6001_commit_failure
+	dd if=/dev/mmcblk0p4 of="$dir/check1" bs=512 count=1 2>/dev/null || ln6001_commit_failure
+	cmp -s "$dir/old0" "$dir/check0" &&
+		cmp -s "$dir/old1" "$dir/check1" || ln6001_commit_failure
+}
+
+ln6001_commit_failure() {
+	echo "LN6001 selector state uncertain; staying in RAM for serial recovery" >&2
+	exit 1
+}
+
+ln6001_do_upgrade() {
+	local image="$1" active target kernel_dev root_dev dir
+
+	ln6001_preflight "$image" || return 1
+	active="$(ln6001_upgrade_slot)" || return 1
+	case "$active" in
+		0) target=1; kernel_dev=/dev/mmcblk0p30; root_dev=/dev/mmcblk0p31 ;;
+		1) target=0; kernel_dev=/dev/mmcblk0p28; root_dev=/dev/mmcblk0p29 ;;
+		*) return 1 ;;
+	esac
+	dir="$(mktemp -d /tmp/ln6001-upgrade.XXXXXX)" || return 1
+	if ! ln6001_stage_inactive_slot "$image" "$dir" "$kernel_dev" "$root_dev" \
+		"$target" "$UPGRADE_BACKUP"; then
+		ln6001_cleanup_upgrade "$dir"
+		return 1
+	fi
+
+	ln6001_write_sector_verified "$dir/new0" /dev/mmcblk0p3 \
+		"$dir/readback" || ln6001_commit_failure
+	ln6001_write_sector_verified "$dir/new1" /dev/mmcblk0p4 \
+		"$dir/readback" || ln6001_commit_failure
+	[ "$(ln6001_bootconfig_pair_slot /dev/mmcblk0p3 /dev/mmcblk0p4)" = \
+		"$target" ] || ln6001_commit_failure
+	fw_setenv boot_part "$((target + 1))" || ln6001_commit_failure
+	[ "$(ln6001_bootenv_slot)" = "$target" ] || ln6001_commit_failure
+	ln6001_cleanup_upgrade "$dir"
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/platform.sh
new file mode 100644
index 0000000..71f110c
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/platform.sh
@@ -0,0 +1,87 @@
+REQUIRE_IMAGE_METADATA=1
+RAMFS_COPY_BIN='dumpimage fitblk fit_check_sign'
+
+gl_be6500_remove_oem_rootfs() {
+	local mtdnum
+	local ubidev
+	local ubivol
+
+	mtdnum=$(find_mtd_index "$CI_UBIPART")
+	if [ -z "$mtdnum" ]; then
+		echo "Unable to find UBI MTD partition $CI_UBIPART"
+		return 1
+	fi
+
+	ubidev=$(nand_find_ubi "$CI_UBIPART")
+	if [ -z "$ubidev" ]; then
+		ubiattach --mtdn="$mtdnum" || return 1
+		ubidev=$(nand_find_ubi "$CI_UBIPART")
+	fi
+
+	[ -n "$ubidev" ] || return 1
+
+	ubivol=$(nand_find_volume "$ubidev" ubi_rootfs)
+	[ -z "$ubivol" ] || {
+		echo "Removing legacy ubi_rootfs volume"
+		ubirmvol "/dev/$ubidev" --name=ubi_rootfs || return 1
+	}
+}
+
+platform_do_upgrade() {
+	case "$(board_name)" in
+	mercusys,mr47be-v2)
+		CI_UBIPART="rootfs_1"
+		nand_do_upgrade "$1"
+		;;
+	gl.inet,gl-be6500)
+		CI_UBIPART="rootfs"
+		gl_be6500_remove_oem_rootfs || return 1
+		nand_do_upgrade "$1"
+		;;
+	gl.inet,gl-be9300)
+		CI_KERNPART="0:HLOS"
+		CI_ROOTPART="rootfs"
+		glinet_emmc_do_upgrade "$1" || exit 1
+		;;
+	ubnt,u7-pro-xgs)
+		CI_KERNPART="kernel0"
+		fit_do_upgrade "$1"
+		;;
+	*)
+		echo "Sysupgrade is not supported on your board yet."
+		return 1
+		;;
+	esac
+}
+
+platform_check_image() {
+	[ "$#" -gt 1 ] && return 1
+
+	case "$(board_name)" in
+	mercusys,mr47be-v2)
+		return 0
+		;;
+	gl.inet,gl-be6500)
+		return 0
+		;;
+	gl.inet,gl-be9300)
+		glinet_emmc_check_image "$1"
+		;;
+	ubnt,u7-pro-xgs)
+		fit_check_image "$1"
+		;;
+	*)
+		echo "Sysupgrade is not supported on your board yet."
+		return 1
+		;;
+	esac
+}
+
+platform_copy_config() {
+	case "$(board_name)" in
+	gl.inet,gl-be9300|\
+	ubnt,u7-pro-xgs)
+		emmc_copy_config
+		;;
+	esac
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/mr47be-wan-diag b/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/mr47be-wan-diag
new file mode 100755
index 0000000..f688204
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/mr47be-wan-diag
@@ -0,0 +1,105 @@
+﻿﻿#!/bin/sh
+# mr47be-wan-diag - MR47BE V2 WAN/PPPoE teşhis (salt-okunur)
+# Kullanım: mr47be-wan-diag > /tmp/diag.txt 2>&1 ; cat /tmp/diag.txt
+
+echo "===== 1. KURULUM / KERNEL ====="
+uname -a
+tr -d '\0' < /proc/device-tree/model 2>/dev/null; echo
+echo "--- bootargs:"; cat /proc/cmdline
+
+echo
+echo "===== 2. NETWORK UCI ====="
+for s in lan wan wan6; do
+	echo "--- network.$s"
+	uci -q show network.$s
+done
+echo "--- device bolumleri:"
+uci -q show network | grep -E "\.device|\.ports|\.macaddr|\.proto|\.ifname"
+
+echo
+echo "===== 3. NETDEV DURUMU (link/mac/traffic) ====="
+for i in /sys/class/net/*; do
+	n=$(basename "$i")
+	c=$(cat "$i/carrier" 2>/dev/null)
+	o=$(cat "$i/operstate" 2>/dev/null)
+	m=$(cat "$i/address" 2>/dev/null)
+	r=$(cat "$i/statistics/rx_packets" 2>/dev/null)
+	t=$(cat "$i/statistics/tx_packets" 2>/dev/null)
+	printf "%-12s carrier=%-3s oper=%-10s mac=%-18s rx=%-10s tx=%-10s\n" "$n" "$c" "$o" "$m" "$r" "$t"
+done
+
+echo
+echo "===== 4. IP ADRES / ROUTE ====="
+ip -4 -br addr
+ip route
+echo "--- default route sayisi:"; ip route | grep -c "^default"
+
+echo
+echo "===== 5. PPPoE / PPP GUNLUGU ====="
+logread 2>/dev/null | grep -iE "pppoe|pppd|ppp0|pppoe-wan" | tail -40
+echo "--- ppp netdev var mi:"
+ls /sys/class/net/ 2>/dev/null | grep -E "ppp|pppoe" || echo "(ppp netdev yok)"
+
+echo
+echo "===== 6. CANLI WAN PHY1 TX (PADI cikiyor mu?) ====="
+echo "--- 8 saniye, 2 aralikla PHY1 TX sayaci:"
+for i in 1 2 3 4 5; do
+	t=$(mdio 90000.mdio-1 mmd 1:7 raw 0x802e 2 2>/dev/null | awk '{x=$NF} END{print x}')
+	r=$(mdio 90000.mdio-1 mmd 1:7 raw 0x8029 1 2>/dev/null | awk '{x=$NF} END{print x}')
+	echo "  $(date +%T) phy1_tx=$t phy1_rx=$r"
+	sleep 2
+done
+echo "--- wan rx/tx sayaci (kontrol):"
+for i in 1 2 3; do
+	echo "  $(date +%T) gmac1 rx=$(cat /sys/class/net/wan/statistics/rx_packets 2>/dev/null) tx=$(cat /sys/class/net/wan/statistics/tx_packets 2>/dev/null)"
+	sleep 2
+done
+
+echo
+echo "===== 7. SWITCH (QCA8386) DURUMU ====="
+echo "--- die-switch status:"
+/usr/sbin/mr47be-die-switch status 2>/dev/null | tail -5
+echo "--- mdio phy link (1=WAN 2=LAN3 3=LAN2 4=LAN1):"
+for p in 1 2 3 4; do
+	l=$(mdio 90000.mdio-1 phy $p raw 1 2>/dev/null | awk '{x=$NF} END{print x}')
+	echo "  phy$p BMSR=$l"
+done
+echo "--- switch ACL registerlari (R16/M16/A4/A8):"
+for r in 58010 59010 5a004 5a008; do
+	echo "  0x$r = $(mdio 90000.mdio-1 phy 20 raw $r 2>/dev/null)"
+done
+
+echo
+echo "===== 8. TP_DATA MAC (stok MAC kaynagi) ====="
+mtdnum=$(awk '/tp_data/ {gsub(":","",$1); print $1; exit}' /proc/mtd 2>/dev/null)
+echo "tp_data mtd=$mtdnum"
+if [ -n "$mtdnum" ]; then
+	[ -e /dev/ubi1 ] || ubiattach -m "$mtdnum" -d 1 >/dev/null 2>&1
+	mkdir -p /tmp/.tpd
+	mount -t ubifs -o ro ubi1:tp_data /tmp/.tpd 2>/dev/null && {
+		ls -l /tmp/.tpd
+		echo "--- default-mac:"
+		od -An -tx1 -N6 /tmp/.tpd/default-mac 2>/dev/null
+		umount /tmp/.tpd 2>/dev/null
+	}
+	rmdir /tmp/.tpd 2>/dev/null
+fi
+
+echo
+echo "===== 9. ART MAC (0:art) ====="
+grep art /proc/mtd
+echo "--- mtd_get_mac_binary:"
+mtd_get_mac_binary "0:art" 0x0 2>/dev/null || echo "(okunamadı)"
+
+echo
+echo "===== 10. LAN YOLU (bridge uyeleri) ====="
+bridge link show 2>/dev/null | head -20
+echo "--- br-lan uyeleri:"
+ls /sys/class/net/br-lan/brif 2>/dev/null
+
+echo
+echo "===== 11. DIE-SWITCH LOG (son 40) ====="
+tail -40 /tmp/mr47be-die.log 2>/dev/null || echo "(log yok)"
+
+echo
+echo "===== Bitti ====="
