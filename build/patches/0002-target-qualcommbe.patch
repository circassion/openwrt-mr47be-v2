new file mode 100644
index 0000000..0c8480b
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0387-net-phy-qca808x-bring-up-PCS0-UNIPHY0-as-SGMII-PHY-side.patch
@@ -0,0 +1,217 @@
+From: lab <lab@local>
+Subject: [PATCH] net: phy: qca808x: bring up PCS0/UNIPHY0 as SGMII PHY-side lane
+
+The WAN EPHY reaches the SoC dataport through the package's UNIPHY0
+(MDIO face 5). u-boot initialises that face as MAC-side with a forced 1G
+(0x11b=0x0420, 0x120=0x084c) even though it writes WORK_MODE=0x20
+(SWITCH_BYPASS_PORT5), which the vendor only uses together with the
+PHY-side setting. With the lane wired to a switch MAC instead of the
+EPHY, the SoC dataport receives switch-forwarded frames - carrying the
+2-byte header that shows up as "be 43" in the ethertype slot - and its
+own TX never leaves towards the wire.
+
+Program the vendor qca_mht_interface_sgmii_mode_set(UNIPHY_SGMII_0,
+auto_neg = 1) recipe from the package config_init_once(): SGMII select,
+PHY-side, SGMII data path, IPG tuning cleared, forced speed dropped so
+channel 0 negotiates in band, analog soft reset + calibration wait, then
+the channel-0 adapt and SGMII function reset pulses.
+
+The face gets no mdio_device: the package probe maps every "pcs-phy"
+child onto shared_priv->mdiodev[0] and would clobber the working PCS1
+handle, and the QCA8084 clock provider has no SRDS0/uniphy0 clocks to
+hand out, so drive it with the bus-level C45/C22 helpers instead.
+
+Signed-off-by: lab <lab@local>
+---
+--- a/drivers/net/phy/qcom/qca8084_serdes.c
++++ b/drivers/net/phy/qcom/qca8084_serdes.c
+@@ -627,6 +627,8 @@
+ /* Defined further down; needed by qca8084_sgmii_set_mode() below. */
+ static int qca8084_pcs_ipg_tune_reset(struct mdio_device *mdio_dev,
+ 				      int reset_function);
++static int qca8084_pcs_ipg_tune_reset_bus(struct mii_bus *bus, int addr,
++					  int reset_function);
+ 
+ /* Bring up PCS1 (UNIPHY1) for SGMII/SGMII+ towards the switch MAC.
+  *
+@@ -712,6 +714,113 @@
+ }
+ EXPORT_SYMBOL_GPL(qca8084_sgmii_set_mode);
+ 
++/*
++ * Bring up the PCS0/UNIPHY0 face as the SGMII PHY-side lane that carries the
++ * WAN EPHY towards the SoC dataport.
++ *
++ * This face deliberately gets no mdio_device: the package probe assigns every
++ * child named "pcs-phy" to shared_priv->mdiodev[0], so a second one would
++ * clobber the working PCS1 handle, and the QCA8084 clock provider has no
++ * SRDS0/uniphy0 312p5m or branch clocks to hand out. The face is reachable
++ * straight on the package MDIO bus (address taken from qcom,phy-addr-fixup),
++ * so use the bus-level C45/C22 helpers here.
++ *
++ * u-boot leaves this SerDes as MAC-side with a forced 1G (0x11b=0x0420,
++ * 0x120=0x084c) while it writes WORK_MODE=0x20 (SWITCH_BYPASS_PORT5), which is
++ * the vendor value for PHY-side only. With the lane wired to a switch MAC the
++ * SoC receives switch-forwarded frames - i.e. frames carrying the 2-byte
++ * header seen as "be 43" in the ethertype slot - and its own TX disappears
++ * into the switch. Program the vendor PCS0_SGMII_PHY recipe instead: SGMII,
++ * PHY-side, in-band auto-negotiation, analog reset, calibration, adapt and
++ * function reset.
++ */
++int qca8084_uniphy0_sgmii_phy_mode(struct mii_bus *bus, int addr)
++{
++	int ret;
++
++	/* Plain 1G SGMII on the serial lane, data path not USXGMII. */
++	ret = mdiobus_modify(bus, addr, PLL_CONTROL,
++			     PLL_CONTROL_CMLDIV2_IBSEL_MASK,
++			     FIELD_PREP(PLL_CONTROL_CMLDIV2_IBSEL_MASK, 3));
++	if (ret)
++		return ret;
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, MODE_CONTROL,
++				 MODE_CONTROL_SEL_MASK,
++				 FIELD_PREP(MODE_CONTROL_SEL_MASK,
++					    MODE_CONTROL_SGMII));
++	if (ret)
++		return ret;
++
++	/* PHY-side: the SoC PCS stays the MAC of this link. */
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, MODE_CONTROL,
++				 MODE_CONTROL_SGMII_SEL_MASK,
++				 FIELD_PREP(MODE_CONTROL_SGMII_SEL_MASK,
++					    MODE_CONTROL_SGMII_PHY));
++	if (ret)
++		return ret;
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, QP_USXG_OPTION1,
++				 QP_USXG_OPTION1_DATAPASS,
++				 QP_USXG_OPTION1_DATAPASS_SGMII);
++	if (ret)
++		return ret;
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, BYPASS_TUNNING_IPG,
++				 BYPASS_TUNNING_IPG_MASK, 0);
++	if (ret)
++		return ret;
++
++	/* Drop the forced speed so channel 0 negotiates in band with the
++	 * SoC PCS, like qca_mht_interface_sgmii_mode_set(auto_neg = 1).
++	 */
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, CHANNEL0_CFG,
++				 CH0_FORCE_SPEED_MASK, 0);
++	if (ret)
++		return ret;
++
++	/* Analog soft reset/release; the lane only produces clocks after
++	 * calibration completed.
++	 */
++	ret = mdiobus_modify(bus, addr, PLL_POWER_ON_AND_RESET,
++			     PCS_ANA_SW_RESET, 0);
++	if (ret)
++		return ret;
++
++	usleep_range(10000, 11000);
++
++	ret = mdiobus_modify(bus, addr, PLL_POWER_ON_AND_RESET,
++			     PCS_ANA_SW_RESET, PCS_ANA_SW_RESET);
++	if (ret)
++		return ret;
++
++	ret = read_poll_timeout(mdiobus_c45_read, ret,
++				(ret & CALIBRATION_DONE),
++				100, 100000, true, bus, addr,
++				MDIO_MMD_PMAPMD, CALIBRATION4);
++	if (ret) {
++		dev_err(&bus->dev, "UNIPHY0 calibration timeout!\n");
++		return ret;
++	}
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, CHANNEL0_CFG,
++				 CH0_ADPT_RESET, 0);
++	if (ret)
++		return ret;
++
++	usleep_range(1000, 1100);
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, CHANNEL0_CFG,
++				 CH0_ADPT_RESET, CH0_ADPT_RESET);
++	if (ret)
++		return ret;
++
++	return qca8084_pcs_ipg_tune_reset_bus(bus, addr,
++					      QP_USXG_SGMII_FUNC_RESET);
++}
++EXPORT_SYMBOL_GPL(qca8084_uniphy0_sgmii_phy_mode);
++
++
+ int qca8084_qxgmii_set_mode(struct mdio_device *xpcs_mdiodev,
+ 			    struct mdio_device *pcs_mdiodev)
+ {
+@@ -744,6 +853,25 @@
+ 				  reset_function, reset_function);
+ }
+ 
++/* Same pulse sequence as qca8084_pcs_ipg_tune_reset(), for a face that has
++ * no mdio_device of its own (PCS0/UNIPHY0).
++ */
++static int qca8084_pcs_ipg_tune_reset_bus(struct mii_bus *bus, int addr,
++					  int reset_function)
++{
++	int ret;
++
++	ret = mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, QP_USXG_RESET,
++				 reset_function, 0);
++	if (ret)
++		return ret;
++
++	usleep_range(1000, 1100);
++
++	return mdiobus_c45_modify(bus, addr, MDIO_MMD_PMAPMD, QP_USXG_RESET,
++				  reset_function, reset_function);
++}
++
+ static int qca8084_xpcs_an_restart(struct mdio_device *xpcs_mdiodev,
+ 				   int channel)
+ {
+
+--- a/drivers/net/phy/qcom/qca8084_serdes.h
++++ b/drivers/net/phy/qcom/qca8084_serdes.h
+@@ -18,6 +18,7 @@
+ 					 struct mdio_device *pcs_mdiodev);
+ int qca8084_sgmii_set_mode(struct mdio_device *pcs_mdiodev,
+ 			   phy_interface_t interface);
++int qca8084_uniphy0_sgmii_phy_mode(struct mii_bus *bus, int addr);
+ int qca8084_qxgmii_set_mode(struct mdio_device *xpcs_mdiodev,
+ 			    struct mdio_device *pcs_mdiodev);
+ void qca8084_qxgmii_set_speed(struct mdio_device *xpcs_mdiodev,
+
+--- a/drivers/net/phy/qcom/qca808x.c
++++ b/drivers/net/phy/qcom/qca808x.c
+@@ -1329,6 +1329,26 @@
+ 		break;
+ 	}
+ 
++	/* The WAN EPHY leaves the package through PCS0/UNIPHY0. Do the same
++	 * SerDes bring-up the vendor does from qca_mht_hw_init(), but after
++	 * the shared package clocks are up and before the SoC side attaches.
++	 */
++	if (shared_priv->package_mode == QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_PHY) {
++		int uniphy_addr[QCA8084_MDIO_DEVICE_NUM] = { 0, 1, 2, 3, 4, 5, 6 };
++		struct device_node *np = phy_package_get_node(phydev);
++
++		/* addr[4] is the MDIO address of the PCS0/UNIPHY0 face, i.e.
++		 * the same array the package probe programmed into PCS_CFG.
++		 */
++		of_property_read_u32_array(np, "qcom,phy-addr-fixup",
++					   uniphy_addr, ARRAY_SIZE(uniphy_addr));
++
++		ret = qca8084_uniphy0_sgmii_phy_mode(phydev->mdio.bus,
++						     uniphy_addr[4]);
++		if (ret)
++			return ret;
++	}
++
+ 	/* Initialize the PHY package clock and reset, which is the
+ 	 * necessary config sequence after GPIO reset on the PHY package.
+ 	 */
diff --git a/target/linux/qualcommbe/patches-6.18/0391-net-phy-qca808x-config-init-unattached-QCA8084-EPHYs.patch b/target/linux/qualcommbe/patches-6.18/0391-net-phy-qca808x-config-init-unattached-QCA8084-EPHYs.patch
