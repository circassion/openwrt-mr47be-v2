new file mode 100644
index 0000000..2b7bdb6
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0386-net-phy-qca808x-bring-up-package-GCC-EPHY-clocks-deassert.patch
@@ -0,0 +1,370 @@
+From: Qoder Lab <lab@localhost>
+Date: Sun, 01 Nov 2026 18:00:00 +0300
+Subject: [PATCH] net: phy: qca808x: bring up the package GCC clocks, release the EPHY DSP and load the analog fuses
+
+The QCA8084 has its own clock controller (GCC) in the 0xc800000 register
+window, reached with the same 32-bit MDIO sequence the driver already uses
+for the secure control registers.
+
+Vendor Linux programmed it from the MDIO bus probe, in
+mdio-qca.c:qca_mht_clock_init(), triggered by the "mdio_clk_fixup"
+property of the MDIO bus node. This board's device tree carries that
+property, but no driver in this tree acts on it, so the EPHY sys clocks
+stayed gated, the EPHY DSP stayed in reset and the analog trim fuses were
+never pushed into the PHYs.
+
+Port the sequence into the PHY package bring-up, where the MDIO access
+helpers already exist, and run it before any interface mode configuration
+because it reset-pulses SRDS0 and SRDS1.
+
+Failures in the fuse and analog trim steps are reported but not fatal, so
+that a single MDIO read error cannot take down the ports that already link.
+---
+--- a/drivers/net/phy/qcom/qca808x.c
++++ b/drivers/net/phy/qcom/qca808x.c
+@@ -164,6 +164,57 @@
+ #define QCA8084_MEM_ACC_CFG			0xc90f048
+ #define QCA8084_MEM_ACC_SWITCH			0x000c0c0c
+ 
++/* The QCA8084 GCC (its own clock controller) lives in the 0xc800000 window and
++ * is reached with the same 32-bit MDIO sequence as the secure control registers
++ * above. Vendor Linux brought it up from the MDIO bus probe, in
++ * mdio-qca.c:qca_mht_clock_init(), gated on the "mdio_clk_fixup" property of
++ * the MDIO node. Without that sequence the four EPHYs keep their sys clocks
++ * gated and their DSP in reset, so they cannot autonegotiate at all.
++ */
++#define QCA8084_GEPHY0_TX_CBCR			0xc800058
++#define QCA8084_GEPHY_TX_CBCR_NUM		8
++#define QCA8084_GEPHY_TX_CBCR_STRIDE		0x20
++#define QCA8084_SRDS0_SYS_CBCR			0xc8001a8
++#define QCA8084_SRDS_CBCR_NUM			2
++#define QCA8084_SRDS_CBCR_STRIDE		4
++#define QCA8084_EPHY0_SYS_CBCR			0xc8001b0
++#define QCA8084_EPHY_NUM			4
++#define QCA8084_EPHY_CBCR_STRIDE		4
++#define QCA8084_GCC_GEPHY_MISC			0xc800304
++
++#define QCA8084_CBCR_ENABLE			BIT(0)
++#define QCA8084_CBCR_RESET			BIT(2)
++#define QCA8084_GEPHY_DSP_MASK			GENMASK(4, 0)
++
++#define QCA8084_EPHY_ADDR_SHIFT			5
++#define QCA8084_EPHY_ADDR_MASK			GENMASK(4, 0)
++
++/* Analog trim fuses. On engineering-sample parts the fuse values are not
++ * delivered to the analog circuit automatically, they have to be pushed into
++ * each PHY through its debug port.
++ */
++#define QCA8084_QFPROM_PTE_ROW2_MSB		0xc900014
++#define QCA8084_QFPROM_PTE_ES_MASK		GENMASK(23, 16)
++#define QCA8084_QFPROM_CAL_ROW4_LSB		0xc900048
++#define QCA8084_QFPROM_CAL_ROW4_LDO		GENMASK(21, 18)
++#define QCA8084_QFPROM_CAL_ROW4_ICC		GENMASK(26, 22)
++#define QCA8084_QFPROM_CAL_ROW7_LSB		0xc900060
++#define QCA8084_QFPROM_CAL_ROW_LDO		GENMASK(26, 23)
++#define QCA8084_QFPROM_CAL_ROW_ICC		GENMASK(31, 27)
++#define QCA8084_QFPROM_CAL_ROW8_LSB		0xc900068
++#define QCA8084_QFPROM_CAL_ROW6_MSB		0xc90005c
++#define QCA8084_QFPROM_CAL_ROW6_LDO		GENMASK(17, 14)
++#define QCA8084_QFPROM_CAL_ROW6_ICC		GENMASK(22, 18)
++
++#define QCA8084_PHY_DEBUG_PORT_ADDR		0x1d
++#define QCA8084_PHY_DEBUG_PORT_DATA		0x1e
++#define QCA8084_PHY_LDO_EFUSE_REG		0x180
++#define QCA8084_PHY_LDO_EFUSE_LEVEL_MASK	GENMASK(7, 4)
++#define QCA8084_PHY_ICC_EFUSE_REG		0x280
++#define QCA8084_PHY_ICC_EFUSE_LEVEL_MASK	GENMASK(4, 0)
++#define QCA8084_PHY_10BT_SG_THRESH_REG		0x3380
++#define QCA8084_PHY_ANA_OPTION2_REG		0x8102
++
+ MODULE_DESCRIPTION("Qualcomm Atheros QCA808X PHY driver");
+ MODULE_AUTHOR("Matus Ujhelyi, Luo Jie");
+ MODULE_LICENSE("GPL");
+@@ -277,6 +328,272 @@
+ 	return ret;
+ };
+ 
++static int qca8084_mii_read(struct phy_device *phydev, u32 regaddr, u32 *val)
++{
++	u16 reg, addr, page, sw_addr;
++	struct mii_bus *bus;
++	int ret;
++
++	bus = phydev->mdio.bus;
++	mutex_lock(&bus->mdio_lock);
++
++	reg = FIELD_GET(QCA8084_MII_REG_MASK, regaddr);
++	addr = FIELD_GET(QCA8084_MII_PHY_ADDR_MASK, regaddr);
++	page = FIELD_GET(QCA8084_MII_PAGE_MASK, regaddr);
++	sw_addr = FIELD_GET(QCA8084_MII_SW_ADDR_MASK, regaddr);
++
++	ret = __qca8084_set_page(bus, sw_addr, page);
++	if (ret < 0)
++		goto qca8084_mii_read_exit;
++
++	ret = __qca8084_mii_read(bus, QCA8084_LOW_ADDR_PREFIX | addr, reg, val);
++qca8084_mii_read_exit:
++	mutex_unlock(&bus->mdio_lock);
++
++	return ret;
++}
++
++static void qca8084_mht_clk_reset(struct phy_device *phydev, u32 regaddr)
++{
++	qca8084_mii_modify(phydev, regaddr, 0, QCA8084_CBCR_RESET);
++	usleep_range(20000, 21000);
++	qca8084_mii_modify(phydev, regaddr, QCA8084_CBCR_RESET, 0);
++}
++
++static int qca8084_phy_debug_read(struct mii_bus *bus, int addr, u16 reg_id,
++				  u16 *val)
++{
++	int ret;
++
++	mutex_lock(&bus->mdio_lock);
++	ret = __mdiobus_write(bus, addr, QCA8084_PHY_DEBUG_PORT_ADDR, reg_id);
++	if (!ret)
++		ret = __mdiobus_read(bus, addr, QCA8084_PHY_DEBUG_PORT_DATA);
++	mutex_unlock(&bus->mdio_lock);
++	if (ret < 0)
++		return ret;
++
++	*val = ret;
++
++	return 0;
++}
++
++static int qca8084_phy_debug_write(struct mii_bus *bus, int addr, u16 reg_id,
++				   u16 val)
++{
++	int ret;
++
++	mutex_lock(&bus->mdio_lock);
++	ret = __mdiobus_write(bus, addr, QCA8084_PHY_DEBUG_PORT_ADDR, reg_id);
++	if (!ret)
++		ret = __mdiobus_write(bus, addr, QCA8084_PHY_DEBUG_PORT_DATA, val);
++	mutex_unlock(&bus->mdio_lock);
++
++	return ret;
++}
++
++static int qca8084_ephy_mdio_addr(u32 ephy_cfg, int ethphy)
++{
++	return FIELD_GET(QCA8084_EPHY_ADDR_MASK,
++			 ephy_cfg >> (ethphy * QCA8084_EPHY_ADDR_SHIFT));
++}
++
++static int qca8084_mht_efuse_loading(struct phy_device *phydev, u32 ephy_cfg,
++				     int ethphy)
++{
++	struct mii_bus *bus = phydev->mdio.bus;
++	u32 val = 0, ldo_efuse = 0, icc_efuse = 0;
++	u16 reg_val = 0;
++	int ret, addr;
++
++	/* Each EPHY has its own calibration fuse row, and the LDO/ICC fields
++	 * sit at different offsets in it.
++	 */
++	switch (ethphy) {
++	case 0:
++		ret = qca8084_mii_read(phydev, QCA8084_QFPROM_CAL_ROW4_LSB, &val);
++		ldo_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW4_LDO, val);
++		icc_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW4_ICC, val);
++		break;
++	case 1:
++		ret = qca8084_mii_read(phydev, QCA8084_QFPROM_CAL_ROW7_LSB, &val);
++		ldo_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW_LDO, val);
++		icc_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW_ICC, val);
++		break;
++	case 2:
++		ret = qca8084_mii_read(phydev, QCA8084_QFPROM_CAL_ROW8_LSB, &val);
++		ldo_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW_LDO, val);
++		icc_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW_ICC, val);
++		break;
++	case 3:
++		ret = qca8084_mii_read(phydev, QCA8084_QFPROM_CAL_ROW6_MSB, &val);
++		ldo_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW6_LDO, val);
++		icc_efuse = FIELD_GET(QCA8084_QFPROM_CAL_ROW6_ICC, val);
++		break;
++	default:
++		return -EINVAL;
++	}
++	if (ret)
++		return ret;
++
++	addr = qca8084_ephy_mdio_addr(ephy_cfg, ethphy);
++
++	ret = qca8084_phy_debug_read(bus, addr, QCA8084_PHY_LDO_EFUSE_REG, &reg_val);
++	if (ret)
++		return ret;
++
++	ret = qca8084_phy_debug_write(bus, addr, QCA8084_PHY_LDO_EFUSE_REG,
++				      (reg_val & ~QCA8084_PHY_LDO_EFUSE_LEVEL_MASK) |
++				      FIELD_PREP(QCA8084_PHY_LDO_EFUSE_LEVEL_MASK,
++						 ldo_efuse));
++	if (ret)
++		return ret;
++
++	ret = qca8084_phy_debug_read(bus, addr, QCA8084_PHY_ICC_EFUSE_REG, &reg_val);
++	if (ret)
++		return ret;
++
++	return qca8084_phy_debug_write(bus, addr, QCA8084_PHY_ICC_EFUSE_REG,
++				       (reg_val & ~QCA8084_PHY_ICC_EFUSE_LEVEL_MASK) |
++				       FIELD_PREP(QCA8084_PHY_ICC_EFUSE_LEVEL_MASK,
++						  icc_efuse));
++}
++
++static int qca8084_mht_ethphy_ana_fixup(struct phy_device *phydev, u32 ephy_cfg,
++					int ethphy)
++{
++	struct mii_bus *bus = phydev->mdio.bus;
++	int ret, addr;
++	u16 reg_val;
++
++	addr = qca8084_ephy_mdio_addr(ephy_cfg, ethphy);
++
++	mutex_lock(&bus->mdio_lock);
++	ret = __mdiobus_c45_read(bus, addr, MDIO_MMD_PMAPMD,
++				 QCA8084_PHY_ANA_OPTION2_REG);
++	if (ret >= 0)
++		ret = __mdiobus_c45_write(bus, addr, MDIO_MMD_PMAPMD,
++					  QCA8084_PHY_ANA_OPTION2_REG, ret | 0x7f);
++	mutex_unlock(&bus->mdio_lock);
++	if (ret < 0)
++		return ret;
++
++	ret = qca8084_phy_debug_read(bus, addr, QCA8084_PHY_10BT_SG_THRESH_REG,
++				     &reg_val);
++	if (ret)
++		return ret;
++
++	return qca8084_phy_debug_write(bus, addr, QCA8084_PHY_10BT_SG_THRESH_REG,
++				       reg_val | BIT(0));
++}
++
++static int qca8084_mht_clock_init(struct phy_device *phydev)
++{
++	int ret, i;
++	u32 ephy_cfg, val, es;
++
++	ret = qca8084_mii_read(phydev, QCA8084_EPHY_CFG, &ephy_cfg);
++	if (ret)
