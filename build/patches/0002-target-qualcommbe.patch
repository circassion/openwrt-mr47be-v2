diff --git a/target/linux/qualcommbe/patches-6.18/2986-dt-bindings-usb-qcom-snps-dwc3-add-support-for-usb-phy-mux-selection.patch b/target/linux/qualcommbe/patches-6.18/2986-dt-bindings-usb-qcom-snps-dwc3-add-support-for-usb-phy-mux-selection.patch
new file mode 100644
index 0000000..2ecdeb7
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2986-dt-bindings-usb-qcom-snps-dwc3-add-support-for-usb-phy-mux-selection.patch
@@ -0,0 +1,59 @@
+From 60579708362f0e1603b0ad0a25ed6b2ef2cf8a47 Mon Sep 17 00:00:00 2001
+From: George Moussalem <george.moussalem@outlook.com>
+Date: Mon, 03 Aug 2026 18:38:32 +0400
+Subject: [PATCH v2 11/17] dt-bindings: usb: qcom,snps-dwc3: Add support for USB phy mux selection
+MIME-Version: 1.0
+Content-Type: text/plain; charset="utf-8"
+Content-Transfer-Encoding: 7bit
+Message-Id: <20260803-ipq5018-usb3-v2-11-3a4136712b20@outlook.com>
+
+On some SoCs, such as IPQ5018 and IPQ5332, the USB3 PHY and PCIe PHY
+pads are muxed to the same physical pads. Selection is controlled by a
+register in TCSR. The mux register must be written to before the USB
+controller is taken out of reset and clocks are enabled.
+As such, add a property to enable USB mux selection that takes a phandle
+to the TCSR syscon and the offset to the mux register.
+
+Signed-off-by: George Moussalem <george.moussalem@outlook.com>
+Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
+---
+Credits to Stanislaw Pal for finding the right order of applying the USB
+mux selection ahead of taking the USB controller out of reset and
+enabling clocks.
+---
+ Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml | 12 ++++++++++++
+ 1 file changed, 12 insertions(+)
+
+diff --git a/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml b/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
+index e87cdf41f5f2..9a08a4b8f89f 100644
+--- a/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
++++ b/Documentation/devicetree/bindings/usb/qcom,snps-dwc3.yaml
+@@ -148,6 +148,16 @@ properties:
+     minItems: 3
+     maxItems: 19
+ 
++  qcom,phy-usb-mux-sel:
++    description: |
++      Mux selection for USB PHY. On some SoCs, the USB3 and PCIe PHY pads are
++      muxed and the selection is done via a register in TCSR syscon.
++    $ref: /schemas/types.yaml#/definitions/phandle-array
++    items:
++      - items:
++          - description: phandle of TCSR syscon
++          - description: offset of PHY mux selection register
++
+   qcom,select-utmi-as-pipe-clk:
+     description:
+       If present, disable USB3 pipe_clk requirement.
+@@ -534,6 +544,8 @@ allOf:
+             - const: pwr_event
+             - const: dp_hs_phy_irq
+             - const: dm_hs_phy_irq
++      required:
++        - qcom,phy-usb-mux-sel
+ 
+   - if:
+       properties:
+
+-- 
+2.53.0
diff --git a/target/linux/qualcommbe/patches-6.18/2987-usb-dwc3-qcom-add-support-for-usb-phy-mux-selection.patch b/target/linux/qualcommbe/patches-6.18/2987-usb-dwc3-qcom-add-support-for-usb-phy-mux-selection.patch
new file mode 100644
index 0000000..f108f2c
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2987-usb-dwc3-qcom-add-support-for-usb-phy-mux-selection.patch
@@ -0,0 +1,136 @@
+From 1484ac49343d1014f44f570974b68a0b1bb51da4 Mon Sep 17 00:00:00 2001
+From: George Moussalem <george.moussalem@outlook.com>
+Date: Mon, 03 Aug 2026 18:38:33 +0400
+Subject: [PATCH v2 12/17] usb: dwc3-qcom: Add support for USB phy mux selection
+MIME-Version: 1.0
+Content-Type: text/plain; charset="utf-8"
+Content-Transfer-Encoding: 7bit
+Message-Id: <20260803-ipq5018-usb3-v2-12-3a4136712b20@outlook.com>
+
+The USB3 and PCIe PHYs on IPQ5018 and IPQ5332 are muxed to the same
+physical pads. Selection is controlled by a register in TCSR.
+
+For IPQ5018 and IPQ5332, BIT(0) of 0x1947540 controls mux selection:
+- 0: PCIe (default)
+- 1: USB3
+
+The mux register must be written to before the USB controller is taken
+out of reset and clocks are enabled, else the USB3 PHY doesn't train as
+it will be stuck in Rx.Detect and the controller will fall back to USB2
+mode. As such, add ability to optionally acquire the regmap to the TCSR
+syscon for SoCs that need it and continue if the property is not set.
+The restriction is applied in the bindings for the IPQ5018 and IPQ5332
+DWC3 controller.
+
+Signed-off-by: George Moussalem <george.moussalem@outlook.com>
+Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
+---
+Credits to Stanislaw Pal for finding the right order of applying the USB
+mux selection ahead of taking the USB controller out of reset and
+enabling clocks.
+---
+ drivers/usb/dwc3/dwc3-qcom.c | 43 +++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 43 insertions(+)
+
+diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
+index ac68b4218b56..8b7ab082b6a9 100644
+--- a/drivers/usb/dwc3/dwc3-qcom.c
++++ b/drivers/usb/dwc3/dwc3-qcom.c
+@@ -12,9 +12,11 @@
+ #include <linux/module.h>
+ #include <linux/kernel.h>
+ #include <linux/interconnect.h>
++#include <linux/mfd/syscon.h>
+ #include <linux/platform_device.h>
+ #include <linux/phy/phy.h>
+ #include <linux/usb/of.h>
++#include <linux/regmap.h>
+ #include <linux/reset.h>
+ #include <linux/iopoll.h>
+ #include <linux/usb/hcd.h>
+@@ -42,6 +44,8 @@
+ #define SDM845_QSCRATCH_SIZE			0x400
+ #define SDM845_DWC3_CORE_SIZE			0xcd00
+ 
++#define TCSR_USB_MUX_SEL			BIT(0)
++
+ /* Interconnect path bandwidths in MBps */
+ #define USB_MEMORY_AVG_HS_BW MBps_to_icc(240)
+ #define USB_MEMORY_PEAK_HS_BW MBps_to_icc(700)
+@@ -85,6 +89,9 @@ struct dwc3_qcom {
+ 	struct icc_path		*icc_path_apps;
+ 
+ 	enum usb_role		current_role;
++
++	struct regmap		*tcsr;
++	unsigned int		mux_offset;
+ };
+ 
+ #define to_dwc3_qcom(d) container_of((d), struct dwc3_qcom, dwc)
+@@ -558,6 +565,15 @@ static int dwc3_qcom_setup_irq(struct dwc3_qcom *qcom, struct platform_device *p
+ 	return 0;
+ }
+ 
++static int dwc3_qcom_usb_mux_setup(struct dwc3_qcom *qcom, bool enable)
++{
++	if (!qcom->tcsr)
++		return 0;
++
++	return regmap_update_bits(qcom->tcsr, qcom->mux_offset, TCSR_USB_MUX_SEL,
++				  enable ? TCSR_USB_MUX_SEL : 0);
++}
++
+ static void dwc3_qcom_set_role_notifier(struct dwc3 *dwc, enum usb_role next_role)
+ {
+ 	struct dwc3_qcom *qcom = to_dwc3_qcom(dwc);
+@@ -624,6 +640,20 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
+ 
+ 	qcom->dev = &pdev->dev;
+ 
++	/*
++	 * USB PHY mux selection is mandatory for IPQ5018 & IPQ5332 only,
++	 * continue if property is not found.
++	 */
++	qcom->tcsr = syscon_regmap_lookup_by_phandle_args(dev->of_node,
++							  "qcom,phy-usb-mux-sel",
++							  1, &qcom->mux_offset);
++	if (IS_ERR(qcom->tcsr)) {
++		ret = PTR_ERR(qcom->tcsr);
++		if (ret != -ENOENT)
++			return dev_err_probe(dev, ret, "failed to get regmap\n");
++		qcom->tcsr = NULL;
++	}
++
+ 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
+ 	if (IS_ERR(qcom->resets)) {
+ 		return dev_err_probe(&pdev->dev, PTR_ERR(qcom->resets),
+@@ -635,6 +665,18 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
+ 		return dev_err_probe(dev, ret, "failed to get clocks\n");
+ 	qcom->num_clocks = ret;
+ 
++	/*
++	 * Select the USB position of the phy mux before anything comes out
++	 * of reset. Selecting it later leaves the SuperSpeed pads muxed away
++	 * while the controller resets, and the SS link doesn't train and is
++	 * stuck in Rx.Detect (USB2 is unaffected as it isn't muxed).
++	 */
++	ret = dwc3_qcom_usb_mux_setup(qcom, true);
++	if (ret) {
++		dev_err(dev, "failed to write USB mux to TCSR, err=%d\n", ret);
++		return ret;
++	}
++
+ 	ret = reset_control_assert(qcom->resets);
+ 	if (ret) {
+ 		dev_err(&pdev->dev, "failed to assert resets, err=%d\n", ret);
+@@ -741,6 +783,7 @@ static void dwc3_qcom_remove(struct platform_device *pdev)
+ 	dwc3_core_remove(&qcom->dwc);
+ 	clk_bulk_disable_unprepare(qcom->num_clocks, qcom->clks);
+ 	dwc3_qcom_interconnect_exit(qcom);
++	dwc3_qcom_usb_mux_setup(qcom, false);
+ 
+ 	pm_runtime_put_noidle(qcom->dev);
+ }
+
+-- 
+2.53.0
diff --git a/target/linux/qualcommbe/patches-6.18/2988-arm64-dts-qcom-ipq5332-add-super-speed-uniphy-to-usb-node.patch b/target/linux/qualcommbe/patches-6.18/2988-arm64-dts-qcom-ipq5332-add-super-speed-uniphy-to-usb-node.patch
new file mode 100644
index 0000000..e500e3e
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2988-arm64-dts-qcom-ipq5332-add-super-speed-uniphy-to-usb-node.patch
@@ -0,0 +1,42 @@
+From 521a3f58ecb2b9e3a940d86f1d5a654ea0b2ab94 Mon Sep 17 00:00:00 2001
+From: Praveenkumar I <quic_ipkumar@quicinc.com>
+Date: Mon, 03 Aug 2026 18:38:34 +0400
+Subject: [PATCH v2 13/17] arm64: dts: qcom: ipq5332: Add Super-Speed UNIPHY to USB node
+MIME-Version: 1.0
+Content-Type: text/plain; charset="utf-8"
+Content-Transfer-Encoding: 7bit
+Message-Id: <20260803-ipq5018-usb3-v2-13-3a4136712b20@outlook.com>
+
+Add the USB3 UNIPHY node to the USB controller node.
+
+In addition, switch to the pipe clock supplied by the USB3 UNIPHY
+instead of the UTMI clock and add a phandle to the TCSR register for
+USB3 mux selection to support USB3 mode.
+
+Signed-off-by: Praveenkumar I <quic_ipkumar@quicinc.com>
+Signed-off-by: George Moussalem <george.moussalem@outlook.com>
+---
+ arch/arm64/boot/dts/qcom/ipq5332.dtsi | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+diff --git a/arch/arm64/boot/dts/qcom/ipq5332.dtsi b/arch/arm64/boot/dts/qcom/ipq5332.dtsi
+index 382691a77d61..98180d626216 100644
+--- a/arch/arm64/boot/dts/qcom/ipq5332.dtsi
++++ b/arch/arm64/boot/dts/qcom/ipq5332.dtsi
+@@ -539,10 +539,10 @@ usb: usb@8a00000 {
+ 					<&gcc MASTER_SNOC_USB &gcc SLAVE_SNOC_USB>;
+ 			interconnect-names = "usb-ddr", "apps-usb";
+ 
+-			phys = <&usbphy0>;
+-			phy-names = "usb2-phy";
++			phys = <&usbphy0>, <&pcie0_phy>;
++			phy-names = "usb2-phy", "usb3-phy";
+ 
+-			qcom,select-utmi-as-pipe-clk;
++			qcom,phy-usb-mux-sel = <&tcsr 0x10540>;
+ 
+ 			tx-fifo-resize;
+ 			snps,is-utmi-l1-suspend;
+
+-- 
+2.53.0
