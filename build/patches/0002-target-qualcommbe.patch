diff --git a/target/linux/qualcommbe/patches-6.18/0428-net-ethernet-qualcomm-ppe-fix-multicast-queue-AC-table-access.patch b/target/linux/qualcommbe/patches-6.18/0428-net-ethernet-qualcomm-ppe-fix-multicast-queue-AC-table-access.patch
new file mode 100644
index 0000000..de1b60e
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0428-net-ethernet-qualcomm-ppe-fix-multicast-queue-AC-table-access.patch
@@ -0,0 +1,43 @@
+From: Francois Guerraz <kubrick@fgv6.net>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: fix multicast queue AC table
+ access
+
+The multicast admission-control table has one 16-byte entry per
+multicast queue (44 entries at 0x84a000), indexed from the first
+multicast queue, as the vendor SSDK does with obj_id - UCAST_QUEUE_ID_MAX
+and as its shipped qca-ssdk.ko does with a subtraction of 256. The driver
+indexes it with the absolute queue ID (256 to 299), which lands 0x1000
+past the table, so the multicast thresholds were never written. It also
+transfers five words per entry while the entry holds three and the
+stride is four, so each write spilled into the next entry.
+
+Index the table relative to the first multicast queue and transfer the
+three words the entry has. The driver only touches words 0 and 2.
+
+Signed-off-by: Francois Guerraz <kubrick@fgv6.net>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
+@@ -1716,7 +1716,7 @@
+ {
+ 	const struct ppe_qm_queue_config *queue_cfg;
+ 	int ret, i, queue_id, queue_cfg_count;
+-	u32 reg, multicast_queue_cfg[5];
++	u32 reg, multicast_queue_cfg[3];
+ 	u32 unicast_queue_cfg[4];
+ 	u32 group_cfg[3];
+ 	int group_limit;
+@@ -1781,8 +1781,12 @@
+ 				if (ret)
+ 					goto qm_config_fail;
+ 			} else {
++				/* The multicast table is indexed relative to the
++				 * first multicast queue.
++				 */
+ 				reg = PPE_AC_MULTICAST_QUEUE_CFG_TBL_ADDR +
+-				      PPE_AC_MULTICAST_QUEUE_CFG_TBL_INC * queue_id;
++				      PPE_AC_MULTICAST_QUEUE_CFG_TBL_INC *
++				      (queue_id - PPE_AC_UNICAST_QUEUE_CFG_TBL_ENTRIES);
+ 
+ 				ret = regmap_bulk_read(ppe_dev->regmap, reg,
+ 						       multicast_queue_cfg,
diff --git a/target/linux/qualcommbe/patches-6.18/0429-net-ethernet-qualcomm-ppe-fix-EDMA-IRQ-unwind-on-partial-failure.patch b/target/linux/qualcommbe/patches-6.18/0429-net-ethernet-qualcomm-ppe-fix-EDMA-IRQ-unwind-on-partial-failure.patch
new file mode 100644
index 0000000..cce6c7d
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0429-net-ethernet-qualcomm-ppe-fix-EDMA-IRQ-unwind-on-partial-failure.patch
@@ -0,0 +1,121 @@
+From: Francois Guerraz <kubrick@fgv6.net>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: fix EDMA IRQ unwind on partial
+ failure
+
+When request_irq() fails for a Tx completion ring or an Rx descriptor
+ring other than the first, the unwind frees the names of the rings
+requested so far but leaves their interrupts registered, with handlers
+whose dev_id points into edma_ctx and whose names are freed memory. A
+failure to allocate an Rx ring name also skips freeing the names and
+interrupts of the earlier Rx rings. The probe then fails and edma_ctx is
+freed, so a later interrupt on one of those lines is a use after free.
+
+Count the interrupts requested for each ring type and free exactly those
+on failure, then the names, which kzalloc'd arrays make safe to free
+unconditionally.
+
+Signed-off-by: Francois Guerraz <kubrick@fgv6.net>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
+@@ -407,8 +407,8 @@
+ 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
+ 	struct edma_ring_info *rx = hw_info->rx;
+ 	struct device *dev = ppe_dev->dev;
++	u32 i, txcmpl_irqs = 0, rx_irqs = 0;
+ 	int ret;
+-	u32 i;
+ 
+ 	/* Request IRQ for TXCMPL rings. */
+ 	edma_txcmpl_irq_name = kzalloc((sizeof(char *) * txcmpl->num_rings), GFP_KERNEL);
+@@ -420,7 +420,7 @@
+ 						  GFP_KERNEL);
+ 		if (!edma_txcmpl_irq_name[i]) {
+ 			ret = -ENOMEM;
+-			goto txcmpl_ring_irq_name_alloc_fail;
++			goto txcmpl_irq_fail;
+ 		}
+ 
+ 		snprintf(edma_txcmpl_irq_name[i], EDMA_IRQ_NAME_SIZE, "txcmpl_%d",
+@@ -435,8 +435,9 @@
+ 		if (ret) {
+ 			pr_err("TXCMPL ring IRQ:%d request %d failed\n",
+ 			       edma_ctx->intr_info.intr_txcmpl[i], i);
+-			goto txcmpl_ring_intr_req_fail;
++			goto txcmpl_irq_fail;
+ 		}
++		txcmpl_irqs++;
+ 
+ 		pr_debug("TXCMPL ring: %d IRQ:%d request success: %s\n",
+ 			 txcmpl->ring_start + i,
+@@ -449,7 +450,7 @@
+ 				       GFP_KERNEL);
+ 	if (!edma_rxdesc_irq_name) {
+ 		ret = -ENOMEM;
+-		goto rxdesc_irq_name_alloc_fail;
++		goto txcmpl_irq_fail;
+ 	}
+ 
+ 	for (i = 0; i < rx->num_rings; i++) {
+@@ -457,7 +458,7 @@
+ 						  GFP_KERNEL);
+ 		if (!edma_rxdesc_irq_name[i]) {
+ 			ret = -ENOMEM;
+-			goto rxdesc_ring_irq_name_alloc_fail;
++			goto rx_irq_fail;
+ 		}
+ 
+ 		snprintf(edma_rxdesc_irq_name[i], 20, "rxdesc_%d",
+@@ -472,8 +473,9 @@
+ 		if (ret) {
+ 			pr_err("RXDESC ring IRQ:%d request failed\n",
+ 			       edma_ctx->intr_info.intr_rx[i]);
+-			goto rx_desc_ring_intr_req_fail;
++			goto rx_irq_fail;
+ 		}
++		rx_irqs++;
+ 
+ 		pr_debug("RXDESC ring: %d IRQ:%d request success: %s\n",
+ 			 rx->ring_start + i,
+@@ -488,33 +490,31 @@
+ 	if (ret) {
+ 		pr_err("MISC IRQ:%d request failed\n",
+ 		       edma_ctx->intr_info.intr_misc);
+-		goto misc_intr_req_fail;
++		goto rx_irq_fail;
+ 	}
+ 
+ 	return 0;
+ 
+-misc_intr_req_fail:
+-	/* Free IRQ for RXDESC rings */
+-	for (i = 0; i < rx->num_rings; i++) {
++rx_irq_fail:
++	/* Free the IRQs of the RXDESC rings requested so far, then all the
++	 * names (kfree() ignores the NULL ones).
++	 */
++	for (i = 0; i < rx_irqs; i++) {
+ 		synchronize_irq(edma_ctx->intr_info.intr_rx[i]);
+ 		free_irq(edma_ctx->intr_info.intr_rx[i],
+ 			 (void *)&edma_ctx->rx_rings[i]);
+ 	}
+-rx_desc_ring_intr_req_fail:
+ 	for (i = 0; i < rx->num_rings; i++)
+ 		kfree(edma_rxdesc_irq_name[i]);
+-rxdesc_ring_irq_name_alloc_fail:
+ 	kfree(edma_rxdesc_irq_name);
+-rxdesc_irq_name_alloc_fail:
+-	for (i = 0; i < txcmpl->num_rings; i++) {
++txcmpl_irq_fail:
++	for (i = 0; i < txcmpl_irqs; i++) {
+ 		synchronize_irq(edma_ctx->intr_info.intr_txcmpl[i]);
+ 		free_irq(edma_ctx->intr_info.intr_txcmpl[i],
+ 			 (void *)&edma_ctx->txcmpl_rings[i]);
+ 	}
+-txcmpl_ring_intr_req_fail:
+ 	for (i = 0; i < txcmpl->num_rings; i++)
+ 		kfree(edma_txcmpl_irq_name[i]);
+-txcmpl_ring_irq_name_alloc_fail:
+ 	kfree(edma_txcmpl_irq_name);
+ 
+ 	return ret;
diff --git a/target/linux/qualcommbe/patches-6.18/0430-net-ethernet-qualcomm-ppe-add-fixed-trunk-speed.patch b/target/linux/qualcommbe/patches-6.18/0430-net-ethernet-qualcomm-ppe-add-fixed-trunk-speed.patch
new file mode 100644
index 0000000..9eba27e
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0430-net-ethernet-qualcomm-ppe-add-fixed-trunk-speed.patch
@@ -0,0 +1,81 @@
+From: MR47BE porting work <local>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: add fixed CPU trunk speed
+
+On IPQ5332 the PPE port that faces the switch die is a SerDes trunk whose
+framing and rate are fixed by the board (2.5G SGMII+ here).  When that port
+also carries a phy-handle, phylink propagates the external PHY negotiated
+speed down to the MAC: at 1G the port is muxed to GMAC and its RX/TX clocks
+are retimed to 125 MHz, while the die still expects a 2.5G trunk.  Link is
+reported up but both directions of the datapath die silently.
+
+Add an optional per-port "qcom,fixed-trunk-speed" property.  When present,
+mac_config keeps the XGMAC selected and mac_link_up programs the trunk rate
+instead of the PHY speed.  PHY management (autoneg, link state, config_init)
+is untouched, and the PCS still sees the PHY interface, so a port without
+the property behaves exactly as before.
+
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.h
+@@ -57,6 +57,7 @@
+  * @gmib_read: Delay work task for GMAC MIB statistics polling function
+  * @gmib_stats: GMAC MIB statistics array
+  * @gmib_stats_lock: Lock to protect GMAC MIB statistics
++ * @trunk_speed: Fixed CPU trunk speed in Mbps, 0 = follow the PHY speed
+  */
+ struct ppe_port {
+ 	struct device_node *np;
+@@ -72,6 +73,7 @@
+ 	struct delayed_work gmib_read;
+ 	u64 *gmib_stats;
+ 	spinlock_t gmib_stats_lock; /* Protects GMIB stats */
++	u32 trunk_speed;
+ };
+ 
+ /**
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_port.c
+@@ -662,10 +662,17 @@
+ 	struct ppe_device *ppe_dev = ppe_port->ppe_dev;
+ 	int port = ppe_port->port_id;
+ 	enum ppe_mac_type mac_type;
++	phy_interface_t iface = state->interface;
+ 	u32 val, mask;
+ 	int ret;
+ 
+-	switch (state->interface) {
++	/* A fixed CPU trunk keeps its SerDes framing whatever the external
++	 * PHY negotiates, so the XGMAC must stay selected.
++	 */
++	if (ppe_port->trunk_speed)
++		iface = PHY_INTERFACE_MODE_2500BASEX;
++
++	switch (iface) {
+ 	case PHY_INTERFACE_MODE_2500BASEX:
+ 	case PHY_INTERFACE_MODE_USXGMII:
+ 	case PHY_INTERFACE_MODE_10GBASER:
+@@ -952,6 +959,11 @@
+ 	int ret, port = ppe_port->port_id;
+ 	u32 reg, val;
+ 
++	if (ppe_port->trunk_speed) {
++		speed = ppe_port->trunk_speed;
++		interface = PHY_INTERFACE_MODE_2500BASEX;
++	}
++
+ 	/* Set PPE port MAC speed clock */
+ 	ret = ppe_port_mac_speed_clock_rate_set(ppe_port, interface, speed);
+ 	if (ret)
+@@ -1390,6 +1402,13 @@
+ 		ppe_ports->port[i].interface = phy_mode;
+ 		ppe_ports->port[i].mac_type = PPE_MAC_TYPE_GMAC;
+ 
++		ret = of_property_read_u32(port_node, "qcom,fixed-trunk-speed",
++					   &ppe_ports->port[i].trunk_speed);
++		if (ret && ret != -EINVAL) {
++			dev_err(ppe_dev->dev, "Failed to get fixed trunk speed\n");
++			goto err_port_node;
++		}
++
+ 		ret = ppe_port_clock_init(&ppe_ports->port[i]);
+ 		if (ret) {
+ 			dev_err(ppe_dev->dev, "Failed to initialize port clocks\n");
diff --git a/target/linux/qualcommbe/patches-6.18/2007-mailbox-tmelite-qmp-Introduce-TMEL-QMP-mailbox-drive.patch b/target/linux/qualcommbe/patches-6.18/2007-mailbox-tmelite-qmp-Introduce-TMEL-QMP-mailbox-drive.patch
new file mode 100644
index 0000000..4397fa5
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/2007-mailbox-tmelite-qmp-Introduce-TMEL-QMP-mailbox-drive.patch
@@ -0,0 +1,1007 @@
+From d5c31cdb0652c5c7fbd9c5d1484c1b23022eb536 Mon Sep 17 00:00:00 2001
+From: Sricharan Ramabadhran <quic_srichara@quicinc.com>
+Date: Thu, 27 Mar 2025 23:47:50 +0530
+Subject: [PATCH 2007/2034] mailbox: tmelite-qmp: Introduce TMEL QMP mailbox
+ driver
+
+This mailbox facilitates the communication between the TMEL server
+subsystem (Trust Management Engine Lite) and the TMEL client
+(APPSS/BTSS/AUDIOSS), used for secure services like secure image
+authentication, enable/disable efuses, crypto services etc. Each client in
+the SoC has its own block of message RAM and IRQ for communication with the
+TMEL SS. The protocol used to communicate in the message RAM is known as
+Qualcomm Messaging Protocol (QMP).
+
+Remote proc driver subscribes to this mailbox and uses the
+mbox_send_message to use TMEL to securely authenticate/teardown the images.
+
+Signed-off-by: Sricharan Ramabadhran <quic_srichara@quicinc.com>
