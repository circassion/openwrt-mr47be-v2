++		qca8084_mht_clk_reset(phydev,
++				      QCA8084_SRDS0_SYS_CBCR +
++				      i * QCA8084_SRDS_CBCR_STRIDE);
++
++	for (i = 0; i < QCA8084_GEPHY_TX_CBCR_NUM; i++) {
++		ret = qca8084_mii_modify(phydev,
++					 QCA8084_GEPHY0_TX_CBCR +
++					 i * QCA8084_GEPHY_TX_CBCR_STRIDE,
++					 QCA8084_CBCR_ENABLE, 0);
++		if (ret)
++			return ret;
++	}
++
++	for (i = 0; i < QCA8084_EPHY_NUM; i++) {
++		ret = qca8084_mii_modify(phydev,
++					 QCA8084_EPHY0_SYS_CBCR +
++					 i * QCA8084_EPHY_CBCR_STRIDE,
++					 0, QCA8084_CBCR_ENABLE);
++		if (ret)
++			return ret;
++	}
++
++	for (i = 0; i < QCA8084_EPHY_NUM; i++)
++		qca8084_mht_clk_reset(phydev,
++				      QCA8084_EPHY0_SYS_CBCR +
++				      i * QCA8084_EPHY_CBCR_STRIDE);
++
++	ret = qca8084_mii_modify(phydev, QCA8084_GCC_GEPHY_MISC,
++				 QCA8084_GEPHY_DSP_MASK, 0);
++	if (ret)
++		return ret;
++
++	ret = qca8084_mii_read(phydev, QCA8084_QFPROM_PTE_ROW2_MSB, &val);
++	if (ret)
++		return ret;
++
++	es = FIELD_GET(QCA8084_QFPROM_PTE_ES_MASK, val);
++
++	/* The fuse and trim steps only affect signal quality, so a failing
++	 * MDIO access there is reported but not fatal: aborting here would
++	 * leave the ports that already link unusable.
++	 */
++	if (es == 1 || es == 2) {
++		for (i = 0; i < QCA8084_EPHY_NUM; i++) {
++			ret = qca8084_mht_efuse_loading(phydev, ephy_cfg, i);
++			if (ret)
++				phydev_warn(phydev, "EPHY%d efuse loading failed: %d\n",
++					    i, ret);
++		}
++	}
++
++	for (i = 0; i < QCA8084_EPHY_NUM; i++) {
++		ret = qca8084_mht_ethphy_ana_fixup(phydev, ephy_cfg, i);
++		if (ret)
