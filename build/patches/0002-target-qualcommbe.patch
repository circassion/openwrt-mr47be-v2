+From: MR47BE OpenWrt port <dev@localhost>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: resync EDMA Rx ring state
+ after U-Boot
+
+U-Boot drives EDMA (TFTP) with its own 16-entry rings and leaves the
+HW producer/consumer indices and Rx interrupt status behind. The
+clock-level edma_hw_reset() does not reliably clear them, so Linux
+sees phantom Rx descriptors: dma_unmap of a bogus 0xc0000000 buffer
+(RC03 panic in dcache_inval_poc) or an endless reap/refill loop
+(RC05: skb leak -> OOM deadlock).
+
+Zero all four Rx ring indices and clear ring interrupt status while
+the rings are disabled, resync the consumer to the HW producer if a
+phantom descriptor is still reaped (without refilling), and stop the
+NAPI do/while spin when an interrupt is asserted with nothing
+reapable.
+
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
+@@ -10,7 +10,9 @@
+ #include <linux/etherdevice.h>
+ #include <linux/irqreturn.h>
+ #include <linux/kernel.h>
++#include <linux/mm.h>
+ #include <linux/netdevice.h>
++#include <linux/pfn.h>
+ #include <linux/platform_device.h>
+ #include <linux/printk.h>
+ #include <linux/regmap.h>
+@@ -486,6 +488,25 @@
+ 		skb = next_skb;
+ 		rxdesc_pri = next_rxdesc_pri;
+ 		dma_addr = EDMA_RXDESC_BUFFER_ADDR_GET(rxdesc_pri);
++		/* Phantom/stale descriptor: the ring lost sync with HW (U-Boot
++		 * leaves EDMA running with its own rings and indices). Never
++		 * dma_unmap an address we did not map (RC03: panic in
++		 * dcache_inval_poc on 0xc0000000) and never refill for
++		 * descriptors we did not consume (RC05: unbounded skb alloc
++		 * -> OOM). Resync consumer to HW producer and bail out.
++		 */
++		if (unlikely(!skb || !pfn_valid(PHYS_PFN(dma_addr)))) {
++			reg = EDMA_BASE_OFFSET +
++			      EDMA_REG_RXDESC_PROD_IDX(rxdesc_ring->ring_id);
++			regmap_read(regmap, reg, &prod_idx);
++			cons_idx = prod_idx & EDMA_RXDESC_PROD_IDX_MASK;
++			reg = EDMA_BASE_OFFSET +
++			      EDMA_REG_RXDESC_CONS_IDX(rxdesc_ring->ring_id);
++			regmap_write(regmap, reg, cons_idx);
++			rxdesc_ring->cons_idx = cons_idx;
++			rxdesc_ring->work_leftover = 0;
++			return work_done;
++		}
+ 		dma_map_size = alloc_size - EDMA_RX_SKB_HEADROOM - NET_IP_ALIGN;
+ 
+ 		if (!page_mode)
+@@ -577,7 +598,9 @@
+ 	u32 status, reg;
+ 
+ 	do {
+-		work_done += edma_rx_reap(rxdesc_ring, budget - work_done);
++		int done = edma_rx_reap(rxdesc_ring, budget - work_done);
++
++		work_done += done;
+ 		if (likely(work_done >= budget))
+ 			return work_done;
+ 
+@@ -585,6 +608,15 @@
+ 		reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_STAT(rxdesc_ring->ring_id);
+ 		regmap_read(regmap, reg, &status);
+ 		status = status & EDMA_RXDESC_RING_INT_STATUS_MASK;
++		if (status && !done) {
++			/* IRQ asserted but nothing reapable: stale/spurious
++			 * status (U-Boot leftovers). Clear it and stop, else
++			 * this loop spins forever (RC01: RCU stall; RC05:
++			 * refill path leaked skbs until OOM).
++			 */
++			regmap_write(regmap, reg, status);
++			break;
++		}
+ 	} while (likely(status));
+ 
+ 	napi_complete(napi);
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+@@ -168,6 +168,20 @@
+ 	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_RING_SIZE(rxdesc_ring->ring_id);
+ 	regmap_write(regmap, reg, data);
+ 
++	/* U-Boot runs EDMA (TFTP) with its own small rings and leaves HW
++	 * indices and interrupt status behind; the clock-level hw reset
++	 * does not reliably clear them. Start from a known-zero state so
++	 * the driver never sees phantom descriptors (RC03/RC05 fix).
++	 * Index registers are writable while the ring is disabled (EDMA v1).
++	 */
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_PROD_IDX(rxdesc_ring->ring_id);
++	regmap_write(regmap, reg, 0);
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_CONS_IDX(rxdesc_ring->ring_id);
++	regmap_write(regmap, reg, 0);
++	rxdesc_ring->cons_idx = 0;
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_STAT(rxdesc_ring->ring_id);
++	regmap_write(regmap, reg, 0xffffffff);
++
+ 	/* Validate mitigation timer value */
+ 	if (edma_rx_mitigation_timer < EDMA_RX_MITIGATION_TIMER_MIN ||
+ 	    edma_rx_mitigation_timer > EDMA_RX_MITIGATION_TIMER_MAX) {
+@@ -651,6 +665,17 @@
+ 	reg = EDMA_BASE_OFFSET + EDMA_REG_RXFILL_RING_SIZE(rxfill_ring->ring_id);
+ 	regmap_write(regmap, reg, ring_sz);
+ 
++	/* Clear stale U-Boot ring state before the initial fill (see
++	 * edma_cfg_rx_desc_ring_configure).
++	 */
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXFILL_PROD_IDX(rxfill_ring->ring_id);
++	regmap_write(regmap, reg, 0);
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXFILL_CONS_IDX(rxfill_ring->ring_id);
++	regmap_write(regmap, reg, 0);
++	rxfill_ring->prod_idx = 0;
++	reg = EDMA_BASE_OFFSET + EDMA_REG_RXFILL_INT_STAT(rxfill_ring->ring_id);
++	regmap_write(regmap, reg, 0xffffffff);
++
+ 	edma_rx_alloc_buffer(rxfill_ring, rxfill_ring->count - 1);
+ }
+ 
diff --git a/target/linux/qualcommbe/patches-6.18/0414-net-ethernet-qualcomm-ppe-reject-stale-rx-desc-nomap.patch b/target/linux/qualcommbe/patches-6.18/0414-net-ethernet-qualcomm-ppe-reject-stale-rx-desc-nomap.patch
new file mode 100644
index 0000000..eb53dfa
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0414-net-ethernet-qualcomm-ppe-reject-stale-rx-desc-nomap.patch
@@ -0,0 +1,149 @@
+From: MR47BE OpenWrt port <dev@localhost>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: reject stale Rx descriptors
+ pointing into no-map memory
+
+RC06 evidence: 2.1s into live traffic the reap path dma_unmap'ed a
+descriptor buffer at 0x4a102100 - inside the nomap bootloader@4a100000
+region. arm64 pfn_valid() returns true for nomap pfns that share a
+sparse section with mapped memory, so the previous guard passed and
+dcache_inval_poc faulted on the empty linear-map pmd. pfn_is_map_memory
+is not exported to modules.
+
+Build a no-map exclusion table from /reserved-memory at probe and
+validate both descriptor words (buffer address and opaque skb pointer
+via the linear-map identity) against it. On a stale descriptor dump the
+raw ring state (rate limited) for diagnosis, resync cons to the HW
+producer and return without refilling.
+
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
+@@ -12,6 +12,7 @@
+ #include <linux/kernel.h>
+ #include <linux/mm.h>
+ #include <linux/netdevice.h>
++#include <linux/of.h>
+ #include <linux/pfn.h>
+ #include <linux/platform_device.h>
+ #include <linux/printk.h>
+@@ -23,6 +24,75 @@
+ #include "ppe.h"
+ #include "ppe_regs.h"
+ 
++/* DT-declared no-map regions: physical memory the kernel does not
++ * linear-map (bootloader, tz, wcss, ...). An Rx descriptor pointing
++ * there is stale hardware state (U-Boot leftovers), never one of our
++ * buffers; dma_unmap on it faults in dcache_inval_poc because the
++ * linear-map pmd is empty (RC03/RC06 panics). pfn_valid() is not
++ * enough on arm64: it returns true for nomap pfns sharing a section
++ * with mapped memory, and pfn_is_map_memory() is not module-callable.
++ */
++#define EDMA_MAX_NOMAP_REGIONS	16
++
++static phys_addr_t edma_nomap_start[EDMA_MAX_NOMAP_REGIONS];
++static phys_addr_t edma_nomap_end[EDMA_MAX_NOMAP_REGIONS];
++static int edma_nomap_cnt;
++
++void edma_rx_nomap_init(void)
++{
++	struct device_node *np, *child;
++
++	np = of_find_node_by_path("/reserved-memory");
++	if (!np)
++		return;
++
++	for_each_child_of_node(np, child) {
++		u32 r[4];
++
++		if (edma_nomap_cnt >= EDMA_MAX_NOMAP_REGIONS) {
++			of_node_put(child);
++			break;
++		}
++		if (!of_get_property(child, "no-map", NULL))
++			continue;
++		if (of_property_read_u32_array(child, "reg", r, 4))
++			continue;
++		edma_nomap_start[edma_nomap_cnt] =
++			((phys_addr_t)be32_to_cpu(r[0]) << 32) | be32_to_cpu(r[1]);
++		edma_nomap_end[edma_nomap_cnt] =
++			edma_nomap_start[edma_nomap_cnt] +
++			(((phys_addr_t)be32_to_cpu(r[2]) << 32) | be32_to_cpu(r[3]));
++		edma_nomap_cnt++;
++	}
++	of_node_put(np);
++	pr_info("edma: %d no-map regions registered for stale-desc guard\n",
++		edma_nomap_cnt);
++}
++
++static bool edma_rx_addr_stale(phys_addr_t addr)
++{
++	int i;
++
++	if (unlikely(!pfn_valid(PHYS_PFN(addr))))
++		return true;
++	for (i = 0; i < edma_nomap_cnt; i++)
++		if (addr >= edma_nomap_start[i] && addr < edma_nomap_end[i])
++			return true;
++	return false;
++}
++
++static bool edma_rx_desc_stale(struct sk_buff *skb, dma_addr_t dma_addr)
++{
++	/* Both descriptor words must translate to kernel-mapped memory:
++	 * the buffer address directly, the opaque skb pointer through the
++	 * linear-map identity. Stale U-Boot descriptors fail one or both
++	 * (RC06: buffer 0x4a102100 inside the nomap bootloader region).
++	 */
++	if (edma_rx_addr_stale(dma_addr))
++		return true;
++	return edma_rx_addr_stale(__virt_to_phys((unsigned long)skb));
++}
++
+ static int edma_rx_alloc_buffer_list(struct edma_rxfill_ring *rxfill_ring, int alloc_count)
+ {
+ 	struct edma_rxfill_stats *rxfill_stats = &rxfill_ring->rxfill_stats;
+@@ -495,10 +565,16 @@
+ 		 * descriptors we did not consume (RC05: unbounded skb alloc
+ 		 * -> OOM). Resync consumer to HW producer and bail out.
+ 		 */
+-		if (unlikely(!skb || !pfn_valid(PHYS_PFN(dma_addr)))) {
++		if (unlikely(!skb || edma_rx_desc_stale(skb, dma_addr))) {
+ 			reg = EDMA_BASE_OFFSET +
+ 			      EDMA_REG_RXDESC_PROD_IDX(rxdesc_ring->ring_id);
+ 			regmap_read(regmap, reg, &prod_idx);
++			if (net_ratelimit())
++				pr_err("edma: stale rxdesc ring %d cons %u hwprod %u w0 %08x w1 %08x w2 %08x w3 %08x skb %px dma %pad\n",
++				       rxdesc_ring->ring_id, cons_idx, prod_idx,
++				       rxdesc_pri->word0, rxdesc_pri->word1,
++				       rxdesc_pri->word2, rxdesc_pri->word3,
++				       skb, &dma_addr);
+ 			cons_idx = prod_idx & EDMA_RXDESC_PROD_IDX_MASK;
+ 			reg = EDMA_BASE_OFFSET +
+ 			      EDMA_REG_RXDESC_CONS_IDX(rxdesc_ring->ring_id);
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
+@@ -288,4 +288,6 @@
+ irqreturn_t edma_rx_handle_irq(int irq, void *ctx);
+ int edma_rx_alloc_buffer(struct edma_rxfill_ring *rxfill_ring, int alloc_count);
+ int edma_rx_napi_poll(struct napi_struct *napi, int budget);
++void edma_rx_nomap_init(void);
++
+ #endif
+--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
++++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
+@@ -20,6 +20,7 @@
+ #include "edma.h"
+ #include "edma_cfg_tx.h"
+ #include "edma_cfg_rx.h"
++#include "edma_rx.h"
+ #include "ppe_regs.h"
+ 
+ #define EDMA_IRQ_NAME_SIZE		32
+@@ -675,6 +676,8 @@
+ 		return ret;
+ 	}
+ 
++	edma_rx_nomap_init();
++
+ 	/* Allocate memory for netdevices. */
+ 	edma_ctx->netdev_arr = kzalloc((sizeof(**edma_ctx->netdev_arr) *
+ 					 hw_info->max_ports),
diff --git a/target/linux/qualcommbe/patches-6.18/0415-net-pcs-ipq9574-sgmii-plus-mode-2-5g.patch b/target/linux/qualcommbe/patches-6.18/0415-net-pcs-ipq9574-sgmii-plus-mode-2-5g.patch
new file mode 100644
index 0000000..3e9e344
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0415-net-pcs-ipq9574-sgmii-plus-mode-2-5g.patch
@@ -0,0 +1,36 @@
+From: MR47BE OpenWrt port <dev@localhost>
+Subject: [PATCH] net: pcs: qcom-ipq9574: run SGMII as SGMII+ at 2.5G rate
+
+MR47BE (IPQ5332) wires PPE MAC2 (port@2, pcs1_ch0) to the QCA8386 CPU
+port, which speaks SGMII+ (2.5G SGMII; vendor dp1 phy-mode=sgmii).
+The PCS driver programmed MISC2=SGMII with a 125 MHz rate for SGMII
+and then rejected SPEED_2500 at link-up ("Invalid SGMII speed 2500",
+-EINVAL). Escaping to "2500base-x" links up but frames incompatibly
+with the switch side: test127 field evidence lan rx_packets=0 while
+wan (ephy path) rx=183 works.
+
+Program SGMII+ framing and the 2.5G 312.5 MHz rate in the SGMII mode
+case (already proven for 2500BASEX). In-band AN (managed =
+"in-band-status") carries the speed, so the forced-speed path that
+rejects 2500 is not reached.
+---
+ drivers/net/pcs/pcs-qcom-ipq9574.c | 8 +++++++-
+ 1 file changed, 7 insertions(+), 1 deletion(-)
+
+--- a/drivers/net/pcs/pcs-qcom-ipq9574.c
++++ b/drivers/net/pcs/pcs-qcom-ipq9574.c
+@@ -344,7 +344,13 @@ static int ipq_pcs_config_mode(struct ipq_pcs *qpcs,
+ 	case PHY_INTERFACE_MODE_SGMII:
+ 		mask |= PCS_MODE_SGMII_MODE_MASK;
+ 		val = PCS_MODE_SGMII | PCS_MODE_SGMII_MODE_MAC;
+-		misc2 = PCS_MISC2_MODE_SGMII;
++		/* MR47BE: the QCA8386 CPU port talks SGMII+ (2.5G SGMII).
++		 * Program SGMII+ framing and the 2.5G rate here; in-band
++		 * AN then carries the speed and the forced-speed path
++		 * (which rejects SPEED_2500) is skipped.
++		 */
++		misc2 = PCS_MISC2_MODE_SGMII_PLUS;
++		rate = 312500000;
+ 		break;
+ 	case PHY_INTERFACE_MODE_QSGMII:
+ 		mask |= PCS_MODE_SGMII_MODE_MASK;
diff --git a/target/linux/qualcommbe/patches-6.18/0426-net-ethernet-qualcomm-ppe-use-IPQ5332-scheduler-tables.patch b/target/linux/qualcommbe/patches-6.18/0426-net-ethernet-qualcomm-ppe-use-IPQ5332-scheduler-tables.patch
new file mode 100644
index 0000000..5c4ba3b
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/0426-net-ethernet-qualcomm-ppe-use-IPQ5332-scheduler-tables.patch
@@ -0,0 +1,166 @@
+From: Francois Guerraz <kubrick@fgv6.net>
+Subject: [PATCH] net: ethernet: qualcomm: ppe: use IPQ5332 scheduler tables
+
+The PPE driver programs the BM (TDM) and QM scheduler tables of the
+IPQ9574 on every SoC. The IPQ5332 has three PPE ports, not eight, and
+with the IPQ9574 table its port 2 (the 2.5G WAN on the GL-BE9300) gets
+only 2 of the 100 TDM slots, 2 of the 50 ingress slots.
+
+On a GL-BE9300 this shows as ingress drops on PPE port 2 that are counted
+one-for-one as XGMAC rx_fifo_overflow, with the BM and QM drop counters at
+zero and the CPUs idle: a router-local download over the 2.5G WAN reached
+124 Mbit/s with about a fifth of the frames lost, and forwarding topped
+out near 1.9 Gbit/s with the same counter climbing. The XGMAC has a 1 KB
+RX FIFO in cut-through mode, so it depends on the PPE draining it without
+gaps. The stock firmware, which uses the vendor MPPE tables, shows zero
+overflows at 2.2 Gbit/s on the same unit. A share of 2 slots in 100 is
+consistent with an ingress ceiling around 2 Gbit/s if a slot moves 64
+bytes per PPE clock at 200 MHz; that model is an estimate, the drop
+location and the vendor table are what is established.
+
+Install the vendor SSDK MPPE tables (ppe_port_tdm0_tbl, depth 32, and
+ppe_port_scheduler0_tbl, depth 10) when the PPE is an IPQ5332. The
+values are copied from the public qca-ssdk source, src/init/ssdk_appe.c,
+and match the tables in the shipped GL.iNet 4.10.0 qca-ssdk.ko entry for
+entry. Add a small helper to detect the IPQ5332 PPE for the following
+changes.
+
+Signed-off-by: Francois Guerraz <kubrick@fgv6.net>
+---
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
+@@ -7,7 +7,9 @@
+ #define __PPE_H__
+ 
+ #include <linux/compiler.h>
++#include <linux/device.h>
+ #include <linux/interconnect.h>
++#include <linux/of.h>
+ 
+ struct device;
+ struct regmap;
+@@ -40,4 +42,13 @@
+ 	unsigned int num_icc_paths;
+ 	struct icc_bulk_data icc_paths[] __counted_by(num_icc_paths);
+ };
++
++/* The IPQ5332 PPE has three ports (CPU, port 1 and port 2) and a smaller
++ * buffer budget than the IPQ9574; several configuration tables depend on it.
++ */
++static inline bool ppe_is_ipq5332(const struct ppe_device *ppe_dev)
++{
++	return of_device_is_compatible(ppe_dev->dev->of_node,
++				       "qcom,ipq5332-ppe");
++}
+ #endif
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_config.c
+@@ -372,6 +372,49 @@
+ 	{true, PPE_SCH_EGRESS,  7, false, 0},
+ };
+ 
++/* BM scheduler (TDM) slots for the IPQ5332 PPE, which has three ports:
++ * 0 (CPU/EDMA), 1 and 2 (10G to the switch and 2.5G WAN on the GL-BE9300).
++ * Copied verbatim from the vendor SSDK MPPE table ppe_port_tdm0_tbl,
++ * depth 32 including the trailing invalid entry. With the IPQ9574 table
++ * above, port 2 receives only 2 of the 100 TDM slots (2 of the 50 ingress
++ * slots); on a GL-BE9300 that correlates with PPE port 2 ingress drops
++ * counted as XGMAC rx_fifo_overflow, from a few hundred Mbit/s up.
++ */
++static const struct ppe_scheduler_bm_config ipq5332_ppe_sch_bm_config[] = {
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  0, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{true, PPE_SCH_EGRESS,  1, false, 0},
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  2, false, 0},
++	{true, PPE_SCH_INGRESS, 0, false, 0},
++	{true, PPE_SCH_EGRESS,  0, false, 0},
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  1, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{true, PPE_SCH_EGRESS,  2, false, 0},
++	{true, PPE_SCH_INGRESS, 0, false, 0},
++	{true, PPE_SCH_EGRESS,  0, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{true, PPE_SCH_EGRESS,  1, false, 0},
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  2, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{true, PPE_SCH_EGRESS,  0, false, 0},
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  1, false, 0},
++	{true, PPE_SCH_INGRESS, 0, false, 0},
++	{true, PPE_SCH_EGRESS,  2, false, 0},
++	{true, PPE_SCH_INGRESS, 2, false, 0},
++	{true, PPE_SCH_EGRESS,  0, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{true, PPE_SCH_EGRESS,  1, false, 0},
++	{true, PPE_SCH_INGRESS, 0, false, 0},
++	{true, PPE_SCH_EGRESS,  2, false, 0},
++	{true, PPE_SCH_INGRESS, 1, false, 0},
++	{false, PPE_SCH_INGRESS, 0, false, 0},
++};
++
+ /* PPE scheduler configuration for QM includes multiple entries. Each entry
+  * contains ports to be dispatched for enqueueing and dequeueing. The backup
+  * port for dequeueing is supported to be used when the primary port for
+@@ -439,6 +482,22 @@
+ 	{0x98, 6, 5, true, 2},
+ };
+ 
++/* QM scheduler slots for the IPQ5332 PPE, from the vendor SSDK MPPE table
++ * ppe_port_scheduler0_tbl (depth 10).
++ */
++static const struct ppe_scheduler_qm_config ipq5332_ppe_sch_qm_config[] = {
++	{0x0, 2, 0, false, 0},
++	{0x0, 1, 2, false, 0},
++	{0x0, 0, 1, false, 0},
++	{0x0, 0, 2, false, 0},
++	{0x0, 1, 0, false, 0},
++	{0x0, 2, 1, false, 0},
++	{0x0, 0, 2, false, 0},
++	{0x0, 0, 1, false, 0},
++	{0x0, 0, 2, false, 0},
++	{0x0, 0, 1, false, 0},
++};
++
+ static const struct ppe_scheduler_port_config ppe_port_sch_config[] = {
+ 	{
+ 		.port		= 0,
+@@ -1743,11 +1802,17 @@
+ 	const struct ppe_scheduler_port_config *port_cfg;
+ 	const struct ppe_scheduler_qm_config *qm_cfg;
+ 	const struct ppe_scheduler_bm_config *bm_cfg;
++	bool is_ipq5332 = ppe_is_ipq5332(ppe_dev);
+ 	int ret, i, count;
+ 	u32 val, reg;
+ 
