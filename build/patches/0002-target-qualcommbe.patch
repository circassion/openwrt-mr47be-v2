+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Mercusys MR47BE V2 - IPQ5332 AP-MI01.6 based Wi-Fi 7 tri-band router
+ * Base: GL-BE6500 DTS (qualcommbe/ipq53xx) + MR47BE V2 GPL kernel DTS
+ * SoC: Qualcomm IPQ5322 (die: "IPQ5322 003 FK5134HJ"; yazilim varyanti
+ *      string'i IPQ5332LA), 4x Cortex-A53, 1 GiB DDR4 (SEC K4A8G165WC)
+ * WiFi: on-SoC 2.4GHz (wifi0, qcom,board-id = 18 = 0x12) + QCN6274 via
+ *      PCIe1 (5G+6G, 2 radyo, pci17cb,1109, qcom,board-id = 0x1015)
+ * Switch: QCA8084 - IPQ53xx SoC'ya ENTEGRE (ayri cip YOK; GPL U-Boot
+ *      ipq_qca8084.c "QCA8084-switch"), 4x 2.5G + SoC PPE
+ * Flash: SPI-NAND Winbond W25N01GW 128MiB (SPI-NOR YOK - boot log: not found)
+ * UART: GPIO18/19 @ 115200
+ * IPQ5332 AP-MI01.6 board device tree source
+ *
+ * Copyright (c) 2020-2021 The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+/dts-v1/;
+
+#include <arm64/qcom/ipq5332.dtsi>
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>
+#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
+#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
+#include <dt-bindings/net/qcom,qca808x.h>
+#include <dt-bindings/net/qcom,ipq9574-pcs.h>
+
+#ifdef __IPQ_MEM_PROFILE_512_MB__
+#include "ipq5332-512MB-memory.dtsi"
+#else
+#include "ipq5332-default-memory.dtsi"
+#endif
+
+/ {
+	#address-cells = <0x2>;
+	#size-cells = <0x2>;
+	model = "Qualcomm Technologies, Inc. IPQ5332/AP-MI01.6, Mercusys MR47BE V2";
+	compatible = "mercusys,mr47be-v2", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";
+
+	aliases {
+		serial0 = &blsp1_uart0;
+		ethernet0 = "/soc/dp1";
+		ethernet1 = "/soc/dp2";
+	};
+
+	chosen {
+		stdout-path = "serial0";
+	};
+
+	soc {
+		pinctrl@1000000 {
+			spi_0_pins: spi0-pinmux {
+				spi_clock {
+					pins = "gpio14";
+					function = "blsp0_spi";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				spi_mosi {
+					pins = "gpio15";
+					function = "blsp0_spi";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				spi_miso {
+					pins = "gpio16";
+					function = "blsp0_spi";
+					drive-strength = <2>;
+					bias-pull-down;
+				};
+
+				spi_cs {
+					pins = "gpio17";
+					function = "blsp0_spi";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+			};
+
+			serial_0_pins: serial0-pinmux {
+				pins = "gpio18", "gpio19";
+				function = "blsp0_uart0";
+				drive-strength = <8>;
+				bias-pull-up;
+			};
+
+			serial_1_pins: serial1-pinmux {
+				pins = "gpio33", "gpio34", "gpio35", "gpio36";
+				function = "blsp1_uart2";
+				drive-strength = <8>;
+				bias-pull-up;
+			};
+
+			i2c_1_pins: i2c-1-pinmux {
+				pins = "gpio29", "gpio30";
+				function = "blsp1_i2c0";
+				drive-strength = <8>;
+				bias-pull-up;
+			};
+
+			leds_pins: leds_pinmux {
+				led0_2g {
+					pins = "gpio36";
+					function = "gpio";
+					drive-strength = <8>;
+					bias-pull-down;
+				};
+			};
+
+			mdio0_pins: mdio0_pinmux {
+				mux_0 {
+					pins = "gpio25";
+					function = "mdc0";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+				mux_1 {
+					pins = "gpio26";
+					function = "mdio0";
+					drive-strength = <2>;
+					bias-pull-up;
+				};
+			};
+
+			mdio1_pins: mdio1_pinmux {
+				mux_0 {
+					pins = "gpio27";
+					function = "mdc1";
+					drive-strength = <8>;
+					bias-disable;
+				};
+				mux_1 {
+					pins = "gpio28";
+					function = "mdio1";
+					drive-strength = <8>;
+					bias-pull-up;
+				};
+			};
+
+			audio_pins_pri: audio_pinmux_pri {
+				mux_1 {
+					pins = "gpio29";
+					function = "audio_pri";
+					drive-strength = <8>;
+					bias-pull-down;
+				};
+
+				mux_2 {
+					pins = "gpio30";
+					function = "audio_pri";
+					drive-strength = <8>;
+					bias-pull-down;
+				};
+
+				mux_3 {
+					pins = "gpio31";
+					function = "audio_pri";
+					drive-strength = <4>;
+					bias-pull-down;
+				};
+
+				mux_4 {
+					pins = "gpio32";
+					function = "audio_pri";
+					drive-strength = <4>;
+					bias-pull-down;
+				};
+			};
+
+			spi_2_pins: spi-2-pins {
+				pins = "gpio33", "gpio34", "gpio35", "gpio36";
+				function = "blsp2_spi0";
+				drive-strength = <8>;
+				bias-pull-down;
+			};
+		};
+
+		dp1 {
+			device_type = "network";
+			compatible = "qcom,nss-dp";
+			qcom,id = <2>;
+			reg = <0x3a504000 0x4000>;
+			qcom,mactype = <1>;
+			local-mac-address = [000000000000];
+			phy-mode = "usxgmii";
+		};
+
+		dp2 {
+			device_type = "network";
+			compatible = "qcom,nss-dp";
+			qcom,id = <1>;
+			reg = <0x3a500000 0x4000>;
+			qcom,mactype = <1>;
+			qcom,phy-mdio-addr = <0x03>;
+			qcom,link-poll = <0x01>;
+			local-mac-address = [000000000000];
+			phy-mode = "sgmii";
+		};
+
+		mdio:mdio@90000 {
+			status = "ok";
+			pinctrl-0 = <&mdio1_pins &mdio0_pins>;
+			pinctrl-names = "default";
+			/*gpio51 for manhattan reset*/
+			phy-reset-gpio = <&tlmm 30 0>, <&tlmm 39 0>, <&tlmm 45 0>;
+			phyaddr_fixup = <0xC90F018>;
+			uniphyaddr_fixup = <0xC90F014>;
+			mdio_clk_fixup; /* MDIO clock sequence fix up flag */
+
+			phy0: ethernet-phy@0 {
+				reg = <1>;
+				fixup;
+			};
+			phy1: ethernet-phy@1 {
+				reg = <2>;
+				fixup;
+			};
+			phy2: ethernet-phy@2 {
+				reg = <3>;
+				fixup;
+			};
+			phy3: ethernet-phy@3 {
+				reg = <4>;
+				fixup;
+			};
+		};
+
+
+		pcm: pcm@0xA3C0000{
+			pinctrl-0 = <&audio_pins_pri>;
+			pinctrl-names = "primary";
+			status = "disabled";
+		};
+
+		ess-instance {
+			num_devices = <0x01>;
+			ess-switch@3a000000 {
+				switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
+				switch_lan_bmp = <0x2>; /* lan port bitmap */
+				switch_wan_bmp = <0x4>; /* wan port bitmap */
+				switch_mac_mode = <0xc>; /* mac mode for uniphy instance0*/
+				switch_mac_mode1 = <0x0d>; /* mac mode for uniphy instance1*/
+				switch_mac_mode2 = <0xff>; /* mac mode for uniphy instance2*/
+
+				qcom,port_phyinfo {
+					port@0 {
+						port_id = <1>;
+						forced-speed = <2500>;
+						forced-duplex = <1>;
+					};
+					port@1 {
+						port_id = <2>;
+						phy_address = <4>;
+					};
+				};
+
+				led_source@5 {
+					source = <5>;
+					mode = "normal";
+					speed = "all";
+					blink_en = "enable";
+					active = "high";
+				};
+			};
+
+			ess-switch1@1 {
+				compatible = "qcom,ess-switch-qca8386";
+				device_id = <1>;
+				switch_access_mode = "mdio";
+				mdio-bus = <&mdio>;
+				switch_mac_mode = <0xc>; /* mac mode for uniphy instance0 */
+				switch_mac_mode1 = <0xff>; /* mac mode1 for uniphy instance1 */
+				switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
+				switch_lan_bmp = <0xe>; /* lan port bitmap */
+				switch_wan_bmp = <0x0>;  /* wan port bitmap */
+				link-polling-required = <0>;
+				fdb_sync = "interrupt";
+				link-intr-gpio = <&tlmm 23 0>;
+				qcom,port_phyinfo {
+					port@0 {
+						port_id = <0>;
+						forced-speed = <2500>;
+						forced-duplex = <1>;
+					};
+					port@1 {
+						port_id = <1>;
+						phy_address = <1>;
+					};
+					port@2 {
+						port_id = <2>;
+						phy_address = <2>;
+					};
+					port@3 {
+						port_id = <3>;
+						phy_address = <3>;
+					};
+				};
+
+				led_source@2 {
+					source = <2>;
+					mode = "normal";
+					speed = "all";
+					blink_en = "enable";
+					active = "high";
+				};
+				led_source@5 {
+					source = <5>;
+					mode = "normal";
+					speed = "all";
+					blink_en = "enable";
+					active = "high";
+				};
+				led_source@8 {
+					source = <8>;
+					mode = "normal";
+					speed = "all";
+					blink_en = "enable";
+					active = "high";
+                                };
+			};
+		};
+
+		/* EDMA host driver configuration for the board */
+		edma@3ab00000 {
+			qcom,txdesc-ring-start = <4>;		/* Tx desc ring start ID */
+			qcom,txdesc-rings = <12>;		/* Total number of Tx desc rings to be provisioned */
+			qcom,mht-txdesc-rings = <8>;            /* Extra Tx desc rings to be provisioned for MHT SW ports. */
+			qcom,txcmpl-ring-start = <4>;		/* Tx complete ring start ID */
+			qcom,txcmpl-rings = <12>;		/* Total number of Tx complete rings to be provisioned */
+			qcom,mht-txcmpl-rings = <8>;            /* Extra Tx complete rings to be provisioned for mht sw ports. */
+			qcom,rxfill-ring-start = <4>;		/* Rx fill ring start ID */
+			qcom,rxfill-rings = <4>;		/* Total number of Rx fill rings to be provisioned */
+			qcom,rxdesc-ring-start = <12>;		/* Rx desc ring start ID */
+			qcom,rxdesc-rings = <4>;		/* Total number of Rx desc rings to be provisioned */
+			qcom,rx-page-mode = <0>;		/* Rx fill ring page mode */
+			qcom,tx-map-priority-level = <1>;	/* Tx priority level per port */
+			qcom,rx-map-priority-level = <1>;	/* Rx priority level per core */
+			qcom,ppeds-num = <2>;			/* Number of PPEDS nodes */
+			/* PPE-DS node format: <Rx-fill Tx-cmpl Rx Tx Queue-base Queue-count> */
+			qcom,ppeds-map = <1 1 1 1 32 8>,	/* PPEDS Node#0 ring and queue map */
+					<2 2 2 2 40 8>;		/* PPEDS Node#1 ring and queue map */
+			qcom,txdesc-map = <8 9 10 11>,		/* Port0 per-core Tx ring map */
+					  <12 13 14 15>,	/* MHT-Port1 per-core Tx ring map */
+					  <4 5 6 7>,            /* MHT-Port2 per-core Tx ring map/packets from  vp*/
+					  <16 17 18 19>,        /* MHT-Port3 per-core Tx ring map */
+					  <20 21 22 23>;        /* MHT-Port4 per-core Tx ring map */
+			qcom,txdesc-fc-grp-map = <1 2 3 4 5>;   /* Per GMAC flow control group map */
+			qcom,rxfill-map = <4 5 6 7>;		/* Per-core Rx fill ring map */
+			qcom,rxdesc-map = <12 13 14 15>;	/* Per-core Rx desc ring map */
+			qcom,rx-queue-start = <0>;		/* Rx queue start */
+			qcom,rx-ring-queue-map = <0 8 16 24>,	/* Priority 0 queues per-core Rx ring map */
+						<1 9 17 25>,	/* Priority 1 queues per-core Rx ring map */
+						<2 10 18 26>,	/* Priority 2 queues per-core Rx ring map */
+						<3 11 19 27>,	/* Priority 3 queues per-core Rx ring map */
+						<4 12 20 28>,	/* Priority 4 queues per-core Rx ring map */
+						<5 13 21 29>,	/* Priority 5 queues per-core Rx ring map */
+						<6 14 22 30>,	/* Priority 6 queues per-core Rx ring map */
+						<7 15 23 31>;	/* Priority 7 queues per-core Rx ring map */
+			interrupts = <0 163 4>,			/* Tx complete ring id #4 IRQ info */
+				   <0 164 4>,			/* Tx complete ring id #5 IRQ info */
+				   <0 165 4>,			/* Tx complete ring id #6 IRQ info */
+				   <0 166 4>,			/* Tx complete ring id #7 IRQ info */
+				   <0 167 4>,			/* Tx complete ring id #8 IRQ info */
+				   <0 168 4>,			/* Tx complete ring id #9 IRQ info */
+				   <0 169 4>,			/* Tx complete ring id #10 IRQ info */
+				   <0 170 4>,			/* Tx complete ring id #11 IRQ info */
+				   <0 171 4>,			/* Tx complete ring id #12 IRQ info */
+				   <0 172 4>,			/* Tx complete ring id #13 IRQ info */
+				   <0 173 4>,			/* Tx complete ring id #14 IRQ info */
+				   <0 174 4>,			/* Tx complete ring id #15 IRQ info */
+				   <0 139 4>,			/* Rx desc ring id #12 IRQ info */
+				   <0 140 4>,			/* Rx desc ring id #13 IRQ info */
+				   <0 141 4>,			/* Rx desc ring id #14 IRQ info */
+				   <0 142 4>,			/* Rx desc ring id #15 IRQ info */
+				   <0 191 4>,			/* Misc error IRQ info */
+				<0 160 4>,			/* PPEDS Node #1(TxComp ring id #1) TxComplete IRQ info */
+				<0 128 4>,			/* PPEDS Node #1(Rx Desc ring id #1) Rx Desc IRQ info */
+				<0 152 4>,			/* PPEDS Node #1(RxFill Desc ring id #1) Rx Fill IRQ info */
+				<0 161 4>,			/* PPEDS Node #2(TxComp ring id #2) TxComplete IRQ info */
+				<0 129 4>,			/* PPEDS Node #2(Rx Desc ring id #2) Rx Desc IRQ info */
+				<0 153 4>,			/* PPEDS Node #2(RxFill Desc ring id #2) Rx Fill IRQ info */
+				   <0 175 4>,			/* MHT port Tx complete ring id #16 IRQ info */
+				   <0 176 4>,			/* MHT port Tx complete ring id #17 IRQ info */
+				   <0 177 4>,			/* MHT port Tx complete ring id #18 IRQ info */
+				   <0 178 4>,			/* MHT port Tx complete ring id #19 IRQ info */
+				   <0 179 4>,			/* MHT port Tx complete ring id #20 IRQ info */
+				   <0 180 4>,			/* MHT port Tx complete ring id #21 IRQ info */
+				   <0 181 4>,			/* MHT port Tx complete ring id #22 IRQ info */
+				   <0 182 4>;			/* MHT port Tx complete ring id #23 IRQ info */
+		};
+
+		serial@78af000 {
+			pinctrl-0 = <&serial_0_pins>;
+			pinctrl-names = "default";
+			status = "ok";
+		};
+
+		serial@78b0000 {
+			pinctrl-0 = <&serial_1_pins>;
+			pinctrl-names = "default";
+			status = "disabled";
+		};
+
+		spi@78b5000 {
+			pinctrl-0 = <&spi_0_pins>;
+			pinctrl-names = "default";
+			cs-select = <0>;
+			status = "ok";
+
+			m25p80@0 {
+				compatible = "n25q128a11";
+				#address-cells = <1>;
+				#size-cells = <1>;
+				reg = <0>;
+				spi-max-frequency = <50000000>;
+			};
+		};
+
+		spi_2: spi@78b7000 {
+			pinctrl-0 = <&spi_2_pins>;
+			pinctrl-names = "default";
+			cs-select = <0>;
+			status = "disabled";
+		};
+
+		i2c_1: i2c@78b6000 {
+			pinctrl-0 = <&i2c_1_pins>;
+			pinctrl-names = "default";
+		};
+
+		dma@7984000 {
+			status = "ok";
+		};
+
+		nand: nand@79b0000 {
+			pinctrl-0 = <&qspi_nand_pins>;
+			pinctrl-names = "default";
+			status = "ok";
+		};
+
+		usb3@8A00000 {
+			status = "ok";
+			qcom,multiplexed-phy;
+		};
+
+		ssuniphy_0: ssuniphy@4b0000 {
+			status = "ok";
+		};
+
+		hs_m31phy_0: hs_m31phy@7b000 {
+			status = "ok";
+		};
+
+		leds {
+			compatible = "gpio-leds";
+			pinctrl-0 = <&leds_pins>;
+			pinctrl-names = "default";
+			led@36 {
+				label = "led0_2g";
+				gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
+				linux,default-trigger = "led_2g";
+				default-state = "off";
+			};
+		};
+
+		pcie1_phy_x2: phy_x2@4b1000 {
+			status = "ok";
+		};
+
+		wsi: wsi {
+			id = <0>;
+			num_chip = <2>;
+		};
+
+		pcie1: pcie@18000000 {
+			status = "ok";
+			pcie1_rp {
+				reg = <0 0 0 0 0>;
+
+				qcom,mhi@1 {
+					reg = <0 0 0 0 0>;
+					qti,disable-rddm-prealloc;
+					qti,rddm-seg-len = <0x1000>;
+#if defined(__CNSS2__)
+					qrtr_node_id = <0x31>;
+					memory-region = <0>, <&mhi_region1>;
+#else
+					memory-region = <&qcn9224_pcie1>;
+					qcom,board_id = <0x1019>;
+					qcom,wsi = <&wsi>;
+#endif
+				};
+			};
+		};
+	};
+};
+
+&mhi_region1 {
+	status = "ok";
+};
+
+&qcn9224_pcie1 {
+	status = "ok";
+};
diff --git a/target/linux/qualcommbe/dts/_yedek_on_DSA_20261105_115254/ipq5332-mr47be-v2.dts b/target/linux/qualcommbe/dts/_yedek_on_DSA_20261105_115254/ipq5332-mr47be-v2.dts
new file mode 100644
index 0000000..3fbf6ed
--- /dev/null
+++ b/target/linux/qualcommbe/dts/_yedek_on_DSA_20261105_115254/ipq5332-mr47be-v2.dts
@@ -0,0 +1,989 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+//
+// Mercusys MR47BE V2 - IPQ5332 AP-MI01.6 based Wi-Fi 7 tri-band router
+// Base: GL-BE6500 DTS (qualcommbe/ipq53xx) + MR47BE V2 GPL kernel DTS
+// SoC: Qualcomm IPQ5322 (die: "IPQ5322 003 FK5134HJ"; yazilim varyanti
+//      string'i IPQ5332LA), 4x Cortex-A53, 1 GiB DDR4 (SEC K4A8G165WC)
+// WiFi: on-SoC 2.4GHz (wifi0, qcom,board-id = 18 = 0x12) + QCN6274 via
+//      PCIe1 (5G+6G, 2 radyo, pci17cb,1109, qcom,board-id = 0x1015)
+// Switch: QCA8084 - IPQ53xx SoC'ya ENTEGRE (ayri cip YOK; GPL U-Boot
+//      ipq_qca8084.c "QCA8084-switch"), 4x 2.5G + SoC PPE
+// Flash: SPI-NAND Winbond W25N01GW 128MiB (SPI-NOR YOK - boot log: not found)
+// UART: GPIO18/19 @ 115200
+// v6: v5 uzerine firmware-DTB duzeltmeleri (reset tusu gpio29, bus reset 30/39/45, LED 24/39 kaldirildi).
+// v3: FINAL-DTS-6.18.54 uzerine: mdio reset-gpios kaldirildi, nsscc reset gecikmesi, reset tusu gpio30,
+//     NAND ECC 4-bit (stok), conduit label "cpu". Gerisi birebir.
+
+/dts-v1/;
+
+#include <arm64/qcom/ipq5332.dtsi>
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>
+#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
+#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
+#include <dt-bindings/net/qcom,qca808x.h>
+#include <dt-bindings/net/qcom,ipq9574-pcs.h>
+
+/ {
+	#address-cells = <0x2>;
+	#size-cells = <0x2>;
+	model = "Mercusys MR47BE V2";
+	compatible = "mercusys,mr47be-v2", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";
+
+	aliases {
+		serial0 = &blsp1_uart0;
+		/* Stock DTS semantic mapping: dp1/id=2 -> LAN switch CPU conduit,
+		 * dp2/id=1 -> WAN MAC. These aliases are enumeration hints only;
+		 * DSA still creates the actual lan1/lan2/lan3 ports below. */
+		ethernet0 = &xgmac2;
+		ethernet1 = &xgmac1;
+		led-boot = &led_sys_green;
+		led-failsafe = &led_sys_orange;
+		led-running = &led_sys_green;
+		led-upgrade = &led_sys_orange;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs-append = " root=/dev/ubiblock0_1 cnss2.bdf_integrated=0x12";
+	};
+
+        /* CPU: 4x Cortex-A53 */
+        cpus {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+		cpu@0 { reg = <0x00>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@1 { reg = <0x01>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@2 { reg = <0x02>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@3 { reg = <0x03>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		tzapp: tzapp@49b00000 {
+			reg = <0x0 0x49b00000 0x0 0x00600000>;
+			no-map;
+		};
+
+		/*
+		 * Q6 carveout 35 MB (0x2300000) = VENDOR GL-BE9300 stok DTB
+		 * (vendor.dts wcnss@4a900000) + MR47BE GPL mi01.6 degeri.
+		 * test50: 43MB ile TZ AUTH ret=-12 res0=0 (SMC katmani oldu,
+		 * TZ payload yazmadi) -> TZ kendi 35MB tablosuyla uyusmazlik.
+		 * test51: vendor haritasi (m3 0x4cc00000, caldb 0x4ce00000).
+		 */
+		q6_region: wcss@4a900000 {
+			reg = <0x0 0x4a900000 0x0 0x02300000>;
+			no-map;
+		};
+
+		/* BE9300/MR47BE vendor Q6 BDF host window: q6 base + 0x0c00000.
+		 * It intentionally lies in the tail of q6_region, as in the working
+		 * GL-BE9300 DTS; ath12k consumes it as an explicit host-ddr region. */
+		q6_host_ddr: host-ddr@4b500000 {
+			reg = <0x0 0x4b500000 0x0 0x01700000>;
+			no-map;
+		};
+
+		m3_dump: m3-dump@4cc00000 {
+			reg = <0x0 0x4cc00000 0x0 0x100000>;
+			no-map;
+		};
+
+		q6_caldb: q6-caldb@4ce00000 {
+			reg = <0x0 0x4ce00000 0x0 0x500000>;
+			no-map;
+		};
+
+		q6_etr: q6-etr-dump@4cd00000 {
+			reg = <0x0 0x4cd00000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* ramoops: flint3 be9300'de 0x4da00000 1MB (persist dmesg) */
+		ramoops@4da00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x4da00000 0x0 0x100000>;
+			console-size = <0x40000>;
+			record-size = <0x20000>;
+			pmsg-size = <0x20000>;
+		};
+
+		mlo_mem: mlo-global-mem@4db00000 {
+			reg = <0x0 0x4db00000 0x0 0x01100000>; /* TEST133: stok 17MB */
+			no-map;
+		};
+
+		qcn9224_host_ddr: qcn9224-host-ddr@4ed00000 {
+			reg = <0x0 0x4ed00000 0x0 0x03200000>;
+			no-map;
+		};
+	};
+
+	soc@0 {
+		leds {
+			compatible = "gpio-leds";
+			pinctrl-0 = <&leds_pins>;
+			pinctrl-names = "default";
+			status = "okay";
+
+			led@31 {
+				label = "wan";
+				gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
+				default-state = "off";
+			};
+
+			/* v6: led@24 (lan1) ve led@39 (lan2) KALDIRILDI. Firmware DTB'de gpio24 =
+			 * ledswitch BUTONU (giris), gpio39 = PHY reset hatti. GPL mi01.6 referans
+			 * kartindan gelen LED eslesmesi bu kart icin dogrulanmadi. */
+
+			led@32 {
+				label = "lan3";
+				gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
+				default-state = "off";
+			};
+
+			led_sys_green: led@33 {
+				label = "sys_green";
+				gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
+				default-state = "on";
+			};
+
+			led_sys_orange: led@34 {
+				label = "sys_orange";
+				gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+				default-state = "on";
+			};
+		};
+
+		gpio_keys {
+			compatible = "gpio-keys";
+			pinctrl-0 = <&button_pins>;
+			pinctrl-names = "default";
+			status = "okay";
+
+			reset {
+				label = "reset";
+				linux,code = <KEY_RESTART>;
+				gpios = <&tlmm 29 GPIO_ACTIVE_LOW>; /* v6: firmware DTB gpio-keys-polled reset = gpio29 (v2-v5deki 30 YANLISTI: 30 = PHY reset hatti) */
+				linux,input-type = <1>;
+			};
+		};
+
+		/* mdio@90000 dtsi icinde tanimli; compatible = "qcom,ipq4019-mdio".
+		 * Burada yeniden tanimlamak compatible'i ezip surucuyu devre disi
+		 * birakiyordu (mdio probe yok -> PHY/switch/WAN yok).
+		 * &mdio override'i asagida: qca8k_nsscc, ethernet-phy-package@1,
+		 * switch@10 (pseudo-PHY 0x10). */
+
+        /* NSS & PPE */
+	nss-ppe { qcom,ppeds-num = <0x02>; qcom,ppeds-map = <0x01 0x01 0x01 0x01 0x20 0x08 0x02 0x02 0x02 0x02 0x28 0x08>; };
+	nsscc@39b00000 { compatible = "qcom,nsscc-ipq5332";
+		clock-names = "xo", "cmn_pll_nss_clk_200m", "cmn_pll_nss_clk_300m", "gcc_gpll0_out_aux"; };
+	};
+};
+
+&blsp1_uart0 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&tlmm {
+	qspi_nand_pins: qspi_nand_pins {
+		qspi_clock {
+			pins = "gpio13";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi_cs {
+			pins = "gpio12";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi_data {
+			pins = "gpio8", "gpio9", "gpio10", "gpio11";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	leds_pins: leds_pinmux {
+		led_wan {
+			pins = "gpio31";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_lan3 {
+			pins = "gpio32";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_green {
+			pins = "gpio33";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_orange {
+			pins = "gpio34";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+	};
+
+	button_pins: button_pins {
+		reset_button {
+			pins = "gpio29";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	pcie1_default: pcie1-default-state {
+		clkreq-n-pins {
+			pins = "gpio46";
+			function = "pcie1_clk";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio47";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-up;
+			output-low;
+		};
+
+		wake-n-pins {
+			pins = "gpio48";
+			function = "pcie1_wake";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	mdio0_pins: mdio0-state {
+		mux_0 {
+			pins = "gpio25";
+			function = "mdc0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		mux_1 {
+			pins = "gpio26";
+			function = "mdio0";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	mdio1_pins: mdio1-state {
+		mux_0 {
+			pins = "gpio27";
+			function = "mdc1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		mux_1 {
+			pins = "gpio28";
+			function = "mdio1";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+	pinctrl-0 = <&mdio1_pins &mdio0_pins>;
+	pinctrl-names = "default";
+	mdio_clk_fixup;
+	/* QCA8084 reset (vendor GPL: phy-reset-gpio tlmm 16).
+	 * QCA8084 = 4x 2.5G switch-PHY: LAN PORT1..3 + WAN PHY1.
+	 * AYRI CIP YOK: QCA8084, IPQ53xx SoC'ya entegre (GPL U-Boot
+	 * ipq_qca8084.c:1472 "QCA8084-switch"; tum register/saat erisimi
+	 * dahili MDIO uzerinden). KESIN: QCA8386 YOK (foto + boot log).
+	 */
+	/* TEST8: vendor GPL gercek resetlar (ipq5332-BE9300_2_0_0.dts:
+	 * phy-reset-gpio = <&tlmm 30 0 &tlmm 39 0 &tlmm 43 0>).
+	 * Eski gpio16 TAHMINDI YANLISTI. */
+	/* test46 (6.18.39) vendor gercek 3-PHY reset hatti */
+	/* v6: firmware DTB (mr47be_stock_dtb) mdio dugumu: phy-reset-gpio = tlmm 30, 39, 45
+	 * (0x1e, 0x27, 0x2d). 43 degil 45. NOT: MDIO cekirdegi reset-gpios dizisinden yalniz
+	 * ILK girisi (30) kullanir; 39 ve 45 burada sadece belgelenmistir. qca8k_nsscc
+	 * gpio16 resetine dokunulmadi (v2-v5 ile ayni). */
+	/* test011 = ref50 canli DTB: mdio@90000 reset-gpios <&tlmm 16 ACTIVE_LOW>,
+	 * assert/deassert 100000 us. qca8k_nsscc kapali oldugu icin QCA8084 chip
+	 * resetini tek garantili birakan yer burasi (ref50'de WAN+lan 2.5G link up).
+	 * Eski 30/39/45 dizisi stok vendor DTB okumasaydi; cekirdek ilkiyle yetiniyordu. */
+	reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
+	reset-assert-us = <100000>;
+	reset-deassert-us = <100000>;
+
+	/* TEST9: U-Boot mii okumasi KANIT: 004d.d180 adres 1,2,3'te (C22
+	 * reg2/3), adres 7 BOS (FFFF). Vendor DTS'teki 0x7/0x1d port
+	 * numarasiymis, MDIO adresi degil. Adres 4 (WAN) kontrolu cihazda. */
+	/* B133: WAN PHY0 (MDIO addr 1) artik package ICINDE "ephy1" olarak
+	 * tanimli (asagida). Eski standalone phy0 SILINDI: package@1 ile ayni
+	 * MDIO adresinde cakisiyordu ve GEPHY0_SYS_CLK/RESET almiyordu. */
+
+	/* ===================================================================
+	 * B131: QCA8084 DSA switch - SADECE LAN1/2/3 icin.
+	 * B127'den alindi (saha kanitli port eslesmesi) + B130 saatleri.
+	 * WAN BURDA DEGIL: xgmac1 -> phy0(addr1) B130'daki gibi calisir.
+	 * =================================================================== */
+	/* test011: referans test50'in birebir sekli - DSA/switch surucusu yok.
+	 * mdio cekirdegi bu dugumleri PHY ID (004d:d180) ile tanir; saat/reset
+	 * istemez (U-Boot + mdio reset-gpios yeter). qca8084_probe paketsiz yolu
+	 * destekliyor: devm_of_phy_package_join -EINVAL -> devam.
+	 * GMAC1 <-> :01 (wan), GMAC2 <-> :04 (lan). :02/:03 bosta (test012). */
+	phy_wan: ethernet-phy@1 {
+		reg = <1>;
+	};
+
+	ethernet-phy@2 {
+		reg = <2>;
+	};
+
+	ethernet-phy@3 {
+		reg = <3>;
+	};
+
+	phy_lan: ethernet-phy@4 {
+		reg = <4>;
+	};
+
+	qca8k_nsscc: clock-controller@18 {
+		compatible = "qcom,qca8084-nsscc";
+		reg = <0x18>;
+		status = "disabled";
+		reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
+		reset-delay-us = <10000>;
+		reset-post-delay-us = <50000>;
+		/* v2: mdio_device cekirdeginin okudugu isimler (ustteki ikisi legacy) */
+		reset-assert-us = <10000>;
+		reset-deassert-us = <50000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+		#power-domain-cells = <1>;
+
+		clocks = <&qca8084_xo>,
+			 <&qca8k_uniphy0_rx>,
+			 <&qca8k_uniphy0_tx>,
+			 <&qca8k_uniphy1_rx>,
+			 <&qca8k_uniphy1_tx>,
+			 <&qca8k_uniphy1_rx312p5m>,
+			 <&qca8k_uniphy1_tx312p5m>;
+	};
+
+	/* 3 entegre QCA8084 GEPHY: addr2/3/4 = LAN3/LAN2/LAN1.
+	 * (addr1 = WAN, xgmac1 tarafinda plain phy0 olarak kaldi.) */
+	ethernet-phy-package@1 {
+		compatible = "qcom,qca8084-package";
+		reg = <1>;
+		/* test011: ref50 canli DTB de package dugumu YOK; U-Boot WORK_MODE kuruyor. */
+		status = "disabled";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		clocks = <&qca8k_nsscc NSS_CC_APB_BRIDGE_CLK>,
+			 <&qca8k_nsscc NSS_CC_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_TLMM_CLK>,
+			 <&qca8k_nsscc NSS_CC_TLMM_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_CNOC_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_MDIO_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_MDIO_MASTER_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_SWITCH_CORE_CLK>;
+		clock-names = "apb_bridge", "ahb", "sec_ctrl_ahb",
+			      "tlmm", "tlmm_ahb", "cnoc_ahb", "mdio_ahb",
+			      "mdio_master_ahb", "switch_core";
+		resets = <&qca8k_nsscc NSS_CC_GEPHY_FULL_ARES>;
+
+		/* WORK_MODE 0x20 = PCS1_SGMII | MAC_PCS0_SGMII | PHY.
+		 * test120 kaniti: 0x10 yazmak LAN1 uplink'ini OLDURUR. */
+		qcom,package-mode = <QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_PHY>;
+		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;
