+&wifi0 {
+	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
+			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
+	/* ath12k AHB (mac80211 backports wifi7 driver) resolves these by INDEX, not
+	 * by name: index0 = q6-region (UserPD load + BDF pool at +bdf_addr_offset
+	 * = 0x4b500000), index1 = m3-dump.  With host-ddr at index1 the target is
+	 * told its M3 dump buffer starts on top of the BDF/calibration data. */
+	memory-region = <&q6_region>, <&m3_dump>, <&q6_caldb>, <&mlo_mem>,
+			<&q6_etr>, <&q6_host_ddr>;
+	memory-region-names = "q6-region", "m3-dump", "q6-caldb", "mlo-global-mem",
+			      "q6-etr-dump", "host-ddr-mem";
+	/* board-2.bindeki kayit "bus=ahb,qmi-chip-id=0,qmi-board-id=18".
+	 * QMI bu cihazda board_id 0xff donduruyor; yama 701 (mac80211)
+	 * id'yi DT'den okuyor. qcom,board-id / bdf-type property'leri bu
+	 * agacta hicbir surucu tarafindan okunmuyordu, kaldirildi. */
+	qcom,ath12k-board-id = <18>;
+	qcom,rproc = <&q6v5_wcss>;
+	qcom,wsi-controller;
+
+	status = "okay";
+
+	/* TEST144: WSI ports grafigi KALDIRILDI -> test45/47 tek-cihaz rejimi.
+	 * Kanit: 103 logu "qcn9274 hw2.0 / MSI vectors: 16" sonrasi sessiz (test41-44 duvari);
+	 * test45-47 portsuz DTS ile 5G ch36/80 + 6G ch37/160 AP yayinladi.
+	 * GERI ALMA: .bak_104_pre_ports_revert dosyasindaki bloklari geri koy. */
+
+};
