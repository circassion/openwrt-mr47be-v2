+
+	qca8k_uniphy1_tx312p5m: clock-qca8k-uniphy1-tx312p5m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <312500000>;
+	};
+};
+
+/* B127: NSSCC'nin UNIPHY parent saatleri (ipq5332.dtsi'de <0> kalmisti!).
+ * Sira nsscc-ipq5332.c DT_ enum'u ile birebir olmali:
+ *   0=cmn_pll_nss_200m 1=cmn_pll_nss_300m 2=gpll0_aux
+ *   3=uniphy0 TX 4=uniphy0 RX 5=uniphy1 TX 6=uniphy1 RX 7=xo_board
+ * (PCS_TX_CLK=1 / PCS_RX_CLK=0 -> dt-bindings/net/qcom,ipq9574-pcs.h)
+ * Bu bag olmadan nss_cc_port2_rx/tx_clk_src 312.5 MHz'i secemez, XO'da
+ * (24 MHz) kalir; conduit MAC2 <-> switch CPU portu veri tasimaz.
+ * Kanit: MR47BE_126 -> nss_cc_port2_rx_clk = 24000000
+ *       (olmasi gereken 312500000; PCS tarafi zaten 312500000).
+ */
+&nsscc {
+	/* B130: NSSCC probe pm_clk_add() ile "bus/nssnoc/nssnoc_snoc/nssnoc_snoc_1/
+	 * snoc_nssnoc/snoc_nssnoc_1" isimlerini ZORUNLU ister. clock-names yoksa
+	 * of_clk_get_by_name() index 0'a duser -> 6 isim de ayni PLL'e baglanir ve
+	 * GCC NSS<->SNOC fabric clock'lari HIC enable edilmez -> LAN/PPE conduit
+	 * veri yolu olu kalir (link var, trafik yok). PR#23161 0375 ile ayni. */
+	clocks = <&cmn_pll_nss_200m_clk>,
+		 <&cmn_pll_nss_300m_clk>,
+		 <&gcc GPLL0_OUT_AUX>,
+		 <&pcs0 PCS_TX_CLK>,
+		 <&pcs0 PCS_RX_CLK>,
+		 <&pcs1 PCS_TX_CLK>,
+		 <&pcs1 PCS_RX_CLK>,
+		 <&xo_board>,
+		 <&gcc GCC_NSSCC_CLK>,
+		 <&gcc GCC_NSSNOC_NSSCC_CLK>,
+		 <&gcc GCC_NSSNOC_SNOC_CLK>,
+		 <&gcc GCC_NSSNOC_SNOC_1_CLK>,
+		 <&gcc GCC_SNOC_NSSNOC_CLK>,
+		 <&gcc GCC_SNOC_NSSNOC_1_CLK>;
+	clock-names = "cmn_pll_nss_clk_200m",
+		      "cmn_pll_nss_clk_300m",
+		      "gcc_gpll0_out_aux",
+		      "uniphy0_tx",
+		      "uniphy0_rx",
+		      "uniphy1_tx",
+		      "uniphy1_rx",
+		      "xo",
+		      "bus",
+		      "nssnoc",
+		      "nssnoc_snoc",
+		      "nssnoc_snoc_1",
+		      "snoc_nssnoc",
+		      "snoc_nssnoc_1";
+};
diff --git a/target/linux/qualcommbe/dts/ipq5332-default-memory.dtsi b/target/linux/qualcommbe/dts/ipq5332-default-memory.dtsi
new file mode 100644
index 0000000..c75a8be
--- /dev/null
+++ b/target/linux/qualcommbe/dts/ipq5332-default-memory.dtsi
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Dev SoC Memory device tree source
+ *
+ * Copyright (c) 2022 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+#include "ipq5332-memory.dtsi"
+
+/ {
+
+	/*		  Default Profile
+	 * +=========+==============+========================+
+	 * |        |              |                         |
+	 * | Region | Start Offset |          Size           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * | For core memory regions, please refer           |
+	 * | ipq5332-memory.dtsi                             |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * | WLAN   |              |                         |
+	 * |   Q6   |  0x4A900000  |          35MB           |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * | M3 Dump|  0x4CC00000  |          1MB            |
+	 * +--------+--------------+-------------------------+
+	 * | WLAN   |              |                         |
+	 * | Q6 ETR |  0x4CD00000  |          1MB            |
+	 * | Region |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * | caldb  |  0x4CE00000  |           5MB           |
+	 * +--------+--------------+-------------------------+
+         * |  MLO   |  0x4DB00000  |          17MB           |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |  WKK0  |  0x4EC00000  |          50MB           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |  WKK1  |  0x51E00000  |          50MB           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |  MHI0  |    DYNAMIC   |          9MB            |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |  MHI1  |    DYNAMIC   |          9MB            |
+	 * |        |              |                         |
+	 * +=================================================+
+	 * |                                                 |
+	 * |                                                 |
+	 * |                                                 |
+	 * |            Rest of memory for Linux             |
+	 * |                                                 |
+	 * |                                                 |
+	 * |                                                 |
+	 * +=================================================+
+	 */
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		q6_region: wcnss@4a900000 {
+			no-map;
+			reg = <0x0 0x4a900000 0x0 0x02300000>;
+		};
+
+		m3_dump: m3_dump@4cc00000 {
+			no-map;
+			reg = <0x0 0x4CC00000 0x0 0x100000>;
+		};
+
+		q6_etr_region: q6_etr_dump@1 {
+			no-map;
+			reg = <0x0 0x4CD00000 0x0 0x100000>;
+		};
+
+		q6_caldb_region:q6_caldb_region@4ce00000 {
+			no-map;
+			reg = <0x0 0x4CE00000 0x0 0x500000>;
+		};
+
+		mlo_global_mem0: mlo_global_mem_0@0x4db00000 {
+			no-map;
+			reg = <0x0 0x4DB00000 0x0 0x01100000>;
+		};
+
+		qcn9224_pcie0: qcn9224_pcie0@4ec00000 {
+			no-map;
+			reg = <0x0 0x4EC00000 0x0 0x03200000>;
+			status = "disabled";
+		};
+
+		qcn9224_pcie1: qcn9224_pcie1@51e00000 {
+			no-map;
+			reg = <0x0 0x51e00000 0x0 0x03200000>;
+			status = "disabled";
+		};
+
+		mhi_region0: dma_pool0@0 {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x00900000>;
+			status = "disabled";
+		};
+
+		mhi_region1: dma_pool1@1 {
+			compatible = "shared-dma-pool";
+			no-map;
+			size = <0x0 0x00900000>;
+			status = "disabled";
+                };
+
+	};
+};
diff --git a/target/linux/qualcommbe/dts/ipq5332-memory.dtsi b/target/linux/qualcommbe/dts/ipq5332-memory.dtsi
new file mode 100644
index 0000000..704cbbf
--- /dev/null
+++ b/target/linux/qualcommbe/dts/ipq5332-memory.dtsi
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * IPQ5332 Memory device tree source
+ *
+ * Copyright (c) 2022 Qualcomm Innovation Center, Inc. All rights reserved.
+ */
+
+/ {
+
+#if defined(__IPQ_MEM_PROFILE_512_MB__)
+	MP_512;
+#endif
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x0 0x20000000>;
+	};
+
+	/*		  Core Memory Profile
+	 * +=========+==============+========================+
+	 * |        |              |                         |
+	 * | Region | Start Offset |          Size           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * | Linux  |  0x40000000  |           161MB         |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * | TZ App is applicable only for 1GB profile.      |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * | TZ App |  0x49B00000  |           6MB           |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * | uboot  |  0x4A100000  |           4MB           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |  SBL   |  0x4A500000  |           1MB           |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |  TZ    |  0x4A600000  |           2MB           |
+	 * |        |              |                         |
+	 * +--------+--------------+-------------------------+
+	 * |  smem  |  0x4A800000  |           1MB           |
+	 * +--------+--------------+-------------------------+
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * | WLAN   |              |                         |
+	 * |   Q6   |  0x4A900000  |          43MB           |
+	 * |        |              |                         |
+	 * |        |              |                         |
+	 * +=================================================+
+	 */
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		tzapp: tzapp@49B00000 {
+			no-map;
+		#if !defined(__IPQ_MEM_PROFILE_512_MB__)
+			reg = <0x0 0x49B00000 0x0 0x00600000>;
+		#endif
+		};
+
+		uboot@4A100000 {
+			no-map;
+			reg = <0x0 0x4A100000 0x0 0x00400000>;
+		};
+
+		sbl@4A500000 {
+			no-map;
+			reg = <0x0 0x4A500000 0x0 0x00100000>;
+		};
+
+		tz@4A600000 {
+			no-map;
+			reg = <0x0 0x4A600000 0x0 0x00200000>;
+		};
+
+		smem_region: smem@4A800000 {
+			no-map;
+			reg = <0x0 0x4A800000 0x0 0x00100000>;
+		};
+
+		/*
+		* q6_region has to be redefined in RDP specific
+		* dts file based on no of userpd's
+		*/
+		q6_region: wcnss@4a900000 {
+			no-map;
+			reg = <0x0 0x4a900000 0x0 0x02b00000>;
+		};
+	};
+};
diff --git a/target/linux/qualcommbe/dts/ipq5332-mr47be-v2.dts b/target/linux/qualcommbe/dts/ipq5332-mr47be-v2.dts
new file mode 100644
index 0000000..3677342
--- /dev/null
+++ b/target/linux/qualcommbe/dts/ipq5332-mr47be-v2.dts
@@ -0,0 +1,1072 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+//
+// Mercusys MR47BE V2 - IPQ5332 AP-MI01.6 based Wi-Fi 7 tri-band router
+// Base: GL-BE6500 DTS (qualcommbe/ipq53xx) + MR47BE V2 GPL kernel DTS
+// SoC: Qualcomm IPQ5322 (die: "IPQ5322 003 FK5134HJ"; yazilim varyanti
+//      string'i IPQ5332LA), 4x Cortex-A53, 1 GiB DDR4 (SEC K4A8G165WC)
+// WiFi: on-SoC 2.4GHz (wifi0, qcom,board-id = 18 = 0x12) + QCN6274 via
+//      PCIe1 (5G+6G, 2 radyo, pci17cb,1109, qcom,board-id = 0x1015)
+// Switch: QCA8084 - IPQ53xx SoC'ya ENTEGRE (ayri cip YOK; GPL U-Boot
+//      ipq_qca8084.c "QCA8084-switch"), 4x 2.5G + SoC PPE
+// Flash: SPI-NAND Winbond W25N01GW 128MiB (SPI-NOR YOK - boot log: not found)
+// UART: GPIO18/19 @ 115200
+// v6: v5 uzerine firmware-DTB duzeltmeleri (reset tusu gpio29, bus reset 30/39/45, LED 24/39 kaldirildi).
+// v3: FINAL-DTS-6.18.54 uzerine: mdio reset-gpios kaldirildi, nsscc reset gecikmesi, reset tusu gpio30,
+//     NAND ECC 4-bit (stok), conduit label "cpu". Gerisi birebir.
+
+/dts-v1/;
+
+#include <arm64/qcom/ipq5332.dtsi>
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>
+#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
+#include <dt-bindings/reset/qcom,qca8k-nsscc.h>
+#include <dt-bindings/net/qcom,qca808x.h>
+#include <dt-bindings/net/qcom,ipq9574-pcs.h>
+
+/ {
+	#address-cells = <0x2>;
+	#size-cells = <0x2>;
+	model = "Mercusys MR47BE V2";
+	compatible = "mercusys,mr47be-v2", "qcom,ipq5332-ap-mi01.6", "qcom,ipq5332";
+
+	aliases {
+		serial0 = &blsp1_uart0;
+		/* Stock DTS semantic mapping: dp1/id=2 -> LAN switch CPU conduit,
+		 * dp2/id=1 -> WAN MAC. These aliases are enumeration hints only;
+		 * DSA still creates the actual lan1/lan2/lan3 ports below. */
+		ethernet0 = &xgmac2;
+		ethernet1 = &xgmac1;
+		led-boot = &led_sys_green;
+		led-failsafe = &led_sys_orange;
+		led-running = &led_sys_green;
+		led-upgrade = &led_sys_orange;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/* test051: die NSSCC saglayicisi (clock-controller@18) okay oldugu icin
+		 * CCF late_initcall'da enable_count==0 olan her dali donanimdan kapatir
+		 * (mac0..mac4/gephy/srds) = WAN+LAN RX sifir (test039-A, test050 olculdu).
+		 * clk_ignore_unused bu temizligi kapatir; U-Boot'un kurduyu yerinde kalir. */
+		bootargs-append = " root=/dev/ubiblock0_1 cnss2.bdf_integrated=0x12 clk_ignore_unused";
+	};
+
+        /* CPU: 4x Cortex-A53 */
+        cpus {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+		cpu@0 { reg = <0x00>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@1 { reg = <0x01>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@2 { reg = <0x02>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+		cpu@3 { reg = <0x03>; compatible = "arm,cortex-a53"; enable-method = "psci"; };
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		tzapp: tzapp@49b00000 {
+			reg = <0x0 0x49b00000 0x0 0x00600000>;
+			no-map;
+		};
+
+		/*
+		 * Q6 carveout 35 MB (0x2300000) = VENDOR GL-BE9300 stok DTB
+		 * (vendor.dts wcnss@4a900000) + MR47BE GPL mi01.6 degeri.
+		 * test50: 43MB ile TZ AUTH ret=-12 res0=0 (SMC katmani oldu,
+		 * TZ payload yazmadi) -> TZ kendi 35MB tablosuyla uyusmazlik.
+		 * test51: vendor haritasi (m3 0x4cc00000, caldb 0x4ce00000).
+		 */
+		q6_region: wcss@4a900000 {
+			reg = <0x0 0x4a900000 0x0 0x02300000>;
+			no-map;
+		};
+
+		/* BE9300/MR47BE vendor Q6 BDF host window: q6 base + 0x0c00000.
+		 * It intentionally lies in the tail of q6_region, as in the working
+		 * GL-BE9300 DTS; ath12k consumes it as an explicit host-ddr region. */
+		q6_host_ddr: host-ddr@4b500000 {
+			reg = <0x0 0x4b500000 0x0 0x01700000>;
+			no-map;
+		};
+
+		m3_dump: m3-dump@4cc00000 {
+			reg = <0x0 0x4cc00000 0x0 0x100000>;
+			no-map;
+		};
+
+		q6_caldb: q6-caldb@4ce00000 {
+			reg = <0x0 0x4ce00000 0x0 0x500000>;
+			no-map;
+		};
+
+		q6_etr: q6-etr-dump@4cd00000 {
+			reg = <0x0 0x4cd00000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* ramoops: flint3 be9300'de 0x4da00000 1MB (persist dmesg) */
+		ramoops@4da00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x4da00000 0x0 0x100000>;
+			console-size = <0x40000>;
+			record-size = <0x20000>;
+			pmsg-size = <0x20000>;
+		};
+
+		mlo_mem: mlo-global-mem@4db00000 {
+			reg = <0x0 0x4db00000 0x0 0x01100000>; /* TEST133: stok 17MB */
+			no-map;
+		};
+
+		qcn9224_host_ddr: qcn9224-host-ddr@4ed00000 {
+			reg = <0x0 0x4ed00000 0x0 0x03200000>;
+			no-map;
+		};
+	};
+
+	soc@0 {
+		leds {
+			compatible = "gpio-leds";
+			pinctrl-0 = <&leds_pins>;
+			pinctrl-names = "default";
+			status = "okay";
+
+			led@31 {
+				label = "wan";
+				gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
+				default-state = "off";
+			};
+
+			/* v6: led@24 (lan1) ve led@39 (lan2) KALDIRILDI. Firmware DTB'de gpio24 =
+			 * ledswitch BUTONU (giris), gpio39 = PHY reset hatti. GPL mi01.6 referans
+			 * kartindan gelen LED eslesmesi bu kart icin dogrulanmadi. */
+
+			led@32 {
+				label = "lan3";
+				gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
+				default-state = "off";
+			};
+
+			led_sys_green: led@33 {
+				label = "sys_green";
+				gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
+				default-state = "on";
+			};
+
+			led_sys_orange: led@34 {
+				label = "sys_orange";
+				gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
+				default-state = "on";
+			};
+		};
+
+		gpio_keys {
+			compatible = "gpio-keys";
+			pinctrl-0 = <&button_pins>;
+			pinctrl-names = "default";
+			status = "okay";
+
+			reset {
+				label = "reset";
+				linux,code = <KEY_RESTART>;
+				gpios = <&tlmm 30 GPIO_ACTIVE_LOW>; /* v7: canli olcum (debugfs gpio taramasi) -> reset = GPIO30, aktif-low. gpio29 DEGIL. */
+				linux,input-type = <1>;
+			};
+		};
+
+		/* mdio@90000 dtsi icinde tanimli; compatible = "qcom,ipq4019-mdio".
+		 * Burada yeniden tanimlamak compatible'i ezip surucuyu devre disi
+		 * birakiyordu (mdio probe yok -> PHY/switch/WAN yok).
+		 * &mdio override'i asagida: qca8k_nsscc, ethernet-phy-package@1,
+		 * switch@10 (pseudo-PHY 0x10). */
+
+        /* NSS & PPE */
+	nss-ppe { qcom,ppeds-num = <0x02>; qcom,ppeds-map = <0x01 0x01 0x01 0x01 0x20 0x08 0x02 0x02 0x02 0x02 0x28 0x08>; };
+	nsscc@39b00000 { compatible = "qcom,nsscc-ipq5332";
+		clock-names = "xo", "cmn_pll_nss_clk_200m", "cmn_pll_nss_clk_300m", "gcc_gpll0_out_aux"; };
+	};
+};
+
+&blsp1_uart0 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&tlmm {
+	qspi_nand_pins: qspi_nand_pins {
+		qspi_clock {
+			pins = "gpio13";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi_cs {
+			pins = "gpio12";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi_data {
+			pins = "gpio8", "gpio9", "gpio10", "gpio11";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	leds_pins: leds_pinmux {
+		led_wan {
+			pins = "gpio31";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_lan3 {
+			pins = "gpio32";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_green {
+			pins = "gpio33";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+
+		led_orange {
+			pins = "gpio34";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-down;
+		};
+	};
+
+	button_pins: button_pins {
+		reset_button {
+			pins = "gpio30";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	pcie1_default: pcie1-default-state {
+		clkreq-n-pins {
+			pins = "gpio46";
+			function = "pcie1_clk";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		perst-n-pins {
+			pins = "gpio47";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-pull-up;
+			output-low;
+		};
+
+		wake-n-pins {
+			pins = "gpio48";
+			function = "pcie1_wake";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	mdio0_pins: mdio0-state {
+		mux_0 {
+			pins = "gpio25";
+			function = "mdc0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		mux_1 {
+			pins = "gpio26";
+			function = "mdio0";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+
+	mdio1_pins: mdio1-state {
+		mux_0 {
+			pins = "gpio27";
+			function = "mdc1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		mux_1 {
+			pins = "gpio28";
+			function = "mdio1";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+	};
+};
+
+&mdio {
+	status = "okay";
+	pinctrl-0 = <&mdio1_pins &mdio0_pins>;
+	pinctrl-names = "default";
+	mdio_clk_fixup;
+	/* QCA8084 reset (vendor GPL: phy-reset-gpio tlmm 16).
+	 * QCA8084 = 4x 2.5G switch-PHY: LAN PORT1..3 + WAN PHY1.
+	 * AYRI CIP YOK: QCA8084, IPQ53xx SoC'ya entegre (GPL U-Boot
+	 * ipq_qca8084.c:1472 "QCA8084-switch"; tum register/saat erisimi
+	 * dahili MDIO uzerinden). KESIN: QCA8386 YOK (foto + boot log).
+	 */
+	/* TEST8: vendor GPL gercek resetlar (ipq5332-BE9300_2_0_0.dts:
+	 * phy-reset-gpio = <&tlmm 30 0 &tlmm 39 0 &tlmm 43 0>).
+	 * Eski gpio16 TAHMINDI YANLISTI. */
+	/* test46 (6.18.39) vendor gercek 3-PHY reset hatti */
+	/* v6: firmware DTB (mr47be_stock_dtb) mdio dugumu: phy-reset-gpio = tlmm 30, 39, 45
+	 * (0x1e, 0x27, 0x2d). 43 degil 45. NOT: MDIO cekirdegi reset-gpios dizisinden yalniz
+	 * ILK girisi (30) kullanir; 39 ve 45 burada sadece belgelenmistir. qca8k_nsscc
+	 * gpio16 resetine dokunulmadi (v2-v5 ile ayni). */
+	/* test011 = ref50 canli DTB: mdio@90000 reset-gpios <&tlmm 16 ACTIVE_LOW>,
+	 * assert/deassert 100000 us. qca8k_nsscc kapali oldugu icin QCA8084 chip
+	 * resetini tek garantili birakan yer burasi (ref50'de WAN+lan 2.5G link up).
+	 * Eski 30/39/45 dizisi stok vendor DTB okumasaydi; cekirdek ilkiyle yetiniyordu. */
+	reset-gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
+	reset-assert-us = <100000>;
+	reset-deassert-us = <100000>;
+
+	/* TEST9: U-Boot mii okumasi KANIT: 004d.d180 adres 1,2,3'te (C22
+	 * reg2/3), adres 7 BOS (FFFF). Vendor DTS'teki 0x7/0x1d port
+	 * numarasiymis, MDIO adresi degil. Adres 4 (WAN) kontrolu cihazda. */
+	/* B133: WAN PHY0 (MDIO addr 1) artik package ICINDE "ephy1" olarak
+	 * tanimli (asagida). Eski standalone phy0 SILINDI: package@1 ile ayni
+	 * MDIO adresinde cakisiyordu ve GEPHY0_SYS_CLK/RESET almiyordu. */
+
+	/* ===================================================================
+	 * B131: QCA8084 DSA switch - SADECE LAN1/2/3 icin.
+	 * B127'den alindi (saha kanitli port eslesmesi) + B130 saatleri.
+	 * WAN BURDA DEGIL: xgmac1 -> phy0(addr1) B130'daki gibi calisir.
+	 * =================================================================== */
+	/* test011: referans test50'in birebir sekli - DSA/switch surucusu yok.
+	 * mdio cekirdegi bu dugumleri PHY ID (004d:d180) ile tanir; saat/reset
+	 * istemez (U-Boot + mdio reset-gpios yeter). qca8084_probe paketsiz yolu
+	 * destekliyor: devm_of_phy_package_join -EINVAL -> devam.
+	 * GMAC1 <-> :01 (wan), GMAC2 <-> :04 (lan). :02/:03 bosta (test012). */
+	/* test050: DSA kullanicilari bunlari phy-handle ile ister (package dugumu
+	 * disabled kalir, yoksa cocuk ephy'ler probe olmaz ve DSA portlari
+	 * -EPROBE_DEFER'de takilir). die port N == EPHY MDIO adresi N:
+	 *   :01 = WAN jak | :02 = LAN3 | :03 = LAN2 | :04 = LAN1 */
+	phy_wan: ethernet-phy@1 {
+		reg = <1>;
+	};
+
+	phy_l3: ethernet-phy@2 {
+		reg = <2>;
+	};
+
+	phy_l2: ethernet-phy@3 {
+		reg = <3>;
+	};
+
+	phy_lan: ethernet-phy@4 {
+		reg = <4>;
+	};
+
+	qca8k_nsscc: clock-controller@18 {
+		compatible = "qcom,qca8084-nsscc";
+		reg = <0x18>;
+		/* test050: saglayici ACIK (DSA surucusu 13 reset + 21 saat
+		 * istiyor). reset-gpios BURAYA YAZILMAZ: die reset hattini
+		 * &mdio node'u sahip; probe'daki gpiod "reset" OPTIONAL oldugu
+		 * icin hat burada hic pulse'lanmaz. Cift talep = -EBUSY
+		 * (test038) ve pulse = U-Boot'un kurduyu die'yi sifirlar
+		 * (test039-A: WAN+lan RX iki sifir). */
+		status = "okay";
+		reset-delay-us = <10000>;
+		reset-post-delay-us = <50000>;
+		/* v2: mdio_device cekirdeginin okudugu isimler (ustteki ikisi legacy) */
+		reset-assert-us = <10000>;
+		reset-deassert-us = <50000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+		#power-domain-cells = <1>;
+
+		clocks = <&qca8084_xo>,
+			 <&qca8k_uniphy0_rx>,
+			 <&qca8k_uniphy0_tx>,
+			 <&qca8k_uniphy1_rx>,
+			 <&qca8k_uniphy1_tx>,
+			 <&qca8k_uniphy1_rx312p5m>,
+			 <&qca8k_uniphy1_tx312p5m>;
+	};
+
+	/* 3 entegre QCA8084 GEPHY: addr2/3/4 = LAN3/LAN2/LAN1.
+	 * (addr1 = WAN, xgmac1 tarafinda plain phy0 olarak kaldi.) */
+	ethernet-phy-package@1 {
+		compatible = "qcom,qca8084-package";
+		reg = <1>;
+		/* test011: ref50 canli DTB de package dugumu YOK; U-Boot WORK_MODE kuruyor. */
+		status = "disabled";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		clocks = <&qca8k_nsscc NSS_CC_APB_BRIDGE_CLK>,
+			 <&qca8k_nsscc NSS_CC_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_TLMM_CLK>,
+			 <&qca8k_nsscc NSS_CC_TLMM_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_CNOC_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_MDIO_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_MDIO_MASTER_AHB_CLK>,
+			 <&qca8k_nsscc NSS_CC_SWITCH_CORE_CLK>;
+		clock-names = "apb_bridge", "ahb", "sec_ctrl_ahb",
+			      "tlmm", "tlmm_ahb", "cnoc_ahb", "mdio_ahb",
+			      "mdio_master_ahb", "switch_core";
+		resets = <&qca8k_nsscc NSS_CC_GEPHY_FULL_ARES>;
+
+		/* WORK_MODE 0x20 = PCS1_SGMII | MAC_PCS0_SGMII | PHY.
+		 * test120 kaniti: 0x10 yazmak LAN1 uplink'ini OLDURUR. */
+		qcom,package-mode = <QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_PHY>;
+		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;
+
+		/* B133: PHY0 = WAN (GMAC1). Upstream binding (0301) package'in
+		 * ILK cocugu ethernet-phy@1 olmali: reg=1 + GEPHY0_SYS_CLK/ARES.
+		 * B131/B132'de bu dugum EKSIKTI -> WAN EPHY'si package disinda
+		 * kalip ne saat ne reset aliyordu (WAN link Up ama DHCP yok). */
+		ephy1: ethernet-phy@1 {
+			compatible = "ethernet-phy-id004d.d180";
+			reg = <1>;
+			clocks = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_CLK>;
+			resets = <&qca8k_nsscc NSS_CC_GEPHY0_SYS_ARES>;
+		};
+
+		ephy2: ethernet-phy@2 {
+			compatible = "ethernet-phy-id004d.d180";
+			reg = <2>;
+			clocks = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_CLK>;
+			resets = <&qca8k_nsscc NSS_CC_GEPHY1_SYS_ARES>;
+		};
+
+		ephy3: ethernet-phy@3 {
+			compatible = "ethernet-phy-id004d.d180";
+			reg = <3>;
+			clocks = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_CLK>;
+			resets = <&qca8k_nsscc NSS_CC_GEPHY2_SYS_ARES>;
+		};
+
+		ephy4: ethernet-phy@4 {
+			compatible = "ethernet-phy-id004d.d180";
+			reg = <4>;
+			clocks = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_CLK>;
+			resets = <&qca8k_nsscc NSS_CC_GEPHY3_SYS_ARES>;
+		};
+
+		/* PCS1 SGMII+ -> switch MAC0 (CPU uplink) tasiyicisi. */
+		pcs-phy@6 {
+			compatible = "qcom,qca8k-pcs-phy";
+			reg = <6>;
+			clocks = <&qca8k_nsscc NSS_CC_SRDS1_SYS_CLK>,
+				 <&qca8k_uniphy1_tx312p5m>,
+				 <&qca8k_uniphy1_rx312p5m>;
+			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root";
+			resets = <&qca8k_nsscc NSS_CC_SRDS1_SYS_ARES>;
+		};
+	};
+
+	/* QCA8386-uyumlu DSA surucusu QCA8084'u yonetir (QCA8386 YOK
+	 * boardda; register penceresi pseudo-PHY 0x10). */
+	switch@10 {
+		compatible = "qca,qca8386";
+		reg = <0x10>;
+		/* test050: ACIK. Surucu = m (modul); insmod'u mr47be-die-switch'in
+		 * dsa profili yapar, cunku once WORK_MODE 0x20 -> 0x10 flip'i ve
+		 * SerDes/RCG/CBC bring-up'i gerekir (prove: test047 apply sirasi). */
+		status = "okay";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		resets = <&qca8k_nsscc NSS_CC_SWITCH_CORE_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC0_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC0_RX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC1_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC1_RX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC2_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC2_RX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC3_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC3_RX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC4_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC4_RX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC5_TX_ARES>,
+			 <&qca8k_nsscc NSS_CC_MAC5_RX_ARES>;
+		reset-names = "switch_core",
+			      "mac0_tx", "mac0_rx",
+			      "mac1_tx", "mac1_rx",
+			      "mac2_tx", "mac2_rx",
+			      "mac3_tx", "mac3_rx",
+			      "mac4_tx", "mac4_rx",
+			      "mac5_tx", "mac5_rx";
+
+		clocks = <&qca8k_nsscc NSS_CC_MAC0_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC0_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC0_TX_SRDS1_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC0_RX_SRDS1_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC1_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC1_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC2_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC2_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC3_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC3_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC4_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC4_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
+			 <&qca8k_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>,
+			 <&qca8k_nsscc NSS_CC_SRDS1_SYS_CLK>;
+		clock-names = "mac0_tx", "mac0_rx", "mac0_tx_srds1", "mac0_rx_srds1",
+			      "mac1_tx", "mac1_rx", "mac1_gephy_tx", "mac1_gephy_rx",
+			      "mac2_tx", "mac2_rx", "mac2_gephy_tx", "mac2_gephy_rx",
+			      "mac3_tx", "mac3_rx", "mac3_gephy_tx", "mac3_gephy_rx",
+			      "mac4_tx", "mac4_rx", "mac4_gephy_tx", "mac4_gephy_rx",
+				     "srds1_sys";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* test050 TEK CONDUIT = die port5 <-> &xgmac2 (pcs1/UNIPHY1).
+			 * Kanit: vendor cpu_bmp=0x21 (port0 + port5) ve test047 flip'i
+			 * LAN'i port5 uzerinden tasiyor (acl cpu_bmp 0x21 ile olculen
+			 * 0x20000000/0x14). 6.18 DSA (dsa.c:1120 + dsa_tree_setup)
+			 * kullanici portlarina ILK yerel CPU portunu atar -> tek conduit.
+			 * B127 kaniti: "sgmii" 2500'i reddediyor -> 2500base-x +
+			 * fixed-link; fixed-link ALTI-DUGUMU en sonda olmali. */
+			port@5 {
+				reg = <5>;
+				label = "cpu";
+				ethernet = <&xgmac2>;
+				phy-mode = "2500base-x";
+				fixed-link {
+					speed = <2500>;
+					full-duplex;
+				};
+			};
+
+			/* Kullanicilar: label dogrudan netdev adidir
+			 * (user.c:dsa_user_create, NET_NAME_PREDICTABLE).
+			 * phy-handle = standalone qca808x PHY'leri (MDIO 1..4);
+			 * package dugumu disabled kaldigi icin ephy1..4 etiketleri
+			 * KULLANILAMAZ (probe olmazlar, DSA sonsuza dek defer olur).
+			 * WAN da artk die uzerinde: WORK_MODE kuresel, bypass ile
+			 * switch ayni anda olmaz (test042/#82). */
+			/* phylib TEK SAHIP kurali (drivers/net/phy/phy_device.c
+			 * phy_attach_direct):PHY zaten bir dev'e bagliysa ikinci
+			 * baglanma -EBUSY "PHY already attached". &phy_wan'i flip
+			 * ONCESI WAN yolu (xgmac1) tutmak zorunda -> DSA port@1
+			 * fixed-link olur. Tasimayi die icinde fabric yapar; link
+			 * durumu hukumcu degil, DSA-GUARD pinger'i hukum verir.
+			 * fixed-link ALTI-DUGUMU en sonda olmali. */
+			port@1 {
+				reg = <1>;
+				label = "wan";
+				phy-mode = "internal";
+				fixed-link {
+					speed = <2500>;
+					full-duplex;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+				label = "lan3";
+				phy-mode = "internal";
+				phy-handle = <&phy_l3>;
+			};
+
+			port@3 {
+				reg = <3>;
+				label = "lan2";
+				phy-mode = "internal";
+				phy-handle = <&phy_l2>;
+			};
+
+			port@4 {
+				reg = <4>;
+				label = "lan1";
+				phy-mode = "internal";
+				phy-handle = <&phy_lan>;
+			};
+		};	/* ports */
+	};	/* switch@10 */
+	/* &mdio'nun kapanisi asagida (replace ile) ekleniyor. */};
+
+/* TEST22 (vendor gercegi: Iplatform/build/product_configs/MR47BEv2/
+ * kernel-ipq5332-mi01.6.dts):
+ *   dp1 = qcom,id=2, reg 0x3a504000, qcom,is_switch_connected=1 -> LAN (switch arkasi)
+ *   dp2 = qcom,id=1, reg 0x3a500000, phy'siz                    -> WAN
+ * Kanit: ppe_regs.h:605 PPE_PORT_XGMAC_ADDR(x)=0x500000+(x-1)*0x4000
+ *   port@1 = 0x3a500000 = MAC1 = WAN | port@2 = 0x3a504000 = MAC2 = LAN-switch
+ * Saha kaniti (test20): LAN1 jakina kablo -> port@2 ("wan") netdev link geldi.
+ * Yani TEST22 oncesi etiketler vendor'in tersiydi.
+ * WAN jak PHY MDIO adresi 1,2 veya 3 arasinda (U-Boot canli PHY: 1,2,3;
+ * addr4 = LAN1, test20'de kanitlandi). Ilk deneme: wan = phy@1
+ * (vendor boot log "eth0 PHY1 = WAN"). port@2 phy-handle'siz fixed-link
+ * (vendor dp1'de phy-handle yok; LAN1..3 QCA8084 switch ile MAC2'ye gelir).
+ */
+&qcom_ppe {
+	status = "okay";
+
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		xgmac1: port@1 {
+			reg = <1>;
+			/* v22: WAN = die'in switch port0 CPU yuzu (2500 SGMII+).
+			 * port@2 (lan) ile AYNI desen: pcs-handle + 2500base-x +
+			 * fixed-link, phy-handle YOK. phy-handle baglaninca phylink
+			 * MAC'i PHY'nin bakir hizina (100M) kilitliyor ve die'nin
+			 * 2.5G MAC yuzuyle eslesmiyor -> link up gorunur, RX 0.
+			 * Trunk sabit 2.5G'dir; 100M/1G/2.5G cevirimini die icindeki
+			 * switch port1 MAC'i yapar (vendor ile ayni mimari). */
+			label = "gmac1";
+			pcs-handle = <&pcs0_ch0>;
+			phy-mode = "2500base-x";
+			qcom,fixed-trunk-speed = <2500>;
+			nvmem-cells = <&base_macaddr 0>;
+			nvmem-cell-names = "mac-address";
+
+
+			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT1_RX_CLK>,
+				 <&nsscc NSS_CC_PORT1_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+
+			fixed-link {
+				speed = <2500>;
+				full-duplex;
+			};
+		};
+
+		xgmac2: port@2 {
+			reg = <2>;
+			label = "lan";
+			pcs-handle = <&pcs1_ch0>;
+			/* test011 = ref50: GMAC2 dogrudan EPHY :04 (pcs1/uniphy1,
+			 * phy/sgmii). DSA conduit yok, fixed-link yok. */
+			/* TEST048 KOK NEDEN DUZELTMESI:
+			 * Eski tarif (test011 ref50) GMAC2'yi EPHY :04'e, yani LAN1
+			 * JAGI'nin PHY'sine bagliyordu; phylink carrier'i o PHY'nin MDI
+			 * linkinden aldig icin LAN1'de kablo yokken 'lan' dusuyor ve
+			 * br-lan'in tek kablolu uyesi kayboluyordu. O yuzden LAN2/LAN3
+			 * yalniz LAN1 dolu iken calisiyordu (t315/t317 canli kanit).
+			 * Switch modda veri yolu die port5'tir; jak linkleri die'in kendi
+			 * PS sozcuklerindendir. Vendor dp1 tarifinde de port@2 phy-handle'siz.
+			 * B127 kaniti: "sgmii" 2500'i reddediyor -> 2500base-x + fixed-link.
+			 * dtc kurali: fixed-link ALTI-DUGUMU, tum property'lerden SONRA gelmeli. */
+			/* TEST049: test048 bu phy-handle'i fixed-link icin sildi ve
+			 * LAN1/2/3 oldu: die mesh'i LAN2/3 karelerini port4 (LAN1 EPHY)
+			 * uzerinden tasiyordu, uplink'in ta kendisiydi. Geri alindi.
+			 */
+			phy-mode = "2500base-x";
+			/* test050: phy-handle KALDIRILDI. Bu MAC artik DSA
+			 * conduit'idir (switch port@5 ethernet=<&xgmac2>): trunk,
+			 * die port5'in SerDes hatti; jak linkleri die'in kendi PS
+			 * sozcuklerinden okunur. &phy_lan artik DSA port@4'in
+			 * phy-handle'i (cift bagimililik yasak).
+			 * TEST048'in NEGATIF sonucu bypass topologyune aitti -
+			 * o moda uplink'in ta kendisi EPHY4'tu; switch moda port5
+			 * trunk'i sabit-link oldugu icin "lan" her zaman oper-up. */
+			nvmem-cells = <&base_macaddr 1>;
+			nvmem-cell-names = "mac-address"; /* TEST27: LAN1 jak = PHY addr4 (test20 kaniti + test11a'da MAC2<->addr4 link tepkisi) */
+
+
