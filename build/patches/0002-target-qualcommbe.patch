diff --git a/target/linux/qualcommbe/patches-6.18/0370-net-ethernet-qualcomm-ppe-reset-all-EDMA-controls.patch b/target/linux/qualcommbe/patches-6.18/0370-net-ethernet-qualcomm-ppe-reset-all-EDMA-controls.patch
