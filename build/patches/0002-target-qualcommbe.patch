diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-gl-wireless-country b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-gl-wireless-country
new file mode 100644
index 0000000..fc041a7
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-gl-wireless-country
@@ -0,0 +1,80 @@
+#!/bin/sh
+#
+# GL.iNet boards store the factory regulatory domain as a 2-byte ISO-3166
+# country code in the ART partition. The vendor firmware exposes it as
+# /proc/gl-hw-info/country_code via an out-of-tree module; read it straight
+# out of the partition instead.
+#
+# Without a country set, hostapd refuses to start on 6 GHz ("Invalid
+# country_code '00'"), so the radios stay down on a fresh install.
+#
+# Every exit path that leaves the country unset is logged: a silent failure
+# here looks like "Wi-Fi is broken" with nothing in the log to explain it.
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+
+LOG_TAG=gl-wireless-country
+
+warn_manual() {
+	logger -t "$LOG_TAG" -p daemon.warn "$1"
+	logger -t "$LOG_TAG" -p daemon.warn \
+		"radios may stay down (6 GHz needs a country). Set one manually, e.g.:" \
+		"uci set wireless.radio0.country=US; uci commit wireless; wifi"
+}
+
+board=$(board_name)
+
+case "$board" in
+gl.inet,gl-be9300) ;;
+*) exit 0 ;;
+esac
+
+art=$(find_mmc_part "0:ART")
+if [ -z "$art" ]; then
+	warn_manual "ART partition (0:ART) not found"
+	exit 0
+fi
+
+# Offset 0x88, 2 bytes. Accept lower case too - only a value that is not two
+# letters at all means the field is unprogrammed.
+country=$(dd if="$art" bs=1 skip=136 count=2 2>/dev/null |
+	tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
+
+if [ "${#country}" != 2 ]; then
+	warn_manual "ART regulatory field at 0x88 is not a valid ISO-3166 code"
+	exit 0
+fi
+
+[ -f /etc/config/wireless ] || /sbin/wifi config
+
+# A country counts as set only if it is two letters. `wifi config` writes
+# country='00' for the 6 GHz radio whenever the board supplies no wlan defaults
+# (see mac80211.uc), and '00' is worse than an unset value: hostapd rejects it
+# with "Invalid country_code '00'" and then NO interface on the phy starts, not
+# just 6 GHz. A non-empty test would skip precisely that radio and leave the
+# board with no working Wi-Fi at all - which is the dead-radio report.
+country_is_set() {
+	[ "${#1}" = 2 ] || return 1
+	case "$1" in
+		*[!A-Z]*) return 1 ;;
+	esac
+	return 0
+}
+
+changed=0
+for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
+	cur=$(uci -q get wireless.$dev.country | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
+	country_is_set "$cur" && continue
+	uci set wireless.$dev.country="$country"
+	changed=1
+done
+
+if [ "$changed" = 1 ]; then
+	uci commit wireless
+	logger -t "$LOG_TAG" "set regulatory country '$country' from ART"
+else
+	logger -t "$LOG_TAG" "regulatory country already set; left unchanged"
+fi
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-mr47be-lan-ip b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-mr47be-lan-ip
new file mode 100644
index 0000000..1e5ccbe
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/95-mr47be-lan-ip
@@ -0,0 +1,26 @@
+#!/bin/sh
+# Use 192.168.5.1/24 as the default MR47BE LAN address to avoid clashing with
+# upstream routers that use 192.168.1.1. Only changes the factory default
+# (192.168.1.1) or an empty value; a user-set custom IP is left untouched.
+# On initramfs (RAM) boot /etc/config is regenerated on every boot, so this
+# script ships with the persistent image.
+[ -f /etc/config/network ] || exit 0
+
+cur="$(uci -q get network.lan.ipaddr)"
+base="${cur%%/*}"
+
+[ -z "$base" ] || [ "$base" = "192.168.1.1" ] || exit 0
+
+uci set network.lan.proto='static'
+uci set network.lan.ipaddr='192.168.5.1'
+uci set network.lan.netmask='255.255.255.0'
+uci commit network
+
+# The DHCP pool is computed from the LAN address; update the base if present.
+if [ -n "$(uci -q get dhcp.lan)" ]; then
+	uci set dhcp.lan.start='100'
+	uci set dhcp.lan.limit='150'
+	uci commit dhcp
+fi
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/96-mr47be-wan-fix b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/96-mr47be-wan-fix
new file mode 100644
index 0000000..927b88a
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/96-mr47be-wan-fix
@@ -0,0 +1,56 @@
+#!/bin/sh
+# MR47BE V2 - v27 WAN config migration (runs once after sysupgrade).
+#
+# v27 notes:
+#  - The WAN netdev is probed by the kernel as "gmac1" and is renamed to "wan"
+#    by /etc/init.d/wan-rename (START=19).  Every consumer must therefore use
+#    the name "wan"; the old "gmac1" leftovers made LuCI draw a phantom
+#    "gmac1" port with 0 B and left the WAN LED trigger dangling.
+#  - wan6 follows the wan interface ('@wan'), never a hard netdev name.
+#  - /etc/board-base.json is NOT rewritten here.  It is generated at image
+#    build time from /etc/board.d/* (01_leds/02_network) and already carries
+#    the correct "wan" device.  The v13 hack that rewrote
+#    '"device": "wan"' -> '"device": "gmac1"' is gone: it was the reason the
+#    WAN port showed up as a dead gmac1 tile in LuCI.
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+[ -f /lib/functions/system.sh ] && [ "$(board_name)" = "mercusys,mr47be-v2" ] || exit 0
+[ -f /etc/config/network ] || exit 0
+
+_changed=0
+
+# 1) wan6 must follow the wan interface ('@wan'), never a hard netdev name.
+if uci -q get network.wan6 >/dev/null 2>&1; then
+	_d6=$(uci -q get network.wan6.device)
+	case "$_d6" in
+	wan|gmac1|'')
+		uci set network.wan6.device='@wan'
+		_changed=1
+		;;
+	esac
+fi
+
+# 2) A wan section resurrected by older builds without proto and without an
+#    address is dead weight - remove it (same rule as v13).
+if uci -q get network.wan >/dev/null 2>&1; then
+	_p=$(uci -q get network.wan.proto)
+	_ip=$(uci -q get network.wan.ipaddr)
+	if [ -z "$_p" ] && [ -z "$_ip" ]; then
+		_d=$(uci -q get network.wan.device)
+		case "$_d" in
+		wan|gmac1|'')
+			uci delete network.wan
+			_changed=1
+			;;
+		esac
+	fi
+fi
+
+# 3) The final WAN device name is decided by /etc/init.d/wan-rename: it knows
+#    whether the gmac1 -> wan rename actually succeeded, so we do not hardcode
+#    it here.
+
+[ "$_changed" = 1 ] && uci commit network
+
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/96-mr47be-wireless b/target/linux/qualcommbe/ipq53xx/base-files/etc/uci-defaults/96-mr47be-wireless
