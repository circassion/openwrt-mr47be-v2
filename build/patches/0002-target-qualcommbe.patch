+                        next-level-cache = <0x00000002>;
+                        clocks = <0x00000003 0x00000003>;
+                        operating-points-v2 = <0x00000004>;
+                        qcom,acc = <0x00000006>;
+                        phandle = <0x00000045>;
+		};
+
+		cpu2: cpu@2 {
+			device_type = "cpu";
